# Build-time
PUBLIC_SITE_URL=https://mens-circle.de
# Server-island key; must stay stable across builds (bunx astro create-key).
ASTRO_KEY=
# Optional analytics overrides; defaults live in SeoHead.astro.
PUBLIC_UMAMI_ID=
PUBLIC_UMAMI_ENDPOINT=

# Runtime
APP_URL=https://mens-circle.de
DATABASE_PATH=./data/mens-circle.db

MAIL_FROM_ADDRESS=hallo@mens-circle.de
MAIL_FROM_NAME=Männerkreis Niederbayern/Straubing
MAIL_ADMIN_ADDRESS=hallo@mens-circle.de
MAIL_ADMIN_NAME=Männerkreis Admin
MAIL_CONTACT_ADDRESS=hallo@mens-circle.de

# Pocket ID; callback URL is ${APP_URL}/auth/callback.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Admission: a Pocket ID group and/or comma-separated verified emails.
OIDC_ADMIN_GROUP=
ADMIN_EMAIL=
# ≥ 32 characters (openssl rand -hex 32).
ADMIN_SESSION_SECRET=

# listmonk base URL without /api.
LISTMONK_URL=
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
# Numeric list IDs, not UUIDs.
LISTMONK_LIST_IDS=
LISTMONK_CAMPAIGN_TEMPLATE_ID=
# Transactional template IDs; an empty one skips that mail.
LISTMONK_TX_REGISTRATION_CONFIRMATION=
LISTMONK_TX_WAITLIST_CONFIRMATION=
LISTMONK_TX_ADMIN_NOTIFICATION=
LISTMONK_TX_WAITLIST_PROMOTION=
LISTMONK_TX_EVENT_REMINDER=
LISTMONK_TX_EVENT_MESSAGE=

# Optional SQLite → S3 backup; empty bucket disables it.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=mens-circle-db
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=30
