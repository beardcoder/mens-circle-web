# Build-time
PUBLIC_SITE_URL=https://mens-circle.de
# Where EmDash keeps its SQLite database (admin sessions beside it, in sessions/).
# Baked into the build: the Dockerfile sets /data/emdash.db.
DATABASE_PATH=./data/emdash.db
# Optional Umami analytics, read at build time. Without both nothing is loaded.
# Production: PUBLIC_UMAMI_ENDPOINT=https://va.letsbenow.de and the site's website ID.
# The privacy policy names this host; change it there too when it moves.
PUBLIC_UMAMI_ID=
PUBLIC_UMAMI_ENDPOINT=

# Runtime
APP_URL=https://mens-circle.de
# Whose header names the visitor's IP for the rate limits: `cloudflare` trusts
# CF-Connecting-IP (only while the origin is reachable through Cloudflare alone);
# `none` (default) uses the socket's peer. X-Forwarded-For is never trusted.
TRUSTED_PROXY=none
# Days after an event until its registrations are anonymised (plugin cron, 02:30 UTC).
# May only be lower than the 30 the privacy policy names (src/lib/shared/retention.ts).
RETENTION_DAYS=30

# Who hears of every new registration, and the address the mails name for questions.
MAIL_ADMIN_ADDRESS=hallo@mens-circle.de
MAIL_CONTACT_ADDRESS=hallo@mens-circle.de
# Signs the cancel links in participant mails; ≥ 32 characters (openssl rand -hex 32).
# Without it the mails say "write to us" instead.
CANCEL_LINK_SECRET=

# EmDash. Encrypts secrets stored in the admin (an SMTP password saved there):
# bunx emdash secrets generate
EMDASH_ENCRYPTION_KEY=
# Behind Cloudflare: the header naming the visitor's IP for EmDash's sign-in rate limits.
EMDASH_TRUSTED_PROXY_HEADERS=
# The participant mails go out through EmDash's SMTP transport. Either set these or
# configure SMTP in the admin (Settings → Email), which then takes precedence.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_SMTP_FROM=Männerkreis Niederbayern <hallo@mens-circle.de>

# listmonk keeps the newsletter list (sign-up form, double opt-in, campaigns).
# Base URL without /api.
LISTMONK_URL=
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
# Numeric list IDs, not UUIDs.
LISTMONK_LIST_IDS=
