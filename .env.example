# Canonical site URL (build-time: sitemap/OG). On Coolify set via SERVICE_URL_WEB.
PUBLIC_SITE_URL=https://mens-circle.de

# Runtime app URL (used in email links, the hosted .ics URL, image URLs).
APP_URL=https://mens-circle.de

# Encryption key for server-island props (`server:defer`). BUILD-TIME only:
# Astro encodes it into the server manifest, so the running container never
# reads this variable — in Coolify it has to be marked as a build variable.
# Generate once with `bunx astro create-key` and then keep the value stable.
# Otherwise Astro mints a fresh key per build and prerendered HTML from an older
# build can no longer resolve its islands (/_server-islands answers 400 and the
# fallback stays). That is the precondition for the cacheable HTML headers in
# src/lib/cache.ts; drop this and that constant goes back to 'no-cache'.
# Locally it is optional.
ASTRO_KEY=
MAIL_FROM_ADDRESS=hallo@mens-circle.de
MAIL_FROM_NAME=Männerkreis Niederbayern/ Straubing
MAIL_ADMIN_ADDRESS=hallo@mens-circle.de
MAIL_ADMIN_NAME=Männerkreis Admin
MAIL_CONTACT_ADDRESS=hallo@mens-circle.de

# SQLite database file (Drizzle / bun:sqlite). In Docker this lives in the
# mounted /data volume; locally it defaults to ./data/mens-circle.db.
DATABASE_PATH=./data/mens-circle.db

# Admin UI — sign-in through Pocket ID (OpenID Connect). Create an OIDC client
# there with the callback URL `${APP_URL}/auth/callback` (e.g.
# https://mens-circle.de/auth/callback, locally http://localhost:4321/auth/callback
# with APP_URL set to match). Without these the /admin area is unusable.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Who may enter: comma-separated emails (must be verified in Pocket ID) and/or
# one Pocket ID group. At least one of the two is required.
ADMIN_EMAIL=
OIDC_ADMIN_GROUP=
# At least 32 random characters; signs the session cookie (`openssl rand -hex 32`).
ADMIN_SESSION_SECRET=

# listmonk — newsletter subscribers, per-event lists AND transactional email.
# Independently hosted service; HTTPS base URL without /api, e.g.
# https://newsletter.example.org. Restart the web service after changing it.
LISTMONK_URL=
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
# Numeric list ID(s), comma-separated — e.g. "1" or "1,2".
# Use the numeric ID from listmonk → Lists (URL .../admin/lists/<ID>), NOT the
# list UUID.
LISTMONK_LIST_IDS=

# Numeric ID of the listmonk *campaign* template used for the event newsletter
# (Admin → Campaigns → Templates → type "Campaign") on the external instance.
# Empty/0 → listmonk's default campaign template.
LISTMONK_CAMPAIGN_TEMPLATE_ID=

# Numeric IDs of the listmonk *transactional* templates (Admin → Campaigns →
# Templates → type "Transactional") on the external instance. See README.md
# for the payload contract. Empty → corresponding email is skipped and logged.
LISTMONK_TX_REGISTRATION_CONFIRMATION=
LISTMONK_TX_WAITLIST_CONFIRMATION=
LISTMONK_TX_ADMIN_NOTIFICATION=
LISTMONK_TX_WAITLIST_PROMOTION=
LISTMONK_TX_EVENT_REMINDER=
LISTMONK_TX_EVENT_MESSAGE=

# SQLite → S3 backup (scripts/backup-db.ts). Run on a schedule, e.g.
#   docker exec <web> bun run scripts/backup-db.ts
# Works with AWS S3 or any S3-compatible store (Cloudflare R2, MinIO, …).
# Leave BACKUP_S3_BUCKET empty to disable. For R2/MinIO set BACKUP_S3_ENDPOINT.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=mens-circle-db
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Prune backups older than N days (0 = keep everything).
BACKUP_RETENTION_DAYS=30

# Umami analytics — BUILD-TIME overrides. Both default to the production
# Männerkreis property, hard-coded in src/components/SeoHead.astro, so leaving
# them empty keeps tracking as-is; set them to point a build at a different
# (e.g. staging) Umami instance. They drive both consumers at once: the
# tracker script (incl. Core Web Vitals) and the preconnect hint.
PUBLIC_UMAMI_ID=
PUBLIC_UMAMI_ENDPOINT=

# Coolify auto-generates SERVICE_URL_WEB for the web service.
# Configure LISTMONK_URL explicitly; listmonk is deployed independently.
