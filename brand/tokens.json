    "panel": {
      "$type": "dimension",
      "$value": {
        "base": "1.75rem",
        "48rem": "2.5rem",
        "64rem": "3rem"
      }
    },
    "overlap": {
      "$type": "dimension",
      "$value": {
        "base": "2.5rem",
        "48rem": "4rem",
        "64rem": "6rem"
