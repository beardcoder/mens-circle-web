      }
    },
    "gutter": {
      "$type": "dimension",
      "$value": {
        "base": "1.75rem",
        "48rem": "2.5rem",
        "80rem": "3.5rem"
      }
    },
    "card": {
      "$type": "dimension",
      "$value": {
        "base": "1.5rem",
        "48rem": "1.75rem",
        "64rem": "2rem"
