  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": "var(--font-figtree)",
      "$description": ""
    },
    "display": {
      "$type": "fontFamily",
      "$value": "var(--font-vollkorn)",
      "$description": "Vollkorn, variable: weight 400–900, lining figures"
    },
    "display--font-feature-settings": {
      "$type": "fontFamily",
      "$value": "'lnum'",
      "$description": ""
    }
  },
  "type": {
    "marginal": {
      "$type": "typography",
      "$value": {
        "fontSize": "0.875rem",
        "lineHeight": "1.5",
        "letterSpacing": "0.01em"
      },
      "$description": "14px: a note in the margin column"
    },
    "xs": {
      "$type": "typography",
      "$value": {
        "fontSize": "0.8125rem",
        "lineHeight": "1.45",
        "letterSpacing": ""
      },
      "$description": "13px: the small print"
    },
    "sm": {
      "$type": "typography",
      "$value": {
        "fontSize": "0.875rem",
        "lineHeight": "1.5",
        "letterSpacing": ""
      },
      "$description": "14px: labels, hints, captions"
    },
    "base": {
      "$type": "typography",
      "$value": {
        "fontSize": "1rem",
        "lineHeight": "1.55",
        "letterSpacing": ""
      },
      "$description": "16px: controls, data, buttons"
    },
    "md": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem)",
        "lineHeight": "1.65",
        "letterSpacing": ""
      },
      "$description": "17–19px: running text"
    },
    "lg": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(1.125rem, 1.04rem + 0.35vw, 1.3125rem)",
        "lineHeight": "1.55",
        "letterSpacing": ""
      },
      "$description": "18–21px: a lead"
    },
    "xl": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(1.125rem, 1.05rem + 0.35vw, 1.375rem)",
        "lineHeight": "1.4",
        "letterSpacing": ""
      },
      "$description": "18–22px: FAQ questions, data values"
    },
    "quote": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(1.5rem, 1.3rem + 0.8vw, 2.125rem)",
        "lineHeight": "1.3",
        "letterSpacing": "-0.01em"
      },
      "$description": "24–34px: one short quote"
    },
    "sub": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(1.375rem, 1.2rem + 0.7vw, 1.875rem)",
        "lineHeight": "1.2",
        "letterSpacing": "-0.01em"
      },
      "$description": "22–30px"
    },
    "section": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(2.25rem, 1.4rem + 3.4vw, 4.5rem)",
        "lineHeight": "1.02",
        "letterSpacing": "-0.025em"
      },
      "$description": "36–72px: a section's title"
    },
    "page": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(2.75rem, 1.6rem + 4.6vw, 6rem)",
        "lineHeight": "0.98",
        "letterSpacing": "-0.03em"
      },
      "$description": "44–96px: a sub-page's title"
    },
    "hero": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(2.75rem, 1.5rem + 4.2vw, 5.125rem)",
        "lineHeight": "0.96",
        "letterSpacing": "-0.035em"
      },
      "$description": "44–82px: the home statement"
    },
    "index": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(3rem, 1.9rem + 4.4vw, 6.5rem)",
        "lineHeight": "0.9",
        "letterSpacing": "-0.04em"
      },
      "$description": "48–104px: an index number in the margin"
    },
    "poster": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(4.5rem, 1.4rem + 12.4vw, 13.5rem)",
        "lineHeight": "0.86",
        "letterSpacing": "-0.05em"
      },
      "$description": "72–216px: one poster word or number"
    }
  },
  "space": {
    "section": {
      "$type": "dimension",
      "$value": {
        "base": "5.5rem",
        "48rem": "7rem",
        "64rem": "9rem"
      }
