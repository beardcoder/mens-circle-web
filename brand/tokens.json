        "lineHeight": "0.9",
        "letterSpacing": "-0.04em"
      },
      "$description": "48–104px: an index number in the margin"
    },
    "poster": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(4.5rem, 1.4rem + 12.4vw, 13.5rem)",
        "lineHeight": "0.86",
        "letterSpacing": "-0.05em"
      },
      "$description": "72–216px: one poster word or number"
    }
