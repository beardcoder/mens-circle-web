    },
    "header": {
      "$type": "dimension",
      "$value": {
        "base": "4.5rem"
      },
      "$description": "the fixed bar, 72px"
    },
    "clearance": {
      "$type": "dimension",
      "$value": {
        "base": "6rem"
      },
      "$description": "the bar plus air, for anchors and sticky columns"
    }
  },
  "size": {
    "page": {
      "$type": "dimension",
      "$value": "calc(75rem + 2 * var(--space-gutter))"
    },
    "form": {
      "$type": "dimension",
      "$value": "42rem",
      "$description": "a form's column"
    },
    "column": {
      "$type": "dimension",
      "$value": "45rem",
      "$description": "a reading column (legal pages, essays)"
    },
    "measure": {
      "$type": "dimension",
      "$value": "38rem",
