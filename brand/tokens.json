    "display--font-feature-settings": {
      "$type": "fontFamily",
      "$value": "'lnum'",
      "$description": ""
    }
  },
  "type": {
    "marginal": {
      "$type": "typography",
      "$value": {
        "fontSize": "0.875rem",
        "lineHeight": "1.5",
        "letterSpacing": "0.01em"
      },
      "$description": "14px: a note in the margin column"
    },
    "xs": {
      "$type": "typography",
      "$value": {
        "fontSize": "0.8125rem",
        "lineHeight": "1.45",
        "letterSpacing": ""
      },
      "$description": "13px: the small print"
    },
    "sm": {
      "$type": "typography",
      "$value": {
        "fontSize": "0.875rem",
        "lineHeight": "1.5",
        "letterSpacing": ""
      },
      "$description": "14px: labels, hints, captions"
    },
    "base": {
      "$type": "typography",
      "$value": {
        "fontSize": "1rem",
        "lineHeight": "1.55",
        "letterSpacing": ""
      },
      "$description": "16px: controls, data, buttons"
    },
    "md": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem)",
        "lineHeight": "1.65",
        "letterSpacing": ""
      },
      "$description": "17–19px: running text"
    },
    "lg": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(1.125rem, 1.04rem + 0.35vw, 1.3125rem)",
        "lineHeight": "1.55",
        "letterSpacing": ""
      },
      "$description": "18–21px: a lead"
    },
    "xl": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(1.125rem, 1.05rem + 0.35vw, 1.375rem)",
        "lineHeight": "1.4",
        "letterSpacing": ""
      },
      "$description": "18–22px: FAQ questions, data values"
    },
    "quote": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(1.75rem, 1.45rem + 1.2vw, 2.625rem)",
        "lineHeight": "1.2",
        "letterSpacing": "-0.01em"
      },
      "$description": "28–42px: one short quote"
    },
    "sub": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(1.625rem, 1.4rem + 0.9vw, 2.25rem)",
        "lineHeight": "1.15",
        "letterSpacing": "-0.01em"
      },
      "$description": "26–36px"
    },
    "section": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(2.25rem, 1.4rem + 3.4vw, 4.5rem)",
        "lineHeight": "1.02",
        "letterSpacing": "-0.015em"
      },
      "$description": "36–72px: a section's title"
    },
    "page": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(2.75rem, 1.6rem + 4.6vw, 6rem)",
        "lineHeight": "0.98",
        "letterSpacing": "-0.02em"
      },
      "$description": "44–96px: a sub-page's title"
    },
    "hero": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(3rem, 1.6rem + 5.2vw, 5.625rem)",
        "lineHeight": "0.96",
