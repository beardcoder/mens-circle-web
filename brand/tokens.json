  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": "var(--font-plex)",
      "$description": ""
    },
    "display": {
      "$type": "fontFamily",
      "$value": "var(--font-cormorant)",
      "$description": "Cormorant, variable: weight 500–700, upright and italic, lining figures"
    },
    "display--font-feature-settings": {
      "$type": "fontFamily",
      "$value": "'lnum'",
      "$description": ""
    }
  },
  "type": {
    "marginal": {
      "$type": "typography",
      "$value": {
        "fontSize": "0.875rem",
        "lineHeight": "1.5",
        "letterSpacing": "0.01em"
      },
      "$description": "14px: a note in the margin column"
    },
    "xs": {
      "$type": "typography",
      "$value": {
        "fontSize": "0.8125rem",
        "lineHeight": "1.45",
        "letterSpacing": ""
      },
      "$description": "13px: the small print"
    },
    "sm": {
      "$type": "typography",
      "$value": {
        "fontSize": "0.875rem",
        "lineHeight": "1.5",
        "letterSpacing": ""
      },
      "$description": "14px: labels, hints, captions"
    },
    "base": {
      "$type": "typography",
      "$value": {
        "fontSize": "1rem",
        "lineHeight": "1.55",
        "letterSpacing": ""
      },
      "$description": "16px: controls, data, buttons"
    },
    "md": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem)",
        "lineHeight": "1.65",
        "letterSpacing": ""
      },
      "$description": "17–19px: running text"
    },
    "lg": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(1.125rem, 1.04rem + 0.35vw, 1.3125rem)",
        "lineHeight": "1.55",
        "letterSpacing": ""
      },
      "$description": "18–21px: a lead"
    },
    "xl": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(1.125rem, 1.05rem + 0.35vw, 1.375rem)",
        "lineHeight": "1.4",
        "letterSpacing": ""
      },
      "$description": "18–22px: FAQ questions, data values"
    },
    "quote": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(1.75rem, 1.45rem + 1.2vw, 2.625rem)",
        "lineHeight": "1.2",
        "letterSpacing": "-0.01em"
      },
      "$description": "28–42px: one short quote"
    },
    "sub": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(1.625rem, 1.4rem + 0.9vw, 2.25rem)",
        "lineHeight": "1.15",
        "letterSpacing": "-0.01em"
      },
      "$description": "26–36px"
    },
    "section": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(2.25rem, 1.4rem + 3.4vw, 4.5rem)",
        "lineHeight": "1.02",
        "letterSpacing": "-0.015em"
      },
      "$description": "36–72px: a section's title"
    },
    "page": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(2.75rem, 1.6rem + 4.6vw, 6rem)",
        "lineHeight": "0.98",
        "letterSpacing": "-0.02em"
      },
      "$description": "44–96px: a sub-page's title"
    },
    "hero": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(3rem, 1.6rem + 5.2vw, 5.625rem)",
        "lineHeight": "0.96",
        "letterSpacing": "-0.02em"
      },
      "$description": "48–90px: the home statement"
    },
    "index": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(3rem, 1.9rem + 4.4vw, 6.5rem)",
        "lineHeight": "0.9",
        "letterSpacing": "-0.04em"
      },
      "$description": "48–104px: an index number in the margin"
    },
    "poster": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(4.5rem, 1.4rem + 12.4vw, 13.5rem)",
        "lineHeight": "0.86",
        "letterSpacing": "-0.05em"
      },
      "$description": "72–216px: one poster word or number"
    }
  },
  "space": {
    "section": {
      "$type": "dimension",
      "$value": {
        "base": "5.5rem",
        "48rem": "7rem",
        "64rem": "9rem"
      }
    },
    "band": {
      "$type": "dimension",
      "$value": {
        "base": "3.5rem",
        "48rem": "4rem",
        "64rem": "5rem"
      }
    },
    "group": {
      "$type": "dimension",
      "$value": {
        "base": "2.5rem",
        "48rem": "3rem",
        "64rem": "4rem"
      }
    },
    "grid": {
      "$type": "dimension",
      "$value": {
        "base": "2rem",
        "80rem": "3rem"
      }
    },
    "gutter": {
      "$type": "dimension",
      "$value": {
        "base": "1.75rem",
        "48rem": "2.5rem",
        "80rem": "3.5rem"
      }
    },
    "card": {
      "$type": "dimension",
      "$value": {
        "base": "1.5rem",
        "48rem": "1.75rem",
        "64rem": "2rem"
      }
    },
    "panel": {
      "$type": "dimension",
      "$value": {
        "base": "1.75rem",
        "48rem": "2.5rem",
        "64rem": "3rem"
      }
    },
    "overlap": {
      "$type": "dimension",
      "$value": {
        "base": "2.5rem",
        "48rem": "4rem",
        "64rem": "6rem"
      },
      "$description": "how far an element crosses an edge: 40 / 64 / 96px"
    },
    "bleed": {
      "$type": "dimension",
      "$value": {
        "base": "max(var(--space-gutter), calc((100vw - 75rem) / 2))"
      },
      "$description": "from the content's edge to the window's"
    },
    "header": {
      "$type": "dimension",
      "$value": {
        "base": "4.5rem"
      },
      "$description": "the fixed bar, 72px"
    },
    "clearance": {
      "$type": "dimension",
      "$value": {
        "base": "6rem"
      },
      "$description": "the bar plus air, for anchors and sticky columns"
    }
  },
  "size": {
    "page": {
      "$type": "dimension",
      "$value": "calc(75rem + 2 * var(--space-gutter))"
    },
    "form": {
      "$type": "dimension",
      "$value": "42rem",
      "$description": "a form's column"
    },
    "column": {
      "$type": "dimension",
      "$value": "45rem",
      "$description": "a reading column (legal pages, essays)"
    },
    "measure": {
      "$type": "dimension",
      "$value": "38rem",
      "$description": "a line of running text, ~62 characters"
    }
  },
  "radius": {
    "md": {
      "$type": "dimension",
      "$value": "0.5rem"
    },
    "xl": {
      "$type": "dimension",
      "$value": "1.75rem"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "2.5rem"
    }
  },
  "breakpoint": {
    "sm": {
      "$type": "dimension",
