{
  "ci": {
    "collect": {
      "startServerCommand": "DATABASE_PATH=./data/lighthouse.sqlite HOST=127.0.0.1 PORT=4321 bun --no-env-file server.ts",
      "startServerReadyPattern": "Server listening",
      "url": ["http://127.0.0.1:4321/", "http://127.0.0.1:4321/event"],
      "numberOfRuns": 1,
      "settings": { "preset": "perf", "formFactor": "mobile" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.95 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./dist/lighthouse" }
  }
}
