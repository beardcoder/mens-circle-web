{
  "name": "mens-circle-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Männerkreis Niederbayern/ Straubing — Astro 7 + Svelte 5, SSR on the Bun runtime, with Drizzle (bun:sqlite) as the backend and listmonk for email.",
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "astro build",
    "start": "bun run dist/server/entry.mjs",
    "preview": "bun run build && bun run start",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:backup": "bun run scripts/backup-db.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "9.0.1",
    "@wyattjoh/astro-bun-adapter": "^2.1.1",
    "@yeskunall/astro-umami": "^0.0.9",
    "astro": "7.2.0",
    "astro-icon": "^1.1.5",
    "drizzle-orm": "^0.45.2",
    "leaflet": "^1.9.4",
    "motion": "^12.43.0",
    "svelte": "^5.56.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/leaflet": "^1.9.22",
    "astro-eslint-parser": "^3.0.0",
    "astro-llms-md": "^2.2.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
