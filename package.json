{
  "name": "mens-circle-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "Website of the Männerkreis — Astro 7 SSR on the Bun runtime, Drizzle on bun:sqlite, listmonk for email, Pocket ID for the admin sign-in.",
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "start": "bun run dist/server/entry.mjs",
    "preview": "bun run build && bun run start",
    "check": "astro check",
    "test": "bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:backup": "bun run scripts/backup-db.ts",
    "images:verify": "bun scripts/verify-static-images.ts",
    "knip": "knip"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "openid-client": "^6.8.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@eslint/js": "^10.0.1",
    "@mens-circle/astro-bun": "workspace:*",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "astro": "7.3.8",
    "astro-icon": "^1.2.0",
    "astro-llms-md": "^3.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "knip": "^6.41.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.1",
    "tailwind-animations": "^1.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
