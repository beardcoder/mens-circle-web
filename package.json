{
  "name": "mens-circle-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Website of the Männerkreis — Astro 7 SSR on the Bun runtime, EmDash as the CMS (events, registrations, voices), listmonk for the newsletter.",
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "start": "bun server.ts",
    "preview": "bun run build && bun run start",
    "check": "astro check",
    "test": "bun test",
    "test:pages": "bun run build && bun --no-env-file scripts/check-public-pages.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "knip": "knip",
    "test:browser": "bun run build && bun --no-env-file scripts/check-browser.ts",
    "brand:export": "bun scripts/brand-export.ts",
    "brand:logo": "bun scripts/brand-logo.ts",
    "brand": "bun run brand:export && bun run brand:logo",
    "migrate:emdash": "bun scripts/migrate-to-emdash.ts"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.6",
    "@eslint/js": "^10.0.1",
    "@igloczek/astro-bun-adapter": "^1.3.0",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "astro": "7.4.13",
    "astro-icon": "^1.2.0",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "knip": "^6.47.0",
    "playwright": "1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "tailwind-animations": "^1.0.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "overrides": {
    "@emnapi/runtime": "1.11.3"
  },
  "dependencies": {
    "@emdash-cms/auth-atproto": "^0.2.52",
    "emdash": "1.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
