{
  "name": "mens-circle-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Website of the Männerkreis — Astro 7 SSR on the Bun runtime, Drizzle on bun:sqlite, listmonk for email, Pocket ID for the admin sign-in.",
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "start": "bun server.ts",
    "preview": "bun run build && bun run start",
    "check": "astro check",
    "test": "bun test",
    "test:pages": "bun run build && bun --no-env-file scripts/check-public-pages.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:backup": "bun run scripts/backup-db.ts",
    "knip": "knip",
    "test:browser": "bun run build && bun --no-env-file scripts/check-browser.ts",
    "brand:export": "bun scripts/brand-export.ts",
    "brand:logo": "bun scripts/brand-logo.ts",
    "brand:render": "bun scripts/brand-render.ts",
    "brand": "bun run brand:export && bun run brand:logo && bun run brand:render"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "openid-client": "^6.8.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/preact": "^6.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@eslint/js": "^10.0.1",
    "@igloczek/astro-bun-adapter": "^1.2.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "astro": "7.4.7",
    "astro-icon": "^1.2.0",
    "axe-core": "^4.14.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "knip": "^6.44.2",
    "playwright": "1.65.0",
    "preact": "^11.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "tailwind-animations": "^1.0.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "uqr": "0.1.3"
  }
}
