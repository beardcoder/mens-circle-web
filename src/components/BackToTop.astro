---
import { Icon } from 'astro-icon/components';
---

{/* Four fifths of a screen down the page: once it has scrolled past, the link shows. */}
<span data-top-sentinel aria-hidden="true" class="pointer-events-none absolute top-[80svh] left-0 size-px"></span>
<a
  href="#top"
  data-scroll-top
  aria-label="Nach oben scrollen"
  title="Nach oben"
  class="invisible fixed right-4 bottom-4 z-30 grid size-12 place-items-center rounded-full bg-fill text-on-fill opacity-0 transition-[background-color,translate,opacity,visibility] duration-180 data-[visible]:visible data-[visible]:opacity-100 hover:-translate-y-0.5 hover:bg-fill-strong motion-reduce:hover:translate-y-0 print:hidden sm:right-6 sm:bottom-6 max-lg:data-lifted:-translate-y-20"
>
  <Icon name="chevron-up" aria-hidden="true" class="size-4.5" />
</a>

<script>
  const link = document.querySelector<HTMLAnchorElement>('[data-scroll-top]');

  if (link) {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const behavior = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth';

      window.scrollTo({ top: 0, behavior });
      document.getElementById('top')?.focus({ preventScroll: true });
    });

    // Watched, not measured: reading the scroll position could force a layout.
    const sentinel = document.querySelector('[data-top-sentinel]');

    if (sentinel) {
      new IntersectionObserver(([entry]) => {
        link.toggleAttribute('data-visible', !entry.isIntersecting && entry.boundingClientRect.top < 0);
      }).observe(sentinel);
    }
  }
</script>
