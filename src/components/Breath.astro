---
interface Props {
  /** Rings and glow, or only the glow (for grounds where rings would cross text). */
  variant?: 'rings' | 'glow';
  class?: string;
}

/**
 * A background that breathes: a soft radial glow and, optionally, concentric
 * rings that widen and narrow on a calm breathing cycle (see `breathe` in
 * base/_keyframes.css: 4 s in, a short hold, 5 s out, a short rest — six breaths
 * a minute). Decorative only; place it where it never sits behind running text.
 * Under reduced motion it rests, still.
 */

const { variant = 'rings', class: className } = Astro.props;
const rings = variant === 'rings' ? [0.7, 0.84, 0.98] : [];
---

<span class:list={['breath', `breath--${variant}`, className]} aria-hidden="true">
  <span class="breath__glow"></span>
  {rings.map((size, i) => (
    <span
      class="breath__ring"
      style={`--size: ${size}; --alpha: ${(0.55 - i * 0.15).toFixed(2)}; --lag: ${i * 120}ms`}
    ></span>
  ))}
</span>

<style is:global>
  @layer components {
    .breath {
      --breath-color: var(--accent);
      --breath-glow: 22%;
      --breath-cycle: 10s;

      position: absolute;
      display: block;
      aspect-ratio: 1;
      pointer-events: none;
    }

    .breath__glow,
    .breath__ring {
      position: absolute;
      border-radius: 50%;
      animation: breathe var(--breath-cycle) infinite both;
    }

    /* Warm at the centre, gone at the edge — embers rather than a spotlight. */
    .breath__glow {
      --alpha: 1;
      --rest: 0.82;

      inset: 0;
      background: radial-gradient(
        closest-side,
        color-mix(in oklab, var(--breath-color) var(--breath-glow), transparent),
        color-mix(in oklab, var(--breath-color) calc(var(--breath-glow) * 0.4), transparent) 55%,
        transparent
      );
    }

    .breath__ring {
      --rest: 0.9;

      inset: calc((1 - var(--size)) * 50%);
      border: 1px solid var(--breath-color);
      animation-delay: var(--lag);
    }
  }
</style>
