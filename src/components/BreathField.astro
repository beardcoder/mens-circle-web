---
/**
 * The hero's breathing ground: three soft, warm colour fields (flame, deep rust,
 * amber) that widen and narrow like a body at rest. Each breathes on one shared,
 * three-breath phrase (`breath-swell` in global.css: in shorter than out, a short
 * rest, depth varying) while its wrapper turns slowly on its own period, so the
 * outline never repeats and never restarts.
 *
 * Scrolling gives depth: each field lags behind the page at its own rate
 * (`breath-parallax` on a scroll() timeline, on `translate` so it composes with
 * the turn), the rust most, the amber least. The fields are placed in svh, never
 * in % of the hero: the hero grows when the date island swaps in, and a field
 * moving with it would be a layout shift. lib/breath.ts pauses it off screen;
 * under reduced motion it rests, still. Per field: --x/--y/--w (place and size),
 * --turn, --rgb/--core (colour), the swell's --dx/--dy/--sx/--sy/--o0/--o1 and
 * the parallax's --px/--py.
 */

const drift = [
  'absolute top-(--y) left-(--x) -mt-[calc(var(--w)*var(--ratio,0.78)/2)] -ml-[calc(var(--w)/2)] h-[calc(var(--w)*var(--ratio,0.78))] w-(--w) origin-(--origin)',
  'animate-[breath-drift_var(--turn)_linear_infinite]',
  'scroll-motion:[animation:breath-drift_var(--turn)_linear_infinite,breath-parallax_linear_both] scroll-motion:[animation-range:normal,0_100vh] scroll-motion:[animation-timeline:auto,scroll(root_block)]',
];

// An eased fall-off — more stops, no visible centre. No blur filter: it stays on the compositor.
const blob =
  'size-full animate-breath-swell animate-delay-(--lag) rounded-full bg-[radial-gradient(closest-side,rgb(var(--rgb)/var(--core)),rgb(var(--rgb)/calc(var(--core)*0.78))_20%,rgb(var(--rgb)/calc(var(--core)*0.5))_40%,rgb(var(--rgb)/calc(var(--core)*0.24))_62%,rgb(var(--rgb)/calc(var(--core)*0.07))_82%,rgb(var(--rgb)/0)_100%)] will-change-[transform,opacity]';
---

<div
  aria-hidden="true"
  data-breath
  class="pointer-events-none absolute inset-0 z-0 overflow-clip [contain:strict] [mask-image:linear-gradient(to_bottom,transparent_var(--spacing-header),rgb(0_0_0/35%)_calc(var(--spacing-header)+7rem),#000_calc(var(--spacing-header)+16rem))] after:absolute after:inset-0 after:bg-[url(/images/grain.svg)] after:opacity-5"
>
  {/* Flame, behind the photograph: the warm centre of the breath. */}
  <div
    class:list={[
      drift,
      '[--origin:54%_46%] [--px:-2vw] [--py:34vh] [--turn:84s] [--w:64vmax] [--x:70%] [--y:62svh] max-lg:[--w:92vmax] max-lg:[--x:82%] max-lg:[--y:72svh]',
    ]}
  >
    <div
      class:list={[
        blob,
        '[--core:0.32] [--dx:-3%] [--dy:-2%] [--lag:0s] [--o0:0.7] [--o1:1] [--rgb:228_99_46] [--sx:0.11] [--sy:0.07]',
      ]}
    ></div>
  </div>

  {/* Deep rust, low and to the left: the ground the breath rests on. */}
  <div
    class:list={[
      drift,
      '[animation-direction:reverse] scroll-motion:[animation-direction:reverse,normal]',
      '[--origin:40%_58%] [--px:3vw] [--py:52vh] [--ratio:0.66] [--turn:112s] [--w:72vmax] [--x:12%] [--y:112svh] max-lg:[--w:84vmax] max-lg:[--x:8%] max-lg:[--y:128svh]',
    ]}
  >
    <div
      class:list={[
        blob,
        '[--core:0.3] [--dx:2%] [--dy:-3%] [--lag:-0.35s] [--o0:0.75] [--o1:1] [--rgb:150_58_28] [--sx:0.06] [--sy:0.1]',
      ]}
    ></div>
  </div>

  {/* Amber, high and small: where the inhale lifts. */}
  <div
    class:list={[
      drift,
      '[--origin:60%_40%] [--px:1vw] [--py:18vh] [--ratio:0.8] [--turn:66s] [--w:54vmax] [--x:32%] [--y:28svh] max-lg:[--w:70vmax] max-lg:[--x:24%] max-lg:[--y:30svh]',
    ]}
  >
    <div
      class:list={[
        blob,
        '[--core:0.13] [--dx:1%] [--dy:-5%] [--lag:-0.7s] [--o0:0.5] [--o1:1] [--rgb:232_163_92] [--sx:0.14] [--sy:0.09] max-lg:[--core:0.15]',
      ]}
    ></div>
  </div>
</div>
