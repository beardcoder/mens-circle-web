---
/**
 * A field of warm light that breathes: a core and a haze (flame) that widen and
 * settle on a natural breath (`breath` in theme.css: three breaths of different
 * depth, in shorter than out, a short hold and rest, so it never ticks like a
 * metronome); the haze follows the core a moment later, as a chest fills after
 * the belly.
 *
 * Depth on scroll: `view` lags behind its own block (`breath-parallax`, view()
 * timeline); `page` drifts with the whole page's scroll (`breath-drift`, root
 * scroll() timeline, by `--drift` from the caller) — the mode BreathBackdrop uses.
 *
 * Placed by the caller (absolute, centre and size). At its brightest the light
 * mixes ~17% flame into the ground (`soft`) or ~23% into a dark band (`strong`),
 * which keeps every text token above 4.5:1 where it runs behind text.
 * lib/breath.ts pauses it off screen; under reduced motion it rests, still.
 */
interface Props {
  /** `soft` on paper, `strong` on a dark band. */
  strength?: 'soft' | 'strong';
  parallax?: 'view' | 'page';
  class?: string;
}

const { strength = 'soft', parallax = 'view', class: className } = Astro.props;

// Core and haze, each a `breath-glow` field (theme.css) at its peak percentage.
const LAYERS = {
  soft: ['inset-[22%] breath-glow [--glow:10]', 'inset-0 breath-glow [--glow:8] animate-delay-[500ms]'],
  strong: ['inset-[22%] breath-glow [--glow:13]', 'inset-0 breath-glow [--glow:11] animate-delay-[500ms]'],
} as const;

const PARALLAX = {
  view: 'scroll-motion:animate-[breath-parallax_linear_both] scroll-motion:[animation-timeline:view()]',
  page: 'scroll-motion:animate-[breath-drift_linear_both] scroll-motion:[animation-timeline:scroll(root)]',
} as const;
---

<span class:list={['pointer-events-none absolute block aspect-square', className]} aria-hidden="true" data-breath>
  <span class:list={['absolute inset-0 block', PARALLAX[parallax]]}>
    {LAYERS[strength].map((layer) => (
      <span class:list={['absolute block animate-breath rounded-full', layer]} />
    ))}
  </span>
</span>
