---
interface Props {
  /** Changes the shape of the strokes; the same seed always draws the same ring.
   *  Must be unique per page (it also names the SVG filter). */
  seed?: number;
  /** Runs the one-time entrance (hero only). */
  entrance?: boolean;
  class?: string;
}

/**
 * The mark: a hand-painted ring, as on the flyer and in the logo's brush strokes.
 * Built at render time from a seeded PRNG — a heavy core stroke plus thin, broken
 * bristle strokes — and roughened by an SVG displacement filter. Decorative only;
 * text may sit inside the ring, never across its stroke.
 */

const { seed = 7, entrance = false, class: className } = Astro.props;

// mulberry32: small, deterministic, good enough for shapes.
const prng = (a: number) => () => {
  a |= 0;
  a = (a + 0x6d2b79f5) | 0;
  let t = Math.imul(a ^ (a >>> 15), 1 | a);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const rand = prng(seed);

const C = 200;
const R = 168;
const STEPS = 120;

/** A closed, slightly wobbling circle as a path: r(θ) = base + two slow waves. */
const ring = (base: number, wobble: number) => {
  const p1 = rand() * Math.PI * 2;
  const p2 = rand() * Math.PI * 2;
  const points = Array.from({ length: STEPS + 1 }, (_, i) => {
    const t = (i / STEPS) * Math.PI * 2;
    const r = base + wobble * Math.sin(2 * t + p1) + wobble * 0.6 * Math.sin(3 * t + p2);
    return `${(C + r * Math.cos(t)).toFixed(1)} ${(C + r * Math.sin(t)).toFixed(1)}`;
  });
  return `M${points.join('L')}Z`;
};

const core = ring(R, 2.2);
// Bristles: thin strokes either side of the core, broken into dry-brush runs.
const bristles = Array.from({ length: 11 }, (_, i) => {
  const offset = (i - 5) * 1.9 + (rand() - 0.5) * 1.2;
  const runs = Array.from({ length: 6 }, () => `${Math.round(60 + rand() * 180)} ${Math.round(4 + rand() * 26)}`);
  return {
    d: ring(R + offset, 2 + rand() * 1.6),
    width: (0.8 + rand() * 2.6).toFixed(2),
    dash: runs.join(' '),
    opacity: (0.45 + rand() * 0.5).toFixed(2),
  };
});

// The filter id follows the seed: give each ring on a page its own seed.
const id = `brush-${seed}`;
---

<span class:list={['brush-ring', entrance && 'brush-ring--entrance', className]} aria-hidden="true">
  <svg viewBox="0 0 400 400" focusable="false">
    <defs>
      <filter id={id} x="-10%" y="-10%" width="120%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed={seed} result="grain"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="grain" scale="5"></feDisplacementMap>
      </filter>
    </defs>
    <g class="brush-ring__strokes" filter={`url(#${id})`} fill="none" stroke="currentColor" stroke-linecap="round">
      <path d={core} stroke-width="11"></path>
      {bristles.map((b) => (
        <path d={b.d} stroke-width={b.width} stroke-dasharray={b.dash} opacity={b.opacity}></path>
      ))}
    </g>
  </svg>
</span>

<style is:global>
  @layer components {
    .brush-ring {
      display: block;
      aspect-ratio: 1;
      color: var(--brush-color, var(--color-flame));
      pointer-events: none;
    }

    .brush-ring svg {
      display: block;
      inline-size: 100%;
      block-size: 100%;
      overflow: visible;
    }

    .brush-ring__strokes {
      transform-box: fill-box;
      transform-origin: center;
    }

    @media (prefers-reduced-motion: no-preference) {
      .brush-ring--entrance .brush-ring__strokes {
        animation: ring-in 1100ms var(--ease-emphasised) both;
      }

      .vt-arrival .brush-ring--entrance .brush-ring__strokes {
        animation: none;
      }
    }
  }
</style>
