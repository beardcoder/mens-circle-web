---
/**
 * Contour lines of a hill country (the Bayerischer Wald behind Straubing), drawn in
 * the dark band's accent: the outdoors the circle comes from, never a pattern of
 * rings. Sits absolutely in a `relative` block, behind its content. At 20% even a
 * full blend of the line colour keeps every text token above 4.5:1. The drawing is
 * `public/images/contours.svg` (square, so tall phone bands keep its density).
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  aria-hidden="true"
  class:list={[
    'pointer-events-none absolute inset-0 bg-accent opacity-20 mask-[url(/images/contours.svg)] mask-cover mask-center mask-no-repeat',
    className,
  ]}
></div>
