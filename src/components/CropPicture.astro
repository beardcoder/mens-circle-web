---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A `<picture>` for a box of fixed aspect ratio. Bun.Image cannot crop, so every
 * variant keeps the source's ratio and CSS crops it with `object-fit: cover`;
 * the block sets `aspect-ratio` and `object-position` per breakpoint.
 */

interface Crop {
  /** Width ÷ height of the box this picture has to fill. */
  ratio: number;
  /** Rendered widths, in CSS pixels × the device ratios worth serving. */
  widths: number[];
  sizes: string;
}

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  /** Used below `breakpoint`. */
  narrow: Crop;
  /** Used from `breakpoint` upwards. */
  wide: Crop;
  /** A media query width, e.g. `56em`. */
  breakpoint: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'auto';
}

const { src, alt, class: className, narrow, wide, breakpoint, loading, fetchpriority } = Astro.props;

/** WebP for the sources, JPEG for the fallback. AVIF needs an OS encoder that Bun.Image lacks on Linux. */
type Format = 'webp' | 'jpeg';

/** The smallest variant that still covers a `width` × `ratio` box; the service keeps the source's ratio. */
const covering = (spec: Crop, format: Format, width: number) =>
  getImage({ src, format, width, height: Math.round(width / spec.ratio), fit: 'outside' });

/**
 * One `<source>`'s worth. The `w` descriptor names the box width a variant fills after
 * `cover`, not its pixel width, so the browser picks by the width it actually shows.
 */
async function srcset(spec: Crop, format: Format): Promise<string> {
  const images = await Promise.all(spec.widths.map((width) => covering(spec, format, width)));
  return images.map((image, i) => `${image.src} ${spec.widths[i]}w`).join(', ');
}

const sources = await Promise.all(
  [
    { spec: narrow, media: `(max-width: ${breakpoint})` },
    { spec: wide, media: `(min-width: ${breakpoint})` },
  ].map(async ({ spec, media }) => ({ media, sizes: spec.sizes, srcset: await srcset(spec, 'webp') })),
);

// The fallback carries the wide box: a browser without webp is not a phone.
// Its width and height reserve the box before CSS and the image land.
const fallbackSrcset = await srcset(wide, 'jpeg');
const width = Math.max(...wide.widths);
const fallback = await covering(wide, 'jpeg', width);
---

<picture>
  {sources.map((source) => (
    <source media={source.media} type="image/webp" srcset={source.srcset} sizes={source.sizes} />
  ))}
  <img
    src={fallback.src}
    srcset={fallbackSrcset}
    sizes={wide.sizes}
    width={width}
    height={Math.round(width / wide.ratio)}
    alt={alt}
    class={className}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
  />
</picture>
