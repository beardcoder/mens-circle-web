---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A `<picture>` with one crop below `breakpoint` and another from it upwards: Astro's
 * art-direction recipe ("Build a custom image component"), since `<Picture />` takes one
 * crop only. Sharp crops every variant at build time (`fit: 'cover'` + `position`), so
 * each file is exactly the box it fills and the `w` descriptors are its real width.
 * AVIF first, then WebP; the `<img>` falls back to JPEG.
 */

interface Crop {
  /** Width ÷ height of the box this picture has to fill. */
  ratio: number;
  /** Pixel widths to generate; Astro drops those wider than the source. */
  widths: number[];
  /** The rendered width per viewport, as precise as the layout allows. */
  sizes: string;
  /** What the crop keeps: an `object-position` keyword (`center`, `left`, `top right`…). */
  position?: string;
}

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  /** Used below `breakpoint`. */
  narrow: Crop;
  /** Used from `breakpoint` upwards. */
  wide: Crop;
  /** A media query width, e.g. `64em`. */
  breakpoint: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'auto';
}

const { src, alt, class: className, narrow, wide, breakpoint, loading = 'lazy', fetchpriority } = Astro.props;

const FORMATS = ['avif', 'webp'] as const;

/** All widths of one crop in one format; the largest also sets `src`, `width` and `height`. */
async function crop(spec: Crop, format: (typeof FORMATS)[number] | 'jpg') {
  const width = Math.max(...spec.widths);

  const image = await getImage({
    src,
    format,
    width,
    height: Math.round(width / spec.ratio),
    widths: spec.widths,
    fit: 'cover',
    position: spec.position,
  });

  return {
    srcset: image.srcSet.attribute,
    src: image.src,
    width: Number(image.attributes.width),
    height: Number(image.attributes.height),
  };
}

// The browser takes the first <source> whose media and type match: the wide crop from
// `breakpoint` up, else the narrow one; per crop AVIF before WebP.
const crops = [
  { spec: wide, media: `(min-width: ${breakpoint})` },
  { spec: narrow, media: undefined },
];

const sources = await Promise.all(
  crops.flatMap(({ spec, media }) =>
    FORMATS.map(async (format) => ({ media, format, sizes: spec.sizes, ...(await crop(spec, format)) })),
  ),
);

// The fallback carries the wide crop: a browser without AVIF or WebP is not a phone.
const fallback = await crop(wide, 'jpg');
---

<picture>
  {sources.map((source) => (
    <source
      media={source.media}
      type={`image/${source.format}`}
      srcset={source.srcset}
      sizes={source.sizes}
      width={source.width}
      height={source.height}
    />
  ))}
  <img
    src={fallback.src}
    srcset={fallback.srcset}
    sizes={wide.sizes}
    width={fallback.width}
    height={fallback.height}
    alt={alt}
    class={className}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
  />
</picture>
