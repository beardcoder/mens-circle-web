---
import { Icon } from 'astro-icon/components';

import { label } from '@lib/ui';

import nav from '../data/navigation.json';
import site from '../data/site.json';
import ModeToggle from './ModeToggle.astro';
import Container from './ui/Container.astro';

/**
 * The compact footer on the dark focus ground, the same on every page: the mark
 * and one line about the circle, the navigation, the contact, then the legal
 * links and the display option. No invitation of its own: a page that ends on
 * one sets it itself.
 */

// `mailto:` and `tel:` stay in place; external profiles open in a new tab,
// announced as part of the accessible name. Icons: src/icons/social-<type>.svg.
const socialLinks = site.socialLinks.map((link) => {
  const internal = link.type === 'email' || link.type === 'phone';
  const scheme = link.type === 'email' ? 'mailto:' : link.type === 'phone' ? 'tel:' : '';
  const text = link.type === 'email' ? site.contactEmail : link.type === 'phone' ? site.contactPhone : link.label;

  return { ...link, href: `${scheme}${link.value}`, internal, text };
});

// Only these prerendered pages are safe to fetch before a click.
const prefetchPaths = new Set(['/warum-ich-den-maennerkreis-leite', '/impressum', '/datenschutz']);

const footerLink =
  'inline-flex min-h-11 items-center gap-3 text-base text-fg transition-colors duration-180 hover:text-accent sm:min-h-10';
---

<footer class="surface-dark pt-section pb-8 print:hidden">
  <Container>
    <div class="grid gap-x-grid gap-y-10 pb-group sm:grid-cols-2 lg:grid-cols-[minmax(0,5fr)_minmax(0,3fr)_minmax(0,4fr)]">
      <div class="max-w-[38ch] sm:col-span-2 lg:col-span-1">
        <a href="/" class="mb-4 inline-flex min-h-11 items-center gap-3 font-serif text-sub">
          <Icon name="logo" aria-hidden="true" class="size-9 shrink-0" />
          <span>{site.siteName}</span>
        </a>
        <p class="text-base text-fg-muted">{site.footerDescription}</p>
      </div>

      <nav aria-label="Fußnavigation">
        <h2 class:list={[label, 'mb-3']}>Navigation</h2>
        <ul role="list">
          {nav.footerPrimary.map((item) => (
            <li>
              <a
                href={item.url}
                class={footerLink}
                data-umami-event="footer-link"
                data-astro-prefetch={prefetchPaths.has(item.url) ? 'hover' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class:list={[label, 'mb-3']}>Kontakt</h2>
        <ul role="list">
          {socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.internal ? undefined : '_blank'}
                rel={link.internal ? undefined : 'noopener noreferrer'}
                data-umami-event="social-click"
                data-umami-event-platform={link.type}
                class={footerLink}
              >
                <Icon name={`social-${link.type}`} aria-hidden="true" class="size-4.5 shrink-0 text-fg-muted" />
                <span>
                  {link.text}
                  {!link.internal && <span class="sr-only"> (öffnet in neuem Tab)</span>}
                </span>
              </a>
            </li>
          ))}
          {nav.footerContact.map((item) => (
            <li>
              <a href={item.url} class={footerLink} data-umami-event="footer-link">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-line pt-6">
      <p class="text-sm text-fg-muted">{site.footerText}</p>
      <div class="flex flex-wrap items-center gap-x-6">
        <nav aria-label="Rechtliches" class="flex flex-wrap gap-x-6">
          {nav.footerLegal.map((item) => (
            <a
              href={item.url}
              data-umami-event="footer-link"
              data-astro-prefetch={prefetchPaths.has(item.url) ? 'hover' : undefined}
              class="inline-flex min-h-11 items-center text-sm text-fg-muted transition-colors duration-180 hover:text-fg"
            >
              {item.label}
            </a>
          ))}
        </nav>
        <ModeToggle />
      </div>
    </div>
  </Container>
</footer>
