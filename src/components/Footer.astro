---
import nav from '../data/navigation.json';
import site from '../data/site.json';
import { Icon } from 'astro-icon/components';

// `mailto:` and `tel:` stay in place; external profiles open in a new tab,
// announced as part of the accessible name. Icons: src/icons/social-<type>.svg.
const socialLinks = site.socialLinks.map((link) => {
  const internal = link.type === 'email' || link.type === 'phone';
  const scheme = link.type === 'email' ? 'mailto:' : link.type === 'phone' ? 'tel:' : '';
  return { ...link, href: `${scheme}${link.value}`, internal };
});
const phoneHref = site.contactPhone ? `tel:${site.contactPhone.replace(/[\s\-()]/g, '')}` : null;
// Only these prerendered pages are safe to fetch before a click.
const prefetchPaths = new Set(['/warum-ich-den-maennerkreis-leite', '/impressum', '/datenschutz']);
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__contact">
        <p class="footer__lead">Fragen vorab? Schreib mir oder ruf an.</p>
        {site.contactEmail && (
          <a
            class="footer__mail"
            href={`mailto:${site.contactEmail}`}
            data-umami-event="contact-click"
            data-umami-event-type="email"
          >
            {site.contactEmail}
          </a>
        )}
        {phoneHref && (
          <a class="footer__phone" href={phoneHref} data-umami-event="contact-click" data-umami-event-type="phone">
            {site.contactPhone}
          </a>
        )}
      </div>

      <nav class="footer__nav" aria-label="Fußnavigation">
        <h2 class="footer__heading">Seiten</h2>
        <ul class="footer__links" role="list">
          {nav.footerPrimary.map((item) => (
            <li>
              <a
                href={item.url}
                data-umami-event="footer-link"
                data-astro-prefetch={prefetchPaths.has(item.url) ? 'hover' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {socialLinks.length > 0 && (
        <div class="footer__social">
          <h2 class="footer__heading">Erreichbar über</h2>
          <ul class="footer__links" role="list">
            {socialLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.internal ? undefined : '_blank'}
                  rel={link.internal ? undefined : 'noopener noreferrer'}
                  data-umami-event="social-click"
                  data-umami-event-platform={link.type}
                  class="social-link"
                >
                  <Icon name={`social-${link.type}`} class="social-link__icon" aria-hidden="true" />
                  <span>
                    {link.label}
                    {!link.internal && <span class="sr-only"> (öffnet in neuem Tab)</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <div class="footer__bottom">
      <a href="/" class="footer__logo">
        <Icon name="logo" class="footer__logo-icon" aria-hidden="true" />
        <span>{site.siteName}</span>
      </a>
      <p class="footer__text">{site.footerDescription}</p>
      <div class="footer__legal">
        <p class="footer__copyright">{site.footerText}</p>
        <nav aria-label="Rechtliches">
          <ul class="footer__legal-links" role="list">
            {nav.footerLegal.map((item) => (
              <li>
                <a
                  href={item.url}
                  data-umami-event="footer-link"
                  data-astro-prefetch={prefetchPaths.has(item.url) ? 'hover' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  @layer components {
    /* The page ends on earth in both modes. */
    .footer {
      --text-primary: var(--on-ground);
      --text-secondary: var(--on-ground-soft);
      --rule: rgb(243 235 223 / 18%);
      --focus: var(--on-ground);

      padding-block: var(--space-2xl) var(--space-md);
      font-family: var(--font-ui);
      color: var(--on-ground);
      background: var(--ground-earth);
    }

    .footer__top {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      row-gap: var(--space-xl);
      padding-block-end: var(--space-xl);
    }

    .footer__contact {
      grid-column: 1 / span 7;
    }

    .footer__lead {
      margin-block-end: var(--space-sm);
      font-size: var(--step-1);
      font-weight: 500;
      color: var(--text-secondary);
    }

    .footer__mail {
      display: inline-block;
      font-family: var(--font-display);
      font-size: clamp(1.75rem, 0.9rem + 3.6vw, 4rem);
      font-weight: 600;
      font-variation-settings: 'wdth' 92;
      line-height: 1.05;
      letter-spacing: -0.015em;
      overflow-wrap: anywhere;
      text-decoration: underline;
      text-decoration-color: var(--ember);
      text-decoration-thickness: 2px;
      text-underline-offset: 0.16em;
      transition: color var(--motion-quick);
    }

    .footer__phone {
      display: flex;
      align-items: center;
      min-block-size: 44px;
      margin-block-start: var(--space-xs);
      font-size: var(--step-2);
      font-weight: 500;
      letter-spacing: -0.01em;
    }

    .footer__mail:hover,
    .footer__phone:hover {
      color: var(--ember);
    }

    .footer__nav {
      grid-column: 8 / span 3;
    }

    .footer__social {
      grid-column: 11 / span 2;
    }

    .footer__heading {
      margin-block-end: var(--space-xs);
      font-family: var(--font-ui);
      font-size: 0.875rem;
      font-weight: 560;
      letter-spacing: 0;
      color: var(--ember);
    }

    .footer__links {
      padding: 0;
      margin: 0;
    }

    .footer__links a {
      display: inline-flex;
      gap: var(--space-xs);
      align-items: center;
      min-block-size: 40px;
      font-size: 1rem;
      color: var(--text-secondary);
      transition: color var(--motion-quick);
    }

    .footer__links a:hover,
    .footer__legal-links a:hover {
      color: var(--on-ground);
      text-decoration: underline;
      text-decoration-color: var(--ember);
      text-underline-offset: 0.25em;
    }

    .social-link__icon {
      inline-size: 18px;
      block-size: 18px;
    }

    .footer__bottom {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      row-gap: var(--space-sm);
      align-items: start;
      padding-block-start: var(--space-md);
      border-block-start: 1px solid var(--rule);
    }

    .footer__logo {
      display: flex;
      grid-column: 1 / span 4;
      gap: var(--space-xs);
      align-items: center;
      font-family: var(--font-display);
      font-size: 1.125rem;
      font-weight: 650;
      letter-spacing: -0.02em;
    }

    .footer__logo-icon {
      flex-shrink: 0;
      inline-size: 26px;
      block-size: 26px;
      color: var(--ember);
    }

    .footer__text {
      grid-column: 5 / span 5;
      max-inline-size: 48ch;
      margin: 0;
      font-family: var(--font-body);
      font-size: 0.9375rem;
      line-height: var(--leading-normal);
      color: var(--text-secondary);
    }

    .footer__legal {
      grid-column: 10 / span 3;
      justify-self: end;
      text-align: end;
    }

    .footer__copyright {
      margin: 0;
      font-size: 0.875rem;
      color: var(--text-secondary);
    }

    .footer__legal-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--space-md);
      justify-content: flex-end;
      padding: 0;
      margin: 0;
    }

    .footer__legal-links a {
      display: inline-flex;
      align-items: center;
      min-block-size: 40px;
      font-size: 0.875rem;
      color: var(--text-secondary);
    }

    @media (width <= 56em) {
      .footer__top,
      .footer__bottom {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .footer__contact,
      .footer__logo,
      .footer__text,
      .footer__legal {
        grid-column: 1 / -1;
      }

      .footer__nav {
        grid-column: 1;
      }

      .footer__social {
        grid-column: 2;
      }

      .footer__legal {
        justify-self: start;
        text-align: start;
      }

      .footer__legal-links {
        justify-content: flex-start;
      }
    }
  }
</style>
