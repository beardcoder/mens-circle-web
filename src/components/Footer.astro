---
import nav from '../data/navigation.json';
import site from '../data/site.json';
import { Icon } from 'astro-icon/components';
import Button from './ui/Button.astro';
import Container from './ui/Container.astro';

// `mailto:` and `tel:` stay in place; external profiles open in a new tab,
// announced as part of the accessible name. Icons: src/icons/social-<type>.svg.
const socialLinks = site.socialLinks.map((link) => {
  const internal = link.type === 'email' || link.type === 'phone';
  const scheme = link.type === 'email' ? 'mailto:' : link.type === 'phone' ? 'tel:' : '';
  const text = link.type === 'email' ? site.contactEmail : link.type === 'phone' ? site.contactPhone : link.label;
  return { ...link, href: `${scheme}${link.value}`, internal, text };
});
// Only these prerendered pages are safe to fetch before a click.
const prefetchPaths = new Set(['/warum-ich-den-maennerkreis-leite', '/impressum', '/datenschutz']);

interface Props {
  /** The invitation with its button. Off where the page already closes on one (home: "Dabei sein."). */
  close?: boolean;
}

const { close = true } = Astro.props;

const heading = 'mb-3 font-sans text-sm font-semibold text-fg-muted';
const footerLink =
  'inline-flex min-h-11 items-center gap-2 text-base text-fg underline decoration-transparent decoration-[1.5px] underline-offset-[0.3em] transition-[text-decoration-color] duration-150 hover:decoration-accent focus-visible:decoration-accent sm:min-h-10';
---

<footer class="surface-night pb-6 print:hidden">
  <Container>
    {close && (
      <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-6 border-b border-line pt-section pb-group">
        <p class="max-w-[18ch] font-serif text-display-3 font-medium text-fg">
          Komm so, wie du <em class="text-accent not-italic">gerade</em> bist.
        </p>
        <Button
          href="/event"
          size="lg"
          class="max-sm:w-full"
          data-umami-event="cta-click"
          data-umami-event-location="footer"
        >
          Termine &amp; Anmeldung
        </Button>
      </div>
    )}

    <div class="grid gap-10 py-group sm:grid-cols-2 xl:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)_minmax(0,1.2fr)]">
      <div class="max-w-[36ch] sm:col-span-2 xl:col-span-1">
        <a href="/" class="mb-4 inline-flex items-center gap-3 rounded-control font-serif text-xl font-medium">
          <Icon name="logo" aria-hidden="true" class="size-10 text-flame" />
          <span>{site.siteName}</span>
        </a>
        <p class="text-sm text-fg-muted">{site.footerDescription}</p>
      </div>

      <nav aria-label="Fußnavigation">
        <h2 class={heading}>Seiten</h2>
        <ul role="list">
          {nav.footerPrimary.map((item) => (
            <li>
              <a
                href={item.url}
                class={footerLink}
                data-umami-event="footer-link"
                data-astro-prefetch={prefetchPaths.has(item.url) ? 'hover' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class={heading}>Kontakt</h2>
        <ul role="list">
          {socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.internal ? undefined : '_blank'}
                rel={link.internal ? undefined : 'noopener noreferrer'}
                data-umami-event="social-click"
                data-umami-event-platform={link.type}
                class={footerLink}
              >
                <Icon name={`social-${link.type}`} aria-hidden="true" class="size-4.5 shrink-0 text-accent" />
                <span>
                  {link.text}
                  {!link.internal && <span class="sr-only"> (öffnet in neuem Tab)</span>}
                </span>
              </a>
            </li>
          ))}
          {nav.footerContact.map((item) => (
            <li>
              <a href={item.url} class={footerLink} data-umami-event="footer-link">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-line pt-4">
      <p class="text-sm text-fg-muted">{site.footerText}</p>
      <nav aria-label="Rechtliches" class="flex flex-wrap gap-x-6">
        {nav.footerLegal.map((item) => (
          <a
            href={item.url}
            data-umami-event="footer-link"
            data-astro-prefetch={prefetchPaths.has(item.url) ? 'hover' : undefined}
            class="inline-flex min-h-11 items-center text-sm text-fg-muted underline decoration-transparent underline-offset-[0.3em] transition-[text-decoration-color] hover:text-fg hover:decoration-accent sm:min-h-10"
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>
  </Container>
</footer>
