---
import nav from '../data/navigation.json';
import site from '../data/site.json';
import type { SocialLink } from '../lib/social';
import Logo from './Logo.astro';
import SocialIcon from './SocialIcon.astro';

const socialLinks = site.socialLinks as SocialLink[];
const phoneHref = site.contactPhone ? `tel:${site.contactPhone.replace(/[\s\-()]/g, '')}` : null;
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="/" class="footer__logo">
          <Logo class="footer__logo-icon" />
          <span>{site.siteName}</span>
        </a>
        <p class="footer__text">{site.footerDescription}</p>
        {
          socialLinks.length > 0 && (
            <ul class="footer__social-links">
              {socialLinks.map((link) => (
                <li>
                  <SocialIcon link={link} variant="link" />
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <nav class="footer__nav" aria-label="Fußnavigation">
        <h3 class="footer__heading">Navigation</h3>
        <ul class="footer__links">
          {
            nav.footerPrimary.map((item) => (
              <li>
                <a
                  href={item.url}
                  data-umami-event="footer-link"
                  target={(item as { target?: string }).target}
                  rel={(item as { target?: string }).target === '_blank' ? 'noopener' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer__contact">
        <h3 class="footer__heading">Kontakt</h3>
        <ul class="footer__links">
          {
            site.contactEmail && (
              <li>
                <a href={`mailto:${site.contactEmail}`} data-umami-event="contact-click" data-umami-event-type="email">
                  E-Mail schreiben
                </a>
              </li>
            )
          }
          {
            phoneHref && (
              <li>
                <a href={phoneHref} data-umami-event="contact-click" data-umami-event-type="phone">
                  {site.contactPhone}
                </a>
              </li>
            )
          }
          {
            nav.footerContact.map((item) => (
              <li>
                <a href={item.url} data-umami-event="footer-link">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">{site.footerText}</p>
      <nav class="footer__legal" aria-label="Rechtliches">
        {
          nav.footerLegal.map((item) => (
            <a href={item.url} data-umami-event="footer-link">
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>

<style is:global>
  @layer components {
    /* The one inverted surface on the site — it marks the end of the page and
       carries the legal links. Everything in it is a plain list. */
    .footer {
      padding-block: var(--space-xl) var(--space-md);
      color: var(--text-on-dark);
      background: var(--color-ink);
      border-block-start: 4px solid var(--color-orange);
    }

    .footer__top {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-lg);
      padding-block-end: var(--space-lg);
      border-block-end: 1px solid var(--border-on-dark);
    }

    @media (width <= 800px) {
      .footer__top {
        grid-template-columns: 1fr;
        gap: var(--space-md);
      }
    }

    .footer__brand {
      max-inline-size: 34ch;
    }

    .footer__logo {
      display: flex;
      gap: var(--space-xs);
      align-items: center;
      margin-block-end: var(--space-sm);
      font-family: var(--font-display);
      font-size: 1.4rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.01em;
    }

    .footer__logo:focus-visible {
      outline: 3px solid var(--color-paper);
      outline-offset: 4px;
    }

    .footer__logo-icon {
      flex-shrink: 0;
      inline-size: 26px;
      block-size: 26px;
      color: var(--color-orange);
    }

    .footer__text {
      font-size: var(--text-caption);
      line-height: var(--leading-relaxed);
      color: var(--color-chalk-muted);
    }

    .footer__social-links {
      display: grid;
      gap: var(--space-3xs);
      margin-block-start: var(--space-sm);
      list-style: none;
    }

    /* The footer's standalone links are all held to a 24px minimum box (WCAG
       2.2 SC 2.5.8): they sit in navigation lists, not inside a sentence, so
       the inline-text exception does not cover them. */
    .social-link {
      display: inline-flex;
      gap: var(--space-xs);
      align-items: center;
      min-block-size: 32px;
      font-size: var(--text-caption);
      color: var(--color-chalk-muted);
      transition: color var(--motion-quick);
    }

    .social-link:hover,
    .social-link:focus-visible {
      color: var(--color-chalk);
    }

    .social-link__icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      inline-size: 18px;
      block-size: 18px;
    }

    .social-link__icon svg {
      inline-size: 100%;
      block-size: 100%;
    }

    .social-link__label {
      line-height: 1.4;
    }

    .footer__heading {
      margin-block-end: var(--space-xs);
      font-family: var(--font-display);
      font-size: var(--text-marker);
      font-weight: 600;
      color: var(--color-orange);
      text-transform: uppercase;
      letter-spacing: var(--tracking-marker);
    }

    .footer__links {
      list-style: none;
    }

    .footer__links a,
    .footer__legal a {
      display: inline-flex;
      align-items: center;
      min-block-size: 32px;
      font-size: var(--text-caption);
      color: var(--color-chalk-muted);
      transition: color var(--motion-quick);
    }

    .footer__links a:hover,
    .footer__links a:focus-visible,
    .footer__legal a:hover,
    .footer__legal a:focus-visible {
      color: var(--color-chalk);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    .footer__bottom {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-xs) var(--space-md);
      align-items: center;
      justify-content: space-between;
      padding-block-start: var(--space-sm);
    }

    .footer__copyright {
      margin: 0;
      font-size: var(--text-caption);
      color: var(--color-chalk-muted);
    }

    .footer__legal {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-md);
    }

    .footer a:focus-visible {
      outline: 3px solid var(--color-paper);
      outline-offset: 3px;
      border-radius: 0;
    }
  }
</style>
