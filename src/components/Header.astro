---
import nav from '../data/navigation.json';
import site from '../data/site.json';
import { Icon } from 'astro-icon/components';
import ThemeSwitch from './ThemeSwitch.astro';

/** A wordmark, three destinations and one action; on phones a full panel. */

const links = nav.header.links;
const ctaLinks = nav.header.cta;
const secondary = nav.header.secondary;
// Explicit allowlist, so new entries do not silently become speculative.
const prefetchPaths = new Set(['/warum-ich-den-maennerkreis-leite']);
const phoneHref = site.contactPhone ? `tel:${site.contactPhone.replace(/[\s\-()]/g, '')}` : null;
---

<header class="header surface-night" id="header">
  <div class="container header__inner">
    <a href="/" class="header__logo logo" aria-label={`${site.siteName} – Startseite`}>
      <Icon name="logo" class="logo__mark" aria-hidden="true" />
      <span class="logo__text">
        <span class="logo__name">Männerkreis</span>
        <span class="logo__place">
          {site.geo.locality} <span class="logo__region">· Niederbayern</span>
        </span>
      </span>
    </a>

    <nav class="nav" id="nav" aria-label="Hauptnavigation">
      <ol class="nav__list">
        {links.map((link, i) => (
          <li class="nav__item" style={`--i: ${i}`}>
            <a
              href={link.url}
              class="nav__link"
              data-nav-link
              data-umami-event="nav-click"
              data-umami-event-target={link.umamiTarget}
            >
              <span class="nav__index" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              {link.label}
            </a>
          </li>
        ))}
      </ol>

      {/* Only rendered inside the mobile panel — the bar keeps three items. */}
      <div class="nav__panel-extra">
        <ul class="nav__secondary">
          {[...ctaLinks, ...secondary].map((link) => (
            <li>
              <a
                href={link.url}
                class="nav__secondary-link"
                data-nav-link
                data-astro-prefetch={prefetchPaths.has(link.url) ? 'hover' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        <div class="nav__contact">
          <p class="marker">Fragen vorab?</p>
          {site.contactEmail && <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>}
          {phoneHref && <a href={phoneHref}>{site.contactPhone}</a>}
        </div>

        <div class="nav__footer">
          <span class="nav__footer-label">Darstellung</span>
          <ThemeSwitch class="theme-switch--nav" />
        </div>
      </div>
    </nav>

    <div class="header__actions">
      <ThemeSwitch class="theme-switch--bar" />

      {ctaLinks.map((link) => (
        <a
          href={link.url}
          class="btn btn--primary nav__cta"
          data-nav-link
          data-umami-event="cta-click"
          data-umami-event-location="header"
          data-umami-event-target={link.umamiTarget}
        >
          {link.label}
        </a>
      ))}

      <button
        class="nav-toggle"
        id="navToggle"
        type="button"
        aria-controls="nav"
        aria-expanded="false"
        aria-label="Menü öffnen"
      >
        <span class="nav-toggle__bars" aria-hidden="true">
          <span class="nav-toggle__bar"></span>
          <span class="nav-toggle__bar"></span>
          <span class="nav-toggle__bar"></span>
        </span>
      </button>
    </div>
  </div>

  <span class="header__progress" aria-hidden="true"></span>
</header>

<style is:global>
  @layer components {
    .header {
      position: fixed;
      inset-block-start: 0;
      inset-inline: 0;
      z-index: var(--z-header);
      color: var(--text-primary);
    }

    /* The bar's ground: the flyer's near-black, solid from the first pixel, so
       nothing ever shows through it while the page scrolls underneath. */
    .header::before {
      position: absolute;
      inset: 0;
      z-index: -1;
      content: '';
      background: var(--surface);
      border-block-end: 1px solid var(--border-light);
    }

    /* Reading progress: a hairline of the accent along the bar's lower edge. */
    .header__progress {
      position: absolute;
      inset-inline: 0;
      inset-block-end: -1px;
      display: none;
      block-size: 2px;
      background: var(--accent);
      transform-origin: 0 50%;
    }

    @supports (animation-timeline: scroll()) {
      @media (prefers-reduced-motion: no-preference) {
        .header__progress {
          display: block;
          animation: progress linear both;
          animation-timeline: scroll(root block);
        }
      }
    }

    .header__inner {
      display: grid;
      grid-template-columns: minmax(0, auto) minmax(0, 1fr) minmax(0, auto);
      gap: var(--space-md);
      align-items: center;
      min-block-size: var(--header-height);
    }

    .header__actions {
      display: flex;
      grid-column: 3;
      gap: var(--space-xs);
      align-items: center;
      justify-self: end;
    }

    /* Wordmark: the seat circle and the name, stacked over the place. */
    .logo {
      display: flex;
      gap: 0.7rem;
      align-items: center;
      min-inline-size: 0;
      color: inherit;
      text-decoration: none;
    }

    .logo:focus-visible {
      outline: 2px solid var(--focus-ring);
      outline-offset: 6px;
      border-radius: var(--radius);
    }

    /* The original brush-stroke logo, in the flyer's orange. */
    .logo__mark {
      flex: none;
      inline-size: 2.25rem;
      block-size: 2.25rem;
      color: var(--color-flame);
      transition: rotate var(--duration-slow) var(--ease-settle);
    }

    @media (hover: hover) and (pointer: fine) {
      .logo:hover .logo__mark {
        rotate: 22.5deg;
      }
    }

    .logo__text {
      display: grid;
      min-inline-size: 0;
      line-height: 1.1;
    }

    .logo__name {
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: -0.025em;
    }

    .logo__place {
      overflow: hidden;
      font-size: 0.6875rem;
      font-weight: 500;
      color: var(--text-muted);
      text-overflow: ellipsis;
      text-transform: uppercase;
      letter-spacing: 0.22em;
      white-space: nowrap;
    }

    /* Bar navigation. */
    .nav__list {
      display: flex;
      gap: clamp(1rem, 0.5rem + 1.5vw, 2.25rem);
      align-items: center;
      justify-content: center;
      padding: 0;
      margin: 0;
      list-style: none;
    }

    .nav__link {
      position: relative;
      display: inline-flex;
      gap: 0.45em;
      align-items: baseline;
      min-block-size: 44px;
      align-content: center;
      padding-block: 0.75rem;
      font-size: 0.9375rem;
      font-weight: 500;
      color: var(--text-primary);
      text-decoration: none;
    }

    .nav__index {
      font-family: var(--font-quote);
      font-size: 0.8em;
      font-style: italic;
      color: var(--accent);
    }

    .nav__link::after {
      position: absolute;
      inset-inline: 0;
      inset-block-end: 0.55rem;
      block-size: 1.5px;
      content: '';
      background: var(--accent);
      transform: scaleX(0);
      transform-origin: 0 50%;
      transition: transform var(--motion-standard);
    }

    @media (hover: hover) and (pointer: fine) {
      .nav__link:hover::after {
        transform: scaleX(1);
      }
    }

    .nav__link:focus-visible {
      outline: 2px solid var(--focus-ring);
      outline-offset: 2px;
      border-radius: var(--radius);
    }

    .nav__panel-extra {
      display: none;
    }

    .nav__cta {
      --btn-padding-block: 0.55rem;
      --btn-padding-inline: 1rem;
      --btn-font-size: 0.9375rem;

      min-block-size: 44px;
      white-space: nowrap;
    }

    .nav-toggle {
      display: none;
      place-items: center;
      inline-size: 48px;
      block-size: 48px;
      padding: 0;
      color: var(--text-primary);
      cursor: pointer;
      background: none;
      border: 1px solid var(--border-medium);
      border-radius: 50%;
      transition: border-color var(--motion-quick);
    }

    .nav-toggle:focus-visible {
      outline: 2px solid var(--focus-ring);
      outline-offset: 3px;
    }

    .nav-toggle__bars {
      display: flex;
      flex-direction: column;
      gap: 5px;
      align-items: center;
    }

    .nav-toggle__bar {
      display: block;
      inline-size: 18px;
      block-size: 1.5px;
      background: currentcolor;
      transform-origin: center;
    }

    /* Theme control: a round seat with a sun or a moon. */
    .theme-switch {
      display: flex;
      align-items: center;
    }

    .theme-switch__btn {
      display: grid;
      place-items: center;
      inline-size: 44px;
      block-size: 44px;
      padding: 0;
      color: inherit;
      cursor: pointer;
      background: none;
      border: 1px solid transparent;
      border-radius: 50%;
      transition:
        border-color var(--motion-quick),
        rotate var(--duration-slow) var(--ease-settle);
    }

    @media (hover: hover) and (pointer: fine) {
      .theme-switch__btn:hover {
        border-color: var(--border-medium);
        rotate: -20deg;
      }
    }

    .theme-switch__btn:focus-visible {
      outline: 2px solid var(--focus-ring);
      outline-offset: 2px;
    }

    .theme-switch__icon {
      inline-size: 18px;
      block-size: 18px;
      fill: none;
      stroke: currentcolor;
      stroke-width: 1.6;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    :root:not([data-mode-resolved='dark']) .theme-switch__icon--dark,
    :root[data-mode-resolved='dark'] .theme-switch__icon--light {
      display: none;
    }

    .theme-switch--nav {
      display: none;
    }

    /* Narrow screens: a full panel on the bark surface. */
    @media (width <= 54em) {
      .nav-toggle {
        display: grid;
      }

      .theme-switch--bar {
        display: none;
      }

      .theme-switch--nav {
        display: flex;
      }

      .nav {
        --text-primary: var(--color-chalk);
        --text-secondary: #d2c6b5;
        --text-muted: var(--color-chalk-muted);
        --accent: var(--color-ember);
        --border-light: var(--color-night-rule);
        --border-medium: #4a3d34;

        position: fixed;
        inset: var(--header-height) 0 0;
        display: flex;
        visibility: hidden;
        flex-direction: column;
        gap: var(--space-lg);
        padding-block: var(--space-md) var(--space-lg);
        padding-inline: var(--container-gutter);
        overflow-y: auto;
        overscroll-behavior: contain;
        color: var(--text-primary);
        pointer-events: none;
        background: light-dark(var(--color-ink), var(--color-night-soft));
        opacity: 0;
        transition:
          opacity var(--motion-standard),
          visibility var(--motion-standard);
      }

      .nav.is-open {
        visibility: visible;
        pointer-events: auto;
        opacity: 1;
      }

      .nav__list {
        flex-direction: column;
        gap: 0;
        align-items: stretch;
        border-block-start: 1px solid var(--border-light);
      }

      .nav__item {
        border-block-end: 1px solid var(--border-light);
      }

      .nav__link {
        inline-size: 100%;
        gap: 0.9rem;
        padding-block: var(--space-sm);
        font-family: var(--font-display);
        font-size: clamp(2rem, 1.4rem + 3vw, 2.75rem);
        font-weight: 400;
        line-height: 1.1;
        letter-spacing: -0.02em;
      }

      .nav__link::after {
        display: none;
      }

      .nav__index {
        font-size: 0.45em;
        font-style: normal;
        font-family: var(--font-body);
        font-weight: 600;
        letter-spacing: 0.1em;
      }

      /* The links settle in one after another as the panel opens. */
      @media (prefers-reduced-motion: no-preference) {
        .nav__item {
          opacity: 0;
          transform: translateY(0.75rem);
          transition:
            opacity var(--duration-slow) var(--ease-settle),
            transform var(--duration-slow) var(--ease-settle);
          transition-delay: calc(var(--i) * 50ms + 60ms);
        }

        .nav.is-open .nav__item {
          opacity: 1;
          transform: none;
        }
      }

      .nav__panel-extra {
        display: grid;
        gap: var(--space-lg);
        margin-block-start: auto;
      }

      .nav__secondary {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs) var(--space-md);
        padding: 0;
        margin: 0;
        list-style: none;
      }

      .nav__secondary-link {
        display: inline-flex;
        align-items: center;
        min-block-size: 44px;
        font-size: var(--text-body-compact);
        font-weight: 500;
        color: var(--text-primary);
        text-decoration: underline;
        text-decoration-color: var(--accent);
        text-decoration-thickness: 1.5px;
        text-underline-offset: 0.3em;
      }

      .nav__contact {
        display: grid;
        gap: var(--space-3xs);
      }

      .nav__contact .marker {
        margin-block-end: var(--space-2xs);
      }

      .nav__contact a {
        display: inline-flex;
        align-items: center;
        min-block-size: 44px;
        font-family: var(--font-display);
        font-size: var(--text-xl);
        color: var(--text-primary);
      }

      .nav__footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block-start: var(--space-sm);
        border-block-start: 1px solid var(--border-light);
      }

      .nav__footer-label {
        font-size: var(--text-caption);
        color: var(--text-muted);
      }

      .theme-switch--nav .theme-switch__btn {
        border-color: var(--border-medium);
      }

      body.nav-open {
        position: fixed;
        inline-size: 100%;
        min-block-size: 100%;
        overflow: hidden;
      }

      body.nav-open .header .nav__cta {
        display: none;
      }
    }

    @media (width <= 420px) {
      .header__inner {
        gap: var(--space-xs);
      }

      .logo__mark {
        inline-size: 1.875rem;
        block-size: 1.875rem;
      }

      .logo__name {
        font-size: 1.125rem;
      }

      .logo__place {
        font-size: 0.625rem;
        letter-spacing: 0.1em;
      }

      .nav__cta {
        --btn-padding-inline: 0.8rem;
      }

      .nav__cta::before,
      .nav__cta::after {
        display: none;
      }
    }

    @media (width <= 30em) {
      .logo__region {
        display: none;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .nav {
        transition: none;
      }
    }
  }
</style>
