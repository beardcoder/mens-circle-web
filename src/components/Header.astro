---
import nav from '../data/navigation.json';
import site from '../data/site.json';
import { Icon } from 'astro-icon/components';
import { button } from '@lib/ui';
import Container from './ui/Container.astro';
import ModeToggle from './ModeToggle.astro';

/**
 * The bar, 72px: the mark on the left; from `nav` (1100px) the four content links
 * and the one filled action on the right, below that the action and a menu
 * button. Over the home opening (`over-hero:`) it starts clear with light text
 * and turns to the page's opaque paper once the page moves (`data-scrolled`, set
 * by lib/site-header.ts); elsewhere it is paper from the start. The phone menu is
 * a native modal `<dialog>`: Escape closes it, the focus returns to the button.
 */

const links = nav.header.links;
const cta = nav.header.cta;
const linkClass =
  'inline-flex min-h-11 items-center rounded-control px-3 text-base font-medium underline-offset-[6px] decoration-1 transition-colors duration-180 hover:underline';
---

<header
  id="header"
  class:list={[
    'group/header fixed inset-x-0 top-0 z-40 h-header text-fg print:hidden',
    // The bar's ground: the page's paper, opaque, with a thin line. It switches
    // at once, ground and text together.
    'before:pointer-events-none before:absolute before:inset-0 before:-z-10 before:border-b before:border-line before:bg-ground',
    // Over the dark opening: clear with light text until the page moves.
    'over-hero:text-bone over-hero:before:opacity-0 over-hero:data-[scrolled]:text-fg over-hero:data-[scrolled]:before:opacity-100',
  ]}
>
  <Container class="flex h-full items-center gap-4">
    <a
      href="/"
      aria-label={`${site.siteName} – Startseite`}
      class="flex min-h-11 min-w-0 items-center gap-3 rounded-control font-serif text-xl"
    >
      <Icon name="logo" aria-hidden="true" class="size-9 shrink-0" />
      <span class="max-[22.5rem]:sr-only">Männerkreis</span>
    </a>

    <nav aria-label="Hauptnavigation" class="ml-auto max-nav:hidden">
      <ul role="list" class="flex items-center gap-1">
        {links.map((link) => (
          <li>
            <a
              href={link.url}
              data-nav-link
              data-umami-event="nav-click"
              data-umami-event-target={link.umamiTarget}
              class={linkClass}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a
      href={cta.url}
      data-umami-event="cta-click"
      data-umami-event-location="header"
      data-umami-event-target={cta.umamiTarget}
      class:list={[button({ variant: 'primary', size: 'sm' }), 'max-nav:ml-auto']}
    >
      {cta.label}
    </a>

    <button
      type="button"
      data-nav-open
      aria-controls="nav"
      aria-haspopup="dialog"
      class="inline-flex min-h-11 items-center gap-2 rounded-control px-2 text-base font-medium nav:hidden"
    >
      <Icon name="menu" aria-hidden="true" class="size-6" />
      <span class="max-[26rem]:sr-only">Menü</span>
    </button>
  </Container>

  {/* The phone menu: the content links, the action, then the display option. */}
  <dialog
    id="nav"
    aria-label="Menü"
    class:list={[
      'm-0 h-dvh max-h-none w-full max-w-none overflow-y-auto overscroll-contain bg-ground p-0 text-fg nav:hidden',
      'opacity-0 transition-[opacity,display,overlay] transition-discrete duration-200 open:opacity-100 starting:open:opacity-0 backdrop:bg-transparent',
    ]}
  >
    <Container class="flex h-header items-center gap-4 border-b border-line">
      <a href="/" class="flex min-h-11 min-w-0 items-center gap-3 rounded-control font-serif text-xl" data-nav-link>
        <Icon name="logo" aria-hidden="true" class="size-9 shrink-0" />
        <span>Männerkreis</span>
      </a>
      <button
        type="button"
        data-nav-close
        class="ml-auto inline-flex min-h-11 items-center gap-2 rounded-control px-2 text-base font-medium"
      >
        <Icon name="close" aria-hidden="true" class="size-6" />
        <span>Schließen</span>
      </button>
    </Container>
    <Container class="grid gap-8 py-8">
      <nav aria-label="Hauptnavigation">
        <ul role="list" class="grid border-t border-line">
          {links.map((link) => (
            <li class="border-b border-line">
              <a
                href={link.url}
                data-nav-link
                data-umami-event="nav-click"
                data-umami-event-target={link.umamiTarget}
                class="flex min-h-14 items-center text-xl font-medium transition-colors duration-180 hover:text-accent"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a
        href={cta.url}
        data-nav-link
        data-umami-event="cta-click"
        data-umami-event-location="menu"
        class={button({ variant: 'primary', size: 'lg', block: true })}
      >
        Termine &amp; Anmeldung
      </a>
      <ModeToggle class="justify-self-start" />
    </Container>
  </dialog>
</header>
