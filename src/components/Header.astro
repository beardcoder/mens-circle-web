---
import nav from '../data/navigation.json';
import site from '../data/site.json';
import Logo from './Logo.astro';
import ThemeSwitch from './ThemeSwitch.astro';

/**
 * Site header.
 *
 * A wordmark, three destinations and one action. What used to be here — a
 * numbered five-item list, a full-screen panel with three breathing rings and a
 * radial-gradient ground, a four-button theme cluster and a blurred glass bar —
 * is gone. The bar is opaque, sits on a hairline and does not change on scroll.
 *
 * The navigation labels changed but the anchors did not: "Ablauf" still points
 * at `#reise` and "Markus" at `#moderator`, so every link that was ever shared
 * still lands where it did. The pages that dropped out of the bar (Haltung,
 * Fragen, Atemübung) are reachable from the mobile panel and the footer.
 */

const links = nav.header.links;
const ctaLinks = nav.header.cta;
const secondary = nav.header.secondary;
---

<header class="header" id="header" data-lume="site-header">
  <div class="container">
    <div class="header__inner">
      <a href="/" class="header__logo logo" aria-label={`${site.siteName} – Startseite`}>
        <Logo class="logo__icon" />
        <span class="logo__text">Männerkreis<span class="logo__place">Straubing</span></span>
      </a>

      <nav class="nav" id="nav" data-lume-part="nav" aria-label="Hauptnavigation">
        <ul class="nav__list">
          {
            links.map((link) => (
              <li class="nav__item">
                <a
                  href={link.url}
                  class="nav__link"
                  data-lume-part="nav-link"
                  data-umami-event="nav-click"
                  data-umami-event-target={link.umamiTarget}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        {/* Only rendered inside the mobile panel — the bar keeps three items. */}
        <ul class="nav__secondary">
          {
            secondary.map((link) => (
              <li>
                <a href={link.url} class="nav__secondary-link" data-lume-part="nav-link">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="nav__footer">
          <ThemeSwitch class="theme-switch--nav" />
        </div>
      </nav>

      <div class="header__actions">
        <ThemeSwitch class="theme-switch--bar" />

        {
          ctaLinks.map((link) => (
            <a
              href={link.url}
              class="btn btn--primary nav__cta"
              data-lume-part="nav-link"
              data-umami-event="cta-click"
              data-umami-event-location="header"
              data-umami-event-target={link.umamiTarget}
            >
              {link.label}
            </a>
          ))
        }

        <button
          class="nav-toggle"
          id="navToggle"
          type="button"
          data-lume-part="toggle"
          aria-controls="nav"
          aria-expanded="false"
          aria-label="Menü öffnen"
        >
          <span class="nav-toggle__bars" aria-hidden="true">
            <span class="nav-toggle__bar"></span>
            <span class="nav-toggle__bar"></span>
            <span class="nav-toggle__bar"></span>
          </span>
        </button>
      </div>
    </div>
  </div>
</header>

<style is:global>
  @layer components {
    .header {
      position: fixed;
      inset-block-start: 0;
      inset-inline: 0;
      z-index: var(--z-header);
      padding-block: var(--space-xs);
      color: var(--text-primary);
      background: var(--bg-primary);
      /* A 2px ink rule, not a hairline: the bar is part of the poster now. */
      border-block-end: 2px solid var(--rule-strong);
    }

    .header__inner {
      display: grid;
      /* `minmax(0, …)` on every track: the default `auto` minimum is min-content,
         which lets the actions cluster push past the header box. */
      grid-template-columns: minmax(0, auto) minmax(0, 1fr) minmax(0, auto);
      gap: var(--header-gap, var(--space-md));
      align-items: center;
      min-block-size: 60px;
    }

    .header__logo {
      grid-column: 1;
      justify-self: start;
      /* `min-inline-size: 0` so the wordmark yields instead of growing the
         track and painting over the actions on a 320px screen. */
      min-inline-size: 0;
      overflow: hidden;
    }

    .header__actions {
      display: flex;
      grid-column: 3;
      gap: var(--header-gap, var(--space-xs));
      align-items: center;
      justify-self: end;
      min-inline-size: 0;
    }

    /* ─── Wordmark ────────────────────────────────────────────────── */
    .logo {
      display: flex;
      gap: var(--space-xs);
      align-items: center;
      color: inherit;
    }

    .logo:focus-visible {
      outline: 3px solid var(--text-primary);
      outline-offset: 4px;
      box-shadow: 0 0 0 3px var(--color-orange);
    }

    .logo__icon {
      flex-shrink: 0;
      inline-size: 28px;
      block-size: 28px;
    }

    .logo__text {
      display: flex;
      flex-direction: column;
      min-inline-size: 0;
      font-family: var(--font-display);
      font-size: 1.4rem;
      font-weight: 800;
      line-height: 0.95;
      text-transform: uppercase;
      letter-spacing: 0.01em;
      white-space: nowrap;
    }

    /* The locality belongs in the wordmark: it is the single most useful thing
       a visitor can learn in the first second. */
    .logo__place {
      font-family: var(--font-display);
      font-size: 0.6875rem;
      font-weight: 600;
      /* Not orange: at 11px the orange measures 3.52:1 on paper, under the
         4.5:1 small text requires. `--text-muted`, not the literal ink-muted —
         a literal would stay dark grey on the dark ground (2.8:1). */
      color: var(--text-muted);
      letter-spacing: 0.2em;
    }

    /* ─── Bar navigation (wide screens) ───────────────────────────── */
    .nav__list {
      display: flex;
      gap: var(--space-md);
      align-items: center;
      justify-content: center;
      padding: 0;
      margin: 0;
      list-style: none;
    }

    .nav__link {
      display: inline-flex;
      align-items: center;
      min-block-size: 44px;
      font-family: var(--font-display);
      font-size: var(--text-marker);
      font-weight: 600;
      color: var(--text-primary);
      text-transform: uppercase;
      letter-spacing: var(--tracking-marker);
      border-block-end: 3px solid transparent;
      transition: border-color var(--motion-quick);
    }

    @media (hover: hover) and (pointer: fine) {
      .nav__link:hover {
        border-block-end-color: var(--color-orange);
      }
    }

    .nav__link:focus-visible {
      outline: 3px solid var(--text-primary);
      outline-offset: 4px;
      box-shadow: 0 0 0 3px var(--color-orange);
    }

    .nav__secondary {
      display: none;
    }

    .nav__footer {
      display: none;
    }

    .nav__cta {
      --btn-padding-block: 0.5rem;
      --btn-padding-inline: 1rem;
      --btn-font-size: var(--text-caption);

      white-space: nowrap;
    }

    /* ─── Mobile panel ────────────────────────────────────────────── */
    .nav-toggle {
      display: none;
      place-items: center;
      inline-size: 48px;
      block-size: 48px;
      padding: 0;
      color: var(--text-primary);
      cursor: pointer;
      background: none;
      border: 2px solid var(--rule-strong);
      border-radius: 0;
      transition:
        color var(--motion-quick),
        background-color var(--motion-quick);
    }

    @media (hover: hover) and (pointer: fine) {
      .nav-toggle:hover {
        /* Ink on orange in both modes — the orange field does not flip. */
        color: var(--color-ink);
        background: var(--color-orange);
      }
    }

    .nav-toggle:focus-visible {
      outline: 3px solid var(--text-primary);
      outline-offset: 3px;
      box-shadow: 0 0 0 3px var(--color-orange);
    }

    .nav-toggle__bars {
      display: flex;
      flex-direction: column;
      gap: 5px;
      align-items: center;
    }

    .nav-toggle__bar {
      display: block;
      inline-size: 22px;
      block-size: 2.5px;
      background: currentcolor;
      transform-origin: center;
    }

    /* ─── Theme control ───────────────────────────────────────────── */
    .theme-switch {
      display: flex;
      align-items: center;
    }

    .theme-switch__btn {
      display: grid;
      place-items: center;
      inline-size: 44px;
      block-size: 44px;
      padding: 0;
      color: inherit;
      cursor: pointer;
      background: none;
      border: 2px solid transparent;
      border-radius: 0;
      transition: border-color var(--motion-quick);
    }

    @media (hover: hover) and (pointer: fine) {
      .theme-switch__btn:hover {
        border-color: var(--rule-strong);
      }
    }

    .theme-switch__btn:focus-visible {
      outline: 3px solid var(--text-primary);
      outline-offset: 2px;
      box-shadow: 0 0 0 3px var(--color-orange);
    }

    .theme-switch__icon {
      inline-size: 18px;
      block-size: 18px;
      fill: none;
      stroke: currentcolor;
      stroke-width: 1.7;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* Only the icon matching the resolved mode. The attribute is set before
       first paint by the layout's boot script, so nothing flashes. */
    :root:not([data-mode-resolved='dark']) .theme-switch__icon--dark,
    :root[data-mode-resolved='dark'] .theme-switch__icon--light {
      display: none;
    }

    .theme-switch--nav {
      display: none;
    }

    /* ─── Narrow screens: the panel takes over ────────────────────── */
    @media (width <= 54em) {
      .nav-toggle {
        display: grid;
      }

      .theme-switch--bar {
        display: none;
      }

      .theme-switch--nav {
        display: flex;
      }

      /* The panel hangs off the bottom edge of the bar.

         It cannot be `position: fixed; inset: 0` with a lower z-index: the nav
         is a *child* of the header, and a positioned descendant paints above
         its ancestor's own content whatever the z-index says — which hid the
         wordmark, the CTA and the close button behind the panel. Positioning it
         absolutely against the header instead puts its top edge exactly on the
         bar's bottom edge, with no measured clearance to drift out of sync and
         no sliver of page between the two. */
      .nav {
        position: absolute;
        inset-block-start: 100%;
        inset-inline: 0;
        block-size: calc(100dvh - 100%);
        display: flex;
        visibility: hidden;
        flex-direction: column;
        gap: var(--space-md);
        padding-block: var(--space-md) var(--space-lg);
        padding-inline: var(--container-gutter);
        overflow-y: auto;
        overscroll-behavior: contain;
        pointer-events: none;
        background: var(--bg-primary);
        opacity: 0;
        transition:
          opacity var(--motion-standard),
          visibility var(--motion-standard);
      }

      .nav.is-open {
        visibility: visible;
        pointer-events: auto;
        opacity: 1;
      }

      .nav__list {
        flex-direction: column;
        gap: 0;
        align-items: stretch;
        border-block-start: 2px solid var(--rule-strong);
      }

      .nav__item {
        border-block-end: 2px solid var(--rule-strong);
      }

      .nav__link {
        inline-size: 100%;
        padding-block: var(--space-sm);
        font-family: var(--font-display);
        font-size: var(--text-4xl);
        font-weight: 800;
        line-height: 1;
        color: var(--text-primary);
        text-transform: uppercase;
        letter-spacing: -0.01em;
        border-block-end: none;
      }

      .nav__secondary {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        padding: 0;
        margin: 0;
        list-style: none;
      }

      .nav__secondary-link {
        display: inline-flex;
        align-items: center;
        min-block-size: 44px;
        font-family: var(--font-display);
        font-size: var(--text-marker);
        font-weight: 600;
        color: var(--text-primary);
        text-transform: uppercase;
        letter-spacing: var(--tracking-marker);
        text-decoration: underline;
        text-decoration-color: var(--color-orange);
        text-decoration-thickness: 2px;
        text-underline-offset: 0.3em;
      }

      .nav__secondary-link:focus-visible {
        outline: 3px solid var(--text-primary);
        outline-offset: 4px;
      }

      .nav__footer {
        display: flex;
        margin-block-start: auto;
        padding-block-start: var(--space-sm);
        border-block-start: 2px solid var(--rule-strong);
      }

      /* The panel covers the page; the body lock lives in lib/site-header.ts. */
      body.nav-open {
        position: fixed;
        inline-size: 100%;
        min-block-size: 100%;
        overflow: hidden;
      }
    }

    /* The smallest phones. Everything gives a little rather than one element
       giving everything: the wordmark drops its locality line and a type step,
       the CTA tightens, and the gaps close. Measured at 320px the row then
       comes to ~280px of content in a 280px track, with the CTA keeping a
       readable label and the toggle keeping its 44px box. */
    @media (width <= 420px) {
      .header__inner,
      .header__actions {
        --header-gap: var(--space-xs);
      }

      .logo__place {
        display: none;
      }

      .logo__icon {
        inline-size: 24px;
        block-size: 24px;
      }

      .logo__text {
        font-size: 1rem;
      }

      .nav__cta {
        --btn-padding-inline: 0.75rem;
        --btn-font-size: var(--text-xs);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .nav {
        transition: none;
      }
    }
  }
</style>
