---
import nav from '../data/navigation.json';
import site from '../data/site.json';
import { Icon } from 'astro-icon/components';
import ThemeSwitch from './ThemeSwitch.astro';

/** The mark and name, a handful of destinations, one action. */

const links = nav.header.links;
const ctaLinks = nav.header.cta;
const secondary = nav.header.secondary;
// Explicit allowlist, so new entries do not silently become speculative.
const prefetchPaths = new Set(['/warum-ich-den-maennerkreis-leite']);
---

<header class="header" id="header">
  <div class="container header__inner">
    <a href="/" class="header__logo logo" aria-label={`${site.siteName} – Startseite`}>
      <Icon name="logo" class="logo__icon" aria-hidden="true" />
      <span class="logo__text">
        Männerkreis <span class="logo__place">Straubing</span>
      </span>
    </a>

    <nav class="nav" id="nav" aria-label="Hauptnavigation">
      <ul class="nav__list">
        {links.map((link) => (
          <li class="nav__item">
            <a
              href={link.url}
              class="nav__link"
              data-nav-link
              data-umami-event="nav-click"
              data-umami-event-target={link.umamiTarget}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      {/* Only rendered inside the mobile panel — the bar keeps its few items. */}
      <ul class="nav__secondary">
        {secondary.map((link) => (
          <li>
            <a
              href={link.url}
              class="nav__secondary-link"
              data-nav-link
              data-astro-prefetch={prefetchPaths.has(link.url) ? 'hover' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="nav__footer">
        <p class="nav__contact">
          <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
        </p>
        <ThemeSwitch class="theme-switch--nav" />
      </div>
    </nav>

    <div class="header__actions">
      <ThemeSwitch class="theme-switch--bar" />

      {ctaLinks.map((link) => (
        <a
          href={link.url}
          class="btn btn--primary nav__cta"
          data-nav-link
          data-umami-event="cta-click"
          data-umami-event-location="header"
          data-umami-event-target={link.umamiTarget}
        >
          {link.label}
        </a>
      ))}

      <button
        class="nav-toggle"
        id="navToggle"
        type="button"
        aria-controls="nav"
        aria-expanded="false"
        aria-label="Menü öffnen"
      >
        <span class="nav-toggle__bars" aria-hidden="true">
          <span class="nav-toggle__bar"></span>
          <span class="nav-toggle__bar"></span>
          <span class="nav-toggle__bar"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<style is:global>
  @layer components {
    .header {
      position: fixed;
      inset-block-start: 0;
      inset-inline: 0;
      z-index: var(--z-header);
      color: var(--text-primary);
      background-color: var(--bg-primary);
      border-block-end: 1px solid var(--rule);
    }

    /* At the very top the header has no ground of its own; it gains one within
       the first screenful of scrolling. Without scroll timelines it stays solid. */
    @supports (animation-timeline: scroll()) {
      .header {
        animation: header-ground linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 6rem;
      }
    }

    .header__inner {
      display: flex;
      gap: var(--space-md);
      align-items: center;
      justify-content: space-between;
      min-block-size: var(--header-height);
    }

    /* Wordmark. */
    .logo {
      display: flex;
      flex: none;
      gap: 0.6rem;
      align-items: center;
      min-inline-size: 0;
      color: inherit;
    }

    .logo__icon {
      flex-shrink: 0;
      inline-size: 30px;
      block-size: 30px;
      color: var(--accent);
      transition: rotate var(--duration-slow) var(--ease-settle);
    }

    @media (hover: hover) and (pointer: fine) {
      .logo:hover .logo__icon {
        rotate: 60deg;
      }
    }

    .logo__text {
      font-family: var(--font-display);
      font-size: 1.1875rem;
      font-weight: 680;
      line-height: 1;
      letter-spacing: -0.02em;
      white-space: nowrap;
    }

    .logo__place {
      font-weight: 400;
      color: var(--text-secondary);
    }

    /* Bar navigation (wide screens). */
    .nav {
      margin-inline-start: auto;
    }

    .nav__list {
      display: flex;
      gap: var(--space-md);
      align-items: center;
      padding: 0;
      margin: 0;
      list-style: none;
    }

    /* A seat dot that appears in front of the link you point at. */
    .nav__link {
      position: relative;
      display: inline-flex;
      gap: 0.45em;
      align-items: center;
      min-block-size: 44px;
      font-family: var(--font-ui);
      font-size: 1rem;
      font-weight: 520;
      color: var(--text-primary);
    }

    .nav__link::before {
      inline-size: 0.42em;
      block-size: 0.42em;
      content: '';
      background: var(--accent);
      border-radius: 50%;
      scale: 0;
      transition: scale var(--motion-standard);
    }

    @media (hover: hover) and (pointer: fine) {
      .nav__link:hover::before {
        scale: 1;
      }
    }

    .nav__secondary,
    .nav__footer {
      display: none;
    }

    .header__actions {
      display: flex;
      flex: none;
      gap: var(--space-xs);
      align-items: center;
    }

    .nav__cta {
      --btn-padding-block: 0.5rem;
      --btn-padding-inline: 1rem;
      --btn-font-size: 1rem;

      min-block-size: 44px;
      white-space: nowrap;
    }

    /* Mobile panel toggle. */
    .nav-toggle {
      display: none;
      place-items: center;
      inline-size: 44px;
      block-size: 44px;
      padding: 0;
      color: var(--text-primary);
      cursor: pointer;
      background: none;
      border: 1.5px solid var(--rule-strong);
      border-radius: 50%;
    }

    .nav-toggle__bars {
      display: flex;
      flex-direction: column;
      gap: 5px;
      align-items: center;
    }

    .nav-toggle__bar {
      display: block;
      inline-size: 18px;
      block-size: 1.5px;
      background: currentcolor;
      transform-origin: center;
    }

    /* Theme control: a round button, like everything you can sit in. */
    .theme-switch {
      display: flex;
      align-items: center;
    }

    .theme-switch__btn {
      display: grid;
      place-items: center;
      inline-size: 44px;
      block-size: 44px;
      padding: 0;
      color: inherit;
      cursor: pointer;
      background: none;
      border: 1.5px solid transparent;
      border-radius: 50%;
      transition: border-color var(--motion-quick);
    }

    @media (hover: hover) and (pointer: fine) {
      .theme-switch__btn:hover {
        border-color: var(--rule-strong);
      }
    }

    .theme-switch__icon {
      inline-size: 19px;
      block-size: 19px;
      fill: none;
      stroke: currentcolor;
      stroke-width: 1.6;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* Only the icon matching the resolved mode. The attribute is set before
       first paint by the layout's boot script, so nothing flashes. */
    :root:not([data-mode-resolved='dark']) .theme-switch__icon--dark,
    :root[data-mode-resolved='dark'] .theme-switch__icon--light {
      display: none;
    }

    .theme-switch--nav {
      display: none;
    }

    /* Narrow screens: the panel takes over. */
    @media (width <= 54em) {
      .nav-toggle {
        display: grid;
      }

      .theme-switch--bar {
        display: none;
      }

      .theme-switch--nav {
        display: flex;
      }

      /* The panel hangs off the bottom edge of the bar. */
      .nav {
        position: absolute;
        inset-block-start: 100%;
        inset-inline: 0;
        block-size: calc(100dvh - 100%);
        display: flex;
        visibility: hidden;
        flex-direction: column;
        gap: var(--space-lg);
        padding-block: var(--space-lg);
        padding-inline: var(--container-gutter);
        margin: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        pointer-events: none;
        background: var(--bg-primary);
        opacity: 0;
        translate: 0 -0.5rem;
        transition:
          opacity var(--motion-standard),
          translate var(--motion-standard),
          visibility var(--motion-standard);
      }

      .nav.is-open {
        visibility: visible;
        pointer-events: auto;
        opacity: 1;
        translate: 0 0;
      }

      .nav__list {
        flex-direction: column;
        gap: 0;
        align-items: stretch;
      }

      .nav__link {
        inline-size: 100%;
        padding-block: var(--space-2xs);
        font-family: var(--font-display);
        font-size: var(--step-4);
        font-weight: 600;
        line-height: 1.05;
        letter-spacing: -0.03em;
      }

      .nav__link::before {
        inline-size: 0.22em;
        block-size: 0.22em;
      }

      .nav__secondary {
        display: flex;
        flex-direction: column;
        gap: 0;
        padding: 0;
        margin: 0;
        list-style: none;
        border-block-start: 1px solid var(--rule);
        padding-block-start: var(--space-sm);
      }

      .nav__secondary-link {
        display: inline-flex;
        align-items: center;
        min-block-size: 44px;
        font-family: var(--font-ui);
        font-size: var(--step-1);
        font-weight: 520;
        color: var(--text-primary);
        text-decoration: underline;
        text-decoration-color: var(--accent);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.25em;
      }

      .nav__footer {
        display: flex;
        gap: var(--space-sm);
        align-items: center;
        justify-content: space-between;
        margin-block-start: auto;
        padding-block-start: var(--space-sm);
        border-block-start: 1px solid var(--rule);
      }

      .nav__contact {
        margin: 0;
        font-family: var(--font-ui);
        font-size: 1rem;
        color: var(--text-secondary);
      }

      .nav__contact a {
        display: inline-flex;
        align-items: center;
        min-block-size: 44px;
      }

      /* The panel covers the page; the body lock lives in lib/site-header.ts. */
      body.nav-open {
        position: fixed;
        inline-size: 100%;
        min-block-size: 100%;
        overflow: hidden;
      }

      /* An open panel needs its ground at once, whatever the scroll position. */
      body.nav-open .header {
        animation: none;
      }
    }

    /* The smallest phones. */
    @media (width <= 420px) {
      .header__inner {
        gap: var(--space-xs);
      }

      .logo__place {
        display: none;
      }

      .logo__icon {
        inline-size: 26px;
        block-size: 26px;
      }

      .nav__cta {
        --btn-padding-inline: 0.8rem;

        gap: 0.5em;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .nav {
        transition: none;
      }
    }
  }
</style>
