---
import nav from '../data/navigation.json';
import site from '../data/site.json';
import { Icon } from 'astro-icon/components';
import { button } from '@lib/ui';
import Container from './ui/Container.astro';
import ThemeSwitch from './ThemeSwitch.astro';

/**
 * The bar: the mark, the display switches, one action and the menu toggle. Over a
 * dark opening (`over-hero:`) it starts transparent with light text and turns to
 * the page's opaque paper with its text once the page moves (`data-scrolled`, set
 * by lib/site-header.ts); elsewhere it is paper from the start. Opaque, never glass:
 * the hero's large title would show through. The menu is a full
 * screen of deep earth that opens as a circle from the toggle (`data-open` on the
 * header, `--nav-origin` on the menu), with three rings breathing behind the
 * destinations.
 */

const links = [...nav.header.links, ...nav.header.secondary, ...nav.header.cta];
const ctaLinks = nav.header.cta;
// Explicit allowlist, so new entries do not silently become speculative.
const prefetchPaths = new Set(['/warum-ich-den-maennerkreis-leite']);
const RINGS = [
  'w-[min(78vmin,38rem)] border-sand/20',
  'w-[min(54vmin,26rem)] border-fill/30 animate-delay-[-0.9s]',
  'w-[min(32vmin,16rem)] border-fill/20 bg-radial from-fill/15 to-transparent to-70% animate-delay-[-1.8s]',
];
---

<header
  id="header"
  class:list={[
    'group/header fixed inset-x-0 top-0 z-40 py-[clamp(0.875rem,0.65rem+0.7vw,1.25rem)] text-fg print:hidden',
    // The bar's ground: the page's paper, opaque, with a hairline and a soft cast.
    // It switches at once, ground and text together: a cross-fade passes through a
    // grey, half-clear bar with faint text over the dark opening.
    'before:pointer-events-none before:absolute before:inset-0 before:-z-10 before:border-b before:border-line/50 before:bg-ground before:shadow-[0_10px_24px_-10px] before:shadow-ink/10',
    // Over a dark opening: transparent with light text until the page moves.
    'over-hero:text-bone over-hero:before:opacity-0 over-hero:data-[scrolled]:text-fg over-hero:data-[scrolled]:before:opacity-100',
    // With the menu open the bar sits on the menu's dark ground.
    'data-[open]:text-bone! data-[open]:before:opacity-0!',
  ]}
>
  <Container class="relative z-10 flex items-center gap-3">
    <a
      href="/"
      aria-label={`${site.siteName} – Startseite`}
      class="group/logo flex min-w-0 items-center gap-4 rounded-control font-serif text-xl tracking-[-0.02em] transition-opacity duration-300 hover:opacity-90 focus-visible:outline-offset-6"
    >
      <Icon
        name="logo"
        aria-hidden="true"
        class="size-[42px] shrink-0 transition-transform duration-500 ease-settle group-hover/logo:rotate-[22.5deg]"
      />
      <span class="max-[35rem]:sr-only">Männerkreis</span>
    </a>

    <div class="ml-auto flex items-center gap-2 sm:gap-3">
      <ThemeSwitch class="max-md:hidden" />

      {ctaLinks.map((link) => (
        <a
          href={link.url}
          data-nav-link
          data-umami-event="cta-click"
          data-umami-event-location="header"
          data-umami-event-target={link.umamiTarget}
          class:list={[button({ variant: 'primary', size: 'sm' }), 'group-data-[open]/header:invisible']}
        >
          {link.label}
        </a>
      ))}

      <button
        id="navToggle"
        type="button"
        aria-controls="nav"
        aria-expanded="false"
        aria-label="Menü öffnen"
        class="relative grid size-12 place-items-center rounded-full border border-current/20 text-current transition-[background-color,border-color] duration-300 hover:border-current/40 hover:bg-current/8"
      >
        {/* A breath around the closed toggle. */}
        <span
          aria-hidden="true"
          class="pointer-events-none absolute -inset-0.5 rounded-full border border-current/35 opacity-0 motion-safe:animate-[toggle-breath_4.5s_var(--ease-ambient)_infinite] group-data-[open]/header:hidden"
        ></span>
        <span
          aria-hidden="true"
          class="flex flex-col items-center gap-1.5 group-data-[open]/header:rotate-90 motion-safe:transition-[rotate] motion-safe:duration-500 motion-safe:ease-emphasised"
        >
          <span class="block h-0.5 w-6 rounded-full bg-current group-data-[open]/header:translate-y-2 group-data-[open]/header:rotate-45 motion-safe:transition-transform motion-safe:duration-[420ms] motion-safe:ease-emphasised"></span>
          <span class="block h-0.5 w-6 rounded-full bg-current group-data-[open]/header:scale-x-0 group-data-[open]/header:opacity-0 motion-safe:transition-[transform,opacity] motion-safe:duration-200"></span>
          <span class="block h-0.5 w-6 rounded-full bg-current group-data-[open]/header:-translate-y-2 group-data-[open]/header:-rotate-45 motion-safe:transition-transform motion-safe:duration-[420ms] motion-safe:ease-emphasised"></span>
        </span>
      </button>
    </div>
  </Container>

  <nav
    id="nav"
    aria-label="Hauptnavigation"
    class:list={[
      'surface-night fixed inset-0 grid min-h-dvh grid-rows-[1fr_auto] place-items-center overflow-y-auto overscroll-contain px-gutter pt-[calc(var(--spacing-clearance)+1.5rem)] pb-section',
      'invisible pointer-events-none group-data-[open]/header:visible group-data-[open]/header:pointer-events-auto',
      // A warm light behind the destinations.
      'bg-[radial-gradient(ellipse_at_50%_32%,color-mix(in_oklch,var(--color-fill)_20%,transparent),transparent_58%),linear-gradient(155deg,var(--p-earth-deep),var(--p-earth-dark)_58%,var(--p-earth-mid))]',
      // A circle from the toggle; closing runs back quickly. Reduced motion: a fade.
      '[--nav-origin:100%_0] motion-safe:[clip-path:circle(0_at_var(--nav-origin))] motion-safe:[transition:clip-path_420ms_var(--ease-precise),visibility_0s_linear_420ms]',
      'motion-safe:group-data-[open]/header:[clip-path:circle(150vmax_at_var(--nav-origin))] motion-safe:group-data-[open]/header:[transition:clip-path_820ms_var(--ease-emphasised),visibility_0s]',
      'motion-reduce:opacity-0 motion-reduce:transition-opacity motion-reduce:group-data-[open]/header:opacity-100',
    ]}
  >
    <span aria-hidden="true" class="pointer-events-none absolute inset-0 grid place-items-center">
      {RINGS.map((ring) => (
        <span
          class:list={[
            'col-start-1 row-start-1 aspect-square rounded-full border motion-safe:group-data-[open]/header:animate-[ring-breathe_7s_var(--ease-ambient)_infinite]',
            ring,
          ]}
        />
      ))}
    </span>

    <ul class="relative grid gap-[clamp(1.1rem,3vh,2.25rem)] text-center" role="list">
      {links.map((link, i) => (
        <li class="overflow-clip [overflow-clip-margin:0.4em]" style={`--i: ${i}`}>
          <a
            href={link.url}
            data-nav-link
            data-umami-event="nav-click"
            data-umami-event-target={(link as { umamiTarget?: string }).umamiTarget}
            data-astro-prefetch={prefetchPaths.has(link.url) ? 'hover' : undefined}
            class:list={[
              'group/link relative inline-block rounded-control font-serif text-[clamp(1.7rem,1rem+3.6vw,3.5rem)] leading-none tracking-[-0.02em] text-fg/90 transition-colors duration-300 hover:text-fg focus-visible:outline-offset-8',
              'motion-safe:translate-y-[115%] motion-safe:transition-[translate,color] motion-safe:duration-200',
              'motion-safe:group-data-[open]/header:translate-y-0 motion-safe:group-data-[open]/header:delay-[calc(220ms+var(--i)*70ms)] motion-safe:group-data-[open]/header:duration-700 motion-safe:group-data-[open]/header:ease-emphasised',
            ]}
          >
            {link.label}
            <span
              aria-hidden="true"
              class="absolute inset-x-0 -bottom-[0.22em] h-0.5 scale-x-0 rounded-full bg-fill transition-transform duration-300 ease-precise group-hover/link:scale-x-100 group-focus-visible/link:scale-x-100"
            ></span>
          </a>
        </li>
      ))}
    </ul>

    <div class="relative grid justify-items-center gap-6 motion-safe:opacity-0 motion-safe:transition-opacity motion-safe:duration-150 motion-safe:group-data-[open]/header:opacity-100 motion-safe:group-data-[open]/header:delay-500 motion-safe:group-data-[open]/header:duration-700">
      <ThemeSwitch class="md:hidden" />
      <p class="flex flex-col items-center gap-4 text-xs tracking-[0.16em] text-fg-muted uppercase">
        <span
          class="size-1.5 rounded-full bg-accent motion-safe:animate-[ember-pulse_4.5s_var(--ease-ambient)_infinite]"
          aria-hidden="true"
        ></span>
        Männerkreis · {site.geo.locality} / Niederbayern
      </p>
    </div>
  </nav>
</header>
