---
import Rings from './Rings.astro';
import Container from './ui/Container.astro';

/**
 * The dark opening of a page: deep earth with a fine grain, two warm glows,
 * hairline rings breathing in from the corners. `data-hero` turns the header
 * light over it (`over-hero:` in theme.css). On scroll the content lifts
 * a little (never fading) while the rings drift down (`hero-leave`, `hero-rings-drift`).
 *
 * `full` fills the first screen and sets the content at its foot (home); `tall`
 * takes most of it (an event); `auto` sizes to its content (sub-pages).
 */
interface Props {
  id?: string;
  height?: 'full' | 'tall' | 'auto';
  labelledby?: string;
  class?: string;
  /** Classes for the inner container. */
  innerClass?: string;
}

const { id, height = 'full', labelledby, class: className, innerClass } = Astro.props;

const HEIGHTS = {
  full: 'min-h-[max(43.75rem,100svh)] items-end pt-[calc(var(--spacing-header)+var(--spacing-section))] pb-section sm:min-h-[min(55rem,max(43.75rem,100svh))]',
  tall: 'min-h-[70svh] items-end pt-[calc(var(--spacing-header)+var(--spacing-section))] pb-section',
  auto: 'items-end pt-[calc(var(--spacing-header)+var(--spacing-section))] pb-section',
} as const;
---

<section
  data-hero
  id={id}
  aria-labelledby={labelledby}
  class:list={['surface-night grain relative flex overflow-clip', HEIGHTS[height], className]}
>
  {/* Two warm glows, as of a fire just out of sight. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_70%_30%,color-mix(in_oklch,var(--color-fill)_22%,transparent),transparent_50%),radial-gradient(ellipse_60%_50%_at_20%_80%,color-mix(in_oklch,var(--color-fill)_12%,transparent),transparent_40%)]"
  ></div>
  <Rings set="hero" class="text-sand" />

  <Container
    class:list={[
      'relative scroll-motion:animate-[hero-leave_linear_both] scroll-motion:[animation-range:10vh_92vh] scroll-motion:[animation-timeline:scroll(root)]',
      innerClass,
    ]}
  >
    <slot />
  </Container>
</section>
