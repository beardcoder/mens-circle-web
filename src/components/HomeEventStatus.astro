---
import { dateStatus, nextDateView } from '../lib/event-status';
import EventSummary from './event/EventSummary.astro';
import Button from './ui/Button.astro';
import TextLink from './ui/TextLink.astro';

/**
 * The next date on the home page, as a server island in two places. In the hero
 * it renders two grid items of the hero's grid — the summary and, under the
 * statement, the main action with the quiet link to the evening's course — so
 * the action can name the date's state ("Zum nächsten Termin", "Auf die
 * Warteliste", "Termine ansehen" — with no date planned it leads to the overview,
 * where the empty state is explained). In the closing it is the summary with its
 * action, which then offers the e-mail notification right below. The fallback renders the same lines with static words, so the swap
 * changes text, not height. A failed read says so, never "no date planned".
 */

interface Props {
  placement: 'hero' | 'dates';
  fallback?: boolean;
  /** Hero only: the quiet link beside the action. */
  secondaryLabel?: string;
  secondaryLink?: string;
}
const { placement, fallback = false, secondaryLabel, secondaryLink } = Astro.props;
// The static fallback never opens SQLite. Only the server-island request reads live data.
const result = fallback ? null : await (await import('../lib/server/events')).fetchNextEventState();
const hero = placement === 'hero';
const view = nextDateView(result ? dateStatus(result.status, result.event) : null, hero ? 'overview' : 'notify');
---

{hero ? (
  <>
    <div data-llms-skip class="min-w-0 lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1 lg:self-end">
      <EventSummary view={{ ...view, action: null }} />
    </div>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 lg:col-span-7 lg:row-start-2">
      {view.action && (
        <Button
          href={view.action.href}
          size="lg"
          decorate
          class="max-sm:w-full"
          data-umami-event="cta-click"
          data-umami-event-location="home-hero"
          data-umami-event-state={view.state}
        >
          {view.action.label}
        </Button>
      )}
      {secondaryLabel && secondaryLink && <TextLink href={secondaryLink}>{secondaryLabel}</TextLink>}
    </div>
  </>
) : (
  <div data-llms-skip class="min-w-0">
    <EventSummary view={view} location="home-dates" />
  </div>
)}
