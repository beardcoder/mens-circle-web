---
import { primaryAction, dateStatus } from '../lib/event-status';
import { caps, card } from '../lib/ui';
import SeatCircle from './SeatCircle.astro';
import Button from './ui/Button.astro';

/**
 * The next date as a card: when, where, how many seats, and the one action. A
 * server island in the hero and in the Termine block; the fallback sets the same
 * lines with static words, so the swap changes text, not height. A failed read is
 * said as such, never as "no date planned".
 */

interface Props {
  placement: 'hero' | 'dates';
  fallback?: boolean;
  class?: string;
}
const { placement, fallback = false, class: className } = Astro.props;
// The static fallback never opens SQLite. Only the server-island request reads live data.
const result = fallback ? null : await (await import('../lib/server/events')).fetchNextEventState();
const state = dateStatus(result?.status ?? 'unavailable', result?.event ?? null);
const status = fallback ? 'loading' : state.status;
const action = fallback
  ? { note: '', label: 'Termine ansehen', href: '/event' }
  : primaryAction(state, placement === 'dates' ? '#newsletter' : '#termine');

const next = !fallback && state.status === 'scheduled' ? state.next : null;
const seatsLabel = next
  ? state.isFull
    ? 'Ausgebucht – Warteliste möglich'
    : `${next.availableSpots} von ${next.maxParticipants} Plätzen frei`
  : '';

// The same lines in every state: a title, a line under it, a line about the seats.
const title = next
  ? next.dateLabel
  : fallback
    ? 'Termine & Anmeldung'
    : status === 'unavailable'
      ? 'Termine gerade nicht abrufbar'
      : 'Zurzeit kein Termin geplant';
const meta = next
  ? [next.timeRange, next.place].filter(Boolean).join(' · ')
  : fallback
    ? 'Datum, Ort und freie Plätze'
    : status === 'unavailable'
      ? 'Auf der Terminseite steht der aktuelle Stand.'
      : 'Lass dich benachrichtigen, sobald er feststeht.';
// Two lines in every state, so the fallback holds the loaded card's height.
const seatsHeadline = next ? seatsLabel : 'Ohne Vorerfahrung';
const seatsLine = next
  ? state.isFull
    ? 'Wird ein Platz frei, rückst du automatisch nach.'
    : 'Für die Anmeldung genügen Name und E-Mail-Adresse.'
  : 'Auf Spendenbasis, alle zwei bis vier Wochen.';
---

<div
  data-llms-skip
  data-status={status}
  class:list={[card, 'grid gap-5 border-t-4 border-t-accent p-6 sm:p-7', className]}
>
  <div class="min-w-0">
    <p class={`${caps} text-accent`}>Nächster Termin</p>
    <p class="mt-1.5 font-serif text-2xl font-semibold text-fg">{title}</p>
    <p class="mt-1 text-base text-fg-soft">{meta}</p>
  </div>

  <div class="flex items-center gap-4 border-t border-line pt-4">
    {next ? (
      <SeatCircle
        seats={next.maxParticipants}
        taken={next.maxParticipants - next.availableSpots}
        ember
        seatSize={12}
        label={seatsLabel}
        class="size-12 shrink-0"
      />
    ) : (
      /* The circle keeps its place, but shows no seats it does not know. */
      <SeatCircle seatSize={12} class="invisible size-12 shrink-0" />
    )}
    <p class="text-sm text-fg-muted">
      <strong class="block text-base font-semibold text-fg">{seatsHeadline}</strong>
      {seatsLine}
    </p>
  </div>

  <Button
    href={action.href}
    block
    data-umami-event="cta-click"
    data-umami-event-location={placement === 'hero' ? 'home-hero' : 'home-dates'}
    data-umami-event-state={status}
  >
    {action.label}
  </Button>
</div>
