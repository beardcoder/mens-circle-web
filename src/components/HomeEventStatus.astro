---
import { primaryAction, dateStatus } from '../lib/event-status';
import { card } from '../lib/ui';
import SeatMeter from './SeatMeter.astro';
import Button from './ui/Button.astro';

/**
 * The next date as a card: when, where, how many seats, and the one action. A
 * server island in the hero and in the Termine block; the fallback sets the same
 * lines with static words, so the swap changes text, not height. A failed read is
 * said as such, never as "no date planned".
 */

interface Props {
  placement: 'hero' | 'dates';
  fallback?: boolean;
  class?: string;
}
const { placement, fallback = false, class: className } = Astro.props;
// The static fallback never opens SQLite. Only the server-island request reads live data.
const result = fallback ? null : await (await import('../lib/server/events')).fetchNextEventState();
const state = dateStatus(result?.status ?? 'unavailable', result?.event ?? null);
const status = fallback ? 'loading' : state.status;
const action = fallback
  ? { note: '', label: 'Termine ansehen', href: '/event' }
  : primaryAction(state, placement === 'dates' ? '#newsletter' : '#termine');

const next = !fallback && state.status === 'scheduled' ? state.next : null;
const seatsLabel = next
  ? state.isFull
    ? 'Ausgebucht – Warteliste möglich'
    : `${next.availableSpots} von ${next.maxParticipants} Plätzen frei`
  : '';

// The same lines in every state: a title on two fixed lines, a line under it, a
// line about the seats. Every line is one line at every width, so the swap from
// the fallback changes text, never height.
const [titleLead, titleRest] = next
  ? [next.dateLabel.split(', ')[0], next.dateLabel.split(', ').slice(1).join(', ')]
  : fallback
    ? ['Termine', 'und Anmeldung']
    : status === 'unavailable'
      ? ['Termine gerade', 'nicht abrufbar']
      : ['Zurzeit kein', 'Termin geplant'];
const meta = next
  ? [next.timeRange, next.place].filter(Boolean).join(' · ')
  : fallback
    ? 'Datum, Ort und freie Plätze'
    : status === 'unavailable'
      ? 'Die Terminseite zeigt den Stand.'
      : 'Lass dich benachrichtigen.';
// Two lines in every state, so the fallback holds the loaded card's height.
const seatsHeadline = next ? seatsLabel : 'Ohne Vorerfahrung';
const seatsLine = next
  ? state.isFull
    ? 'Wird ein Platz frei, rückst du nach.'
    : 'Anmelden mit Name und E-Mail.'
  : 'Auf Spendenbasis, alle 2–4 Wochen.';
---

<div
  data-llms-skip
  data-status={status}
  class:list={[
    // In the hero the card is glass on the dark opening.
    placement === 'hero' ? 'rounded-card border border-line bg-raised/80 shadow-card backdrop-blur-md' : card,
    'grid gap-6 border-l-4 border-l-fill p-6 sm:p-8',
    className,
  ]}
>
  <div class="min-w-0">
    <p class="flex items-center gap-3 text-[0.7rem] font-bold tracking-eyebrow text-accent uppercase">
      <span class="h-px w-8 shrink-0 bg-current/70" aria-hidden="true"></span>
      Nächster Termin
    </p>
    <p class="mt-3 font-serif text-xl text-fg">
      <span class="block truncate">{titleLead}</span>
      <span class="block truncate">{titleRest}</span>
    </p>
    <p class="mt-2 truncate text-base text-fg-soft">{meta}</p>
  </div>

  <div class="grid gap-3 border-t border-line pt-5">
    <p class="text-sm text-fg-muted">
      <strong class="block truncate text-base font-semibold text-fg">{seatsHeadline}</strong>
      <span class="block truncate">{seatsLine}</span>
    </p>
    {next ? (
      <SeatMeter seats={next.maxParticipants} taken={next.maxParticipants - next.availableSpots} label={seatsLabel} />
    ) : (
      /* The meter keeps its place, but shows no seats it does not know. */
      <SeatMeter class="invisible" />
    )}
  </div>

  <Button
    href={action.href}
    block
    data-umami-event="cta-click"
    data-umami-event-location={placement === 'hero' ? 'home-hero' : 'home-dates'}
    data-umami-event-state={status}
  >
    {action.label}
  </Button>
</div>
