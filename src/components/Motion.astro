---
/**
 * The page's motion below the opening, with Motion (motion.dev). The opening itself
 * moves in CSS (global.css, "Motion: the opening"), so the largest paint never waits
 * for this script. Like an app's list: each piece arrives as it comes into view,
 * quickly and once, and what arrives together follows top to bottom. Opacity fades
 * on a short curve, movement follows a spring without overshoot, distances stay
 * short, and only opacity and transforms move, so scrolling stays on the
 * compositor. Hooks:
 *
 * - `data-reveal`: the element rises in once it enters the view.
 * - `data-reveal-group`: each child rises in on its own as it enters the view (a
 *   section head's label, title and lead; a list's rows; a text's paragraphs), so a
 *   long list on a phone arrives row by row. A step's path (`data-line`) draws
 *   itself in after its step.
 * - What enters from above (scrolling back up, after a jump to an anchor) is simply
 *   there after a short fade: nothing rises against the direction of reading.
 * - `data-seat-fill`: the capacity bar fills once it is in view. In the opening it
 *   fills in CSS with its date line (global.css).
 *
 * The boot script in Layout sets `data-motion` only when motion is allowed; global.css
 * hides the hooked elements under it until they move, and the boot script drops it
 * again if this script has not started within three seconds. Nothing here reads
 * layout: the intersection observer reports where an element entered. No parallax:
 * nothing moves with the scroll itself.
 */
---

<script>
  import { inView, spring } from 'motion';
  import { animate } from 'motion/mini';

  /** A long ease-out: fast at first, then a slow settle (fills, lines, short fades). */
  const ease = [0.22, 1, 0.36, 1] as const;
  /** Fading in: a gentle start, so the fade is seen, then a settle (`--ease-fade`). */
  const fade = { duration: 0.7, ease: [0.33, 0, 0.2, 1] as const };

  /**
   * Movement on a spring that settles without overshoot. The curve is worked out
   * once, here, and handed to every animation as an easing, instead of building a
   * spring for each element when a whole list starts at once.
   */
  const springEase = (visualDuration: number) => {
    const curve = spring({ keyframes: [0, 1], visualDuration, bounce: 0 });
    let end = 0;

    while (!curve.next(end).done && end < 4000) end += 10;

    return { duration: end / 1000, ease: (progress: number) => curve.next(progress * end).value };
  };

  const drift = springEase(0.65);
  /** Pieces that arrive together follow one another by this much, and none waits longer than `wait`. */
  const step = 0.07;
  const wait = 0.42;
  /** A piece moves once it is a little way above the bottom edge. */
  const inViewOptions = { margin: '0px 0px -6% 0px' } as const;

  interface Arrival {
    el: Element;
    fromAbove: boolean;
  }

  /**
   * One observer reports every piece that entered in a frame, in the order of the
   * page; they are started together, top to bottom, at the end of that task.
   */
  let arrivals: Arrival[] = [];

  const draw = (el: Element, delay: number, duration: number) => {
    const lines = el.querySelectorAll('[data-line]');

    if (lines.length > 0) animate(lines, { transform: ['scale(0)', 'none'] }, { duration, ease, delay });
  };

  const flush = () => {
    const batch = arrivals;
    let order = 0;

    arrivals = [];

    for (const { el, fromAbove } of batch) {
      if (fromAbove) {
        animate(el, { opacity: [0, 1] }, { duration: 0.35, ease });
        draw(el, 0, 0.35);
        continue;
      }

      const delay = Math.min(order++ * step, wait);

      animate(
        el,
        { opacity: [0, 1], transform: ['translateY(1.125rem)', 'none'] },
        { ...drift, delay, opacity: { ...fade, delay } },
      );
      draw(el, delay + 0.3, 0.9);
    }
  };

  const arrive = (el: Element, entry: IntersectionObserverEntry) => {
    if (arrivals.length === 0) queueMicrotask(flush);

    arrivals.push({ el, fromAbove: entry.boundingClientRect.top < (entry.rootBounds?.top ?? 0) });
  };

  /** The bar fills to the taken seats; the opening's bars fill in CSS. */
  const seats = () => {
    const bars = [...document.querySelectorAll('[data-seat-fill]')].filter((bar) => !bar.closest('[data-enter]'));

    if (bars.length === 0) return;

    inView(
      bars,
      (el) => {
        animate(el, { transform: ['scaleX(0)', 'none'] }, { duration: 1.2, ease, delay: 0.25 });
      },
      inViewOptions,
    );
  };

  /**
   * The opening's loops (the glow, the ring) pause once it is out of view: a running
   * animation is still serviced every frame, seen or not.
   */
  const rest = () => {
    const hero = document.querySelector('[data-hero]');

    if (!hero) return;

    new IntersectionObserver(([entry]) => {
      hero.toggleAttribute('data-offscreen', !entry.isIntersecting);
    }).observe(hero);
  };

  const root = document.documentElement;

  if (root.hasAttribute('data-motion')) {
    root.setAttribute('data-motion-ready', '');
    inView('[data-reveal], [data-reveal-group] > *', arrive, inViewOptions);
    seats();
  }

  rest();
</script>
