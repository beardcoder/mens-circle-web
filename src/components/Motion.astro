---
/**
 * The page's motion below the opening, with Motion (motion.dev). The opening itself
 * moves in CSS (global.css, "Motion: the opening"), so the largest paint never waits
 * for this script. Soft rather than snappy: opacity eases out on a long curve,
 * movement follows springs without overshoot, distances stay short, and besides
 * the heads' focus only opacity and transforms move, on the compositor. Hooks:
 *
 * - `data-reveal` / `data-reveal-group`: rises in once it enters the view; a group
 *   staggers its children, and a step's path (`data-line`) draws itself in after.
 *   `data-reveal-group="focus"` (section heads) also comes into focus out of a soft
 *   blur, the one non-composited piece, once and gone when it rests.
 * - `data-seat-fill`: the capacity bar fills once it is in view.
 *
 * The boot script in Layout sets `data-motion` only when motion is allowed; global.css
 * hides the hooked elements under it until they move, and the boot script drops it
 * again if this script has not started within three seconds. Nothing here reads
 * layout: Motion's `inView` observes, it does not measure. No parallax: nothing
 * moves with the scroll itself.
 */
---

<script>
  import { inView, spring, stagger } from 'motion';
  import { animate } from 'motion/mini';

  type Targets = Element | Iterable<Element>;

  /** A long ease-out: fast at first, then a slow settle (fills, lines). */
  const ease = [0.22, 1, 0.36, 1] as const;
  /** Fading in: a gentle start, so the fade is seen, then a long settle (`--ease-fade`). */
  const fade = { duration: 1.3, ease: [0.33, 0, 0.2, 1] as const };
  /** Movement on a soft spring that settles without overshoot. */
  const drift = { type: spring, visualDuration: 1.1, bounce: 0 } as const;
  /** Below the fold things move once they are a little way above the bottom edge. */
  const inViewOptions = { margin: '0px 0px -8% 0px' } as const;

  /**
   * Elements hidden at this width (`hidden`, `lg:hidden`) are left to CSS; they cannot
   * be animated. `checkVisibility` needs styles only, never a layout.
   */
  const shown = (el: Element) => el.checkVisibility?.() ?? true;

  const rendered = (el: Element) => {
    if (shown(el)) return true;

    (el as HTMLElement).style.opacity = '1';

    return false;
  };

  /**
   * Fades in and rises a short way and, with `blur`, comes into focus; several
   * targets follow one another by `step` seconds. Opacity and focus take the fade,
   * the rise the spring, so each needs its own delay.
   */
  const rise = (targets: Targets, distance: string, start: number, step = 0, blur = 0) => {
    const list = (targets instanceof Element ? [targets] : [...targets]).filter(rendered);

    list.forEach((target, i) => {
      const delay = start + i * step;

      animate(
        target,
        {
          opacity: [0, 1],
          transform: [`translateY(${distance})`, 'none'],
          ...(blur > 0 && { filter: [`blur(${blur}px)`, 'none'] }),
        },
        { ...drift, delay, opacity: { ...fade, delay }, filter: { ...fade, delay } },
      );
    });
  };

  /** Sections rise in as they enter the view; a group's children follow one another. */
  const reveal = () => {
    inView('[data-reveal]', (el) => rise(el, '1.25rem', 0), inViewOptions);
    inView(
      '[data-reveal-group]',
      (el) => {
        const focus = (el as HTMLElement).dataset.revealGroup === 'focus';

        rise(el.children, '1.25rem', 0, 0.12, focus ? 6 : 0);

        const lines = [...el.querySelectorAll('[data-line]')].filter(shown);

        if (lines.length > 0) {
          animate(
            lines,
            { transform: ['scale(0)', 'none'] },
            { duration: 1.4, ease, delay: stagger(0.2, { startDelay: 0.5 }) },
          );
        }
      },
      inViewOptions,
    );
  };

  /** The bar fills to the taken seats; in the opening it waits for its date line. */
  const seats = () => {
    inView(
      '[data-seat-fill]',
      (el) => {
        const delay = el.closest('[data-hero]') ? 1.4 : 0.4;

        animate(el, { transform: ['scaleX(0)', 'none'] }, { duration: 1.8, ease, delay });
      },
      inViewOptions,
    );
  };

  const root = document.documentElement;

  if (root.hasAttribute('data-motion')) {
    root.setAttribute('data-motion-ready', '');
    reveal();
    seats();
  }
</script>
