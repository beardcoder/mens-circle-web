---
import type { CollectionEntry } from 'astro:content';

import Cta from './blocks/Cta.astro';
import Dates from './blocks/Dates.astro';
import Facts from './blocks/Facts.astro';
import Faq from './blocks/Faq.astro';
import Frame from './blocks/Frame.astro';
import Hero from './blocks/Hero.astro';
import Intro from './blocks/Intro.astro';
import JourneySteps from './blocks/JourneySteps.astro';
import Moderator from './blocks/Moderator.astro';
import PageHero from './blocks/PageHero.astro';
import Statement from './blocks/Statement.astro';
import Testimonials from './blocks/Testimonials.astro';
import TextSection from './blocks/TextSection.astro';
import ValueItems from './blocks/ValueItems.astro';

interface Props {
  /** A page's blocks, as `src/content.config.ts` validates them. */
  blocks: CollectionEntry<'pages'>['data']['blocks'];
}

const { blocks } = Astro.props;
---

{blocks.map((block) => {
  // Destructured together, so the switch on `type` narrows `data`.
  const { type, data } = block;

  switch (type) {
    case 'hero':
      return <Hero data={data} />;
    case 'facts':
      return <Facts data={data} />;
    case 'intro':
      return <Intro data={data} />;
    case 'moderator':
      return <Moderator data={data} />;
    case 'journey-steps':
      return <JourneySteps data={data} />;
    case 'statement':
      return <Statement data={data} />;
    case 'frame':
      return <Frame data={data} />;
    case 'faq':
      return <Faq data={data} />;
    case 'dates':
      return <Dates data={data} />;
    case 'cta':
      return <Cta data={data} />;
    case 'value-items':
      return <ValueItems data={data} />;
    case 'testimonials':
      return <Testimonials data={data} />;
    case 'page-hero':
      return <PageHero data={data} />;
    case 'text-section':
      return <TextSection data={data} />;
    default:
      return null;
  }
})}
