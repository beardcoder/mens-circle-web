---
import { afterWords, splitText } from '@lib/shared/words'

import Stamp from './brand/Stamp.astro'
import Container from './ui/Container.astro'
import Eyebrow from './ui/Eyebrow.astro'

/**
 * The opening of a sub-page. Without a photograph: on the page's paper, label,
 * title, lead (slot `lead`) and any actions (default slot) on the reading line,
 * the stamp cut by the window's right edge. With a photograph (slot `media`, an
 * image that fills its parent): the home page's poster opening, on the forest and
 * one screen tall, the photograph without a frame in the upper right and the
 * title at poster size across its foot; the page then sets `overHero` on its
 * layout. A long word in the title hyphenates rather than overflows. It arrives
 * once on load (global.css, "The opening").
 */
interface Props {
  eyebrow?: string
  title: string
  id?: string
  titleId?: string
}

const { eyebrow, title, id, titleId } = Astro.props

const words = splitText(title)

const hasLead = Astro.slots.has('lead')
const hasAction = Astro.slots.has('default')
const hasMedia = Astro.slots.has('media')

const titleClass = hasMedia
  ? 'max-w-[10.4em] text-hero font-semibold text-fg wrap-anywhere hyphens-auto lg:text-[clamp(5.625rem,8.6vw,9.5rem)]'
  : 'max-w-[11em] text-page font-semibold text-fg wrap-anywhere hyphens-auto'
---

<section
  id={id}
  data-opening
  aria-labelledby={titleId}
  class:list={[
    // Without a photograph only the sides clip: a short opening (the legal pages) lets the stamp run on below it.
    'relative',
    hasMedia
      ? 'overflow-clip surface-dark flex min-h-[78svh] flex-col justify-end lg:min-h-svh pt-[calc(var(--spacing-header)+10rem)] pb-8 lg:pb-14'
      : 'overflow-x-clip pt-[calc(var(--spacing-header)+var(--spacing-group))] pb-group',
  ]}
>
  {hasMedia ? (
    <div
      data-hero-frame
      class="absolute inset-x-0 top-0 h-[60svh] overflow-clip lg:inset-y-0 lg:left-auto lg:h-auto lg:w-[62vw]"
    >
      <slot name="media" />
    </div>
  ) : (
    /* The stamp, where a photograph would stand: cut by the window's right edge. */
    <div
      aria-hidden="true"
      data-enter="ring"
      class="pointer-events-none absolute top-[calc(var(--spacing-header)+1rem)] right-0 hidden w-80 translate-x-1/4 text-line-strong lg:block xl:w-96"
    >
      <Stamp />
    </div>
  )}
  <Container class="relative grid">
    <div class="grid justify-items-start">
      {eyebrow && (
        <Eyebrow
          class="mb-4"
          data-enter
        >
          {eyebrow}
        </Eyebrow>
      )}
      <h1
        id={titleId}
        data-enter="words"
        class={titleClass}
        set:html={words.html}
      />
      {hasLead && (
        <div
          data-enter
          style={afterWords(words.count, 0)}
          class="mt-6 max-w-measure text-lg text-fg-soft"
        >
          <slot name="lead" />
        </div>
      )}
      {hasAction && (
        <div
          data-enter
          style={afterWords(words.count, 1)}
          class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3"
        >
          <slot />
        </div>
      )}
    </div>
  </Container>
</section>
