---
import Container from './ui/Container.astro';
import Eyebrow from './ui/Eyebrow.astro';

/**
 * The compact opening of a sub-page, on the page's paper: label, title, lead
 * (slot `lead`) and any actions (default slot) on the reading line; a photograph
 * (slot `media`) beside them from `lg`, under them on phones. A long word in the
 * title ("Datenschutzerklärung") hyphenates rather than overflows.
 */
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
  titleId?: string;
}

const { eyebrow, title, id, titleId } = Astro.props;

const titleClass =
  'max-w-[12em] text-page text-fg wrap-anywhere hyphens-auto entrance:animate-rise entrance:animate-delay-[90ms]';

const hasLead = Astro.slots.has('lead');
const hasAction = Astro.slots.has('default');
const hasMedia = Astro.slots.has('media');
---

<section
  id={id}
  aria-labelledby={titleId}
  class="pt-[calc(var(--spacing-header)+var(--spacing-group))] pb-group"
>
  <Container class:list={['grid', hasMedia && 'items-center gap-x-grid gap-y-10 lg:grid-cols-12']}>
    <div class:list={['grid justify-items-start', hasMedia && 'lg:col-span-7']}>
      {eyebrow && <Eyebrow class="mb-3 entrance:animate-rise">{eyebrow}</Eyebrow>}
      <h1
        id={titleId}
        class={titleClass}
      >
        {title}
      </h1>
      {hasLead && (
        <div class="mt-6 max-w-measure text-lg text-fg-muted entrance:animate-rise entrance:animate-delay-[180ms]">
          <slot name="lead" />
        </div>
      )}
      {hasAction && (
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 entrance:animate-rise entrance:animate-delay-[260ms]">
          <slot />
        </div>
      )}
    </div>
    {hasMedia && (
      <div class="lg:col-span-4 lg:col-start-9 entrance:animate-rise entrance:animate-delay-[200ms]">
        <slot name="media" />
      </div>
    )}
  </Container>
</section>
