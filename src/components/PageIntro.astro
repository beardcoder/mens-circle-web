---
import { afterWords, splitText } from '@lib/shared/words';

import Stamp from './brand/Stamp.astro';
import Container from './ui/Container.astro';
import Eyebrow from './ui/Eyebrow.astro';

/**
 * The compact opening of a sub-page, on the page's paper: label, title, lead
 * (slot `lead`) and any actions (default slot) on the reading line; a photograph
 * (slot `media`) beside them from `lg`, under them on phones. A long word in the
 * title ("Datenschutzerklärung") hyphenates rather than overflows. On load the
 * title rises in and the rest follows (global.css, "Motion: the opening").
 */
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
  titleId?: string;
}

const { eyebrow, title, id, titleId } = Astro.props;

const words = splitText(title);

const titleClass = 'max-w-[11em] text-page font-semibold text-fg wrap-anywhere hyphens-auto';

const hasLead = Astro.slots.has('lead');
const hasAction = Astro.slots.has('default');
const hasMedia = Astro.slots.has('media');
---

<section
  id={id}
  aria-labelledby={titleId}
  class="relative overflow-clip pt-[calc(var(--spacing-header)+var(--spacing-group))] pb-group"
>
  {!hasMedia && (
    /* The stamp, where a photograph would stand: cut by the window's right edge. */
    <div
      aria-hidden="true"
      data-enter="ring"
      class="pointer-events-none absolute top-[calc(var(--spacing-header)+1rem)] right-0 hidden w-80 translate-x-1/4 text-line-strong lg:block xl:w-96"
    >
      <Stamp />
    </div>
  )}
  <Container class:list={['relative grid', hasMedia && 'items-center gap-x-grid gap-y-10 lg:grid-cols-12']}>
    <div class:list={['grid justify-items-start', hasMedia && 'lg:col-span-7']}>
      {eyebrow && (
        <Eyebrow class="mb-4" data-enter>
          {eyebrow}
        </Eyebrow>
      )}
      <h1 id={titleId} data-enter="words" class={titleClass} set:html={words.html} />
      {hasLead && (
        <div data-enter style={afterWords(words.count, 0)} class="mt-6 max-w-measure text-lg text-fg-soft">
          <slot name="lead" />
        </div>
      )}
      {hasAction && (
        <div data-enter style={afterWords(words.count, 1)} class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <slot />
        </div>
      )}
    </div>
    {hasMedia && (
      <div data-enter="settle" class="lg:col-span-4 lg:col-start-9 lg:bleed-r lg:translate-x-[8%]">
        <slot name="media" />
      </div>
    )}
  </Container>
</section>
