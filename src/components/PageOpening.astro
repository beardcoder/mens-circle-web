---
import Rings from './Rings.astro';
import Eyebrow from './ui/Eyebrow.astro';
import Section from './ui/Section.astro';

/**
 * The opening of a sub-page: eyebrow, title, the lead (slot `lead`) and any action
 * (default slot), stacked on one reading line. A single long word in the title
 * ("Datenschutzerklärung") breaks rather than overflows. Rings at the right edge
 * keep the circle in the background.
 */
interface Props {
  eyebrow?: string;
  title: string;
  /** Trusted HTML from the content files. */
  titleHtml?: boolean;
  /** Tighter at the foot when the next block continues straight on. */
  joined?: boolean;
  id?: string;
}

const { eyebrow, title, titleHtml = false, joined = false, id } = Astro.props;
const titleClass =
  'max-w-[22ch] text-display-2 text-fg wrap-break-word max-sm:hyphens-auto entrance:animate-fade-in-up entrance:animate-delay-60';
const hasLead = Astro.slots.has('lead');
const hasAction = Astro.slots.has('default');
---

<Section
  id={id}
  space="none"
  class:list={['overflow-clip pt-[calc(var(--spacing-header)+var(--spacing-group))]', joined ? 'pb-8' : 'pb-group']}
  innerClass="relative grid justify-items-start gap-5"
>
  <Rings
    slot="before"
    class="top-full left-full w-[26rem] -translate-1/2 lg:top-1/2 lg:left-[90%] lg:w-[min(60rem,75vw)]"
  />
  {eyebrow && <Eyebrow class="entrance:animate-fade-in-up">{eyebrow}</Eyebrow>}
  {titleHtml ? <h1 class={titleClass} set:html={title} /> : <h1 class={titleClass}>{title}</h1>}
  {hasLead && (
    <div class="max-w-measure text-lg text-fg-soft entrance:animate-fade-in-up entrance:animate-delay-120">
      <slot name="lead" />
    </div>
  )}
  {hasAction && (
    <div class="mt-2 flex flex-wrap gap-3 entrance:animate-fade-in-up entrance:animate-delay-160">
      <slot />
    </div>
  )}
</Section>
