---
/**
 * The arrival of what lies below the first screen: every piece of a page slides up
 * and fades in the first time it is scrolled to, and pieces that come into view
 * together follow one another. "Every piece" is taken from the markup itself
 * (titles, paragraphs, list rows, figures, questions, forms, links that stand
 * alone …) plus whatever a component marks with `data-reveal` or
 * `data-reveal-group`; where pieces nest, the outermost one arrives as a whole.
 *
 * It happens once, and only for what was below the window when the page was read:
 * whatever is on screen at load is never hidden, so nothing flashes and the largest
 * paint is untouched. The fixed bars, the menu and popovers are left alone. Without
 * JavaScript, under reduced motion and in print everything simply stands. No
 * layout is read: the observer's own first report says what is below the window.
 * Styles: global.css, "Arriving".
 */
---

<script>
  /** How far above the window's lower edge a piece's top is when it arrives, as a share of the window. */
  const LEAD = 0.2;
  /** Pieces that come into view in the same moment follow one another by this much, up to six. */
  const STEP_MS = 80;

  /** What counts as a piece, inside the page's content and its footer. */
  const PIECES = [
    '[data-reveal]',
    '[data-reveal-group] > *',
    '[data-enter]',
    'h2',
    'h3',
    'p',
    'li',
    'dl > div',
    'details',
    'figure',
    'blockquote',
    'aside',
    'form',
    'table',
    'a',
    'button',
  ]
    .map((piece) => `:is(main, #footer) ${piece}`)
    .join(', ');

  /** Never a piece: what floats or is fixed, and what only shows on demand. */
  const LEFT_ALONE = '[data-action-bar], [data-event-dock], [data-scroll-top], dialog, [popover], [hidden]';

  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const found = still ? [] : [...document.querySelectorAll<HTMLElement>(PIECES)];
  const all = new Set<Element>(found);

  /** The outermost pieces: one inside another arrives with it, not on its own. */
  const pieces = found.filter((piece) => {
    if (piece.closest(LEFT_ALONE)) return false;

    for (let parent = piece.parentElement; parent; parent = parent.parentElement) {
      if (all.has(parent)) return false;
    }

    return true;
  });

  if (pieces.length > 0) {
    const seen = new WeakSet<Element>();

    /** The piece slides up and fades in, `nth` among those that come at the same moment. */
    const arrive = (piece: HTMLElement, nth: number) => {
      observer.unobserve(piece);
      piece.style.transitionDelay = `${Math.min(nth, 6) * STEP_MS}ms`;
      piece.dataset.arrive = 'done';
      // Once it stands, the piece gets its own transitions back (a button's press,
      // a link's colour): the arrival's would otherwise replace them.
      piece.addEventListener('transitionend', function settled(event) {
        if (event.target !== piece || event.propertyName !== 'opacity') return;

        piece.removeEventListener('transitionend', settled);
        piece.style.transitionDelay = '';
        piece.dataset.arrive = 'there';
      });
    };

    const observer: IntersectionObserver = new IntersectionObserver(
      (entries) => {
        let together = 0;

        for (const entry of entries) {
          const piece = entry.target as HTMLElement;

          if (!seen.has(piece)) {
            // The first report: hide only what lies below the window. The root ends a
            // fifth above the window's lower edge (below); what stands in that last
            // fifth at load is on screen and must not be hidden. A piece that is not
            // laid out (`display: none` at this width) is left alone: it would never
            // be seen arriving and would stay hidden if it showed up later.
            seen.add(piece);

            const root = entry.rootBounds;
            const box = entry.boundingClientRect;
            const below = root !== null && box.height > 0 && box.top >= root.top + root.height / (1 - LEAD);

            if (!entry.isIntersecting && below) piece.dataset.arrive = 'pending';
            else observer.unobserve(piece);

            continue;
          }

          if (entry.isIntersecting) arrive(piece, together++);
        }
      },
      // A piece arrives once its top is a fifth of the window's height above the
      // lower edge: where the eye is, and clear of the phone's bottom bar, which
      // covers the last tenth (an arrival at the very edge played behind it).
      { rootMargin: `0px 0px -${LEAD * 100}% 0px` },
    );

    for (const piece of pieces) observer.observe(piece);

    // The last rows of a page never rise to that line: the page ends first. So the
    // page's end, once it is on screen, brings in whatever is still waiting.
    // An empty mark after the footer's last row says when that is (no layout read).
    const end = document.createElement('div');

    const atEnd = new IntersectionObserver(([entry]) => {
      if (!entry?.isIntersecting) return;

      atEnd.disconnect();
      end.remove();
      pieces.filter((piece) => piece.dataset.arrive === 'pending').forEach(arrive);
    });

    end.setAttribute('aria-hidden', 'true');
    document.querySelector('#footer')?.append(end);
    atEnd.observe(end);
  }
</script>
