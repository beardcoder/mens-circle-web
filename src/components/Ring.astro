---
interface Props {
  /** Where on the page this instance sits — drives size and crop, see the CSS. */
  place: 'hero' | 'close';
  class?: string;
}

/**
 * The ring.
 *
 * One graphic motif, used twice: once in the hero and once at the participation
 * close. A thick, open orange ring — the circle men sit in, drawn as a mark
 * rather than as an illustration. It is cropped by the viewport edge on purpose
 * and it overlaps the display type and the photograph.
 *
 * Deliberately *not*: a cluster of floating bubbles, a gradient blob, a rotating
 * word-wreath, or a mandala. It is a single stroke with one gap in it.
 *
 * Drawn as SVG rather than a bordered div because the gap has to be a clean
 * butt-ended break (a `border-color: … transparent` gap cuts on the diagonal),
 * and because the stroke then scales with the box instead of needing its own
 * clamp.
 *
 * ── Why a wrapper element ────────────────────────────────────────────────
 * The ring carries two independent animations: a one-shot entrance (time-based)
 * and a drift on scroll (view-timeline-based). They cannot share an element:
 * both animate `transform`, so the later one in the list simply wins — and the
 * `.vt-arrival` rule that stands the entrance down after a view transition was
 * killing the whole `animation` shorthand, silently taking the scroll drift
 * with it. The wrapper owns the entrance, the inner SVG owns the drift.
 *
 * `aria-hidden` and `focusable="false"`: it carries no information, and it must
 * never take a tab stop. Nothing readable is ever placed on top of it — the
 * text sits beside or under it, never over the stroke.
 */

const { place, class: className } = Astro.props;

// r=88 in a 200 box leaves room for the 23-unit stroke without clipping.
// Circumference = 2πr ≈ 552.9. A 470/83 dash leaves one ~54° opening.
const R = 88;
const CIRCUMFERENCE = 2 * Math.PI * R;
const GAP = 83;
---

<span class:list={['ring', `ring--${place}`, className]} data-ring={place} aria-hidden="true">
  <svg class="ring__svg" viewBox="0 0 200 200" focusable="false">
    <circle
      class="ring__stroke"
      cx="100"
      cy="100"
      r={R}
      fill="none"
      stroke="currentColor"
      stroke-width="23"
      stroke-linecap="butt"
      stroke-dasharray={`${CIRCUMFERENCE - GAP} ${GAP}`}
      transform="rotate(-152 100 100)"></circle>
  </svg>
</span>

<style is:global>
  @layer sections {
    .ring {
      position: absolute;
      z-index: 0;
      display: block;
      color: var(--color-orange);
      pointer-events: none;
    }

    .ring__svg {
      display: block;
      inline-size: 100%;
      block-size: 100%;
      /* The drift turns about the circle's own centre. Left on the element's
         border box: `transform-box: fill-box` on an `<svg>` root resolves
         against the child bounding box in user units and threw the ring ~1500px
         off its position as soon as a rotation applied. */
      transform-origin: 50% 50%;
    }

    /* ─── Hero ────────────────────────────────────────────────────────
       Sits to the upper right, cropped by the top and right edges. The display
       type runs to its left; the portrait tucks into its lower arc. Sized in vw
       so the crop stays proportional rather than being a fixed overhang that
       disappears on a wide screen. */
    .ring--hero {
      inset-block-start: -3vw;
      inset-inline-end: -6vw;
      inline-size: min(48vw, 42rem);
      aspect-ratio: 1;
    }

    /* ─── Close ───────────────────────────────────────────────────────
       The reprise. Smaller, cropped by the left edge and the bottom, so the
       page ends on the same mark it opened with, seen from the other side. */
    .ring--close {
      inset-block-end: -13vw;
      inset-inline-start: -11vw;
      inline-size: min(40vw, 30rem);
      aspect-ratio: 1;
    }

    @media (width <= 56em) {
      /* On a phone the ring is recomposed, not shrunk: it crops harder into the
         headline's top-right corner, so the headline still owns the screen and
         the action stays above the fold. */
      .ring--hero {
        inset-block-start: -16vw;
        inset-inline-end: -24vw;
        inline-size: min(70vw, 22rem);
      }

      .ring--close {
        inset-block-end: -22vw;
        inset-inline-start: -24vw;
        inline-size: min(64vw, 20rem);
      }
    }

    /* ─── Scroll reaction ─────────────────────────────────────────────
       The ring drifts and turns a little as its section passes. Bounded on
       purpose: ~40px of travel and ~12° of rotation — enough to notice, not
       enough to chase. Scroll-driven, so the compositor does the work and
       normal scrolling is untouched: no listeners, no hijacking.

       On the inner SVG, never the wrapper — see the note at the top of this
       file. */
    @media (prefers-reduced-motion: no-preference) {
      @supports (animation-timeline: view()) {
        .ring__svg {
          animation: ring-drift linear both;
          animation-timeline: view();
          animation-range: cover 0% cover 100%;
        }

        .ring--close .ring__svg {
          animation-name: ring-drift-reverse;
        }
      }
    }
  }
</style>
