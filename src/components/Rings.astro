---
/**
 * The circle, kept in the background: wide concentric hairlines, like rings in
 * water around a dropped stone, or around a fire. Sits absolutely in a
 * `relative` block behind its content and is placed by the caller (centre and
 * size). Drawn in the ground's hairline colour, so it stays faint on every
 * ground and every contrast holds where a ring runs behind text.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Spacing widens outward, as ripples do; seven rings are enough to read as one form.
const RADII = [60, 104, 156, 216, 284, 360, 444];
---

<svg
  viewBox="0 0 1000 1000"
  aria-hidden="true"
  focusable="false"
  class:list={['pointer-events-none absolute aspect-square max-w-none stroke-line-strong', className]}
>
  {RADII.map((r) => (
    <circle cx="500" cy="500" r={r} fill="none" stroke-width="1" vector-effect="non-scaling-stroke" />
  ))}
</svg>
