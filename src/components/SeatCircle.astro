---
interface Props {
  /** How many seats sit on the ring. The circle is set for eight. */
  seats?: number;
  /** Seats drawn as taken (filled); the rest stay open. Defaults to all. */
  taken?: number;
  /** A glowing centre: the fire the circle sits around. */
  ember?: boolean;
  /** Seat radius in the 240-unit box; smaller for the large instances. */
  seatSize?: number;
  /** Runs the one-time draw-in (hero only). */
  entrance?: boolean;
  /** Turns a little with the scroll position (hero only). */
  turn?: boolean;
  /** An accessible description; without it the graphic is decorative. */
  label?: string;
  class?: string;
}

/**
 * The identity mark: a hairline ring with seats on it. Used at different scales —
 * around the hero photograph, in the middle of the questions, as the seat count
 * of an event. Open seats take the ground they sit on (`fill-surface`).
 */

const {
  seats = 8,
  taken = seats,
  seatSize = 7.5,
  ember = false,
  entrance = false,
  turn = false,
  label,
  class: className,
} = Astro.props;

const C = 120;
const R = 100;
// Start at the top and go clockwise, with a half-step offset so no seat sits
// exactly at twelve o'clock — the circle reads as people, not as a clock.
const positions = Array.from({ length: seats }, (_, i) => {
  const angle = ((i + 0.5) / seats) * Math.PI * 2 - Math.PI / 2;
  return { x: +(C + R * Math.cos(angle)).toFixed(2), y: +(C + R * Math.sin(angle)).toFixed(2), filled: i < taken };
});

// A hairline at every size.
const hairline = 'origin-center transform-fill [vector-effect:non-scaling-stroke]';
---

<span
  class:list={['pointer-events-none block aspect-square', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <svg
    viewBox="0 0 240 240"
    focusable="false"
    class:list={[
      'block size-full overflow-visible',
      turn &&
        'scroll-motion:animate-[ring-turn_linear_both] scroll-motion:[animation-range:cover_30%_cover_100%] scroll-motion:[animation-timeline:view()]',
    ]}
  >
    <circle
      cx={C}
      cy={C}
      r={R}
      fill="none"
      class:list={[hairline, 'stroke-accent [stroke-width:1.25px]', entrance && 'entrance:animate-ring-in']}
    ></circle>
    {ember && (
      <g
        class:list={['origin-center transform-fill', entrance && 'entrance:animate-ember entrance:animate-delay-1000']}
      >
        <circle cx={C} cy={C} r="22" class:list={[hairline, 'fill-none stroke-accent opacity-45']} />
        <circle cx={C} cy={C} r="9" class:list={[hairline, 'fill-accent stroke-accent']} />
      </g>
    )}
    {positions.map((seat, i) => (
      <circle
        cx={seat.x}
        cy={seat.y}
        r={seatSize}
        style={`--i: ${i}`}
        class:list={[
          hairline,
          'stroke-fg [stroke-width:1.5px]',
          seat.filled ? 'fill-fg' : 'fill-surface',
          entrance && 'entrance:animate-seat-in entrance:animate-delay-[calc(500ms+var(--i)*70ms)]',
        ]}
      />
    ))}
  </svg>
</span>
