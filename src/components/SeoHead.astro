---
import site from '../data/site.json';
import { umamiOrigin } from '../lib/umami-config';
import { canonicalUrl } from '../lib/canonical';

// Font preloading is handled by the native <Font preload /> component in the
// layout head (fonts configured in astro.config.mjs).

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  /** Open Graph / social title. Falls back to `title` (then the site name). */
  ogTitle?: string;
  /** Open Graph / social description. Falls back to `description`. */
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** Pixel size of `ogImage`. Only pass them when they are actually known —
   *  see the note at `ogImageUrl` below. Both or neither. */
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** Up to two labelled facts a card can render as fields (`twitter:label1`
   *  / `data1`, `label2` / `data2`). Slack and X both show them; the event
   *  pages use them for the date and the place. */
  socialDetails?: { label: string; value: string }[];
  robots?: string;
  /** Extra JSON-LD objects to embed (Article, FAQPage, Event, …). */
  schemas?: Record<string, unknown>[];
  /** ISO dates for an `ogType="article"` page. Emitted as `article:*` meta. */
  publishedTime?: string;
  modifiedTime?: string;
  /** Web app manifest to link. Defaults to the site-wide manifest; a page can
   *  point at a focused one (e.g. the installable breathing app). */
  manifest?: string;
  /** When set, the page advertises itself as an installable standalone web app
   *  (adds the iOS/Android web-app metas with this as the home-screen title). */
  webAppTitle?: string;
  /** Viewport meta content. Defaults to a zoomable viewport with
   *  `viewport-fit=cover` so `env(safe-area-inset-*)` actually resolves; an
   *  app-like page can override it (e.g. to lock zoom). */
  viewport?: string;
}

const {
  title,
  description = site.description,
  ogType = 'website',
  ogTitle,
  ogDescription,
  ogImage,
  ogImageAlt = `${site.siteName} – ${site.tagline}`,
  ogImageWidth,
  ogImageHeight,
  socialDetails = [],
  // `index, follow` alone leaves Google's *preview* limits at their defaults:
  // a thumbnail-sized image and a snippet the crawler shortens on its own.
  // The three max-* directives lift them, which is what lets a result carry a
  // large image in Search and makes the page eligible for Discover.
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  schemas = [],
  publishedTime,
  modifiedTime,
  manifest = '/manifest.webmanifest',
  webAppTitle,
  viewport = 'width=device-width, initial-scale=1.0, viewport-fit=cover',
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://mens-circle.de');

// One spelling per page, shared with the pages' own structured data — see
// lib/canonical.ts. og:url and twitter:url below inherit it.
const canonical = canonicalUrl(siteUrl, Astro.url.pathname);

// Only third-party origin we ever load: the Umami analytics endpoint. Preconnect
// to it so the tracker script connects faster. Everything else (fonts, CSS, JS,
// API) is same-origin, so no other preconnect candidates exist.
const analyticsOrigin = umamiOrigin();
const fullTitle = title ?? `${site.siteName}${site.tagline ? ` – ${site.tagline}` : ''}`;
const socialTitle = ogTitle ?? title ?? site.siteName;
const socialDescription = ogDescription ?? description;
// The default social card is a real 1200x630 poster (public/images/og-default.png),
// not the square logo. Declared dimensions must match the file: the logo is
// 512x513, and every share used to advertise 1200x630 for it, which is what
// downgrades a summary_large_image card to a small one.
//
// So width/height are emitted only when the caller knows them. A page passing
// an image of its own (an event's picture, entered in the admin as an arbitrary
// URL) passes no dimensions, and the scraper measures the file itself — slower
// than a declaration, but never wrong.
const usesDefaultImage = !ogImage;
const ogImageUrl = new URL(ogImage ?? '/images/og-default.png', siteUrl).href;
const imageWidth = usesDefaultImage ? 1200 : ogImageWidth;
const imageHeight = usesDefaultImage ? 630 : ogImageHeight;

const MIME_BY_EXTENSION: Record<string, string> = {
  png: 'image/png',
  jpg: 'image/jpeg',
  jpeg: 'image/jpeg',
  webp: 'image/webp',
  gif: 'image/gif',
  avif: 'image/avif',
};
// From the PATH, not the href: an admin-entered image URL may carry a query
// string, and splitting the full URL on "." would read that as the extension.
const imageType = MIME_BY_EXTENSION[new URL(ogImageUrl).pathname.split('.').pop()?.toLowerCase() ?? ''];

// Two labelled facts at most — the card formats define label1/2 only.
const cardDetails = socialDetails.slice(0, 2);

// Global structured data (mirrors the original LocalBusiness/Organization/WebSite).
const sameAs = site.socialLinks.filter((l) => !['email', 'phone', 'whatsapp'].includes(l.type)).map((l) => l.value);

// Markus as a first-class entity rather than an `author` string. He runs the
// circle, the site has a page about him, and he is the author of the essay —
// three mentions that a crawler previously had no way to tie together. One
// `@id`, referenced from the business below and from the Article on his page.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteUrl.origin}/#markus`,
  name: 'Markus Sommer',
  url: new URL('/warum-ich-den-maennerkreis-leite', siteUrl).href,
  image: new URL('/images/og-markus.jpg', siteUrl).href,
  worksFor: { '@id': `${siteUrl.origin}/#organization` },
};

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteUrl.origin}/#organization`,
  name: site.siteName,
  description: site.description,
  url: siteUrl.origin,
  // An ImageObject rather than a bare URL: Google prefers explicit dimensions
  // when picking an organisation logo.
  logo: {
    '@type': 'ImageObject',
    url: new URL('/images/logo-color.png', siteUrl).href,
    width: 512,
    height: 513,
  },
  image: new URL('/images/og-default.png', siteUrl).href,
  email: site.contactEmail,
  telephone: site.contactPhone,
  founder: { '@id': `${siteUrl.origin}/#markus` },
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.geo.locality,
    addressRegion: site.geo.region,
    postalCode: site.geo.postalCode,
    addressCountry: site.geo.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.lat,
    longitude: site.geo.lng,
  },
  areaServed: {
    '@type': 'GeoCircle',
    geoMidpoint: {
      '@type': 'GeoCoordinates',
      latitude: site.geo.lat,
      longitude: site.geo.lng,
    },
    geoRadius: 50000,
  },
  priceRange: '€',
  ...(sameAs.length ? { sameAs } : {}),
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl.origin}/#website`,
  name: site.siteName,
  url: siteUrl.origin,
  description: site.description,
  inLanguage: 'de-DE',
  publisher: { '@id': `${siteUrl.origin}/#organization` },
};

const allSchemas = [localBusiness, person, website, ...schemas];
---

<meta name="viewport" content={viewport} />

<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="author" content="Markus Sommer" />
<link rel="canonical" href={canonical} />

<link rel="alternate" hreflang="de" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />

<meta name="theme-color" content={site.themeColor} />
<meta name="color-scheme" content="light dark" />
<meta name="msapplication-TileColor" content={site.themeColor} />

{analyticsOrigin && <link rel="preconnect" href={analyticsOrigin} crossorigin />}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={socialDescription} />
<meta property="og:image" content={ogImageUrl} />
{
  /* Legacy, and Facebook still reads it: some of its pipeline prefers the
    explicitly-secure URL over og:image when the two differ. Ours never do. */
}
<meta property="og:image:secure_url" content={ogImageUrl} />
{imageType && <meta property="og:image:type" content={imageType} />}
{imageWidth && imageHeight && <meta property="og:image:width" content={String(imageWidth)} />}
{imageWidth && imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:locale" content="de_DE" />
<meta property="og:site_name" content={site.siteName} />
{ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{ogType === 'article' && <meta property="article:author" content="Markus Sommer" />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={socialDescription} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />
{
  cardDetails.map((detail, index) => (
    <>
      <meta name={`twitter:label${index + 1}`} content={detail.label} />
      <meta name={`twitter:data${index + 1}`} content={detail.value} />
    </>
  ))
}

<!-- Robots -->
<meta name="robots" content={robots} />
<meta name="googlebot" content={robots} />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png" />
<link rel="manifest" href={manifest} />

{
  /* Installable standalone web app (e.g. the breathing exercise). */
  webAppTitle && (
    <>
      <meta name="mobile-web-app-capable" content="yes" />
      <meta name="apple-mobile-web-app-capable" content="yes" />
      <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
      <meta name="apple-mobile-web-app-title" content={webAppTitle} />
    </>
  )
}

<!-- Structured data -->
{allSchemas.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />)}
