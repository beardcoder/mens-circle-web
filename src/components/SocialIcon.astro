---
import { Icon } from 'astro-icon/components';
import { resolveSocialLink, type SocialLink } from '../lib/social';

interface Props {
  link: SocialLink;
  variant?: 'icon' | 'link';
}

const { link, variant = 'icon' } = Astro.props;
const { href, title, iconName, type, internal } = resolveSocialLink(link);

const isText = variant === 'link';
const linkClass = isText ? 'social-link' : 'social-icon';
const iconClass = isText ? 'social-link__icon' : 'social-icon__svg';

// External profiles open in a new tab. Say so as part of the accessible name —
// an unannounced context switch is disorienting for screen-reader users, and
// `mailto:`/`tel:` links (internal) stay in place and get no such note.
const newTabNote = internal ? '' : ' (öffnet in neuem Tab)';
---

<a
  href={href}
  title={title}
  target={internal ? '_self' : '_blank'}
  rel={internal ? undefined : 'noopener noreferrer'}
  data-umami-event="social-click"
  data-umami-event-platform={type}
  class={linkClass}
>
  <Icon name={iconName} class={iconClass} aria-hidden="true" />
  {
    isText ? (
      <span class="social-link__label">
        {title}
        <span class="sr-only">{newTabNote}</span>
      </span>
    ) : (
      <span class="sr-only">{title + newTabNote}</span>
    )
  }
</a>
