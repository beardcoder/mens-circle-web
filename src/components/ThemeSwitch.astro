---
import { Icon } from 'astro-icon/components';

interface Props {
  /** Extra class on the wrapper, used to place or hide each instance. */
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['theme-switch', className]}>
  <button
    class="theme-switch__btn"
    type="button"
    data-mode-toggle
    aria-label="Hell- oder Dunkelmodus wechseln"
    title="Hell- oder Dunkelmodus wechseln"
  >
    <Icon class="theme-switch__icon theme-switch__icon--light" name="theme-light" aria-hidden="true" />
    <Icon class="theme-switch__icon theme-switch__icon--dark" name="theme-dark" aria-hidden="true" />
  </button>
</div>
