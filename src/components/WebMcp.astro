---
/**
 * WebMCP on every page (lib/webmcp.ts): the tool that lists the upcoming evenings.
 * The forms offer their own tools where they stand. An origin-trial token
 * (`PUBLIC_WEBMCP_ORIGIN_TRIAL`, registered for the site's origin) switches the API
 * on in Chrome; without one only browsers that ship it, or a flag, see the tools.
 */
const token = import.meta.env.PUBLIC_WEBMCP_ORIGIN_TRIAL;
---

{token && <meta http-equiv="origin-trial" content={token} />}

<script>
  import type { PublicEvents } from '@components/event/types';

  // Most browsers have no model context; only where one exists does the rest load.
  if ('modelContext' in document) {
    const { eventsText, provideTool } = await import('@lib/webmcp');

    provideTool({
      name: 'list-events',
      title: 'Termine ansehen',
      description:
        "Lists the upcoming evenings of this men's circle in Straubing, Lower Bavaria: date, time, place, contribution, free seats and the page to register on. Use it to answer when the next evening is, where it takes place, what it costs or whether a seat is still free.",
      inputSchema: { type: 'object', properties: {} },
      annotations: { readOnlyHint: true },
      execute: async (_input, { signal }) => {
        // Offline or unavailable, the agent gets words for the person, not a bare failure.
        const response = await fetch('/api/public/events', { signal }).catch(() => null);

        if (!response?.ok) return 'Die Termine sind gerade nicht abrufbar. Bitte später erneut versuchen.';

        return eventsText((await response.json()) as PublicEvents, location.origin);
      },
    });
  }
</script>
