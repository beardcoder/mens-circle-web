---
import Eyebrow from '../ui/Eyebrow.astro';

/** A back-office page's head: a label, the title, and an action (default slot) at the far end. */
interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
  <div class="grid gap-2">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h1 class="text-[clamp(2rem,1.4rem+2.4vw,3rem)] leading-none tracking-display">{title}</h1>
  </div>
  <slot />
</div>
