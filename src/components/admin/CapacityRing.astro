---
/** A ring whose arc is the share of taken places, complete (and green) when the event is full. */
interface Props {
  value: number;
  max: number;
  size?: number;
  stroke?: number;
  showLabel?: boolean;
}
const { value, max, size = 46, stroke = 4, showLabel = true } = Astro.props;

const frac = max > 0 ? Math.min(value / max, 1) : value > 0 ? 1 : 0;
const full = max > 0 && value >= max;
const r = (size - stroke) / 2;
const circ = 2 * Math.PI * r;
const offset = circ * (1 - frac);
const labelSize = Math.round(size * 0.24);
---

{/* Size and label size come from the props, so they stay inline; the box is fixed so the
    ring never shrinks under its neighbours. */}
<span class="relative inline-grid shrink-0 place-items-center" style={`width: ${size}px; height: ${size}px`}>
  <svg
    width={size}
    height={size}
    viewBox={`0 0 ${size} ${size}`}
    role="img"
    aria-label={`${value} von ${max} belegt`}
    class="block max-w-none -rotate-90"
  >
    <circle class="stroke-line-strong" cx={size / 2} cy={size / 2} r={r} fill="none" stroke-width={stroke}></circle>
    <circle
      class:list={[
        'transition-[stroke-dashoffset] duration-150 [stroke-linecap:round]',
        full ? 'stroke-success' : 'stroke-accent',
      ]}
      cx={size / 2}
      cy={size / 2}
      r={r}
      fill="none"
      stroke-width={stroke}
      stroke-dasharray={circ}
      stroke-dashoffset={offset}
    ></circle>
  </svg>
  {showLabel && (
    <span
      class="absolute inset-0 grid place-items-center leading-none font-medium text-fg tabular-nums"
      style={`font-size: ${labelSize}px`}
      aria-hidden="true"
    >
      <span>
        {value}
        <span class="text-fg-muted">/{max}</span>
      </span>
    </span>
  )}
</span>
