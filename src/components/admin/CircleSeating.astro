---
/** The event drawn as a circle: each registered participant is a seat around the fire, open places are hollow. */
interface Seat {
  initials: string;
  name: string;
}
interface Props {
  seats: Seat[];
  capacity: number;
}
const { seats, capacity } = Astro.props;

const total = Math.max(capacity, seats.length, 1);
const SIZE = 320;
const C = SIZE / 2;
const R = 122; // seat ring radius
const NODE = 19; // seat radius

const points = Array.from({ length: total }, (_, i) => {
  const a = ((-90 + (i * 360) / total) * Math.PI) / 180;
  return {
    x: C + R * Math.cos(a),
    y: C + R * Math.sin(a),
    seat: seats[i],
    n: i + 1,
  };
});
const full = seats.length >= capacity && capacity > 0;
// Full turns the fire and the seats green.
const fire = full ? 'fill-success' : 'fill-accent';
---

<figure class="m-0 w-full max-w-[300px] justify-self-center">
  <svg
    viewBox={`0 0 ${SIZE} ${SIZE}`}
    role="img"
    aria-label={`Sitzkreis: ${seats.length} von ${capacity} Plätzen belegt`}
    class="block h-auto w-full overflow-visible"
  >
    <circle class="stroke-line [stroke-width:1.5]" cx={C} cy={C} r={R} fill="none"></circle>

    <circle class:list={['origin-center animate-glow opacity-20 transform-fill', fire]} cx={C} cy={C} r="46"></circle>
    <circle class:list={[fire]} cx={C} cy={C} r="30"></circle>
    <text
      class="fill-on-accent text-[19px] font-semibold tabular-nums"
      x={C}
      y={C}
      text-anchor="middle"
      dominant-baseline="central"
    >
      {seats.length}
      <tspan class="text-[13px]">/{capacity}</tspan>
    </text>

    {points.map((p) =>
      p.seat ? (
        <g>
          <circle class={fire} cx={p.x} cy={p.y} r={NODE} />
          <text
            class="fill-on-accent text-[13px] font-semibold"
            x={p.x}
            y={p.y}
            text-anchor="middle"
            dominant-baseline="central"
          >
            {p.seat.initials}
          </text>
        </g>
      ) : (
        <g>
          <circle
            class="stroke-line-strong [stroke-dasharray:3_3] [stroke-width:1.5]"
            cx={p.x}
            cy={p.y}
            r={NODE}
            fill="none"
          />
          <text
            class="fill-fg-muted text-[12px] tabular-nums"
            x={p.x}
            y={p.y}
            text-anchor="middle"
            dominant-baseline="central"
          >
            {p.n}
          </text>
        </g>
      ),
    )}
  </svg>
</figure>
