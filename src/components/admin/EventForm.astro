---
import { DEFAULT_EVENT_NEWSLETTER_INTRO } from '@lib/server/events';
import { button, control, panel } from '@lib/ui';
import Field from '../ui/Field.astro';
import AdminHead from './AdminHead.astro';

interface EventData {
  id?: string;
  title?: string;
  slug?: string;
  description?: string;
  eventDate?: string;
  startTime?: string;
  endTime?: string;
  location?: string;
  locationDetails?: string;
  street?: string;
  postalCode?: string;
  city?: string;
  latitude?: number | null;
  longitude?: number | null;
  maxParticipants?: number;
  costBasis?: string;
  isPublished?: boolean;
  imageUrl?: string | null;
}
interface Props {
  event?: EventData | null;
}
const { event = null } = Astro.props;

const isEdit = !!event?.id;
const isDuplicate = !!event && !event.id;
const v = event ?? {};
const dateValue = v.eventDate ? String(v.eventDate).slice(0, 10) : '';
const num = (n: number | null | undefined) => (n == null ? '' : String(n));
// Short alias so the textarea stays one line: whitespace inside <textarea> is
// significant and would leak into the field value.
const nlIntro = DEFAULT_EVENT_NEWSLETTER_INTRO;
const input = control('sm');
const row = 'grid gap-x-4 gap-y-5 sm:grid-cols-[repeat(auto-fit,minmax(150px,1fr))]';
---

<AdminHead
  eyebrow={isEdit ? 'Bearbeiten' : 'Anlegen'}
  title={isEdit ? 'Veranstaltung bearbeiten' : 'Neue Veranstaltung'}
>
  <a class={button({ variant: 'secondary' })} href="/admin">
    Zurück
  </a>
</AdminHead>

{isDuplicate && (
  <p class="-mt-4 mb-5 rounded-control border border-accent/60 px-4 py-2.5 text-sm text-accent">
    Aus Vorlage übernommen&nbsp;– Datum &amp; Sichtbarkeit bitte neu setzen.
  </p>
)}

<form id="event-form" class:list={[panel, 'grid gap-5']} data-id={event?.id ?? ''} data-edit={isEdit ? '1' : ''}>
  <Field for="title" label="Titel *">
    <input id="title" name="title" type="text" value={v.title ?? ''} required class={input} />
  </Field>

  <div class={row}>
    <Field for="eventDate" label="Datum *">
      <input
        id="eventDate"
        name="eventDate"
        type="date"
        value={dateValue}
        required
        class:list={[input, 'tabular-nums']}
      />
    </Field>
    <Field for="startTime" label="Beginn">
      <input
        id="startTime"
        name="startTime"
        type="time"
        value={v.startTime ?? ''}
        class:list={[input, 'tabular-nums']}
      />
    </Field>
    <Field for="endTime" label="Ende">
      <input id="endTime" name="endTime" type="time" value={v.endTime ?? ''} class:list={[input, 'tabular-nums']} />
    </Field>
  </div>

  <div class={row}>
    <Field for="maxParticipants" label="Max. Teilnehmer">
      <input
        id="maxParticipants"
        name="maxParticipants"
        type="number"
        min="0"
        value={v.maxParticipants ?? 8}
        class:list={[input, 'tabular-nums']}
      />
    </Field>
    <Field
      for="costBasis"
      label="Teilnahmebeitrag"
      hint="Kurz halten: der Text steht auf /event als Fakt in großer Schrift."
      hintId="costBasis-hint"
    >
      <input
        id="costBasis"
        name="costBasis"
        type="text"
        value={v.costBasis ?? ''}
        placeholder="z. B. Auf Spendenbasis"
        aria-describedby="costBasis-hint"
        class={input}
      />
    </Field>
    <Field for="slug" label="Slug">
      <input id="slug" name="slug" type="text" value={v.slug ?? ''} placeholder="auto aus Datum" class={input} />
    </Field>
  </div>

  <Field for="location" label="Ort (Name)">
    <input id="location" name="location" type="text" value={v.location ?? ''} class={input} />
  </Field>

  <div class={row}>
    <Field for="street" label="Straße">
      <input id="street" name="street" type="text" value={v.street ?? ''} class={input} />
    </Field>
    <Field for="postalCode" label="PLZ">
      <input id="postalCode" name="postalCode" type="text" value={v.postalCode ?? ''} class={input} />
    </Field>
    <Field for="city" label="Stadt">
      <input id="city" name="city" type="text" value={v.city ?? ''} class={input} />
    </Field>
  </div>

  <div class={row}>
    <Field for="latitude" label="Breitengrad (lat)">
      <input
        id="latitude"
        name="latitude"
        type="number"
        step="any"
        value={num(v.latitude)}
        class:list={[input, 'tabular-nums']}
      />
    </Field>
    <Field for="longitude" label="Längengrad (lng)">
      <input
        id="longitude"
        name="longitude"
        type="number"
        step="any"
        value={num(v.longitude)}
        class:list={[input, 'tabular-nums']}
      />
    </Field>
  </div>

  <Field for="locationDetails" label="Hinweis zum Ort / Treffpunkt">
    <textarea
      id="locationDetails"
      name="locationDetails"
      class:list={[input, 'min-h-26 resize-y']}
    >{v.locationDetails ?? ''}</textarea>
  </Field>

  <Field for="description" label="Beschreibung">
    <textarea
      id="description"
      name="description"
      rows="6"
      class:list={[input, 'resize-y']}
    >{v.description ?? ''}</textarea>
  </Field>

  <Field for="imageUrl" label="Bild-URL">
    <input id="imageUrl" name="imageUrl" type="url" value={v.imageUrl ?? ''} placeholder="https://…" class={input} />
  </Field>

  <label class="flex cursor-pointer items-center gap-3 text-base">
    <input
      type="checkbox"
      name="isPublished"
      checked={v.isPublished ?? false}
      class="size-5 shrink-0 cursor-pointer accent-accent"
    />
    <span>Veröffentlicht (öffentlich sichtbar)</span>
  </label>

  <button class:list={[button(), 'min-w-44 justify-self-start']} type="submit">
    Speichern
  </button>
</form>

{isEdit && (
  <section class="mt-10 border-t border-line pt-8">
    <h2 class="mb-2 text-2xl">Newsletter zu dieser Veranstaltung senden</h2>
    <p class="mb-4 max-w-[60ch] text-sm text-fg-muted">
      Geht als Kampagne an die <strong class="text-fg">öffentliche Newsletter-Liste</strong>&nbsp;– dieselbe Liste, in
      die sich Besucher über das Anmeldeformular eintragen. Unten steht ein fertiger Vorschlag, den du anpassen kannst.
      Titel, Datum, Ort und der Link zur Veranstaltung werden automatisch ergänzt; Anrede, Grußformel, Fußzeile und
      Abmeldelink kommen aus der listmonk-Vorlage.
    </p>
    <form id="newsletter-form" class:list={[panel, 'grid gap-5']} data-id={event?.id ?? ''}>
      <Field for="nl-subject" label="Betreff *">
        <input
          id="nl-subject"
          name="subject"
          type="text"
          value={`Einladung zum nächsten Männerkreis`}
          required
          class={input}
        />
      </Field>
      <Field for="nl-intro" label="Einleitungstext">
        <textarea id="nl-intro" name="intro" rows="8" set:text={nlIntro} class:list={[input, 'resize-y']} />
      </Field>
      <button class:list={[button({ variant: 'secondary' }), 'min-w-44 justify-self-start']} type="submit">
        Newsletter senden
      </button>
    </form>
  </section>
)}

<script>
  import { actions } from 'astro:actions';
  import { adminToast, bindOnce, ok } from '@lib/admin';

  bindOnce<HTMLFormElement>('#event-form', (form) => {
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const get = (k: string) => String(fd.get(k) ?? '');

      btn.disabled = true;
      btn.textContent = 'Speichern…';
      const result = await actions.saveEvent({
        id: form.dataset.id || undefined,
        title: get('title'),
        slug: get('slug'),
        description: get('description'),
        eventDate: get('eventDate'),
        startTime: get('startTime'),
        endTime: get('endTime'),
        location: get('location'),
        locationDetails: get('locationDetails'),
        street: get('street'),
        postalCode: get('postalCode'),
        city: get('city'),
        latitude: get('latitude'),
        longitude: get('longitude'),
        maxParticipants: get('maxParticipants'),
        costBasis: get('costBasis'),
        imageUrl: get('imageUrl'),
        isPublished: fd.get('isPublished') === 'on',
      });
      btn.disabled = false;
      btn.textContent = 'Speichern';
      if (!ok(result)) return;

      // A new event returns to the list; an edit stays, with confirmation.
      if (!form.dataset.edit) {
        window.location.href = '/admin';
        return;
      }
      adminToast('ok', result.data.message);
    });
  });

  bindOnce<HTMLFormElement>('#newsletter-form', (nlForm) => {
    const nlBtn = nlForm.querySelector('button[type="submit"]') as HTMLButtonElement;

    nlForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(nlForm);
      if (!confirm('Newsletter jetzt an die gesamte Newsletter-Liste senden?')) return;

      nlBtn.disabled = true;
      nlBtn.textContent = 'Senden…';
      const result = await actions.sendEventNewsletter({
        id: nlForm.dataset.id!,
        subject: String(fd.get('subject') ?? ''),
        intro: String(fd.get('intro') ?? ''),
      });
      nlBtn.disabled = false;
      nlBtn.textContent = 'Newsletter senden';
      if (!ok(result)) return;

      adminToast('ok', result.data.message);
    });
  });
</script>
