---
import { button, card } from '@lib/ui';
import Badge from '../ui/Badge.astro';
import AdminHead from './AdminHead.astro';
import CapacityRing from './CapacityRing.astro';

interface EventRow {
  id: string;
  title: string;
  slug: string;
  eventDate: string;
  startTime?: string;
  isPublished: boolean;
  maxParticipants: number;
  activeCount: number;
}
interface Props {
  events: EventRow[];
}
const { events } = Astro.props;

const publishedCount = events.filter((e) => e.isPublished).length;

function fmtDate(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  return d.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' });
}
---

<AdminHead eyebrow="Übersicht" title="Veranstaltungen">
  <a class={button()} href="/admin/events/new">
    Neue Veranstaltung
  </a>
</AdminHead>

{events.length > 0 && (
  <p class="-mt-4 mb-6 text-sm text-fg-muted tabular-nums">
    <span class="font-semibold text-accent">{events.length}</span> Veranstaltungen ·{' '}
    <span class="font-semibold text-accent">{publishedCount}</span> veröffentlicht
  </p>
)}

{events.length === 0 ? (
  <div class="grid justify-items-center gap-4 rounded-control border border-dashed border-line-strong px-4 py-12 text-center text-fg-muted">
    <p>Noch keine Veranstaltungen.</p>
    <a class={button({ variant: 'secondary', size: 'xs' })} href="/admin/events/new">
      Die erste anlegen
    </a>
  </div>
) : (
  <ul id="event-list" class="flex flex-col gap-3">
    {events.map((ev) => (
      <li
        data-id={ev.id}
        data-title={ev.title}
        class:list={[
          card,
          'flex flex-wrap items-center justify-between gap-x-5 gap-y-4 px-5 py-4 transition-[border-color,opacity,translate,height,padding,margin] duration-200 hover:border-line-strong data-[removing]:-mt-3 data-[removing]:h-0! data-[removing]:-translate-x-4 data-[removing]:overflow-hidden data-[removing]:py-0 data-[removing]:opacity-0',
        ]}
      >
        <a class="group/ev flex min-w-0 flex-[1_1_16rem] items-center gap-4" href={`/admin/events/${ev.id}`}>
          <CapacityRing value={ev.activeCount} max={ev.maxParticipants} />
          <span class="flex min-w-0 flex-col gap-0.5">
            <span class="font-serif text-lg text-fg transition-colors duration-150 group-hover/ev:text-accent">
              {ev.title}
            </span>
            <span class="truncate text-sm text-fg-muted tabular-nums">
              {fmtDate(ev.eventDate)}
              {ev.startTime ? ` · ${ev.startTime}` : ''} · /event/{ev.slug}
            </span>
          </span>
        </a>
        <div class="flex flex-wrap items-center justify-end gap-3 max-sm:w-full max-sm:justify-between">
          {ev.isPublished ? <Badge tone="live">veröffentlicht</Badge> : <Badge>Entwurf</Badge>}
          <div class="flex flex-wrap justify-end gap-1.5 max-sm:flex-[1_1_100%] max-sm:[&>*]:flex-auto">
            <a class={button({ variant: 'secondary', size: 'xs' })} href={`/admin/events/${ev.id}/registrations`}>
              Anmeldungen
            </a>
            <a class={button({ variant: 'secondary', size: 'xs' })} href={`/admin/events/new?from=${ev.id}`}>
              Duplizieren
            </a>
            <button class={button({ variant: 'danger', size: 'xs' })} type="button" data-delete>
              Löschen
            </button>
          </div>
        </div>
      </li>
    ))}
  </ul>
)}

<script>
  import { actions } from 'astro:actions';
  import { adminToast, bindOnce, ok } from '@lib/admin';

  bindOnce('#event-list', (list) => {
    list.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('[data-delete]') as HTMLButtonElement | null;
      if (!btn) return;
      const row = btn.closest('[data-id]') as HTMLElement;
      const { id, title } = row.dataset;
      if (!id || !confirm(`„${title}" wirklich löschen?`)) return;

      btn.disabled = true;
      if (!ok(await actions.deleteEvent({ id }))) {
        btn.disabled = false;
        return;
      }

      adminToast('ok', 'Veranstaltung gelöscht.');
      row.style.height = `${row.offsetHeight}px`;
      requestAnimationFrame(() => (row.dataset.removing = ''));
      setTimeout(() => row.remove(), 220);
    });
  });
</script>
