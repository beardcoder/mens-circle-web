---
import { Icon } from 'astro-icon/components';
import { button, panel } from '@lib/ui';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  redirect: string;
  /** `?error=` code from /auth/*, if the last attempt failed. */
  error?: string | null;
  /** False when the OIDC_* variables are missing — sign-in cannot work. */
  configured: boolean;
}
const { redirect, error, configured } = Astro.props;

const MESSAGES: Record<string, string> = {
  denied: 'Dieses Konto hat keinen Zugang zum Back-office.',
  cancelled: 'Die Anmeldung wurde abgebrochen.',
  rate: 'Zu viele Versuche. Bitte später erneut.',
  provider: 'Pocket ID ist gerade nicht erreichbar.',
  failed: 'Die Anmeldung ist fehlgeschlagen. Bitte erneut versuchen.',
  config: 'Die Anmeldung ist auf dem Server nicht eingerichtet.',
};
const message = configured ? error && (MESSAGES[error] ?? MESSAGES.failed) : MESSAGES.config;
---

<div class="grid w-[min(92vw,24rem)] gap-6">
  {/* The same wordmark as the bar, one size up. */}
  <p class="flex items-center gap-3">
    <Icon name="logo" aria-hidden="true" class="size-9 text-flame" />
    <span class="font-serif text-2xl">Männerkreis</span>
  </p>
  <div class:list={[panel, 'grid gap-5']}>
    <div class="grid gap-2">
      <Eyebrow>Back-office</Eyebrow>
      <h1 class="text-display-3">Anmeldung</h1>
    </div>
    {message && (
      <p role="alert" class="border-l-2 border-danger pl-3 text-danger">
        {message}
      </p>
    )}
    {configured && (
      <a class={button({ block: true })} href={`/auth/login?redirect=${encodeURIComponent(redirect)}`}>
        Mit Pocket ID anmelden
      </a>
    )}
  </div>
</div>
