---
interface Props {
  redirect: string;
  /** `?error=` code from /auth/*, if the last attempt failed. */
  error?: string | null;
  /** False when the OIDC_* variables are missing — sign-in cannot work. */
  configured: boolean;
}
const { redirect, error, configured } = Astro.props;

const MESSAGES: Record<string, string> = {
  denied: 'Dieses Konto hat keinen Zugang zum Back-office.',
  cancelled: 'Die Anmeldung wurde abgebrochen.',
  rate: 'Zu viele Versuche. Bitte später erneut.',
  provider: 'Pocket ID ist gerade nicht erreichbar.',
  failed: 'Die Anmeldung ist fehlgeschlagen. Bitte erneut versuchen.',
  config: 'Die Anmeldung ist auf dem Server nicht eingerichtet.',
};
const message = configured ? error && (MESSAGES[error] ?? MESSAGES.failed) : MESSAGES.config;
---

<div class="login">
  <div class="login__brand">
    <span class="login__ring" aria-hidden="true"></span>
    männerkreis
  </div>
  <div class="card login__card">
    <p class="eyebrow">Back-office</p>
    <h1>Anmeldung</h1>
    {message && (
      <p class="login__error" role="alert">
        {message}
      </p>
    )}
    {configured && (
      <a class="btn btn--block" href={`/auth/login?redirect=${encodeURIComponent(redirect)}`}>
        Mit Pocket ID anmelden
      </a>
    )}
  </div>
</div>

<style>
  .login {
    width: min(92vw, 24rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  /* Same wordmark as the topbar's `.brand`, one size up. It was set lowercase
     and tight while the bar above was uppercase — two spellings of one name. */
  .login__brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  .login__ring {
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    border: 3px solid var(--ember);
  }
  .login__card h1 {
    margin: 0.25rem 0 1.25rem;
  }
  .login__error {
    margin: 0 0 1.25rem;
    color: var(--danger);
  }
</style>
