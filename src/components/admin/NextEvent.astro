---
import { button } from '@lib/ui';
import Badge from '../ui/Badge.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import CircleSeating from './CircleSeating.astro';

type Status = 'registered' | 'waitlist' | 'cancelled' | 'attended';
interface Person {
  firstName: string;
  lastName: string;
  status: Status;
}
interface NextEventData {
  id: string;
  title: string;
  eventDate: string;
  startTime?: string;
  endTime?: string;
  location?: string;
  maxParticipants: number;
  activeCount: number;
}
interface Props {
  event: NextEventData;
  people: Person[];
}
const { event, people } = Astro.props;

const registered = people.filter((p) => p.status === 'registered' || p.status === 'attended');
const waitlist = people.filter((p) => p.status === 'waitlist');

const name = (p: Person) => `${p.firstName} ${p.lastName}`.trim();
const initials = (p: Person) => `${p.firstName[0] ?? ''}${p.lastName[0] ?? ''}`.toUpperCase() || '·';
const seats = registered.map((p) => ({ initials: initials(p), name: name(p) }));

const dateLong = (() => {
  const d = new Date(event.eventDate);
  if (Number.isNaN(d.getTime())) return event.eventDate;
  return d.toLocaleDateString('de-DE', {
    weekday: 'long',
    day: '2-digit',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
})();
const timeStr = event.startTime ? `${event.startTime}${event.endTime ? `–${event.endTime}` : ''} Uhr` : '';
---

{/* The one panel that outranks everything under it. */}
<section class="mb-10 rounded-control border border-t-4 border-line-strong border-t-accent bg-raised p-[clamp(1.1rem,3vw,1.6rem)]">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-4">
    <Eyebrow>Nächstes Event · Planung</Eyebrow>
    <a class={button({ size: 'xs' })} href={`/admin/events/${event.id}/registrations`}>
      Anmeldungen verwalten
    </a>
  </div>

  <div class="grid gap-1 border-b border-line pb-4">
    <a
      class="font-serif text-[clamp(1.375rem,1rem+1vw,1.75rem)] leading-tight text-fg transition-colors duration-150 hover:text-accent"
      href={`/admin/events/${event.id}`}
    >
      {event.title}
    </a>
    <p class="text-sm text-fg-muted tabular-nums">
      {dateLong}
      {timeStr && <span> · {timeStr}</span>}
      {event.location && <span> · {event.location}</span>}
    </p>
  </div>

  <div class="grid items-center gap-8 pt-5 sm:grid-cols-[minmax(0,280px)_1fr]">
    <CircleSeating seats={seats} capacity={event.maxParticipants} />

    <div class="grid gap-x-8 gap-y-6 self-start sm:grid-cols-[repeat(auto-fit,minmax(180px,1fr))]">
      <div>
        <p class="mb-2 flex items-baseline gap-2 text-xs font-semibold tracking-label text-fg-muted uppercase">
          Angemeldet
          <span class="tracking-normal text-accent tabular-nums">
            {registered.length}/{event.maxParticipants}
          </span>
        </p>
        {registered.length === 0 ? (
          <p class="text-sm text-fg-muted">Noch niemand angemeldet.</p>
        ) : (
          <ol>
            {registered.map((p, i) => (
              <li class="flex items-center gap-3 border-b border-line py-1.5 last:border-b-0">
                <span class="text-xs text-fg-muted tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-sm">{name(p)}</span>
                {p.status === 'attended' && (
                  <Badge tone="live" class="ml-auto">
                    da
                  </Badge>
                )}
              </li>
            ))}
          </ol>
        )}
      </div>

      {waitlist.length > 0 && (
        <div>
          <p class="mb-2 flex items-baseline gap-2 text-xs font-semibold tracking-label text-fg-muted uppercase">
            Warteliste <span class="tracking-normal text-accent tabular-nums">{waitlist.length}</span>
          </p>
          <ol>
            {waitlist.map((p, i) => (
              <li class="flex items-center gap-3 border-b border-line py-1.5 last:border-b-0">
                <span class="text-xs text-fg-muted tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-sm text-fg-muted">{name(p)}</span>
              </li>
            ))}
          </ol>
        </div>
      )}
    </div>
  </div>
</section>
