---
import { button, card, control, panel } from '@lib/ui';
import Badge from '../ui/Badge.astro';
import Field from '../ui/Field.astro';
import AdminHead from './AdminHead.astro';
import CapacityRing from './CapacityRing.astro';

type Status = 'registered' | 'waitlist' | 'cancelled' | 'attended';
interface Reg {
  id: string;
  status: Status;
  registeredAt: string | null;
  confirmationSentAt: string | null;
  firstName: string;
  lastName: string;
  email: string;
  phone: string;
}
interface Props {
  eventId: string;
  eventTitle: string;
  maxParticipants: number;
  registrations: Reg[];
}
const { eventId, eventTitle, maxParticipants, registrations } = Astro.props;

const STATUS_LABEL: Record<Status, string> = {
  registered: 'Angemeldet',
  waitlist: 'Warteliste',
  cancelled: 'Storniert',
  attended: 'Teilgenommen',
};
const activeCount = registrations.filter((r) => r.status === 'registered' || r.status === 'attended').length;
const waitlistCount = registrations.filter((r) => r.status === 'waitlist').length;
/** Seats that should hold a confirmation but do not — the "fehlende" target. */
const missingConfirmation = registrations.filter(
  (r) => (r.status === 'registered' || r.status === 'waitlist') && !r.confirmationSentAt,
).length;

function fmt(iso: string | null): string {
  if (!iso) return '–';
  const d = new Date(iso);
  return Number.isNaN(d.getTime()) ? '–' : d.toLocaleString('de-DE', { dateStyle: 'short', timeStyle: 'short' });
}
function badgeTone(s: Status): 'live' | 'wait' | 'off' {
  if (s === 'registered' || s === 'attended') return 'live';
  if (s === 'waitlist') return 'wait';
  return 'off';
}
---

<AdminHead eyebrow="Anmeldungen" title={eventTitle}>
  <a class={button({ variant: 'secondary' })} href="/admin">
    Zurück
  </a>
</AdminHead>

<div class:list={[card, 'mb-6 flex items-center gap-5 p-5']}>
  <CapacityRing value={activeCount} max={maxParticipants} size={76} stroke={6} />
  <div class="grid gap-1">
    <p>
      <span class="text-lg font-semibold text-accent tabular-nums">{activeCount}</span> von
      <span class="tabular-nums">{maxParticipants}</span> Plätzen belegt
    </p>
    <p class="text-fg-muted">
      <span class="text-lg font-semibold text-accent tabular-nums">{waitlistCount}</span> auf der Warteliste
    </p>
  </div>
</div>

<section
  id="confirmations"
  class:list={[card, 'mb-8 flex flex-wrap items-center justify-between gap-5 p-5']}
  data-event={eventId}
>
  <div class="grid gap-1">
    <h2 class="text-xl">Anmeldebestätigungen</h2>
    <p class="max-w-[52ch] text-sm text-fg-muted">
      {missingConfirmation > 0 ? (
        <Fragment>
          Bei <strong class="text-fg">{missingConfirmation}</strong> Anmeldung{missingConfirmation === 1 ? '' : 'en'}{' '}
          ist keine Bestätigung nachgewiesen.
        </Fragment>
      ) : (
        'Für alle aktiven Anmeldungen ist eine Bestätigung nachgewiesen.'
      )}{' '}
      Der Versand geht nur an die Teilnehmer:innen, nicht an die Admin-Adresse.
    </p>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <button class={button({ size: 'sm' })} type="button" data-resend-missing disabled={missingConfirmation === 0}>
      Fehlende senden
    </button>
    <button
      class={button({ variant: 'secondary', size: 'sm' })}
      type="button"
      data-resend-all
      disabled={registrations.length === 0}
    >
      Alle erneut senden
    </button>
  </div>
</section>

{registrations.length === 0 ? (
  <div class="mb-10 rounded-control border border-dashed border-line-strong px-4 py-12 text-center text-fg-muted">
    Noch keine Anmeldungen.
  </div>
) : (
  <ul id="reg-list" class="mb-10 flex flex-col gap-3" data-event={eventId}>
    {registrations.map((reg) => (
      <li class:list={[card, 'grid gap-2 px-5 py-4']} data-id={reg.id} data-name={`${reg.firstName} ${reg.lastName}`}>
        <div class="flex items-center justify-between gap-3">
          <span class="font-serif text-lg">
            {reg.firstName} {reg.lastName}
          </span>
          <Badge tone={badgeTone(reg.status)}>{STATUS_LABEL[reg.status]}</Badge>
        </div>
        <div class="min-w-0 text-sm break-words text-fg-muted">
          <a href={`mailto:${reg.email}`} class="underline decoration-line-strong underline-offset-2 hover:text-fg">
            {reg.email}
          </a>
          {reg.phone && <span> · {reg.phone}</span>}
        </div>
        <div class="mt-1 flex flex-wrap items-center justify-between gap-3">
          <span class="text-xs text-fg-muted tabular-nums">
            angemeldet {fmt(reg.registeredAt)}
            {reg.confirmationSentAt ? (
              <span> · Bestätigung {fmt(reg.confirmationSentAt)}</span>
            ) : (
              (reg.status === 'registered' || reg.status === 'waitlist') && (
                <span class="text-accent"> · keine Bestätigung gesendet</span>
              )
            )}
          </span>
          <div class="flex flex-wrap items-center gap-2 max-sm:w-full">
            {(reg.status === 'registered' || reg.status === 'waitlist') && (
              <button class={button({ variant: 'secondary', size: 'xs' })} type="button" data-resend-one>
                Bestätigung senden
              </button>
            )}
            <select
              data-status-select
              aria-label={`Status von ${reg.firstName} ${reg.lastName} ändern`}
              class:list={[control('xs'), 'max-sm:flex-1']}
            >
              <option value="registered" selected={reg.status === 'registered'}>
                Angemeldet
              </option>
              <option value="waitlist" selected={reg.status === 'waitlist'}>
                Warteliste
              </option>
              <option value="attended" selected={reg.status === 'attended'}>
                Teilgenommen
              </option>
              <option value="cancelled" selected={reg.status === 'cancelled'}>
                Storniert
              </option>
            </select>
            <button class={button({ variant: 'danger', size: 'xs' })} type="button" data-delete>
              Entfernen
            </button>
          </div>
        </div>
      </li>
    ))}
  </ul>
)}

<section>
  <h2 class="mb-2 text-2xl">Nachricht an Teilnehmer:innen</h2>
  <p class="mb-4 text-sm text-fg-muted">
    Geht per E-Mail an alle <strong class="text-fg">angemeldeten</strong> Teilnehmer:innen. Platzhalter
    <code class="rounded-control bg-ground px-1.5 py-0.5 text-[0.9em] text-accent">{'{first_name}'}</code> wird durch
    den Vornamen ersetzt.
  </p>
  <form id="broadcast-form" class:list={[panel, 'grid gap-5']} data-event={eventId}>
    <Field for="msg-subject" label="Betreff">
      <input id="msg-subject" name="subject" type="text" class={control('sm')} />
    </Field>
    <Field for="msg-content" label="Nachricht">
      <textarea id="msg-content" name="content" rows="6" class:list={[control('sm'), 'resize-y']}></textarea>
    </Field>
    <button class:list={[button(), 'justify-self-start']} type="submit">
      Nachricht senden
    </button>
  </form>
</section>

<script>
  import { actions } from 'astro:actions';
  import { adminToast, bindOnce, ok } from '@lib/admin';

  bindOnce('#reg-list', (list) => {
    list.addEventListener('change', async (e) => {
      const sel = (e.target as HTMLElement).closest('[data-status-select]') as HTMLSelectElement | null;
      if (!sel) return;
      const row = sel.closest('[data-id]') as HTMLElement;
      const status = sel.value as 'registered' | 'waitlist' | 'cancelled' | 'attended';

      sel.disabled = true;
      const result = await actions.setRegistrationStatus({ id: row.dataset.id!, status });
      sel.disabled = false;
      if (!ok(result)) return;

      adminToast('ok', 'Status aktualisiert.');
      // A cancellation can promote someone from the waitlist.
      if (status === 'cancelled') setTimeout(() => window.location.reload(), 700);
    });

    list.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('[data-resend-one]') as HTMLButtonElement | null;
      if (!btn) return;
      const row = btn.closest('[data-id]') as HTMLElement;
      const { id, name } = row.dataset;
      if (!id || !confirm(`Anmeldebestätigung an ${name} senden?`)) return;

      btn.disabled = true;
      btn.textContent = 'Senden…';
      const result = await actions.resendConfirmations({ eventId: list.dataset.event!, ids: [id] });
      btn.disabled = false;
      btn.textContent = 'Bestätigung senden';
      if (!ok(result)) return;

      adminToast(result.data.sent > 0 ? 'ok' : 'err', result.data.message);
      if (result.data.sent > 0) setTimeout(() => window.location.reload(), 700);
    });

    list.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('[data-delete]') as HTMLButtonElement | null;
      if (!btn) return;
      const row = btn.closest('[data-id]') as HTMLElement;
      const { id, name } = row.dataset;
      if (!id || !confirm(`Anmeldung von ${name} entfernen?`)) return;

      btn.disabled = true;
      if (!ok(await actions.deleteRegistration({ id }))) {
        btn.disabled = false;
        return;
      }

      adminToast('ok', 'Anmeldung entfernt.');
      row.remove();
    });
  });

  bindOnce('#confirmations', (confirmBar) => {
    const eventId = confirmBar.dataset.event!;

    const run = async (btn: HTMLButtonElement, onlyMissing: boolean) => {
      const label = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Senden…';
      const result = await actions.resendConfirmations({ eventId, onlyMissing });
      btn.disabled = false;
      btn.textContent = label;
      if (!ok(result)) return;

      adminToast(result.data.failed > 0 ? 'err' : 'ok', result.data.message);
      if (result.data.sent > 0) setTimeout(() => window.location.reload(), 1200);
    };

    confirmBar.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const missing = target.closest('[data-resend-missing]') as HTMLButtonElement | null;
      if (missing) {
        void run(missing, true);
        return;
      }

      const all = target.closest('[data-resend-all]') as HTMLButtonElement | null;
      if (!all) return;
      if (!confirm('Bestätigung an ALLE angemeldeten und wartenden Teilnehmer:innen erneut senden?')) return;
      void run(all, false);
    });
  });

  bindOnce<HTMLFormElement>('#broadcast-form', (form) => {
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);

      btn.disabled = true;
      btn.textContent = 'Senden…';
      const result = await actions.sendEventMessage({
        id: form.dataset.event!,
        subject: String(fd.get('subject') ?? ''),
        content: String(fd.get('content') ?? ''),
      });
      btn.disabled = false;
      btn.textContent = 'Nachricht senden';
      if (!ok(result)) return;

      adminToast('ok', result.data.message);
      form.reset();
    });
  });
</script>
