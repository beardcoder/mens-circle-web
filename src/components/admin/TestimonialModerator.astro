---
import { button, card, control } from '@lib/ui';
import Badge from '../ui/Badge.astro';
import Field from '../ui/Field.astro';
import AdminHead from './AdminHead.astro';

interface Testimonial {
  id: string;
  quote: string;
  authorName: string;
  role: string;
  email: string;
  isPublished: boolean;
  sortOrder: number;
  createdAt: string;
}
interface Props {
  testimonials: Testimonial[];
}
const { testimonials } = Astro.props;
---

<AdminHead eyebrow="Moderation" title="Stimmen" />

{testimonials.length === 0 ? (
  <div class="rounded-control border border-dashed border-line-strong px-4 py-12 text-center text-fg-muted">
    Noch keine Einreichungen.
  </div>
) : (
  <ul id="testi-list" class="flex flex-col gap-4">
    {testimonials.map((t) => (
      <li class:list={[card, 'grid gap-4 p-5']} data-id={t.id} data-published={t.isPublished ? '1' : ''}>
        <div data-view>
          <blockquote data-quote class="border-l-2 border-accent pl-4 text-lg leading-normal text-fg">
            {t.quote}
          </blockquote>
          <div class="mt-3 text-sm text-fg-muted">
            <strong data-author class="font-semibold text-fg">
              {t.authorName}
            </strong>
            <span data-role>{t.role ? ` · ${t.role}` : ''}</span>
            <span data-email>{t.email ? ` · ${t.email}` : ''}</span>
          </div>
        </div>

        <form data-edit hidden class="grid gap-4">
          <Field for={`quote-${t.id}`} label="Zitat">
            {/* prettier-ignore */}
            <textarea id={`quote-${t.id}`} name="quote" rows="4" class:list={[control('sm'), 'resize-y']}>{t.quote}</textarea>
          </Field>
          <div class="grid gap-4 sm:grid-cols-2">
            <Field for={`author-${t.id}`} label="Name">
              <input id={`author-${t.id}`} name="authorName" type="text" value={t.authorName} class={control('sm')} />
            </Field>
            <Field for={`role-${t.id}`} label="Rolle">
              <input id={`role-${t.id}`} name="role" type="text" value={t.role} class={control('sm')} />
            </Field>
          </div>
          <Field for={`email-${t.id}`} label="E-Mail">
            <input id={`email-${t.id}`} name="email" type="email" value={t.email} class={control('sm')} />
          </Field>
          <div class="flex gap-2">
            <button class={button({ size: 'xs' })} type="submit">
              Speichern
            </button>
            <button class={button({ variant: 'secondary', size: 'xs' })} type="button" data-cancel>
              Abbrechen
            </button>
          </div>
        </form>

        <div data-controls class="flex flex-wrap items-center gap-4 border-t border-line pt-3">
          <Badge tone={t.isPublished ? 'live' : 'off'} data-badge>
            {t.isPublished ? 'veröffentlicht' : 'unsichtbar'}
          </Badge>
          <label class="flex items-center gap-2 text-sm text-fg-muted">
            Reihenfolge
            <input data-order type="number" value={t.sortOrder} class:list={[control('xs'), 'max-w-18 tabular-nums']} />
          </label>
          <div class="ml-auto flex flex-wrap gap-1.5">
            <button class={button({ variant: 'secondary', size: 'xs' })} type="button" data-edit-button>
              Bearbeiten
            </button>
            <button class={button({ variant: 'secondary', size: 'xs' })} type="button" data-toggle>
              {t.isPublished ? 'Verbergen' : 'Veröffentlichen'}
            </button>
            <button class={button({ variant: 'danger', size: 'xs' })} type="button" data-delete>
              Löschen
            </button>
          </div>
        </div>
      </li>
    ))}
  </ul>
)}

<script>
  import { actions } from 'astro:actions';
  import { adminToast, bindOnce, ok } from '@lib/admin';

  function setEditing(card: HTMLElement, on: boolean) {
    (card.querySelector('[data-view]') as HTMLElement).hidden = on;
    (card.querySelector('[data-controls]') as HTMLElement).hidden = on;
    (card.querySelector('[data-edit]') as HTMLElement).hidden = !on;
  }

  async function togglePublish(card: HTMLElement, toggle: HTMLButtonElement) {
    const publish = !card.dataset.published;
    toggle.disabled = true;
    const result = await actions.moderateTestimonial({ id: card.dataset.id!, publish });
    toggle.disabled = false;
    if (!ok(result)) return;

    card.dataset.published = publish ? '1' : '';
    toggle.textContent = publish ? 'Verbergen' : 'Veröffentlichen';
    const badge = card.querySelector('[data-badge]') as HTMLElement;
    badge.textContent = publish ? 'veröffentlicht' : 'unsichtbar';
    badge.dataset.tone = publish ? 'live' : 'off';
    adminToast('ok', publish ? 'Veröffentlicht.' : 'Verborgen.');
  }

  async function removeCard(card: HTMLElement) {
    if (!confirm('Diese Stimme wirklich löschen?')) return;
    if (!ok(await actions.deleteTestimonial({ id: card.dataset.id! }))) return;
    adminToast('ok', 'Gelöscht.');
    card.remove();
  }

  bindOnce('#testi-list', (list) => {
    list.addEventListener('change', async (e) => {
      const input = (e.target as HTMLElement).closest('[data-order]') as HTMLInputElement | null;
      if (!input) return;
      const id = (input.closest('[data-id]') as HTMLElement).dataset.id!;
      if (!ok(await actions.moderateTestimonial({ id, sortOrder: Number(input.value) || 0 }))) return;
      adminToast('ok', 'Reihenfolge gespeichert.');
    });

    list.addEventListener('submit', async (e) => {
      const form = (e.target as HTMLElement).closest('[data-edit]') as HTMLFormElement | null;
      if (!form) return;
      e.preventDefault();
      const card = form.closest('[data-id]') as HTMLElement;
      const fd = new FormData(form);
      const get = (k: string) => String(fd.get(k) ?? '');
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const payload = {
        id: card.dataset.id!,
        quote: get('quote'),
        authorName: get('authorName'),
        role: get('role'),
        email: get('email'),
      };

      btn.disabled = true;
      const result = await actions.updateTestimonial(payload);
      btn.disabled = false;
      if (!ok(result)) return;

      (card.querySelector('[data-quote]') as HTMLElement).textContent = payload.quote;
      (card.querySelector('[data-author]') as HTMLElement).textContent = payload.authorName;
      (card.querySelector('[data-role]') as HTMLElement).textContent = payload.role ? ` · ${payload.role}` : '';
      (card.querySelector('[data-email]') as HTMLElement).textContent = payload.email ? ` · ${payload.email}` : '';
      setEditing(card, false);
      adminToast('ok', 'Stimme gespeichert.');
    });

    // One delegated listener that only routes; each branch owns its own work.
    list.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      const card = target.closest('[data-id]') as HTMLElement | null;
      if (!card) return;

      if (target.closest('[data-edit-button]')) {
        setEditing(card, true);
        (card.querySelector('[data-edit] textarea') as HTMLTextAreaElement)?.focus();
        return;
      }
      if (target.closest('[data-cancel]')) {
        (card.querySelector('[data-edit]') as HTMLFormElement).reset();
        setEditing(card, false);
        return;
      }

      const toggle = target.closest('[data-toggle]') as HTMLButtonElement | null;
      if (toggle) {
        await togglePublish(card, toggle);
        return;
      }
      if (target.closest('[data-delete]')) await removeCard(card);
    });
  });
</script>
