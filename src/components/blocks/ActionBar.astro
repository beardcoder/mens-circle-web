---
import { button } from '@lib/ui';

import type { PublicEvents } from '../event/types';

interface Props {
  events: PublicEvents | null;
}

const { events } = Astro.props;
const next = events?.events[0];
const action = next?.view.action;
const date = next?.view.title.join(' ').replace(/,$/, '');
---

{
  /* On phones, like an app's bottom bar: once the opening's action has scrolled away,
     the next date and its action stay at hand. It steps back where the dates or the
     footer are on screen, and never shows on the desktop or without a date. */
  action && date && (
    <div
      data-action-bar
      aria-hidden="true"
      inert
      class="fixed inset-x-0 bottom-0 z-30 translate-y-full border-t border-line bg-ground/90 px-gutter pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur-xl data-[visible]:translate-y-0 lg:hidden print:hidden"
    >
      <div class="mx-auto flex max-w-page items-center gap-4">
        <p data-action-bar-item class="min-w-0 flex-1">
          <span class="block text-xs font-semibold text-fg-muted">Nächster Termin</span>
          <span class="block truncate font-display text-lg text-fg">{date}</span>
        </p>
        <a
          href={action.href}
          data-action-bar-item
          class:list={[button({ size: 'sm' }), 'shrink-0']}
          tabindex="-1"
          data-umami-event="cta-click"
          data-umami-event-location="home-action-bar"
        >
          {action.label}
        </a>
      </div>
    </div>
  )
}

<script>
  import { spring, stagger } from 'motion';
  import { animate } from 'motion/mini';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const glide = { type: spring, visualDuration: 0.5, bounce: 0 } as const;

  /**
   * Shows the bar while neither the opening's action nor the dates nor the footer is
   * in view. It glides up on a spring and its date and action follow a beat later;
   * it slips away faster than it came. Under reduced motion it simply appears.
   */
  function initActionBar(): void {
    const bar = document.querySelector<HTMLElement>('[data-action-bar]');

    const watched = [
      ...document.querySelectorAll<HTMLElement>(
        '[data-hero] a[data-umami-event-location="home-hero"], #termine, footer',
      ),
    ];

    if (!bar || watched.length === 0) return;

    const items = bar.querySelectorAll('[data-action-bar-item]');
    const onScreen = new Set<Element>();
    let shown = false;

    if (!reduced.matches) bar.style.transform = 'translateY(100%)';

    const move = (show: boolean): void => {
      if (reduced.matches) {
        bar.toggleAttribute('data-visible', show);

        return;
      }

      if (show) {
        bar.setAttribute('data-visible', '');
        animate(bar, { transform: 'none' }, glide);
        animate(
          items,
          { opacity: [0, 1], transform: ['translateY(0.5rem)', 'none'] },
          { ...glide, delay: stagger(0.06, { startDelay: 0.1 }) },
        );

        return;
      }

      void animate(bar, { transform: 'translateY(100%)' }, { duration: 0.25, ease: 'easeIn' }).then(() => {
        if (!shown) bar.removeAttribute('data-visible');
      });
    };

    const render = (): void => {
      const show = onScreen.size === 0 && window.scrollY > 200;

      if (show === shown) return;

      shown = show;
      move(show);
      bar.toggleAttribute('inert', !show);
      bar.setAttribute('aria-hidden', String(!show));

      for (const link of bar.querySelectorAll('a')) link.tabIndex = show ? 0 : -1;

      document.documentElement.toggleAttribute('data-action-bar-open', show);
    };

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) onScreen.add(entry.target);
        else onScreen.delete(entry.target);
      }

      render();
    });

    for (const element of watched) observer.observe(element);
  }

  initActionBar();
</script>
