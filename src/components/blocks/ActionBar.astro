---
import { button } from '@lib/ui';

import type { PublicEvents } from '../event/types';

interface Props {
  events: PublicEvents | null;
}

const { events } = Astro.props;
const next = events?.events[0];
const action = next?.view.action;
const date = next?.view.title.join(' ').replace(/,$/, '');
---

{
  /* On phones, like an app's bottom bar: once the opening's action has scrolled away,
     the next date and its action stay at hand. It steps back where the dates or the
     footer are on screen, and never shows on the desktop or without a date. Its
     movement follows the scroll where the browser can (global.css, "Motion: scroll"). */
  action && date && (
    <div
      data-action-bar
      aria-hidden="true"
      inert
      class="pointer-events-none fixed inset-x-0 bottom-0 z-30 translate-y-full transition-transform duration-500 ease-(--ease-spring) data-[visible]:translate-y-0 motion-reduce:transition-none lg:hidden print:hidden"
    >
      {/* Three layers, one movement each (the opening's action, the dates, the footer):
          a single element with three added animations would leave the compositor. */}
      <div data-bar-dates>
        <div
          data-bar-footer
          class="pointer-events-auto border-t border-line bg-ground/95 px-gutter pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))]"
        >
          <div class="mx-auto flex max-w-page items-center gap-4">
            <p class="min-w-0 flex-1">
              <span class="block text-xs font-semibold text-fg-muted">Nächster Termin</span>
              <span class="block truncate font-display text-lg text-fg">{date}</span>
            </p>
            <a
              href={action.href}
              class:list={[button({ size: 'sm' }), 'shrink-0']}
              tabindex="-1"
              data-umami-event="cta-click"
              data-umami-event-location="home-action-bar"
            >
              {action.label}
            </a>
          </div>
        </div>
      </div>
    </div>
  )
}

<script>
  /**
   * The bar is at hand while neither the opening's action nor the dates nor the
   * footer is in view. Where the browser has scroll-driven animations the scroll
   * itself moves it (global.css, "Motion: scroll"): it rises and sinks with the
   * page. Elsewhere, and under reduced motion, CSS glides it on the attribute set
   * here. In both cases this observer says whether it can be reached: `inert`,
   * `aria-hidden` and the link's tab stop.
   */
  const bar = document.querySelector<HTMLElement>('[data-action-bar]');
  const action = document.querySelector('[data-hero-action]');

  if (bar && action) {
    /** What keeps the bar away: the dates and the footer while on screen, the opening's action until it has gone under the bar. */
    const holding = new Set<Element>();

    const update: IntersectionObserverCallback = (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) holding.add(entry.target);
        else holding.delete(entry.target);
      }

      const show = holding.size === 0;

      if (show === bar.hasAttribute('data-visible')) return;

      bar.toggleAttribute('data-visible', show);
      bar.toggleAttribute('inert', !show);
      bar.setAttribute('aria-hidden', String(!show));

      for (const link of bar.querySelectorAll('a')) link.tabIndex = show ? 0 : -1;
    };

    // The fixed bar is 72px (--spacing-header): what is under it is gone.
    const below = new IntersectionObserver(update, { rootMargin: '-72px 0px 0px 0px' });

    for (const element of document.querySelectorAll('#termine, #footer')) below.observe(element);

    // The action holds the bar until it has been passed, wherever it is below the bar:
    // the root reaches far past the window's lower edge, so an action under the fold
    // (a short window) and a jump straight past it (an anchor link) both count.
    new IntersectionObserver(update, { rootMargin: '-72px 0px 100000px 0px' }).observe(action);
  }
</script>
