---
import SeatRing from '../SeatRing.astro';

interface Props {
  data: {
    anchor?: string;
    title?: string;
    text?: string;
    buttonText?: string;
    buttonLink?: string;
    secondaryLabel?: string;
    secondaryLink?: string;
  };
}

/** A closing invitation on a sub-page: on rust, the colour of every way in. */

const { data } = Astro.props;
---

<section class="section section--rust section--clip cta-section" id={data.anchor}>
  <div class="container bay">
    <div class="cta__body">
      {data.title && <h2 class="cta__title" set:html={data.title} />}
      {data.text && <p class="cta__text">{data.text}</p>}

      {data.buttonText && data.buttonLink && (
        <p class="actions">
          <a
            href={data.buttonLink}
            class="btn btn--primary btn--large"
            data-umami-event="cta-click"
            data-umami-event-location="cta-block"
            data-umami-event-text={data.buttonText}
          >
            {data.buttonText}
          </a>

          {data.secondaryLabel && data.secondaryLink && (
            <a href={data.secondaryLink} class="text-link">
              {data.secondaryLabel}
            </a>
          )}
        </p>
      )}
    </div>

    <SeatRing class="cta__seats" seats={12} open={[7]} turn />
  </div>
</section>

<style is:global>
  @layer sections {
    .cta__body {
      grid-column: 1 / span 7;
      align-self: center;
    }

    .cta__title {
      max-inline-size: 16ch;
      margin-block-end: var(--space-md);
      font-size: var(--step-4);
      color: var(--text-primary);
    }

    .cta__text {
      max-inline-size: 40ch;
      margin-block-end: var(--space-lg);
      font-family: var(--font-body);
      font-size: var(--step-1);
      line-height: 1.5;
      color: var(--text-secondary);
    }

    .cta__seats {
      grid-column: 9 / -1;
      inline-size: min(100%, 24rem);
      justify-self: end;
    }

    @media (width <= 56em) {
      .cta__seats {
        inline-size: 10rem;
        margin-block-start: var(--space-lg);
        justify-self: start;
      }
    }

    @media (width <= 480px) {
      .cta-section .actions {
        flex-direction: column;
        align-items: stretch;
      }

      .cta-section .btn {
        inline-size: 100%;
      }

      .cta-section .text-link {
        align-self: center;
      }
    }
  }
</style>
