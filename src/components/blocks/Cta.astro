---
import Button from '../ui/Button.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import TextLink from '../ui/TextLink.astro';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    text?: string;
    buttonText?: string;
    buttonLink?: string;
    secondaryLabel?: string;
    secondaryLink?: string;
  };
}

/** A closing invitation on a sub-page, on the flame field: one action, one optional quiet link. */

const { data } = Astro.props;
---

<Section id={data.anchor} ground="flame">
  <SectionHead eyebrow={data.eyebrow} title={data.title} titleHtml tone="fg" class="max-w-[46rem]" />

  {data.text && <p class="mt-6 max-w-[46ch] text-lg font-medium text-fg">{data.text}</p>}

  {data.buttonText && data.buttonLink && (
    <p class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 max-sm:flex-col max-sm:items-stretch">
      <Button
        href={data.buttonLink}
        size="lg"
        data-umami-event="cta-click"
        data-umami-event-location="cta-block"
        data-umami-event-text={data.buttonText}
      >
        {data.buttonText}
      </Button>

      {data.secondaryLabel && data.secondaryLink && (
        <TextLink href={data.secondaryLink} class="max-sm:self-start">
          {data.secondaryLabel}
        </TextLink>
      )}
    </p>
  )}
</Section>
