---
interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    text?: string;
    buttonText?: string;
    buttonLink?: string;
    secondaryLabel?: string;
    secondaryLink?: string;
  };
}

/**
 * A closing invitation on a sub-page. One action, one optional quiet link.
 *
 * Used only by the Haltung page now — the home page closes with its own Termine
 * block, which knows the actual scheduling state. It used to be a centred block
 * on a separate ground with two breathing circle ornaments behind it.
 */

const { data } = Astro.props;
---

<section class="section section--ruled cta-section" id={data.anchor}>
  <div class="container">
    <div class="spine">
      {data.eyebrow && <p class="rail-heading">{data.eyebrow}</p>}

      <div class="spine__body" data-reveal-group="55">
        {data.title && <h2 class="cta__title" data-reveal="up" set:html={data.title} />}

        {
          data.text && (
            <p class="cta__text" data-reveal="up">
              {data.text}
            </p>
          )
        }

        {
          data.buttonText && data.buttonLink && (
            <p class="actions" data-reveal="up">
              <a
                href={data.buttonLink}
                class="btn btn--primary btn--large"
                data-umami-event="cta-click"
                data-umami-event-location="cta-block"
                data-umami-event-text={data.buttonText}
              >
                {data.buttonText}
              </a>

              {data.secondaryLabel && data.secondaryLink && (
                <a href={data.secondaryLink} class="text-link">
                  {data.secondaryLabel}
                </a>
              )}
            </p>
          )
        }
      </div>
    </div>
  </div>
</section>

<style is:global>
  @layer sections {
    .cta__title {
      margin-block-end: var(--space-sm);
      font-size: var(--text-3xl);
      line-height: 1.15;
      text-wrap: balance;
    }

    .cta__text {
      max-inline-size: var(--measure);
      margin-block-end: var(--space-md);
      font-size: var(--text-section-body-lg);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
    }

    @media (width <= 480px) {
      .cta-section .actions {
        flex-direction: column;
        align-items: stretch;
      }

      .cta-section .btn {
        inline-size: 100%;
      }

      .cta-section .text-link {
        justify-content: center;
      }
    }
  }
</style>
