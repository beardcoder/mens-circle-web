---
import Button from '../ui/Button.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import TextLink from '../ui/TextLink.astro';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    text?: string;
    buttonText?: string;
    buttonLink?: string;
    secondaryLabel?: string;
    secondaryLink?: string;
  };
}

/** The one closing invitation of a sub-page: a compact band on the secondary ground, a short head, one action, an optional quiet link. */

const { data } = Astro.props;
---

<Section id={data.anchor} ground="alt" space="band" innerClass="grid items-end gap-x-grid gap-y-6 py-4 lg:grid-cols-12">
  <SectionHead eyebrow={data.eyebrow} title={data.title} titleHtml lead={data.text} size="sub" class="lg:col-span-8" />

  {data.buttonText && data.buttonLink && (
    <p class="flex flex-wrap items-center gap-x-6 gap-y-2 lg:col-span-4 lg:justify-end">
      <Button
        href={data.buttonLink}
        size="lg"
        data-umami-event="cta-click"
        data-umami-event-location="cta-block"
        data-umami-event-text={data.buttonText}
      >
        {data.buttonText}
      </Button>
      {data.secondaryLabel && data.secondaryLink && (
        <TextLink href={data.secondaryLink}>{data.secondaryLabel}</TextLink>
      )}
    </p>
  )}
</Section>
