---
import site from '../../data/site.json';
import HomeEventStatus from '../HomeEventStatus.astro';
import NewsletterForm from '../forms/NewsletterForm.astro';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    displayLines?: string[];
    lede?: string;
    newsletterText?: string;
    whatsappText?: string;
  };
}

/** The close, set like the flyer: the invitation inside the ring, the date in orange capitals, and the way to hear about the next one. */

const { data } = Astro.props;
const anchor = data.anchor ?? 'termine';
const whatsapp = site.whatsappCommunityLink;
const lines = data.displayLines ?? ['Dabei sein.'];
---

<section class="section surface-night home-dates" id={anchor} aria-labelledby="termine-title">
  <div class="container home-dates__inner">
    <div class="home-dates__lead">
      <p class="marker marker--plain home-dates__marker">{data.eyebrow}</p>

      <h2 class="display display--xl home-dates__display" id="termine-title">
        {lines.map((line) => (
          <span class="display__line">{line}</span>
        ))}
      </h2>

      {data.lede && <p class="home-dates__lede">{data.lede}</p>}
    </div>

    <div class="home-dates__ticket">
      <HomeEventStatus placement="dates" server:defer>
        <HomeEventStatus placement="dates" fallback slot="fallback" />
      </HomeEventStatus>
    </div>

    <div class="home-dates__notify" id="newsletter">
      <h3 class="home-dates__sub">Bei neuen Terminen benachrichtigen</h3>
      {data.newsletterText && <p class="home-dates__text">{data.newsletterText}</p>}
      <NewsletterForm context={{ location: 'home-dates' }} />

      {whatsapp && (
        <p class="home-dates__alt" id="whatsapp-community">
          {data.whatsappText}{' '}
          <a
            class="link"
            href={whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event="whatsapp-click"
            data-umami-event-type="community-join"
          >
            Zur WhatsApp-Gruppe
            <span class="sr-only"> (öffnet WhatsApp in einem neuen Tab)</span>
          </a>
          .
        </p>
      )}
    </div>
  </div>
</section>

<style is:global>
  @layer sections {
    .home-dates {
      padding-block: var(--space-2xl);
    }

    .home-dates__inner {
      display: grid;
      grid-template-areas:
        'lead   notify'
        'ticket notify';
      grid-template-rows: auto 1fr;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-lg) var(--space-xl);
      align-items: start;
    }

    .home-dates__lead {
      grid-area: lead;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-lg);
      align-items: end;
    }

    .home-dates__marker {
      grid-column: 1 / -1;
      margin: 0;
      color: var(--text-primary);
    }

    .home-dates__display {
      margin: 0;
    }

    .home-dates__ticket {
      grid-area: ticket;
      padding-block-start: var(--space-md);
      border-block-start: 2px solid var(--accent);
    }

    .home-dates__lede {
      max-inline-size: 36ch;
      margin: 0;
      font-size: var(--text-section-body);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
    }

    .home-dates__notify {
      grid-area: notify;
      padding: var(--space-lg);
      background: var(--color-night-soft);
      border: 1px solid var(--border-light);
      border-radius: var(--radius);
    }

    .home-dates__sub {
      margin-block-end: var(--space-xs);
      font-size: var(--text-2xl);
      line-height: 1.1;
    }

    .home-dates__text {
      margin-block-end: var(--space-md);
      font-size: var(--text-section-body);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
    }

    .home-dates__alt {
      margin-block-start: var(--space-md);
      font-size: var(--text-caption);
      line-height: var(--leading-relaxed);
      color: var(--text-muted);
    }

    @media (width <= 62em) {
      .home-dates__inner {
        grid-template-areas:
          'lead'
          'ticket'
          'notify';
        grid-template-rows: none;
        grid-template-columns: minmax(0, 1fr);
      }
    }

    @media (width <= 36em) {
      .home-dates__lead {
        grid-template-columns: minmax(0, 1fr);
        justify-items: center;
      }

      .home-dates__marker {
        justify-self: center;
      }

      .home-dates__lede {
        text-align: center;
      }

      .home-dates__notify {
        padding: var(--space-md);
        margin-inline: calc(-0.5 * var(--container-gutter));
      }
    }
  }
</style>
