---
import { link } from '@lib/ui';

import site from '../../data/site.json';
import NewsletterForm from '../forms/NewsletterForm.astro';
import HomeEventStatus from '../HomeEventStatus.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    displayLines?: string[];
    lede?: string;
    newsletterText?: string;
    whatsappText?: string;
  };
}

/**
 * The close of the home page, in order of what it asks: first taking part — a
 * short invitation beside the next date (the same summary as in the hero) on the
 * secondary ground (`#termine`); then, smaller, on the paper, staying in touch:
 * dates by e-mail (`#newsletter`) and the WhatsApp group as a link.
 */

const { data } = Astro.props;
const anchor = data.anchor ?? 'termine';
const whatsapp = site.whatsappCommunityLink;
const title = (data.displayLines ?? ['Dabei sein.']).join(' ');
---

<Section
  id={anchor}
  ground="alt"
  labelledby="termine-title"
  innerClass="grid items-center gap-x-grid gap-y-10 lg:grid-cols-12"
>
  <SectionHead eyebrow={data.eyebrow} title={title} titleId="termine-title" lead={data.lede} class="lg:col-span-6" />
  <div class="lg:col-span-5 lg:col-start-8">
    <HomeEventStatus placement="dates" />
  </div>
</Section>

<Section
  id="newsletter"
  labelledby="newsletter-title"
  space="band"
  innerClass="grid gap-x-grid gap-y-10 py-4 lg:grid-cols-12"
>
  <div class="lg:col-span-7">
    <h2 id="newsletter-title" class="text-sub text-fg">
      Termine per E-Mail erhalten
    </h2>
    {data.newsletterText && <p class="mt-3 max-w-measure text-md text-fg-soft">{data.newsletterText}</p>}
    <NewsletterForm context={{ location: 'home-dates' }} class="mt-6" />
  </div>
  {whatsapp && data.whatsappText && (
    <div class="border-line max-lg:border-t max-lg:pt-8 lg:col-span-4 lg:col-start-9 lg:border-l lg:pl-8">
      <h2 class="font-sans text-base font-semibold text-fg">Zwischen den Abenden</h2>
      <p class="mt-2 text-md text-fg-soft">
        {data.whatsappText}{' '}
        <a
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[link, 'font-semibold']}
          data-umami-event="whatsapp-click"
          data-umami-event-type="community-join"
        >
          Zur WhatsApp-Gruppe<span class="sr-only"> (öffnet WhatsApp in einem neuen Tab)</span>
        </a>
      </p>
    </div>
  )}
</Section>
