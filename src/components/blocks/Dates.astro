---
import site from '../../data/site.json';
import { Icon } from 'astro-icon/components';
import HomeEventStatus from '../HomeEventStatus.astro';
import Rings from '../Rings.astro';
import NewsletterForm from '../forms/NewsletterForm.astro';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    displayLines?: string[];
    /** A phrase of the title set in the italic accent. */
    titleEmphasis?: string;
    lede?: string;
    newsletterText?: string;
    whatsappText?: string;
  };
}

/**
 * The close of the home page, in three bands: the community (forest), the way to
 * hear about the next date (earth), and the invitation with the next date as a
 * card on the sand, rings rising behind it.
 */

const { data } = Astro.props;
const anchor = data.anchor ?? 'termine';
const whatsapp = site.whatsappCommunityLink;
const title = (data.displayLines ?? ['Dabei sein.']).join(' ');
---

{whatsapp && data.whatsappText && (
  <Section
    ground="forest"
    space="compact"
    label="WhatsApp-Gruppe"
    class="overflow-clip"
    innerClass="relative grid items-center gap-x-grid gap-y-8 py-4 lg:grid-cols-12"
    defer
  >
    <div class="grid justify-items-start gap-4 lg:col-span-7">
      <Eyebrow>Zwischen den Abenden</Eyebrow>
      <p class="max-w-prose font-serif text-2xl text-fg">{data.whatsappText}</p>
    </div>
    <div class="grid justify-items-start gap-3 lg:col-span-4 lg:col-start-9 lg:justify-items-end">
      <Button
        href={whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        data-umami-event="whatsapp-click"
        data-umami-event-type="community-join"
      >
        <Icon name="social-whatsapp" aria-hidden="true" class="size-5" />
        Zur WhatsApp-Gruppe
        <span class="sr-only"> (öffnet WhatsApp in einem neuen Tab)</span>
      </Button>
      <p class="text-sm text-fg-muted">Kostenlos und unverbindlich</p>
    </div>
  </Section>
)}

<Section
  id="newsletter"
  ground="earth"
  labelledby="newsletter-title"
  class="overflow-clip"
  innerClass="relative grid items-center gap-x-grid gap-y-8 lg:grid-cols-12"
>
  {/* A warm glow breathing in from the side. */}
  <div
    slot="before"
    aria-hidden="true"
    data-breath
    class="pointer-events-none absolute -top-[30%] -right-[20%] h-[160%] w-[70%] bg-radial from-fill/16 to-transparent to-50% motion-safe:animate-ring-slow motion-safe:[animation-duration:20s]"
  ></div>
  <div class="grid justify-items-start gap-4 lg:col-span-6">
    <SectionHead
      eyebrow="In Verbindung bleiben"
      title="Bei neuen Terminen benachrichtigen"
      titleEmphasis="benachrichtigen"
      titleId="newsletter-title"
      size="display-3"
    />
    {data.newsletterText && <p class="max-w-measure text-base text-fg-soft">{data.newsletterText}</p>}
  </div>
  <div class="lg:col-span-6">
    <NewsletterForm context={{ location: 'home-dates' }} />
  </div>
</Section>

<Section
  id={anchor}
  ground="sand"
  labelledby="termine-title"
  class="overflow-clip"
  innerClass="relative grid justify-items-center gap-group text-center"
>
  <Rings slot="before" set="close" class="text-earth" />
  <SectionHead
    eyebrow={data.eyebrow}
    title={title}
    titleEmphasis={data.titleEmphasis}
    titleId="termine-title"
    lead={data.lede}
    size="display-2"
    align="center"
    class="max-w-prose"
  />
  <div class="w-full max-w-md text-left">
    <HomeEventStatus placement="dates" server:defer>
      <HomeEventStatus placement="dates" fallback slot="fallback" />
    </HomeEventStatus>
  </div>
</Section>
