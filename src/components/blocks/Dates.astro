---
import Contours from '../Contours.astro';
import site from '../../data/site.json';
import { link } from '@lib/ui';
import HomeEventStatus from '../HomeEventStatus.astro';
import NewsletterForm from '../forms/NewsletterForm.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    displayLines?: string[];
    lede?: string;
    newsletterText?: string;
    whatsappText?: string;
  };
}

/** The close of the home page, at night over the hill country: the invitation and the next date side by side, then the way to hear about the next one. */

const { data } = Astro.props;
const anchor = data.anchor ?? 'termine';
const whatsapp = site.whatsappCommunityLink;
const title = (data.displayLines ?? ['Dabei sein.']).join(' ');
---

<Section
  id={anchor}
  ground="night"
  labelledby="termine-title"
  class="overflow-clip"
  innerClass="relative grid items-start gap-y-10 lg:grid-cols-12 lg:gap-x-grid"
>
  <Contours slot="before" />
  <div class="grid gap-8 lg:col-span-6">
    <SectionHead eyebrow={data.eyebrow} title={title} titleId="termine-title" lead={data.lede} size="display-2" />

    <div id="newsletter" class="scroll-mt-(--spacing-clearance) border-t border-line-strong pt-8">
      <h3 class="mb-2 text-2xl text-fg">Bei neuen Terminen benachrichtigen</h3>
      {data.newsletterText && <p class="mb-5 max-w-measure text-base text-fg-soft">{data.newsletterText}</p>}
      <NewsletterForm context={{ location: 'home-dates' }} />

      {whatsapp && (
        <p class="mt-5 text-sm text-fg-muted" id="whatsapp-community">
          {data.whatsappText}{' '}
          <a
            class={link}
            href={whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event="whatsapp-click"
            data-umami-event-type="community-join"
          >
            Zur WhatsApp-Gruppe
            <span class="sr-only"> (öffnet WhatsApp in einem neuen Tab)</span>
          </a>
          .
        </p>
      )}
    </div>
  </div>

  <div class="lg:sticky lg:top-[calc(var(--spacing-clearance)+1rem)] lg:col-span-5 lg:col-start-8">
    <HomeEventStatus placement="dates" server:defer>
      <HomeEventStatus placement="dates" fallback slot="fallback" />
    </HomeEventStatus>
  </div>
</Section>
