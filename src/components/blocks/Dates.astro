---
import EventAvailability from '../event/EventAvailability.astro';
import type { PublicEvents } from '../event/types';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Props {
  events: PublicEvents | null;
  anchor: string;
  eyebrow: string;
  title: string;
  lede: string;
}

const { events, anchor, eyebrow, title, lede } = Astro.props;
---

<Section
  id={anchor}
  ground="alt"
  labelledby="termine-title"

  innerClass="grid items-center gap-x-grid gap-y-10 lg:grid-cols-12"
>
  <SectionHead eyebrow={eyebrow} title={title} titleId="termine-title" lead={lede} class="lg:col-span-6" />
  <div class="min-w-0 lg:col-span-5 lg:col-start-8">
    <EventAvailability data={events} location="home-dates" />
  </div>
</Section>
