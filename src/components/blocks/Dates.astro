---
import site from '../../data/site.json';
import HomeEventStatus from '../HomeEventStatus.astro';
import NewsletterForm from '../forms/NewsletterForm.astro';

interface Props {
  data: {
    anchor?: string;
    title?: string;
    newsletterText?: string;
    whatsappText?: string;
  };
}

/** The close: the next date with its real free seats, and the way to hear about the next one. */

const { data } = Astro.props;
const anchor = data.anchor ?? 'termine';
const whatsapp = site.whatsappCommunityLink;
---

<section class="section section--rust section--clip home-dates" id={anchor} aria-labelledby="termine-title">
  <div class="container bay">
    <div class="home-dates__lead">
      <h2 class="display display--caps home-dates__title" id="termine-title">
        {data.title ?? 'Dabei sein'}
      </h2>

      <HomeEventStatus placement="dates" server:defer>
        <HomeEventStatus placement="dates" fallback slot="fallback" />
      </HomeEventStatus>
    </div>

    <div class="home-dates__notify" id="newsletter">
      <h3 class="home-dates__sub">Bei neuen Terminen benachrichtigen</h3>
      {data.newsletterText && <p class="home-dates__text">{data.newsletterText}</p>}
      <NewsletterForm context={{ location: 'home-dates' }} />

      {whatsapp && (
        <p class="home-dates__alt" id="whatsapp-community">
          {data.whatsappText}{' '}
          <a
            class="link"
            href={whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event="whatsapp-click"
            data-umami-event-type="community-join"
          >
            Zur WhatsApp-Gruppe
            <span class="sr-only"> (öffnet WhatsApp in einem neuen Tab)</span>
          </a>
        </p>
      )}
    </div>
  </div>
</section>

<style is:global>
  @layer sections {
    .home-dates {
      padding-block: var(--space-2xl);
    }

    .home-dates__lead {
      grid-column: 1 / span 7;
    }

    .home-dates__title {
      margin-block-end: var(--space-lg);
      font-size: var(--step-6);
      color: var(--text-primary);
    }

    .home-dates__status {
      max-inline-size: 40ch;
      margin-block-end: var(--space-md);
      font-family: var(--font-ui);
      font-size: var(--step-1);
      font-weight: 560;
      line-height: var(--leading-snug);
      color: var(--text-primary);
    }

    .home-dates__meta {
      margin-block-end: var(--space-md);
    }

    .home-dates__action {
      margin: 0;
    }

    /* The form column, set off by a rule rather than a panel. */
    .home-dates__notify {
      --control-bg: rgb(255 250 242 / 10%);
      --control-bg-hover: rgb(255 250 242 / 16%);
      --control-color: var(--on-ground);
      --control-border-color: rgb(243 235 223 / 50%);
      --control-placeholder: var(--on-ground-soft);
      --border-dark: var(--on-ground);

      grid-column: 9 / span 4;
      align-self: start;
      padding-inline-start: var(--space-md);
      border-inline-start: 1px solid var(--rule);
    }

    .home-dates__notify .newsletter__form {
      flex-direction: column;
      align-items: stretch;
    }

    .home-dates__sub {
      margin-block-end: var(--space-xs);
      font-size: var(--step-2);
      color: var(--text-primary);
    }

    .home-dates__text {
      margin-block-end: var(--space-md);
      font-family: var(--font-body);
      font-size: var(--step-0);
      line-height: var(--leading-normal);
      color: var(--text-secondary);
    }

    .home-dates__alt {
      margin-block-start: var(--space-md);
      font-family: var(--font-body);
      font-size: 0.9375rem;
      line-height: var(--leading-normal);
      color: var(--text-secondary);
    }

    @media (width <= 56em) {
      .home-dates__notify {
        margin-block-start: var(--space-xl);
        padding-block-start: var(--space-lg);
        padding-inline-start: 0;
        border-block-start: 1px solid var(--rule);
        border-inline-start: none;
      }
    }

    @media (width <= 30em) {
      .home-dates__action .btn {
        inline-size: 100%;
      }
    }
  }
</style>
