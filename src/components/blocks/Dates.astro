---
import EventAvailability from '../event/EventAvailability.astro'
import type { PublicEvents } from '../event/types'
import TextLink from '../ui/TextLink.astro'
import Section from '../ui/Section.astro'

interface Props {
  events: PublicEvents | null
  anchor: string
  title: string
}

const { events, anchor, title } = Astro.props
---

{/* Taking part, on the quiet band: the invitation as a poster word, beside it the next date. */}
<Section
  id={anchor}
  ground="alt"
  labelledby="termine-title"
  innerClass="grid items-start gap-x-grid gap-y-12 lg:grid-cols-12"
>
  <div class="min-w-0 lg:col-span-7">
    <h2 id="termine-title" class="max-w-[13em] font-display text-section text-fg">{title}</h2>
  </div>
  <div class="min-w-0 lg:col-span-5 lg:col-start-8">
    <EventAvailability
      data={events}
      location="home-dates"
    />
    {events && events.events.length > 1 && (
      <TextLink href="/event" class="mt-4">Alle Termine ansehen</TextLink>
    )}
  </div>
</Section>
