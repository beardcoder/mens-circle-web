---
import NextDate from '../event/NextDate';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Props {
  anchor: string;
  eyebrow: string;
  title: string;
  lede: string;
  emptyTitle: string;
  emptyText: string;
  emptyButtonLabel: string;
}

const { anchor, eyebrow, title, lede, emptyTitle, emptyText, emptyButtonLabel } = Astro.props;
---

<Section
  id={anchor}
  ground="alt"
  labelledby="termine-title"
  innerClass="grid items-center gap-x-grid gap-y-10 lg:grid-cols-12"
>
  <SectionHead eyebrow={eyebrow} title={title} titleId="termine-title" lead={lede} class="lg:col-span-6" />
  <div class="min-w-0 lg:col-span-5 lg:col-start-8">
    <NextDate
      client:visible={{ rootMargin: '300px' }}
      emptyTitle={emptyTitle}
      emptyText={emptyText}
      emptyButtonLabel={emptyButtonLabel}
    />
  </div>
</Section>
