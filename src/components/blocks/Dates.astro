---
import EventAvailability from '../event/EventAvailability.astro';
import type { PublicEvents } from '../event/types';
import Poster from '../ui/Poster.astro';
import Section from '../ui/Section.astro';

interface Props {
  events: PublicEvents | null;
  anchor: string;
  title: string;
  lede: string;
}

const { events, anchor, title, lede } = Astro.props;
---

{/* Taking part, on the sand: the invitation as a poster word, beside it the next date. */}
<Section
  id={anchor}
  ground="alt"
  labelledby="termine-title"
  innerClass="grid items-end gap-x-grid gap-y-12 lg:grid-cols-12"
>
  <div data-reveal-group class="min-w-0 lg:col-span-7">
    <Poster as="h2" id="termine-title" data-drift class="max-w-[5em]">
      {title}
    </Poster>
    <p class="mt-8 max-w-measure text-lg text-fg-muted">{lede}</p>
  </div>
  <div class="min-w-0 lg:col-span-5 lg:col-start-8">
    <EventAvailability data={events} location="home-dates" />
  </div>
</Section>
