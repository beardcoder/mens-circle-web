---
import type { SummaryView } from '@lib/event-status';
import { card } from '@lib/ui';

import EventSummary from '../event/EventSummary.astro';
import Button from '../ui/Button.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Props {
  anchor: string;
  eyebrow: string;
  title: string;
  lede: string;
  view: SummaryView;
  emptyTitle: string;
  emptyText: string;
  emptyButtonLabel: string;
}

const { anchor, eyebrow, title, lede, view, emptyTitle, emptyText, emptyButtonLabel } = Astro.props;
---

<Section
  id={anchor}
  ground="alt"
  labelledby="termine-title"
  innerClass="grid items-center gap-x-grid gap-y-10 lg:grid-cols-12"
>
  <SectionHead eyebrow={eyebrow} title={title} titleId="termine-title" lead={lede} class="lg:col-span-6" />
  <div class="min-w-0 lg:col-span-5 lg:col-start-8">
    {view.state === 'none' ? (
      <div class:list={[card, 'grid gap-4 p-6 sm:p-8']}>
        <h3 class="text-sub text-fg">{emptyTitle}</h3>
        <p class="text-md text-fg-soft">{emptyText}</p>
        <Button href="#newsletter" variant="secondary" decorate class="justify-self-start max-sm:w-full">
          {emptyButtonLabel}
        </Button>
      </div>
    ) : (
      <EventSummary view={view} location="home-dates" />
    )}
  </div>
</Section>
