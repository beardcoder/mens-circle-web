---
import NextDate from '../event/NextDate';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Props {
  anchor: string;
  eyebrow: string;
  title: string;
  lede: string;
}

const { anchor, eyebrow, title, lede } = Astro.props;
---

<Section
  id={anchor}
  ground="alt"
  labelledby="termine-title"
  innerClass="grid items-center gap-x-grid gap-y-10 lg:grid-cols-12"
>
  <SectionHead eyebrow={eyebrow} title={title} titleId="termine-title" lead={lede} class="lg:col-span-6" />
  {/* An empty island has no visible target for client:visible; its request is shared with the hero. */}
  <NextDate client:load />
</Section>
