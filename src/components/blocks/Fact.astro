---
import { Icon } from 'astro-icon/components';

interface Props {
  label: string;
  /** An icon from src/icons: place, calendar, clock, heart. */
  icon: string;
}

const { label, icon } = Astro.props;
---

{/* A fact between lines, no box: below `lg` a row (the icon beside the words), on the desktop a column. */}
<div class="grid min-w-0 grid-cols-[auto_minmax(0,1fr)] content-start gap-x-5 border-t border-line py-6 first:border-t-0 lg:grid-cols-1 lg:border-t-0 lg:border-l lg:px-8 lg:py-2 lg:first:border-l-0 lg:first:pl-0 lg:last:pr-0">
  <span
    aria-hidden="true"
    class="row-span-3 grid size-11 place-items-center rounded-full bg-accent-soft text-accent lg:row-span-1 lg:mb-5"
  >
    <Icon name={icon} class="size-5.5" />
  </span>
  <dt class="text-sm font-semibold text-fg-muted">{label}</dt>
  <dd class="mt-1 font-display text-xl text-balance text-fg hyphens-auto sm:text-sub">
    <slot name="value" />
  </dd>
  <dd class="mt-1.5 text-sm text-fg-muted">
    <slot />
  </dd>
</div>
