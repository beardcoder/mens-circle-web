---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="grid content-start gap-1">
  <span aria-hidden="true" class="mb-3 block h-px bg-line-strong"></span>
  <dt class="text-sm text-fg-muted">{label}</dt>
  <dd class="text-xl font-semibold text-fg">
    <slot name="value" />
  </dd>
  <dd class="text-sm text-fg-muted">
    <slot />
  </dd>
</div>
