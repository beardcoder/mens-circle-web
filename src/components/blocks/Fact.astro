---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

{/* A fact under a thin rule: its label, the value in Fraunces, a note. No icon and no box. */}
<div class="grid min-w-0 content-start border-t border-line-strong pt-5">
  <dt class="text-sm font-semibold text-fg-muted">{label}</dt>
  <dd class="mt-2 font-display text-xl text-balance text-fg sm:text-sub lg:text-xl xl:text-sub">
    <slot name="value" />
  </dd>
  <dd class="mt-2 text-sm text-fg-muted">
    <slot />
  </dd>
</div>
