---
import Section from '../ui/Section.astro';

interface Props {
  anchor: string;
  eyebrow: string;
}

const { anchor, eyebrow } = Astro.props;
---

<Section id={anchor} space="band" labelledby="praktisches-title" class="pt-[calc(var(--spacing-band)+1.5rem)]">
  <h2 id="praktisches-title" class="sr-only">
    {eyebrow}
  </h2>
  <dl class="grid grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-4">
    <slot />
  </dl>
</Section>
