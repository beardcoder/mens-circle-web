---
import site from '@data/site.json';
import { type NextEventSummary, summarizeNextEvent } from '@lib/event-status';

/** Quick facts, shared by home and /event. Never more precise than the city. */

interface Props {
  data?: { anchor?: string; eyebrow?: string };
  variant?: 'band' | 'list';
  /** The next scheduled event, when there is one. Read live when omitted. */
  next?: NextEventSummary | null;
}

const { data = {}, variant = 'band' } = Astro.props;
const next =
  Astro.props.next !== undefined
    ? Astro.props.next
    : // Dynamic, so the static fallback never opens SQLite.
      summarizeNextEvent((await (await import('../../lib/server/events')).fetchNextEventState()).event);

const facts = [
  { label: 'Wo', value: next?.place || site.geo.locality, sub: 'Die genaue Adresse bekommst du mit der Anmeldung' },
  // Non-breaking space: the only acceptable break is before "Wochen" — between
  // the 2 and the 4 it reads as a stray hyphen.
  { label: 'Wie oft', value: 'Alle\u00A02–4 Wochen', sub: 'Ein fester Rhythmus, keine Mitgliedschaft' },
  {
    label: 'Dauer',
    value: '2–3 Stunden',
    sub: next?.timeRange ? `Nächster Termin: ${next.timeRange}` : 'Ein Abend, kein Wochenendseminar',
  },
  // The event's own fee text wins: it may name an amount "Spendenbasis" swallows.
  { label: 'Beitrag', value: next?.costBasis || 'Spendenbasis', sub: 'Jeder gibt, was für ihn machbar ist' },
];
const anchor = data.anchor ?? 'praktisches';
---

{variant === 'list' ? (
  <section class="section section--ruled event-landing-facts" aria-labelledby="fakten-title">
    <div class="container">
      <div class="spine">
        <h2 class="rail-heading" id="fakten-title">
          Gut zu wissen
        </h2>

        <dl class="facts-grid spine__body--wide">
          {facts.map((fact) => (
            <div class="facts-grid__item" data-reveal>
              <dt class="facts-grid__label">{fact.label}</dt>
              <dd class="facts-grid__value">{fact.value}</dd>
              <dd class="facts-grid__note">{fact.sub}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>
) : (
  <section class="surface-sand home-facts" id={anchor} aria-labelledby="praktisches-title">
    <div class="container home-facts__inner">
      <h2 class="home-facts__title" id="praktisches-title">
        {data.eyebrow ?? 'Praktisches'}
      </h2>

      <dl class="facts-grid">
        {facts.map((fact) => (
          <div class="facts-grid__item">
            <dt class="facts-grid__label">{fact.label}</dt>
            <dd class="facts-grid__value">{fact.value}</dd>
            <dd class="facts-grid__note">{fact.sub}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
)}

<style is:global>
  @layer sections {
    /* A ledger strip directly under the hero: the four answers a cautious
       reader looks for before anything else. */
    .home-facts {
      padding-block: var(--space-lg);
    }

    .home-facts__inner {
      display: grid;
      grid-template-columns: minmax(0, 10rem) minmax(0, 1fr);
      gap: var(--space-md) var(--space-xl);
      align-items: start;
    }

    .home-facts__title {
      padding-block-start: var(--space-sm);
      font-size: var(--text-xl);
      font-family: var(--font-quote);
      font-style: italic;
      color: var(--accent);
    }

    .facts-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin: 0;
    }

    .facts-grid__item {
      display: grid;
      grid-template-rows: auto auto 1fr;
      gap: var(--space-3xs);
      padding: var(--space-sm) var(--space-md) var(--space-sm) 0;
    }

    .facts-grid__item + .facts-grid__item {
      padding-inline-start: var(--space-md);
      border-inline-start: 1px solid var(--border-light);
    }

    .facts-grid__label {
      font-size: var(--text-marker);
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: var(--tracking-marker);
    }

    .facts-grid__value {
      margin: 0;
      font-family: var(--font-display);
      font-size: var(--text-2xl);
      line-height: 1.1;
      color: var(--text-primary);
      letter-spacing: -0.015em;
      text-wrap: balance;
    }

    .facts-grid__note {
      margin: var(--space-3xs) 0 0;
      font-size: var(--text-caption);
      line-height: 1.5;
      color: var(--text-muted);
      text-wrap: pretty;
    }

    @media (width <= 72em) {
      .home-facts__inner {
        grid-template-columns: minmax(0, 1fr);
        gap: 0;
      }

      .home-facts__title {
        padding-block-start: 0;
      }
    }

    @media (width <= 62em) {
      .facts-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .facts-grid__item:nth-child(3) {
        padding-inline-start: 0;
        border-inline-start: 0;
      }

      .facts-grid__item:nth-child(n + 3) {
        border-block-start: 1px solid var(--border-light);
      }
    }

    @media (width <= 30em) {
      .facts-grid__item,
      .facts-grid__item + .facts-grid__item {
        padding-inline: 0 var(--space-xs);
      }

      .facts-grid__item:nth-child(even) {
        padding-inline-start: var(--space-sm);
      }

      .facts-grid__value {
        font-size: var(--text-xl);
      }
    }
  }
</style>
