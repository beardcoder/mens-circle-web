---
import Section from '../ui/Section.astro';

interface Props {
  anchor: string;
  eyebrow: string;
}

const { anchor, eyebrow } = Astro.props;
---

{/* Close under the opening, and no bottom space of its own: the next section brings it. */}
<Section id={anchor} space="none" labelledby="praktisches-title" class="pt-[calc(var(--spacing-band)+1.5rem)]">
  <h2 id="praktisches-title" class="sr-only">
    {eyebrow}
  </h2>
  <dl class="grid border-y border-line lg:grid-cols-4 lg:py-8">
    <slot />
  </dl>
</Section>
