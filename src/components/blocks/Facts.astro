---
import site from '@data/site.json';
import { type NextEventSummary, summarizeNextEvent } from '@lib/event-status';

/**
 * The quick-scan facts: a full-bleed ink band under the home hero, or a hairline
 * list on /event — one list, so the two pages cannot state different facts. A
 * scheduled event overrides what it knows: city, time window, fee. Never more
 * precise than the city: the exact address goes out with the registration
 * confirmation only.
 */

interface Props {
  data?: { anchor?: string; eyebrow?: string };
  variant?: 'band' | 'list';
  /** The next scheduled event, when there is one. Read live when omitted. */
  next?: NextEventSummary | null;
}

const { data = {}, variant = 'band' } = Astro.props;
const next =
  Astro.props.next !== undefined
    ? Astro.props.next
    : // Dynamic, so the static fallback never opens SQLite.
      summarizeNextEvent((await (await import('../../lib/server/events')).fetchNextEventState()).event);

const facts = [
  { label: 'Wo', value: next?.place || site.geo.locality, sub: 'Die genaue Adresse bekommst du mit der Anmeldung' },
  // Non-breaking space: the only acceptable break is before "Wochen" — between
  // the 2 and the 4 it reads as a stray hyphen.
  { label: 'Wie oft', value: 'Alle\u00A02–4 Wochen', sub: 'Ein fester Rhythmus, keine Mitgliedschaft' },
  {
    label: 'Dauer',
    value: '2–3 Stunden',
    sub: next?.timeRange ? `Nächster Termin: ${next.timeRange}` : 'Ein Abend, kein Wochenendseminar',
  },
  // The event's own fee text wins: it may name an amount "Spendenbasis" swallows.
  { label: 'Beitrag', value: next?.costBasis || 'Spendenbasis', sub: 'Jeder gibt, was für ihn machbar ist' },
];
const anchor = data.anchor ?? 'praktisches';
---

{variant === 'list' ? (
  <section class="section section--ruled event-landing-facts" aria-labelledby="fakten-title">
    <div class="container">
      <div class="spine">
        <h2 class="rail-heading" id="fakten-title">
          Gut zu wissen
        </h2>

        <dl class="deflist spine__body--wide" data-reveal-group="55">
          {facts.map((fact) => (
            <div class="deflist__row" data-reveal="up">
              <dt class="deflist__term">{fact.label}</dt>
              <dd class="deflist__desc">
                {fact.value}
                <span class="deflist__note">{fact.sub}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>
) : (
  <section class="section section--ink home-facts" id={anchor} aria-labelledby="praktisches-title">
    <div class="container">
      <h2 class="marker home-facts__title" id="praktisches-title">
        {data.eyebrow ?? 'Praktisches'}
      </h2>

      <dl class="home-facts__row">
        {facts.map((fact) => (
          <div class="home-facts__item">
            <dt class="home-facts__label">{fact.label}</dt>
            <dd class="home-facts__value">{fact.value}</dd>
            <dd class="home-facts__note">{fact.sub}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
)}

<style is:global>
  @layer sections {
    .home-facts {
      padding-block: var(--rhythm-section);
    }

    .home-facts__title {
      margin-block-end: var(--rhythm-group);
      color: var(--color-orange);
    }

    .home-facts__row {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
      margin: 0;
      border-block-start: 1px solid var(--border-on-dark);
    }

    /* The 11rem floor levels the four cells against each other while they sit
       side by side — it is a column height, not a spacing choice, so it is
       lifted again as soon as they stop being columns (see the stacked
       breakpoint below). */
    .home-facts__item {
      min-block-size: 11rem;
      padding-block: var(--space-md) var(--space-sm);
      padding-inline-end: var(--space-md);
    }

    /* Vertical rules between the four, none at the outer edges. */
    .home-facts__item + .home-facts__item {
      padding-inline-start: var(--space-md);
      border-inline-start: 1px solid var(--border-on-dark);
    }

    .home-facts__label {
      font-family: var(--font-display);
      font-size: var(--text-marker);
      font-weight: 600;
      color: var(--color-chalk-muted);
      text-transform: uppercase;
      letter-spacing: var(--tracking-marker);
    }

    .home-facts__value {
      margin: var(--space-2xs) 0 0;
      font-family: var(--font-display);
      font-size: clamp(1.75rem, 1.1rem + 2.4vw, 3rem);
      font-weight: 800;
      line-height: 0.95;
      color: var(--color-chalk);
      text-transform: uppercase;
      letter-spacing: -0.01em;
      text-wrap: balance;
    }

    .home-facts__note {
      margin: var(--space-xs) 0 0;
      font-size: var(--text-caption);
      line-height: var(--leading-normal);
      color: var(--color-chalk-muted);
      text-wrap: pretty;
    }

    /* Two-up, then stacked. The rules follow the columns.

       The 11rem floor goes with the four-up layout it was drawn for. Grid rows
       already stretch their items to a common height, so below this width the
       floor equalises nothing — it just reserved a fixed 176px band for facts
       that read in about 120px, which is ~56px of dead air under every one of
       them at tablet width and ~90px on a phone. Each fact is now as tall as
       it reads, separated by the hairline and one rung of the ladder. */
    @media (width <= 62em) {
      .home-facts__row {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .home-facts__item {
        min-block-size: 0;
        padding-block: var(--rhythm-item);
      }

      .home-facts__item:nth-child(odd) {
        padding-inline-start: 0;
        border-inline-start: none;
      }

      .home-facts__item:nth-child(n + 3) {
        border-block-start: 1px solid var(--border-on-dark);
      }

      /* The list ends on an item's own bottom padding; without this the band
         carried 48px of air above its title and 68px below its last note. */
      .home-facts__item:nth-last-child(-n + 2) {
        padding-block-end: 0;
      }
    }

    @media (width <= 36em) {
      .home-facts__row {
        grid-template-columns: minmax(0, 1fr);
      }

      .home-facts__item {
        padding-inline: 0;
        border-inline-start: none;
      }

      /* Stacked there is one item per row, so only the true last one ends the
         band — the two-up rule above would strip the second-to-last as well. */
      .home-facts__item:nth-last-child(2) {
        padding-block-end: var(--rhythm-item);
      }

      .home-facts__item + .home-facts__item {
        padding-inline-start: 0;
        border-block-start: 1px solid var(--border-on-dark);
        border-inline-start: none;
      }
    }
  }
</style>
