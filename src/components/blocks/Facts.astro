---
import site from '@data/site.json';
import { type NextEventSummary, summarizeNextEvent } from '@lib/event-status';
import Section from '../ui/Section.astro';
import Split from '../ui/Split.astro';

/** Quick facts, shared by home and /event: the four answers a cautious reader looks for first. Never more precise than the city. */

interface Props {
  data?: { anchor?: string; eyebrow?: string };
  variant?: 'band' | 'list';
  /** The next scheduled event, when there is one. Read live when omitted. */
  next?: NextEventSummary | null;
}

const { data = {}, variant = 'band' } = Astro.props;
const next =
  Astro.props.next !== undefined
    ? Astro.props.next
    : // Dynamic, so the static fallback never opens SQLite.
      summarizeNextEvent((await (await import('../../lib/server/events')).fetchNextEventState()).event);

const facts = [
  {
    label: 'Wo',
    value: next?.place || site.geo.locality,
    sub: 'Die genaue Adresse bekommst du mit der Anmeldebestätigung',
  },
  // Non-breaking space: the only acceptable break is before "Wochen" — between
  // the 2 and the 4 it reads as a stray hyphen.
  { label: 'Wie oft', value: 'Alle 2–4 Wochen', sub: 'Ohne Mitgliedschaft – du kommst, wann es für dich passt' },
  {
    label: 'Dauer',
    value: '2–3 Stunden',
    // Word joiners keep "19:00–21:30" on one line.
    sub: next?.timeRange
      ? `Nächster Termin: ${next.timeRange.replace('–', '⁠–⁠')}`
      : 'Ein Abend, kein Wochenendseminar',
  },
  // The event's own fee text wins: it may name an amount "Spendenbasis" swallows.
  { label: 'Beitrag', value: next?.costBasis || 'Spendenbasis', sub: 'Du gibst, was für dich machbar ist' },
];
const anchor = data.anchor ?? 'praktisches';
const band = variant === 'band';

// Two by two with hairlines between; on the band four abreast from `lg`, each behind its own hairline.
const item = (i: number) => [
  '@container grid grid-rows-[auto_auto_1fr] gap-1 border-line py-4 pr-4',
  i % 2 === 1 && 'border-l pl-4',
  i >= 2 && 'border-t',
  band && 'lg:border-t-0 lg:border-l lg:px-6',
];
---

{band ? (
  <Section id={anchor} ground="sand" space="compact" labelledby="praktisches-title">
    <div class="grid gap-x-group gap-y-2 xl:grid-cols-[minmax(0,12rem)_minmax(0,1fr)] xl:items-start">
      <h2 id="praktisches-title" class="font-serif text-xl text-accent italic xl:pt-4">
        {data.eyebrow ?? 'Auf einen Blick'}
      </h2>
      <dl class="grid grid-cols-2 lg:grid-cols-4">
        {facts.map((fact, i) => (
          <div class:list={item(i)}>
            <dt class="text-xs font-semibold tracking-label text-fg-muted uppercase">{fact.label}</dt>
            {/* Every value on one line at one size: "Alle 2–4 Wochen", the longest, is 7.6em. */}
            <dd class="font-serif text-[length:min(var(--text-xl),12.8cqi)] leading-[1.1] tracking-[-0.015em] whitespace-nowrap text-fg">
              {fact.value}
            </dd>
            <dd class="mt-1 text-sm leading-normal text-fg-muted">{fact.sub}</dd>
          </div>
        ))}
      </dl>
    </div>
  </Section>
) : (
  <Section labelledby="fakten-title" defer>
    <Split>
      <h2 slot="head" id="fakten-title" class="text-display-3 text-fg">
        Gut zu wissen
      </h2>
      <dl class="grid grid-cols-2">
        {facts.map((fact, i) => (
          <div class:list={[item(i), 'reveal']}>
            <dt class="text-xs font-semibold tracking-label text-fg-muted uppercase">{fact.label}</dt>
            <dd class="font-serif text-[length:min(var(--text-xl),12.8cqi)] leading-[1.1] tracking-[-0.015em] whitespace-nowrap text-fg">
              {fact.value}
            </dd>
            <dd class="mt-1 text-sm leading-normal text-fg-muted">{fact.sub}</dd>
          </div>
        ))}
      </dl>
    </Split>
  </Section>
)}
