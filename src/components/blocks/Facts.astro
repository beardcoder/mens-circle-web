---
import { label } from '@lib/ui';

import Section from '../ui/Section.astro';

interface Props {
  anchor: string;
  eyebrow: string;
}

const { anchor, eyebrow } = Astro.props;
---

<Section id={anchor} ground="alt" space="band" labelledby="praktisches-title">
  <h2 id="praktisches-title" class:list={[label, 'mb-6']}>
    {eyebrow}
  </h2>
  <dl class="grid gap-x-grid gap-y-6 md:grid-cols-2 lg:grid-cols-4">
    <slot />
  </dl>
</Section>
