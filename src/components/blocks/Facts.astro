---
import site from '@data/site.json';
import { type DateStatus, readDateStatus, splitFee } from '@lib/event-status';
import { label } from '@lib/ui';

import Section from '../ui/Section.astro';

/**
 * The four answers a cautious reader looks for first, as a compact band on the
 * secondary ground: four equal cells (four columns on the desktop, two on the
 * tablet, one on phones), each a label, a short value and one line of detail. A
 * long fee keeps its value short; the rest goes to the detail. Never more
 * precise than the city. A server island on the home page: without `state` it
 * reads the next date; the fallback shows what is always true.
 */

interface Props {
  state?: DateStatus;
  anchor: string;
  eyebrow: string;
}

const { anchor, eyebrow } = Astro.props;
const { next } = Astro.props.state ?? (await readDateStatus());

const fee = splitFee(next?.costBasis);

const facts = [
  { label: 'Wo', value: next?.place || site.geo.locality, sub: 'Die genaue Adresse kommt mit der Bestätigung' },
  // Non-breaking space: the only acceptable break is before "Wochen".
  { label: 'Wie oft', value: 'Alle 2–4 Wochen', sub: 'Ohne Mitgliedschaft – du kommst, wann es passt' },
  {
    label: 'Dauer',
    value: '2–3 Stunden',
    // Word joiners keep "19:00–21:30" on one line.
    sub: next?.timeRange ? `Nächster Termin: ${next.timeRange.replace('–', '⁠–⁠')}` : 'Ein Abend, kein Seminar',
  },
  { label: 'Beitrag', value: fee.main, sub: fee.note || 'Du gibst, was für dich machbar ist' },
];
---

<Section id={anchor} ground="alt" space="band" labelledby="praktisches-title">
  <h2 id="praktisches-title" class:list={[label, 'mb-6']}>
    {eyebrow}
  </h2>
  <dl class="grid gap-x-grid gap-y-6 md:grid-cols-2 lg:grid-cols-4">
    {facts.map((fact) => (
      <div class="reveal grid content-start gap-1">
        <span aria-hidden="true" class="draw mb-3 block h-px bg-line-strong"></span>
        <dt class="text-sm text-fg-muted">{fact.label}</dt>
        <dd class="text-xl font-semibold text-fg">{fact.value}</dd>
        <dd class="text-sm text-fg-muted">{fact.sub}</dd>
      </div>
    ))}
  </dl>
</Section>
