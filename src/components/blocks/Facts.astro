---
import site from '@data/site.json';
import { type NextEventSummary, summarizeNextEvent } from '@lib/event-status';

/** Quick facts, shared by home and /event. Never more precise than the city. */

interface Props {
  data?: { anchor?: string; eyebrow?: string };
  variant?: 'band' | 'list';
  /** The next scheduled event, when there is one. Read live when omitted. */
  next?: NextEventSummary | null;
}

const { data = {}, variant = 'band' } = Astro.props;
const next =
  Astro.props.next !== undefined
    ? Astro.props.next
    : // Dynamic, so the static fallback never opens SQLite.
      summarizeNextEvent((await (await import('../../lib/server/events')).fetchNextEventState()).event);

const facts = [
  { label: 'Wo', value: next?.place || site.geo.locality, sub: 'Die genaue Adresse kommt mit der Anmeldung' },
  // Non-breaking space: the only acceptable break is before "Wochen".
  { label: 'Wie oft', value: 'Alle 2–4 Wochen', sub: 'Ein fester Rhythmus, keine Mitgliedschaft' },
  {
    label: 'Dauer',
    value: '2–3 Stunden',
    sub: next?.timeRange ? `Nächster Termin: ${next.timeRange}` : 'Ein Abend, kein Wochenendseminar',
  },
  // The event's own fee text wins: it may name an amount "Spendenbasis" swallows.
  { label: 'Beitrag', value: next?.costBasis || 'Spendenbasis', sub: 'Jeder gibt, was für ihn machbar ist' },
];
const anchor = data.anchor ?? 'praktisches';
---

{variant === 'list' ? (
  <section class="section section--ruled event-landing-facts" aria-labelledby="fakten-title">
    <div class="container">
      <div class="spine">
        <h2 class="rail-heading" id="fakten-title">
          Gut zu wissen
        </h2>

        <dl class="deflist spine__body--wide">
          {facts.map((fact) => (
            <div class="deflist__row" data-reveal>
              <dt class="deflist__term">{fact.label}</dt>
              <dd class="deflist__desc">
                {fact.value}
                <span class="deflist__note">{fact.sub}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>
) : (
  <section class="home-facts" id={anchor} aria-labelledby="praktisches-title">
    <div class="container">
      <h2 class="sr-only" id="praktisches-title">
        {data.eyebrow ?? 'Das Wichtigste vorab'}
      </h2>

      <dl class="home-facts__row">
        {facts.map((fact) => (
          <div class="home-facts__item">
            <dt class="home-facts__label">{fact.label}</dt>
            <dd class="home-facts__value">{fact.value}</dd>
            <dd class="home-facts__note">{fact.sub}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
)}

<style is:global>
  @layer sections {
    /* The hero's footing: four facts on one rule, read in a single glance. */
    .home-facts {
      padding-block-end: var(--space-md);
    }

    .home-facts__row {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-md) var(--col-gap);
      margin: 0;
      padding-block: var(--space-md) 0;
      border-block-start: 1px solid var(--rule-strong);
    }

    .home-facts__label {
      font-family: var(--font-ui);
      font-size: 0.875rem;
      font-weight: 560;
      color: var(--text-muted);
    }

    .home-facts__value {
      margin: var(--space-3xs) 0 0;
      font-family: var(--font-display);
      font-size: var(--step-2);
      font-weight: 600;
      font-variation-settings: 'wdth' 90;
      line-height: 1.05;
      color: var(--text-primary);
      letter-spacing: -0.02em;
      text-wrap: balance;
    }

    .home-facts__note {
      max-inline-size: 26ch;
      margin: var(--space-2xs) 0 0;
      font-family: var(--font-body);
      font-size: 0.9375rem;
      line-height: var(--leading-normal);
      color: var(--text-muted);
      text-wrap: pretty;
    }

    @media (width <= 56em) {
      .home-facts__row {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        row-gap: var(--space-lg);
      }
    }
  }
</style>
