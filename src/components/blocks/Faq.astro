---
import site from '@data/site.json';
import { link } from '@lib/ui';
import Accordion from '../ui/Accordion.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Split from '../ui/Split.astro';

interface FaqItem {
  question?: string;
  answer?: string;
}

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    intro?: string;
    items?: FaqItem[];
  };
  ground?: 'default' | 'alt';
}

/**
 * Questions people ask before they come: a short head beside them (the title, an
 * intro, the way to ask what is not there), the questions as one Accordion.
 */

const { data, ground = 'default' } = Astro.props;
const anchor = data.anchor ?? 'faq';
const items = data.items ?? [];
---

<Section id={anchor} ground={ground} labelledby={`${anchor}-title`}>
  <Split>
    <div slot="head" class="grid justify-items-start gap-6">
      <SectionHead
        eyebrow={data.eyebrow}
        title={data.title}
        titleHtml={/<[a-z]/i.test(data.title ?? '')}
        titleId={`${anchor}-title`}
        lead={data.intro}
        leadHtml
        size="sub"
      />
      {site.contactEmail && (
        <p class="max-w-measure text-base text-fg-muted">
          Deine Frage ist nicht dabei? Schreib mir an{' '}
          <a class={link} href={`mailto:${site.contactEmail}`}>
            {site.contactEmail}
          </a>
          .
        </p>
      )}
    </div>

    <Accordion items={items} />
  </Split>
</Section>
