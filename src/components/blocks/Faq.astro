---
import site from '@data/site.json';
import { link } from '@lib/ui';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Split from '../ui/Split.astro';

interface FaqItem {
  question?: string;
  answer?: string;
}

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    titleEmphasis?: string;
    intro?: string;
    items?: FaqItem[];
  };
  ground?: 'default' | 'sand';
}

/**
 * Questions people ask before they come, as a keyboard-operable `<details>` list
 * between hairlines: the questions scan quickly, an answer opens on demand behind
 * a round plus that folds into a minus. The head holds its place beside them,
 * with the way to ask what is not there.
 */

const { data, ground = 'default' } = Astro.props;
const anchor = data.anchor ?? 'faq';
const items = (data.items ?? []).filter((i) => i.question && i.answer);
---

<Section id={anchor} ground={ground} labelledby="faq-title" defer>
  <Split sticky>
    <div slot="head" class="grid justify-items-start gap-6">
      <SectionHead
        eyebrow={data.eyebrow}
        title={data.title}
        titleHtml={/<[a-z]/i.test(data.title ?? '')}
        titleEmphasis={data.titleEmphasis}
        titleId="faq-title"
        lead={data.intro}
        leadHtml
      />
      {site.contactEmail && (
        <p class="text-base text-fg-soft">
          Deine Frage ist nicht dabei? Schreib mir an{' '}
          <a class={link} href={`mailto:${site.contactEmail}`}>
            {site.contactEmail}
          </a>
          .
        </p>
      )}
    </div>

    {items.length > 0 && (
      <div class="border-t border-line">
        {items.map((item) => (
          <details class="group/item border-b border-line [&::details-content]:h-0 [&::details-content]:overflow-clip [&::details-content]:opacity-0 [&::details-content]:transition-[height,content-visibility,opacity] [&::details-content]:duration-300 [&::details-content]:[transition-behavior:allow-discrete] open:[&::details-content]:h-auto open:[&::details-content]:opacity-100">
            <summary
              class="group/q flex min-h-11 list-none items-center justify-between gap-6 px-2 py-6 text-left [&::-webkit-details-marker]:hidden"
              data-umami-event="faq-expand"
              data-umami-event-question={item.question!.slice(0, 50)}
            >
              <span class="font-serif text-xl text-pretty text-fg transition-colors duration-200 group-hover/q:text-accent">
                {item.question}
              </span>
              {/* A round plus: the upright bar folds away into a minus when open. */}
              <span
                aria-hidden="true"
                class="relative grid size-8 shrink-0 place-items-center rounded-full border border-line-strong bg-accent-soft text-fg transition-[background-color,border-color,color,rotate] duration-300 ease-settle group-open/item:rotate-180 group-open/item:border-fill group-open/item:bg-fill group-open/item:text-on-fill group-hover/q:border-fill before:absolute before:h-[1.5px] before:w-3 before:bg-current after:absolute after:h-3 after:w-[1.5px] after:bg-current after:transition-[scale] after:duration-300 group-open/item:after:scale-y-0"
              />
            </summary>
            <div
              class="max-w-measure px-2 pb-8 text-base text-fg-soft [&_a]:text-accent [&_a]:underline"
              set:html={item.answer}
            />
          </details>
        ))}
      </div>
    )}
  </Split>
</Section>
