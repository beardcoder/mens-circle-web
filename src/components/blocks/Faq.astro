---
import site from '@data/site.json';
import { link } from '@lib/ui';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Split from '../ui/Split.astro';

interface FaqItem {
  question?: string;
  answer?: string;
}

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    intro?: string;
    items?: FaqItem[];
  };
  ground?: 'default' | 'sand';
}

/**
 * Questions people ask before they come, as a keyboard-operable `<details>` list:
 * the questions scan quickly, an answer opens on demand. The head holds its place
 * beside them, with the way to ask what is not there.
 */

const { data, ground = 'default' } = Astro.props;
const anchor = data.anchor ?? 'faq';
const items = (data.items ?? []).filter((i) => i.question && i.answer);
---

<Section id={anchor} ground={ground} labelledby="faq-title" defer>
  <Split sticky>
    <div slot="head" class="grid gap-6">
      <SectionHead eyebrow={data.eyebrow} title={data.title} titleHtml titleId="faq-title" lead={data.intro} leadHtml />
      {site.contactEmail && (
        <p class="text-base text-fg-soft">
          Deine Frage ist nicht dabei? Schreib mir an{' '}
          <a class={link} href={`mailto:${site.contactEmail}`}>
            {site.contactEmail}
          </a>
          .
        </p>
      )}
    </div>

    {items.length > 0 && (
      <div class="grid gap-3">
        {items.map((item) => (
          <details class="group/item rounded-card border border-line bg-raised shadow-card transition-[border-color] duration-150 open:border-line-strong [&::details-content]:h-0 [&::details-content]:overflow-clip [&::details-content]:opacity-0 [&::details-content]:transition-[height,content-visibility,opacity] [&::details-content]:duration-[240ms] [&::details-content]:[transition-behavior:allow-discrete] open:[&::details-content]:h-auto open:[&::details-content]:opacity-100">
            <summary
              class="group/q flex min-h-11 list-none items-center justify-between gap-6 rounded-card px-6 py-5 text-left [&::-webkit-details-marker]:hidden"
              data-umami-event="faq-expand"
              data-umami-event-question={item.question!.slice(0, 50)}
            >
              <span class="font-serif text-xl font-medium text-pretty text-fg transition-colors duration-150 group-hover/q:text-accent">
                {item.question}
              </span>
              {/* A plus that turns into a minus. */}
              <span
                aria-hidden="true"
                class="relative size-9 shrink-0 rounded-full bg-accent-soft text-accent transition-[rotate,background-color,color] duration-[240ms] group-open/item:rotate-180 group-open/item:bg-accent group-open/item:text-on-accent before:absolute before:top-1/2 before:left-1/2 before:h-[1.5px] before:w-3.5 before:-translate-1/2 before:bg-current after:absolute after:top-1/2 after:left-1/2 after:h-3.5 after:w-[1.5px] after:-translate-1/2 after:bg-current after:transition-[scale] after:duration-[240ms] group-open/item:after:scale-y-0"
              />
            </summary>
            <div class="max-w-measure px-6 pb-6 text-base text-fg-soft" set:html={item.answer} />
          </details>
        ))}
      </div>
    )}
  </Split>
</Section>
