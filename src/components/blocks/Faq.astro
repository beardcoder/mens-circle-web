---
interface FaqItem {
  question?: string;
  answer?: string;
}

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    intro?: string;
    items?: FaqItem[];
  };
}

/**
 * Frequently asked questions, as a keyboard-operable `<details>` list.
 *
 * No `name` attribute on the elements: an exclusive accordion closes the answer
 * you were reading the moment you open another, which is the wrong behaviour for
 * a list of questions someone is comparing. Several can be open at once.
 *
 * The practical facts (place, duration, contribution) are never *only* here —
 * they are stated in the open, in the facts list near the top of the page. This
 * section answers the doubts, not the logistics.
 */

const { data } = Astro.props;
const anchor = data.anchor ?? 'faq';
const items = (data.items ?? []).filter((i) => i.question && i.answer);
---

<section class="section section--ruled faq-section" id={anchor} aria-labelledby="faq-title">
  <div class="container">
    <div class="spine">
      <p class="rail-heading">{data.eyebrow}</p>

      <div class="spine__body">
        {data.title && <h2 class="section-title" id="faq-title" data-reveal="up" set:html={data.title} />}
        {data.intro && <p class="section-intro faq__intro" data-reveal="up" set:html={data.intro} />}

        {
          items.length > 0 && (
            <div class="faq__list" data-reveal-group="45">
              {items.map((item) => (
                <details class="accordion-item" data-reveal="up">
                  <summary
                    class="accordion-item__trigger"
                    data-umami-event="faq-expand"
                    data-umami-event-question={item.question!.slice(0, 50)}
                  >
                    <span class="accordion-item__question">{item.question}</span>
                    <span class="accordion-item__icon" aria-hidden="true" />
                  </summary>
                  <div class="accordion-item__body">
                    <div class="accordion-item__content" set:html={item.answer} />
                  </div>
                </details>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<style is:global>
  @layer components {
    .accordion-item {
      border-block-end: 1px solid var(--border-light);
    }

    .accordion-item:first-child {
      border-block-start: 1px solid var(--border-light);
    }

    .accordion-item__trigger {
      display: flex;
      gap: var(--space-sm);
      align-items: baseline;
      justify-content: space-between;
      inline-size: 100%;
      min-block-size: 44px;
      padding-block: var(--space-sm);
      font-size: var(--text-lg);
      color: var(--text-primary);
      text-align: start;
      cursor: pointer;
      list-style: none;
      transition: color var(--motion-quick);
    }

    .accordion-item__trigger::-webkit-details-marker {
      display: none;
    }

    .accordion-item__question {
      font-family: var(--font-display);
      line-height: 1.3;
      text-wrap: pretty;
    }

    @media (hover: hover) and (pointer: fine) {
      .accordion-item__trigger:hover {
        color: var(--accent-text);
      }
    }

    .accordion-item__trigger:focus-visible {
      outline: 2px solid var(--accent-primary);
      outline-offset: 2px;
      border-radius: var(--radius-sm);
    }

    /* A plus that becomes a minus. Two 1px rules, no ring, no fill. */
    .accordion-item__icon {
      position: relative;
      flex: none;
      inline-size: 0.75rem;
      block-size: 0.75rem;
      /* Sits on the first line's baseline area rather than floating mid-row. */
      align-self: center;
      color: var(--text-muted);
    }

    .accordion-item__icon::before,
    .accordion-item__icon::after {
      position: absolute;
      inset-block-start: 50%;
      inset-inline-start: 50%;
      content: '';
      background: currentcolor;
      transform: translate(-50%, -50%);
      transition: transform var(--motion-quick);
    }

    .accordion-item__icon::before {
      inline-size: 0.75rem;
      block-size: 1px;
    }

    .accordion-item__icon::after {
      inline-size: 1px;
      block-size: 0.75rem;
    }

    [open] > .accordion-item__trigger .accordion-item__icon::after {
      transform: translate(-50%, -50%) scaleY(0);
    }

    [open] > .accordion-item__trigger {
      color: var(--text-primary);
    }

    .accordion-item::details-content {
      block-size: 0;
      overflow: clip;
      opacity: 0;
      transition:
        block-size var(--motion-standard),
        content-visibility var(--motion-standard) allow-discrete,
        opacity var(--motion-standard);
    }

    .accordion-item[open]::details-content {
      block-size: auto;
      opacity: 1;
    }

    .accordion-item__body {
      font-size: var(--text-section-body);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
    }

    .accordion-item__content {
      max-inline-size: var(--measure);
      padding-block-end: var(--space-sm);
    }

    .accordion-item__content p:last-child {
      margin-block-end: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      .accordion-item__trigger,
      .accordion-item__icon::before,
      .accordion-item__icon::after,
      .accordion-item::details-content {
        transition: none;
      }
    }
  }

  @layer sections {
    .faq__intro {
      margin-block-end: var(--space-md);
    }

    .faq__list {
      margin-block-start: var(--space-md);
    }
  }
</style>
