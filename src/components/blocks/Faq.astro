---
interface FaqItem {
  question?: string;
  answer?: string;
}

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    intro?: string;
    items?: FaqItem[];
  };
}

/** A keyboard-operable `<details>` list. */

const { data } = Astro.props;
const anchor = data.anchor ?? 'faq';
const items = (data.items ?? []).filter((i) => i.question && i.answer);
---

<section class="section faq-section" id={anchor} aria-labelledby="faq-title">
  <div class="container faq__grid">
    <div class="faq__head">
      <p class="marker">{data.eyebrow}</p>
      {data.title && <h2 class="display display--sm faq__title" id="faq-title" set:html={data.title} />}
      {data.intro && <p class="section-intro faq__intro" set:html={data.intro} />}
    </div>

    {items.length > 0 && (
      <div class="faq__list">
        {items.map((item) => (
          <details class="accordion-item">
            <summary
              class="accordion-item__trigger"
              data-umami-event="faq-expand"
              data-umami-event-question={item.question!.slice(0, 50)}
            >
              <span class="accordion-item__question">{item.question}</span>
              <span class="accordion-item__icon" aria-hidden="true" />
            </summary>
            <div class="accordion-item__body">
              <div class="accordion-item__content" set:html={item.answer} />
            </div>
          </details>
        ))}
      </div>
    )}
  </div>
</section>

<style is:global>
  @layer components {
    .accordion-item {
      border-block-end: 1px solid var(--border-medium);
    }

    .accordion-item:first-child {
      border-block-start: 1px solid var(--rule-strong);
    }

    .accordion-item__trigger {
      display: flex;
      gap: var(--space-md);
      align-items: center;
      justify-content: space-between;
      inline-size: 100%;
      min-block-size: 44px;
      padding-block: var(--space-md);
      color: var(--text-primary);
      text-align: start;
      cursor: pointer;
      list-style: none;
    }

    .accordion-item__trigger::-webkit-details-marker {
      display: none;
    }

    .accordion-item__question {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      line-height: 1.25;
      letter-spacing: -0.01em;
      text-wrap: pretty;
      transition: color var(--motion-quick);
    }

    @media (hover: hover) and (pointer: fine) {
      .accordion-item__trigger:hover .accordion-item__question {
        color: var(--accent);
      }

      .accordion-item__trigger:hover .accordion-item__icon {
        border-color: var(--accent);
      }
    }

    .accordion-item__trigger:focus-visible {
      outline: 2px solid var(--focus-ring);
      outline-offset: 2px;
      border-radius: var(--radius);
    }

    /* A seat with a plus that turns into a minus. */
    .accordion-item__icon {
      position: relative;
      flex: none;
      inline-size: 2.25rem;
      block-size: 2.25rem;
      color: var(--text-primary);
      border: 1px solid var(--border-dark);
      border-radius: 50%;
      transition:
        border-color var(--motion-quick),
        background-color var(--motion-quick),
        rotate var(--motion-standard);
    }

    .accordion-item__icon::before,
    .accordion-item__icon::after {
      position: absolute;
      inset-block-start: 50%;
      inset-inline-start: 50%;
      content: '';
      background: currentcolor;
      translate: -50% -50%;
      transition: scale var(--motion-standard);
    }

    .accordion-item__icon::before {
      inline-size: 0.8rem;
      block-size: 1.5px;
    }

    .accordion-item__icon::after {
      inline-size: 1.5px;
      block-size: 0.8rem;
    }

    [open] > .accordion-item__trigger .accordion-item__icon {
      color: var(--on-accent);
      background: var(--accent);
      border-color: var(--accent);
      rotate: 180deg;
    }

    [open] > .accordion-item__trigger .accordion-item__icon::after {
      scale: 1 0;
    }

    .accordion-item::details-content {
      block-size: 0;
      overflow: clip;
      opacity: 0;
      transition:
        block-size var(--motion-standard),
        content-visibility var(--motion-standard) allow-discrete,
        opacity var(--motion-standard);
    }

    .accordion-item[open]::details-content {
      block-size: auto;
      opacity: 1;
    }

    .accordion-item__body {
      font-size: var(--text-section-body);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
    }

    .accordion-item__content {
      max-inline-size: var(--measure);
      padding-block-end: var(--space-md);
      padding-inline-end: 3.5rem;
    }

    .accordion-item__content p:last-child {
      margin-block-end: 0;
    }
  }

  @layer sections {
    .faq__grid {
      display: grid;
      gap: var(--space-lg);
      align-items: start;
    }

    .faq__title {
      margin-block-end: var(--space-md);
    }

    /* Wide: the title holds the left five columns while the questions pass on
       the right; the list starts level with the title. */
    @media (width > 56em) {
      .faq__grid {
        grid-template-columns: var(--field);
        gap: var(--space-xl) var(--field-gap);
      }

      .faq__head {
        position: sticky;
        inset-block-start: calc(var(--header-clearance) + var(--space-md));
        grid-column: 1 / span 5;
      }

      .faq__title {
        max-inline-size: 17ch;
        margin: 0;
        font-size: var(--display-2);
      }

      .faq__intro {
        margin-block-start: var(--space-md);
      }

      .faq__list {
        grid-column: 7 / span 6;
        margin-block-start: calc(var(--text-marker) * 1.3 + var(--space-sm));
      }
    }

    @media (width <= 56em) {
      .faq__grid {
        grid-template-columns: minmax(0, 1fr);
      }

      .accordion-item__content {
        padding-inline-end: 0;
      }
    }
  }
</style>
