---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Split from '../ui/Split.astro';

interface FaqItem {
  question?: string;
  answer?: string;
}

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    intro?: string;
    items?: FaqItem[];
  };
}

/**
 * Questions people ask before they come, as a keyboard-operable `<details>` list:
 * the questions scan quickly, an answer opens on demand. Wide: the title holds
 * columns 1–5 while the questions pass on the right.
 */

const { data } = Astro.props;
const anchor = data.anchor ?? 'faq';
const items = (data.items ?? []).filter((i) => i.question && i.answer);
---

<Section id={anchor} labelledby="faq-title" defer>
  <Split sticky alignToTitle>
    <SectionHead
      slot="head"
      eyebrow={data.eyebrow}
      title={data.title}
      titleHtml
      titleId="faq-title"
      lead={data.intro}
    />

    {items.length > 0 && (
      <div>
        {items.map((item) => (
          <details class="group/item border-b border-line-strong first:border-t first:border-t-fg [&::details-content]:h-0 [&::details-content]:overflow-clip [&::details-content]:opacity-0 [&::details-content]:transition-[height,content-visibility,opacity] [&::details-content]:duration-[240ms] [&::details-content]:[transition-behavior:allow-discrete] open:[&::details-content]:h-auto open:[&::details-content]:opacity-100">
            <summary
              class="group/q flex min-h-11 list-none items-center justify-between gap-6 rounded-control py-6 text-left [&::-webkit-details-marker]:hidden"
              data-umami-event="faq-expand"
              data-umami-event-question={item.question!.slice(0, 50)}
            >
              <span class="font-serif text-xl leading-tight tracking-[-0.01em] text-pretty text-fg transition-colors duration-150 group-hover/q:text-accent">
                {item.question}
              </span>
              {/* A seat with a plus that turns into a minus. */}
              <span
                aria-hidden="true"
                class="relative size-9 shrink-0 rounded-full border border-line-bold text-fg transition-[border-color,background-color,rotate] duration-[240ms] group-hover/q:border-accent group-open/item:rotate-180 group-open/item:border-accent group-open/item:bg-accent group-open/item:text-on-accent before:absolute before:top-1/2 before:left-1/2 before:h-[1.5px] before:w-3.25 before:-translate-1/2 before:bg-current after:absolute after:top-1/2 after:left-1/2 after:h-3.25 after:w-[1.5px] after:-translate-1/2 after:bg-current after:transition-[scale] after:duration-[240ms] group-open/item:after:scale-y-0"
              />
            </summary>
            <div class="max-w-measure pb-6 text-md text-fg-soft lg:pr-14" set:html={item.answer} />
          </details>
        ))}
      </div>
    )}
  </Split>
</Section>
