---
import site from '@data/site.json';
import { link } from '@lib/ui';

import Accordion from '../ui/Accordion.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Split from '../ui/Split.astro';

interface Props {
  anchor: string;
  eyebrow: string;
  title: string;
  intro?: string;
}

/**
 * Questions people ask before they come: a short head beside them (the title, an
 * intro, the way to ask what is not there), the questions as one Accordion.
 */

const { anchor, eyebrow, title, intro } = Astro.props;
---

<Section id={anchor} labelledby={`${anchor}-title`}>
  <div itemscope itemtype="https://schema.org/FAQPage">
    <Split>
      <div slot="head" class="grid justify-items-start gap-6 lg:sticky lg:top-(--spacing-clearance)">
        <SectionHead eyebrow={eyebrow} title={title} titleId={`${anchor}-title`} lead={intro} leadHtml />
        {site.contactEmail && (
          <p class="max-w-measure text-base text-fg-muted">
            Deine Frage ist nicht dabei? Schreib mir an{' '}
            <a class={link} href={`mailto:${site.contactEmail}`}>
              {site.contactEmail}
            </a>
            .
          </p>
        )}
      </div>

      <Accordion>
        <slot />
      </Accordion>
    </Split>
  </div>
</Section>
