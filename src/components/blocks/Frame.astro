---
import { Icon } from 'astro-icon/components';

import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Agreement {
  title: string;
  text?: string;
}

interface Props {
  anchor: string;
  eyebrow: string;
  title: string;
  intro: string;
  agreements: Agreement[];
  boundaryTitle: string;
  boundaryText: string;
}

const { anchor, eyebrow, title, intro, agreements, boundaryTitle, boundaryText } = Astro.props;
---

<Section id={anchor} ground="tint" labelledby="rahmen-title">
  <SectionHead eyebrow={eyebrow} title={title} titleId="rahmen-title" lead={intro} />

  {agreements.length > 0 && (
    <ol role="list" class="mt-group grid gap-4 md:grid-cols-2">
      {agreements.map((rule, i) => (
        <li class="grid content-start gap-3 rounded-xl bg-raised p-6 shadow-card sm:p-7">
          <span
            aria-hidden="true"
            class="grid size-10 place-items-center rounded-full bg-accent-soft font-display text-lg text-accent"
          >
            {i + 1}
          </span>
          <h3 class="text-sub text-fg hyphens-auto">{rule.title}</h3>
          <p class="max-w-measure text-md text-fg-soft">{rule.text}</p>
        </li>
      ))}
    </ol>
  )}

  {boundaryText && (
    <aside
      aria-labelledby="rahmen-boundary-title"
      class="mt-6 grid max-w-3xl grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-1 rounded-xl border border-line-strong p-6 sm:p-7"
    >
      <Icon name="info" aria-hidden="true" class="row-span-2 mt-0.5 size-6 text-accent" />
      <h3 id="rahmen-boundary-title" class="font-sans text-base font-semibold text-fg">
        {boundaryTitle}
      </h3>
      <p class="text-md text-fg-soft">{boundaryText}</p>
    </aside>
  )}
</Section>
