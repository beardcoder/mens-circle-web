---
import { margin } from '@lib/ui'

import Prose from '../ui/Prose.astro'
import Section from '../ui/Section.astro'
import SectionHead from '../ui/SectionHead.astro'

interface Props {
  anchor: string
  eyebrow?: string
  title: string
  intro: string
  pledge: string
  boundaryTitle: string
  boundaryText: string
}

const { anchor, eyebrow, title, intro, pledge, boundaryTitle, boundaryText } = Astro.props
---

<Section
  id={anchor}
  ground="dark"
  labelledby="rahmen-title"
>
  <div class:list={[margin.grid, 'gap-y-group']}>
    <SectionHead
      eyebrow={eyebrow}
      title={title}
      titleId="rahmen-title"
      lead={intro}
      class={margin.cross}
    />

    <div class:list={[margin.grid, 'items-start gap-y-6 border-y border-line py-8 lg:col-span-12 lg:py-12']}>
      <p class="max-w-[18em] text-pretty font-display text-sub text-fg lg:col-span-5">{pledge}</p>
      <Prose class="lg:col-span-6 lg:col-start-7">
        <slot />
      </Prose>
    </div>

    {boundaryText && (
      <aside
        aria-labelledby="rahmen-boundary-title"
        class:list={[margin.grid, 'gap-y-3 lg:col-span-12']}
      >
        <h3
          id="rahmen-boundary-title"
          class:list={[margin.side, 'font-sans text-base font-semibold text-fg']}
        >
          {boundaryTitle}
        </h3>
        <p class:list={[margin.reading, 'max-w-measure text-md text-fg-soft']}>{boundaryText}</p>
      </aside>
    )}
  </div>
</Section>
