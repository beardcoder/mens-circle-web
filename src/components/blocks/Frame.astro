---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Agreement {
  title?: string;
  text?: string;
}

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    intro?: string;
    agreements?: Agreement[];
    boundaryTitle?: string;
    boundaryText?: string;
  };
}

/**
 * The agreements every evening starts with, as an ordered list in two columns
 * (one on phones) under thin lines, and the note that says what the circle is
 * not, as plain additional information under them.
 */

const { data } = Astro.props;
const anchor = data.anchor ?? 'rahmen';
const agreements = data.agreements ?? [];
---

<Section id={anchor} ground="alt" labelledby="rahmen-title">
  <SectionHead eyebrow={data.eyebrow} title={data.title} titleId="rahmen-title" lead={data.intro} />

  {agreements.length > 0 && (
    <ol role="list" class="mt-group grid gap-x-grid gap-y-6 md:grid-cols-2">
      {agreements.map((rule) => (
        <li class="grid content-start gap-2 border-t border-line-strong pt-5">
          <h3 class="font-sans text-xl font-semibold text-fg hyphens-auto">{rule.title}</h3>
          <p class="max-w-measure text-md text-fg-soft">{rule.text}</p>
        </li>
      ))}
    </ol>
  )}

  {data.boundaryText && (
    <aside
      aria-labelledby="rahmen-boundary-title"
      class="mt-group grid max-w-[48rem] gap-2 border-l-2 border-line-strong pl-5"
    >
      <h3 id="rahmen-boundary-title" class="font-sans text-base font-semibold text-fg">
        {data.boundaryTitle ?? 'Gut zu wissen'}
      </h3>
      <p class="text-md text-fg-soft">{data.boundaryText}</p>
    </aside>
  )}
</Section>
