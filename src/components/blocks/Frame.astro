---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Agreement {
  title?: string;
  text?: string;
}

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    titleEmphasis?: string;
    intro?: string;
    agreements?: Agreement[];
    boundaryTitle?: string;
    boundaryText?: string;
  };
}

/** The agreements every evening starts with, as a field of equal cells parted by hairlines, and the one note that says what the circle is not, across its foot. */

const { data } = Astro.props;
const anchor = data.anchor ?? 'rahmen';
const agreements = data.agreements ?? [];
---

<Section id={anchor} labelledby="rahmen-title" defer>
  <SectionHead
    eyebrow={data.eyebrow}
    title={data.title}
    titleEmphasis={data.titleEmphasis}
    titleId="rahmen-title"
    lead={data.intro}
    size="display-3"
    align="center"
    class="mx-auto max-w-prose"
  />

  {agreements.length > 0 && (
    <ul role="list" class="mt-group grid border-y border-line sm:grid-cols-2">
      {agreements.map((rule) => (
        <li class="reveal grid content-start gap-3 border-line px-1 py-10 max-sm:not-first:border-t sm:px-10 sm:even:border-l sm:nth-[n+3]:border-t lg:px-14">
          <h3 class="text-2xl text-fg hyphens-auto">{rule.title}</h3>
          <p class="max-w-measure text-base text-fg-soft">{rule.text}</p>
        </li>
      ))}
    </ul>
  )}

  {data.boundaryText && (
    <aside
      aria-labelledby="rahmen-boundary-title"
      class="reveal grid gap-3 border-b border-line px-1 py-10 sm:px-10 lg:grid-cols-12 lg:gap-x-grid lg:px-14"
    >
      <h3 id="rahmen-boundary-title" class="font-serif text-2xl text-accent italic lg:col-span-4">
        {data.boundaryTitle ?? 'Gut zu wissen'}
      </h3>
      <p class="max-w-measure text-base text-fg-soft lg:col-span-8">{data.boundaryText}</p>
    </aside>
  )}
</Section>
