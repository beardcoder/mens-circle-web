---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Agreement {
  title?: string;
  text?: string;
}

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    intro?: string;
    agreements?: Agreement[];
    boundaryTitle?: string;
    boundaryText?: string;
  };
}

/**
 * The agreements every evening starts with — unnumbered, none comes first, each
 * under its own hairline — and the one place that says what the circle is not.
 */

const { data } = Astro.props;
const anchor = data.anchor ?? 'rahmen';
const agreements = data.agreements ?? [];
---

<Section id={anchor} ground="sand" labelledby="rahmen-title" defer>
  <SectionHead eyebrow={data.eyebrow} title={data.title} titleId="rahmen-title" lead={data.intro} layout="split" />

  {agreements.length > 0 && (
    <ul role="list" class="mt-group grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 sm:gap-y-group xl:grid-cols-4">
      {agreements.map((rule) => (
        <li class="reveal @container grid content-start gap-2 border-t border-line-strong pt-6">
          {/* Capped by the column: "Eigenverantwortung" is one word. */}
          <h3 class="text-[length:min(var(--text-2xl),9.5cqi)] leading-[1.15] font-medium tracking-[-0.015em] text-fg">
            {rule.title}
          </h3>
          <p class="text-md text-fg-soft">{rule.text}</p>
        </li>
      ))}
    </ul>
  )}

  {data.boundaryText && (
    <aside
      aria-labelledby="rahmen-boundary-title"
      class="reveal mt-group grid gap-x-grid gap-y-3 rounded-control border border-line-strong bg-ground p-6 sm:p-8 lg:grid-cols-12 lg:items-baseline"
    >
      <h3 id="rahmen-boundary-title" class="font-serif text-2xl text-fg italic lg:col-span-4">
        {data.boundaryTitle ?? 'Gut zu wissen'}
      </h3>
      <p class="max-w-[58ch] text-lg text-fg-soft lg:col-span-8">{data.boundaryText}</p>
    </aside>
  )}
</Section>
