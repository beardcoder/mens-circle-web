---
import { card } from '@lib/ui';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Agreement {
  title?: string;
  text?: string;
}

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    intro?: string;
    agreements?: Agreement[];
    boundaryTitle?: string;
    boundaryText?: string;
  };
}

/** The agreements every evening starts with, as equal cards, and the one note that says what the circle is not. */

const { data } = Astro.props;
const anchor = data.anchor ?? 'rahmen';
const agreements = data.agreements ?? [];
---

<Section id={anchor} ground="sand" labelledby="rahmen-title" defer>
  <SectionHead eyebrow={data.eyebrow} title={data.title} titleId="rahmen-title" lead={data.intro} size="display-2" />

  {agreements.length > 0 && (
    <ul role="list" class="mt-group grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {agreements.map((rule) => (
        <li class:list={[card, 'reveal grid content-start gap-2 p-6']}>
          <h3 class="text-xl text-fg hyphens-auto">{rule.title}</h3>
          <p class="text-base text-fg-soft">{rule.text}</p>
        </li>
      ))}
    </ul>
  )}

  {data.boundaryText && (
    <aside
      aria-labelledby="rahmen-boundary-title"
      class="reveal mt-6 grid gap-2 rounded-card border border-line-strong p-6 sm:p-8 lg:grid-cols-12 lg:gap-x-grid"
    >
      <h3 id="rahmen-boundary-title" class="text-xl text-fg lg:col-span-4">
        {data.boundaryTitle ?? 'Gut zu wissen'}
      </h3>
      <p class="max-w-measure text-base text-fg-soft lg:col-span-8">{data.boundaryText}</p>
    </aside>
  )}
</Section>
