---
import { PENDING } from '@lib/event-status';

import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import HeroDate from './HeroDate.astro';

/**
 * The home opening on the dark focus ground: the statement (its phrase in the
 * italic accent), the short explanation, the main action with the quiet link to
 * the course of an evening, and beside them the next date. Phones stack it:
 * statement, explanation, date, action. The circle stands in the right
 * background: two thin rings breathing out of phase. The words rise in, one after
 * the other. A responsive minimum height gives it room while longer content can
 * expand naturally. The date and the
 * action are a server island (HeroDate); its fallback stands the same height.
 */

interface Props {
  kicker: string;
  /** The central sentence. */
  title: string;
  /** A phrase inside `title` set in the italic accent. */
  titleEmphasis: string;
  lede: string;
  secondaryLabel: string;
  secondaryLink: string;
}

const { kicker, title, titleEmphasis, lede, secondaryLabel, secondaryLink } = Astro.props;
const emphasis = titleEmphasis && title.includes(titleEmphasis) ? titleEmphasis : '';
const [before, after] = emphasis ? title.split(emphasis) : [title, ''];
---

<section
  data-hero
  aria-labelledby="hero-title"
  class="surface-dark hero-gradient relative flex min-h-[90svh] items-center overflow-clip pt-[calc(var(--spacing-header)+var(--spacing-group)+1rem)] pb-[calc(var(--spacing-section)+1.5rem)] lg:min-h-[min(58rem,100svh)] lg:pt-[calc(var(--spacing-header)+var(--spacing-section)+1.5rem)]"
>
  {/* Thin rings breathe slowly, without adding visual weight. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute right-[-14rem] bottom-[-15rem] aspect-square w-[30rem] lg:top-[calc(50%-22rem)] lg:right-[-16rem] lg:bottom-auto lg:w-[44rem]"
  >
    <span class="absolute inset-0 rounded-[48%_52%_46%_54%/54%_45%_55%_46%] border border-line-strong motion-safe:animate-ring"></span>
    <span class="absolute inset-[23%] rounded-[54%_46%_52%_48%/46%_55%_45%_54%] border border-line motion-safe:animate-ring-slow motion-safe:animate-delay-[-7s]"></span>
  </div>

  <Container class="relative grid gap-x-grid gap-y-8 lg:grid-cols-12">
    <div class="grid min-w-0 justify-items-start lg:col-span-7 lg:row-start-1">
      {kicker && <Eyebrow class="mb-4 entrance:animate-rise">{kicker}</Eyebrow>}
      <h1
        id="hero-title"
        class="max-w-[9.5em] text-hero text-fg wrap-anywhere hyphens-auto entrance:animate-rise entrance:animate-delay-[90ms]"
      >
        {before}
        {emphasis && <em class="font-serif font-normal text-accent">{emphasis}</em>}
        {after}
      </h1>
      {lede && (
        <p class="mt-6 max-w-measure text-lg text-fg-muted entrance:animate-rise entrance:animate-delay-[180ms]">
          {lede}
        </p>
      )}
    </div>

    <HeroDate server:defer secondaryLabel={secondaryLabel} secondaryLink={secondaryLink}>
      <HeroDate slot="fallback" state={PENDING} secondaryLabel={secondaryLabel} secondaryLink={secondaryLink} />
    </HeroDate>
  </Container>
</section>
