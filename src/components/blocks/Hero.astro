---
import CropPicture from '../CropPicture.astro';
import { resolveAssetImage } from '../../lib/images';
import BrushRing from '../BrushRing.astro';
import HomeEventStatus from '../HomeEventStatus.astro';

/**
 * The home page opening, set like the flyer: a near-black poster, the sentence
 * inside the painted ring, the date in orange capitals — and the photograph
 * beside it. Below, the four parts of an evening.
 */

interface Pillar {
  title?: string;
  text?: string;
}

interface Props {
  data: {
    kicker?: string;
    /** The central sentence. */
    title?: string;
    /** A phrase inside `title` set in the accent. */
    titleEmphasis?: string;
    /** Three short words under the sentence, inside the ring. */
    claim?: string;
    lede?: string;
    pillarsLabel?: string;
    pillars?: Pillar[];
    secondaryLabel?: string;
    secondaryLink?: string;
    image?: string;
    imageAlt?: string;
    imageCaption?: string;
  };
}

const { data } = Astro.props;
const photo = resolveAssetImage(data.image);
const pillars = data.pillars ?? [];

const title = data.title ?? '';
const emphasis = data.titleEmphasis && title.includes(data.titleEmphasis) ? data.titleEmphasis : '';
const [before, after] = emphasis ? title.split(emphasis) : [title, ''];
---

<section class="home-hero surface-night section--clip" aria-labelledby="hero-title">
  <div class="container home-hero__grid">
    <div class="home-hero__poster">
      {data.kicker && (
        <p class="marker marker--plain home-hero__kicker" aria-hidden="true">
          {data.kicker}
        </p>
      )}

      <div class="home-hero__ring-wrap">
        <BrushRing class="home-hero__ring" seed={11} entrance />
        <div class="home-hero__inside">
          <h1 class="home-hero__title" id="hero-title">
            {data.kicker && <span class="sr-only">{data.kicker}: </span>}
            {before}
            {emphasis && <em>{emphasis}</em>}
            {after}
          </h1>
          {data.claim && <p class="home-hero__claim">{data.claim}</p>}
        </div>
      </div>
    </div>

    <div class="home-hero__details">
      <HomeEventStatus
        placement="hero"
        secondaryLabel={data.secondaryLabel}
        secondaryLink={data.secondaryLink}
        server:defer
      >
        <HomeEventStatus
          placement="hero"
          secondaryLabel={data.secondaryLabel}
          secondaryLink={data.secondaryLink}
          fallback
          slot="fallback"
        />
      </HomeEventStatus>
    </div>

    {photo && (
      <figure class="home-hero__figure">
        <div class="home-hero__frame">
          <CropPicture
            src={photo}
            class="home-hero__image"
            breakpoint="56em"
            narrow={{ ratio: 4 / 3, widths: [420, 700, 960], sizes: '100vw' }}
            wide={{ ratio: 4 / 5, widths: [420, 640, 840], sizes: 'min(30rem, 36vw)' }}
            loading="eager"
            fetchpriority="high"
            alt={data.imageAlt ?? ''}
          />
        </div>
        {data.imageCaption && <figcaption class="caption">{data.imageCaption}</figcaption>}
      </figure>
    )}
  </div>

  {(data.lede || pillars.length > 0) && (
    <div class="container home-hero__below">
      {data.lede && <p class="home-hero__lede">{data.lede}</p>}

      {pillars.length > 0 && (
        <div class="home-hero__pillars">
          {data.pillarsLabel && <p class="home-hero__pillars-label quote-voice">{data.pillarsLabel}</p>}
          <ul class="home-hero__pillar-list" role="list">
            {pillars.map((pillar) => (
              <li class="home-hero__pillar">
                <span class="home-hero__pillar-title">{pillar.title}</span>
                <span class="home-hero__pillar-text">{pillar.text}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  )}
</section>

<style is:global>
  @layer sections {
    .home-hero {
      padding-block: calc(var(--header-height) + var(--space-lg)) var(--space-xl);
    }

    .home-hero__grid {
      display: grid;
      grid-template-areas:
        'poster  figure'
        'details figure';
      grid-template-rows: auto 1fr;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-lg) var(--space-xl);
      align-items: start;
    }

    .home-hero__poster {
      grid-area: poster;
    }

    .home-hero__kicker {
      justify-content: center;
      max-inline-size: 36rem;
      margin-block-end: var(--space-md);
      color: var(--text-primary);
    }

    /* The ring and its sentence. The wrapper is a size container, so the type
       scales with the ring and can never run into the stroke. */
    .home-hero__ring-wrap {
      position: relative;
      display: grid;
      place-items: center;
      inline-size: min(100%, 36rem);
      aspect-ratio: 1;
      container-type: inline-size;
    }

    .home-hero__ring {
      position: absolute;
      inset: 0;
    }

    .home-hero__inside {
      position: relative;
      display: grid;
      gap: 3cqi;
      justify-items: center;
      inline-size: 68%;
      text-align: center;
    }

    .home-hero__title {
      margin: 0;
      font-size: 9.3cqi;
      font-weight: 800;
      line-height: 1;
      letter-spacing: -0.035em;
      color: var(--text-primary);
      text-wrap: balance;
    }

    .home-hero__title em {
      font-style: normal;
      color: var(--accent);
    }

    .home-hero__claim {
      margin: 0;
      font-size: 3.6cqi;
      font-weight: 500;
      color: var(--text-secondary);
      letter-spacing: 0.02em;
    }

    .home-hero__details {
      grid-area: details;
      max-inline-size: 36rem;
      padding-block-start: var(--space-md);
      border-block-start: 2px solid var(--accent);
    }

    .home-hero__figure {
      grid-area: figure;
      /* Level with the top of the ring, below the kicker line. */
      margin: calc(var(--space-md) + 1rem) 0 0;
    }

    .home-hero__frame {
      overflow: clip;
      aspect-ratio: 4 / 5;
      border-radius: var(--radius);
    }

    .home-hero__frame picture {
      display: block;
      block-size: 100%;
    }

    .home-hero__image {
      display: block;
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
      object-position: 30% 50%;
    }

    .home-hero__below {
      display: grid;
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      gap: var(--space-lg) var(--space-xl);
      align-items: start;
      padding-block-start: var(--space-xl);
      margin-block-start: var(--space-xl);
      /* A hairline across the content box only, not into the gutters. */
      background: linear-gradient(var(--border-light), var(--border-light)) center top /
        calc(100% - 2 * var(--container-gutter)) 1px no-repeat;
    }

    .home-hero__lede {
      max-inline-size: 46ch;
      margin: 0;
      font-size: var(--text-section-body-lg);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
    }

    .home-hero__pillars-label {
      margin-block-end: var(--space-xs);
      font-size: var(--text-xl);
      color: var(--accent);
    }

    .home-hero__pillar-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: 0;
      margin: 0;
      list-style: none;
      border-block-start: 1px solid var(--border-medium);
    }

    .home-hero__pillar {
      display: grid;
      gap: var(--space-3xs);
      align-content: start;
      padding: var(--space-sm) var(--space-sm) var(--space-sm) 0;
      border-block-end: 1px solid var(--border-light);
    }

    .home-hero__pillar:nth-child(even) {
      padding-inline-start: var(--space-sm);
      border-inline-start: 1px solid var(--border-light);
    }

    .home-hero__pillar-title {
      display: flex;
      gap: 0.5em;
      align-items: center;
      font-size: var(--text-lg);
      font-weight: 800;
      letter-spacing: -0.01em;
      color: var(--text-primary);
    }

    .home-hero__pillar-title::before {
      flex: none;
      inline-size: 0.5rem;
      block-size: 0.5rem;
      content: '';
      background: var(--accent);
      border-radius: 50%;
    }

    .home-hero__pillar-text {
      font-size: var(--text-caption);
      line-height: 1.5;
      color: var(--text-muted);
    }

    /* Entrance: the sentence rises inside the turning ring. Under a second. */
    @media (prefers-reduced-motion: no-preference) {
      .home-hero__kicker {
        animation: rise 520ms var(--ease-settle) both;
      }

      .home-hero__inside {
        animation: rise 700ms var(--ease-emphasised) 120ms both;
      }

      .home-hero__details {
        animation: rise 600ms var(--ease-settle) 320ms both;
      }

      .home-hero__figure {
        animation: fade-in 800ms var(--ease-settle) 200ms both;
      }

      .vt-arrival :is(.home-hero__kicker, .home-hero__inside, .home-hero__details, .home-hero__figure) {
        animation: none;
      }
    }

    /* Phone and tablet: its own order. The ring first, full width; then the date
       and the action; then the photograph as a band; then the reading. */
    @media (width <= 56em) {
      .home-hero {
        padding-block: calc(var(--header-height) + var(--space-md)) var(--space-xl);
      }

      .home-hero__grid {
        grid-template-areas:
          'poster'
          'details'
          'figure';
        grid-template-rows: none;
        grid-template-columns: minmax(0, 1fr);
      }

      .home-hero__kicker,
      .home-hero__ring-wrap {
        margin-inline: auto;
      }

      .home-hero__details {
        max-inline-size: none;
      }

      .home-hero__figure {
        margin: var(--space-md) calc(-1 * var(--container-gutter)) 0;
      }

      .home-hero__frame {
        aspect-ratio: 4 / 3;
        border-radius: 0;
      }

      .home-hero__figure .caption {
        padding-inline: var(--container-gutter);
      }

      .home-hero__below {
        grid-template-columns: minmax(0, 1fr);
        padding-block-start: var(--space-lg);
        margin-block-start: var(--space-lg);
      }
    }

    @media (width <= 30em) {
      .home-hero__pillar-list {
        grid-template-columns: minmax(0, 1fr);
      }

      .home-hero__pillar,
      .home-hero__pillar:nth-child(even) {
        padding-inline: 0;
        border-inline-start: 0;
      }
    }
  }
</style>
