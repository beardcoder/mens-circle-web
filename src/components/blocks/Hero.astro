---
import Breath from '../Breath.astro';
import CropPicture from '../CropPicture.astro';
import { resolveAssetImage } from '../../lib/images';
import HomeEventStatus from '../HomeEventStatus.astro';
import SeatRing from '../SeatRing.astro';

/** The home page opening: the sentence, the circle with one seat kept free, and the way in. */

interface Props {
  data: {
    kicker?: string;
    /** The central sentence, one block element per line. */
    displayLines?: string[];
    body?: string;
    secondaryLabel?: string;
    secondaryLink?: string;
    image?: string;
    imageAlt?: string;
    imageCaption?: string;
  };
}

const { data } = Astro.props;
const photo = resolveAssetImage(data.image);
const lines = data.displayLines ?? [];
// Seat 7 sits low on the left, on the side of the text: the one that is free.
const OPEN_SEAT = 7;
---

<section class="home-hero section--clip">
  <div class="container home-hero__grid">
    <div class="home-hero__type">
      <h1 class="home-hero__heading">
        {data.kicker && <span class="kicker home-hero__kicker">{data.kicker}</span>}
        <span class="display home-hero__display">
          {lines.map((line) => (
            <span class="display__line">{line}</span>
          ))}
        </span>
      </h1>

      {data.body && <p class="home-hero__lede">{data.body}</p>}
    </div>

    <figure class="home-hero__kreis kreis">
      <Breath class="kreis__breath" />
      {photo && (
        <div class="kreis__window">
          <CropPicture
            src={photo}
            class="kreis__image"
            breakpoint="56em"
            narrow={{ ratio: 1, widths: [400, 640, 900], sizes: '80vw' }}
            wide={{ ratio: 1, widths: [440, 640, 880], sizes: 'min(38vw, 34rem)' }}
            loading="eager"
            fetchpriority="high"
            alt={data.imageAlt ?? ''}
          />
        </div>
      )}
      <SeatRing class="kreis__ring" seats={12} open={[OPEN_SEAT]} seatSize={4.8} enter turn />
      {data.imageCaption && <figcaption class="caption kreis__caption">{data.imageCaption}</figcaption>}
    </figure>

    <div class="home-hero__action">
      <HomeEventStatus
        placement="hero"
        secondaryLabel={data.secondaryLabel}
        secondaryLink={data.secondaryLink}
        server:defer
      >
        <HomeEventStatus
          placement="hero"
          secondaryLabel={data.secondaryLabel}
          secondaryLink={data.secondaryLink}
          fallback
          slot="fallback"
        />
      </HomeEventStatus>
    </div>
  </div>
</section>

<style is:global>
  @layer sections {
    .home-hero {
      position: relative;
      padding-block: calc(var(--header-clearance) + var(--space-lg)) var(--space-xl);
      isolation: isolate;
    }

    .home-hero__grid {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto 1fr;
      column-gap: var(--col-gap);
      align-items: start;
    }

    .home-hero__type {
      position: relative;
      z-index: 1;
      grid-row: 1;
      grid-column: 1 / span 7;
    }

    .home-hero__heading {
      margin: 0;
      font-size: inherit;
      letter-spacing: normal;
    }

    .home-hero__kicker {
      margin-block-end: var(--space-md);
      color: var(--text-secondary);
    }

    .home-hero__display {
      display: block;
      font-size: clamp(2.6rem, 1.2rem + 5.2vw, 6.75rem);
      color: var(--text-primary);
    }

    /* The serif speaks after the sentence: what actually happens on such an evening. */
    .home-hero__lede {
      max-inline-size: 40ch;
      margin-block: var(--space-lg) 0;
      font-family: var(--font-body);
      font-size: var(--step-1);
      font-weight: 380;
      line-height: 1.5;
      color: var(--text-secondary);
    }

    .home-hero__action {
      position: relative;
      z-index: 1;
      grid-row: 2;
      grid-column: 1 / span 7;
      align-self: end;
      margin-block-start: var(--space-lg);
    }

    /* The status line: the circle's open seat, in words. */
    .home-hero__status {
      display: flex;
      gap: 0.65em;
      align-items: baseline;
      max-inline-size: 46ch;
      margin-block-end: var(--space-sm);
      font-family: var(--font-ui);
      font-size: 1.0625rem;
      font-weight: 560;
      line-height: var(--leading-snug);
      color: var(--text-primary);
    }

    .home-hero__status::before {
      flex: none;
      inline-size: 0.6em;
      block-size: 0.6em;
      content: '';
      border: 2px solid var(--accent);
      border-radius: 50%;
      translate: 0 -0.05em;
    }

    .home-hero__status[data-status='none']::before,
    .home-hero__status[data-status='loading']::before {
      border-color: var(--text-muted);
    }

    /* A failed read is marked, never dressed as "nothing planned". */
    .home-hero__status[data-status='unavailable']::before {
      background: var(--color-error);
      border-color: var(--color-error);
      border-radius: 0;
    }

    /* The circle: photograph in a round window, the breath around it, the seats around that. */
    .kreis {
      position: relative;
      container-type: inline-size;
      aspect-ratio: 1;
      margin: 0;
    }

    .home-hero__kreis {
      grid-row: 1 / span 2;
      grid-column: 8 / -1;
      align-self: center;
      inline-size: calc(100% + var(--container-gutter) * 0.6);
    }

    .kreis .kreis__breath {
      --breath-x: 0.5;
      --breath-y: 0.5;
      --breath-radius: 47cqi;
      --breath-fade: 0;

      inset: -18%;
      overflow: visible;
    }

    .kreis__window {
      position: absolute;
      inset: 13%;
      overflow: hidden;
      background: var(--bg-secondary);
      border-radius: 50%;
    }

    /* Zoomed a little towards the figure, who sits at the left of the frame. */
    .kreis__image {
      display: block;
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
      scale: 1.12;
      transform-origin: 30% 30%;
    }

    .kreis__ring {
      position: absolute;
      inset: 0;
    }

    .kreis__caption {
      position: absolute;
      inset-block-start: 100%;
      inset-inline-start: 13%;
      margin: 0;
    }

    /* Phones and tablets: a composition of its own. The sentence first, then the
       circle breaking out of the column to the right, then the way in. */
    @media (width <= 56em) {
      .home-hero {
        padding-block: calc(var(--header-clearance) + var(--space-md)) var(--space-lg);
      }

      .home-hero__grid {
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: none;
      }

      .home-hero__type,
      .home-hero__kreis,
      .home-hero__action {
        grid-row: auto;
        grid-column: 1;
      }

      .home-hero__kreis {
        justify-self: end;
        inline-size: min(88vw, 30rem);
        margin-block: var(--space-md) calc(var(--space-lg) + 1.5rem);
        margin-inline-end: calc(var(--container-gutter) * -1 - 6vw);
      }

      .home-hero__lede {
        margin-block-start: var(--space-md);
      }

      .home-hero__action {
        margin-block-start: 0;
      }
    }

    @media (width <= 30em) {
      .home-hero__action .actions {
        flex-direction: column;
        align-items: stretch;
      }

      .home-hero__action .btn {
        inline-size: 100%;
      }

      .home-hero__action .text-link {
        align-self: center;
      }
    }
  }
</style>
