---
import site from '@data/site.json';
import CropPicture from '../CropPicture.astro';
import { resolveAssetImage } from '../../lib/images';
import HomeEventStatus from '../HomeEventStatus.astro';
import Breath from '../Breath.astro';
import SeatCircle from '../SeatCircle.astro';

/** The home page opening on the night ground: the sentence, the four parts of an evening, and the photograph inside the seat circle. */

interface Pillar {
  title?: string;
  text?: string;
}

interface Props {
  data: {
    kicker?: string;
    /** The central sentence. */
    title?: string;
    /** A phrase inside `title` set in the accent. */
    titleEmphasis?: string;
    /** Three short words under the sentence. */
    claim?: string;
    lede?: string;
    pillarsLabel?: string;
    pillars?: Pillar[];
    secondaryLabel?: string;
    secondaryLink?: string;
    image?: string;
    imageAlt?: string;
    imageCaption?: string;
  };
}

const { data } = Astro.props;
const photo = resolveAssetImage(data.image);
const pillars = data.pillars ?? [];

// The sentence, word by word, so the entrance can stagger it; the emphasis
// keeps its words together inside one <em>.
const title = data.title ?? '';
const emphasis = data.titleEmphasis && title.includes(data.titleEmphasis) ? data.titleEmphasis : '';
const [before, after] = emphasis ? title.split(emphasis) : [title, ''];
const words = (text: string) => text.split(/\s+/).filter(Boolean);
const segments = [
  ...words(before).map((word) => ({ word, em: false })),
  ...(emphasis ? [{ word: emphasis, em: true }] : []),
  ...words(after).map((word) => ({ word, em: false })),
];

const format = (n: number) => n.toFixed(2).replace('.', ',');
const coordinates = `${format(site.geo.lat)}° N · ${format(site.geo.lng)}° O`;
---

<section class="home-hero surface-night section--clip" aria-labelledby="hero-title">
  <div class="container home-hero__grid">
    <h1 class="home-hero__heading" id="hero-title">
      {data.kicker && <span class="marker home-hero__kicker">{data.kicker}</span>}
      <span class="display display--xl home-hero__title">
        {segments.map(({ word, em }, i) => (
          <>
            {em ? (
              <em class="home-hero__word" style={`--i: ${i}`}>
                {word}
              </em>
            ) : (
              <span class="home-hero__word" style={`--i: ${i}`}>
                {word}
              </span>
            )}{' '}
          </>
        ))}
      </span>
      {data.claim && <span class="home-hero__claim">{data.claim}</span>}
    </h1>

    {data.lede && <p class="home-hero__lede">{data.lede}</p>}

    {pillars.length > 0 && (
      <div class="home-hero__pillars">
        {data.pillarsLabel && <p class="home-hero__pillars-label">{data.pillarsLabel}</p>}
        <ul class="home-hero__pillar-list" role="list">
          {pillars.map((pillar, i) => (
            <li class="home-hero__pillar" style={`--i: ${i}`}>
              <span class="home-hero__pillar-title">{pillar.title}</span>
              <span class="home-hero__pillar-text">{pillar.text}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="home-hero__action">
      <HomeEventStatus
        placement="hero"
        secondaryLabel={data.secondaryLabel}
        secondaryLink={data.secondaryLink}
        server:defer
      >
        <HomeEventStatus
          placement="hero"
          secondaryLabel={data.secondaryLabel}
          secondaryLink={data.secondaryLink}
          fallback
          slot="fallback"
        />
      </HomeEventStatus>
    </div>

    {photo && (
      <figure class="home-hero__figure">
        <div class="home-hero__orbit">
          <Breath class="home-hero__breath" />
          <SeatCircle class="home-hero__ring" seatSize={3.2} entrance />
          <div class="home-hero__plate">
            <CropPicture
              src={photo}
              class="home-hero__image"
              breakpoint="56em"
              narrow={{ ratio: 1, widths: [360, 540, 720, 960], sizes: '78vw' }}
              wide={{ ratio: 1, widths: [480, 720, 960], sizes: 'min(32rem, 34vw)' }}
              loading="eager"
              fetchpriority="high"
              alt={data.imageAlt ?? ''}
            />
          </div>
        </div>
        <figcaption class="home-hero__caption">
          {data.imageCaption && <span>{data.imageCaption}</span>}
          <span class="home-hero__coords">{coordinates}</span>
        </figcaption>
      </figure>
    )}
  </div>
</section>

<style is:global>
  @layer sections {
    .home-hero {
      position: relative;
      padding-block: calc(var(--header-height) + var(--space-lg)) var(--space-2xl);
    }

    .home-hero__grid {
      display: grid;
      grid-template-areas:
        'head    figure'
        'lede    figure'
        'pillars figure'
        'action  figure';
      grid-template-rows: auto auto auto 1fr;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--space-xl);
      align-items: start;
    }

    .home-hero__heading {
      grid-area: head;
      margin: 0;
      font-size: inherit;
      letter-spacing: normal;
    }

    .home-hero__kicker {
      margin-block-end: var(--space-md);
    }

    .home-hero__title {
      display: block;
      max-inline-size: 14ch;
      font-size: clamp(2.75rem, 1.2rem + 4.4vw, 5.5rem);
      color: var(--text-primary);
    }

    .home-hero__word {
      display: inline-block;
    }

    .home-hero__claim {
      display: block;
      margin-block-start: var(--space-md);
      font-family: var(--font-body);
      font-size: var(--text-lg);
      font-weight: 500;
      color: var(--text-secondary);
      letter-spacing: 0.02em;
    }

    .home-hero__lede {
      grid-area: lede;
      max-inline-size: 46ch;
      margin-block: var(--space-lg) 0;
      font-size: var(--text-section-body-lg);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
    }

    /* Four parts of an evening, on hairlines — the vocabulary, before the details. */
    .home-hero__pillars {
      grid-area: pillars;
      margin-block-start: var(--space-lg);
    }

    .home-hero__pillars-label {
      margin-block-end: var(--space-xs);
      font-family: var(--font-quote);
      font-size: var(--text-xl);
      font-style: italic;
      color: var(--accent);
    }

    .home-hero__pillar-list {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding: 0;
      margin: 0;
      list-style: none;
      border-block-start: 1px solid var(--border-medium);
    }

    .home-hero__pillar {
      display: grid;
      gap: var(--space-3xs);
      align-content: start;
      padding-block: var(--space-sm);
      padding-inline-end: var(--space-sm);
    }

    .home-hero__pillar + .home-hero__pillar {
      padding-inline-start: var(--space-sm);
      border-inline-start: 1px solid var(--border-light);
    }

    .home-hero__pillar-title {
      display: flex;
      gap: 0.5em;
      align-items: center;
      font-size: var(--text-body-compact);
      font-weight: 600;
      color: var(--text-primary);
    }

    .home-hero__pillar-title::before {
      flex: none;
      inline-size: 0.5rem;
      block-size: 0.5rem;
      content: '';
      background: var(--accent);
      border-radius: 50%;
    }

    .home-hero__pillar-text {
      font-size: var(--text-caption);
      line-height: 1.5;
      color: var(--text-muted);
    }

    .home-hero__action {
      grid-area: action;
      margin-block-start: var(--space-lg);
    }

    /* The photograph inside the circle, the seats around it. */
    .home-hero__figure {
      grid-area: figure;
      align-self: start;
      margin: var(--space-xl) 0 0;
    }

    .home-hero__orbit {
      position: relative;
      inline-size: min(82%, 32rem);
      margin-inline: auto 8%;
      aspect-ratio: 1;
    }

    /* Ring diameter = 200/240 of the box: at -20% it runs ~14% outside the plate. */
    .home-hero__ring {
      position: absolute;
      inset: -20%;
    }

    @media (prefers-reduced-motion: no-preference) {
      @supports (animation-timeline: view()) {
        .home-hero__ring svg {
          animation: ring-turn linear both;
          animation-timeline: view();
          animation-range: cover 30% cover 100%;
        }
      }
    }

    /* The breath around the photograph: its outer ring stays inside this box,
       which ends where the text column begins. */
    .home-hero__breath {
      --breath-glow: 32%;

      inset: -28%;
    }

    .home-hero__plate {
      position: absolute;
      inset: 0;
      overflow: clip;
      background: var(--bg-secondary);
      border-radius: 50%;
    }

    .home-hero__image {
      display: block;
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
    }

    .home-hero__caption {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3xs) var(--space-sm);
      justify-content: flex-end;
      margin-block-start: calc(19% + var(--space-sm));
      font-size: var(--text-caption);
      color: var(--text-muted);
      text-align: end;
    }

    .home-hero__coords {
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.06em;
    }

    /* Entrance: the words rise, the circle opens. Starts at first paint, under a second. */
    @media (prefers-reduced-motion: no-preference) {
      .home-hero__kicker {
        animation: rise 520ms var(--ease-settle) both;
      }

      .home-hero__word {
        animation: line-in 680ms var(--ease-emphasised) both;
        animation-delay: calc(80ms + var(--i) * 45ms);
      }

      .home-hero__lede,
      .home-hero__pillars,
      .home-hero__action {
        animation: rise 600ms var(--ease-settle) both;
      }

      .home-hero__lede {
        animation-delay: 380ms;
      }

      .home-hero__pillars {
        animation-delay: 460ms;
      }

      .home-hero__action {
        animation-delay: 540ms;
      }

      .home-hero__plate {
        animation: plate-open 1100ms var(--ease-emphasised) 120ms both;
      }

      .vt-arrival
        :is(
          .home-hero__kicker,
          .home-hero__word,
          .home-hero__lede,
          .home-hero__pillars,
          .home-hero__action,
          .home-hero__plate
        ) {
        animation: none;
      }
    }

    /* Tablet: the pillars go two-up. */
    @media (width <= 72em) {
      .home-hero__pillar-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .home-hero__pillar:nth-child(3) {
        padding-inline-start: 0;
        border-inline-start: 0;
      }

      .home-hero__pillar:nth-child(n + 3) {
        border-block-start: 1px solid var(--border-light);
      }
    }

    /* Phone: its own composition. The sentence first, then the circle breaking
       out past the right edge, then the reading. */
    @media (width <= 56em) {
      .home-hero {
        padding-block: calc(var(--header-height) + var(--space-lg)) var(--space-xl);
      }

      .home-hero__grid {
        grid-template-areas:
          'head'
          'figure'
          'lede'
          'pillars'
          'action';
        grid-template-rows: none;
        grid-template-columns: minmax(0, 1fr);
      }

      .home-hero__title {
        max-inline-size: 12ch;
      }

      /* The ring reaches 20% of the photo's width past it on every side. */
      .home-hero__figure {
        margin-block-start: calc(78vw * 0.2 + var(--space-md));
        margin-inline-end: calc(-1 * var(--container-gutter) - 14vw);
      }

      /* Stacked, the breath stays within the clear space reserved for the ring. */
      .home-hero__breath {
        inset: -21%;
      }

      .home-hero__orbit {
        inline-size: 78vw;
        margin-inline: auto 6vw;
      }

      .home-hero__caption {
        justify-content: flex-start;
        padding-inline-end: calc(var(--container-gutter) + 14vw);
        margin-block-start: calc(78vw * 0.2 + var(--space-sm));
        text-align: start;
      }

      .home-hero__lede {
        margin-block-start: var(--space-lg);
      }
    }

    @media (width <= 30em) {
      .home-hero__pillar-list {
        grid-template-columns: minmax(0, 1fr);
      }

      .home-hero__pillar,
      .home-hero__pillar + .home-hero__pillar {
        grid-template-columns: 6.5rem minmax(0, 1fr);
        gap: var(--space-sm);
        padding-inline: 0;
        border-inline-start: 0;
      }

      .home-hero__pillar + .home-hero__pillar {
        border-block-start: 1px solid var(--border-light);
      }

      .home-hero__action .actions {
        flex-direction: column;
        align-items: stretch;
      }

      .home-hero__action .btn {
        inline-size: 100%;
      }
    }
  }
</style>
