---
import { button } from '@lib/ui';

import EventAvailability from '../event/EventAvailability.astro';
import type { PublicEvents } from '../event/types';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  events: PublicEvents | null;
  kicker: string;
  secondaryLabel: string;
  secondaryLink: string;
}

const { events, kicker, secondaryLabel, secondaryLink } = Astro.props;
const action = events?.events[0]?.view.action ?? { href: '/event', label: 'Termine ansehen' };
---

<section
  data-hero
  aria-labelledby="hero-title"
  class="surface-dark relative flex min-h-[min(46rem,90svh)] items-center overflow-clip pt-[calc(var(--spacing-header)+var(--spacing-group)+1rem)] pb-[calc(var(--spacing-section)+1.5rem)] lg:min-h-[min(48rem,90svh)] lg:pt-[calc(var(--spacing-header)+var(--spacing-section)+1.5rem)]"
>
  {/* A quiet circle recalls the seating arrangement without competing with the date. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-56 -bottom-60 aspect-square w-120 lg:top-[calc(50%-22rem)] lg:-right-64 lg:bottom-auto lg:w-176"
  >
    <span class="absolute inset-0 rounded-[48%_52%_46%_54%/54%_45%_55%_46%] border border-line-strong"></span>
    <span class="absolute inset-[23%] rounded-[54%_46%_52%_48%/46%_55%_45%_54%] border border-line"></span>
  </div>

  <Container class="relative grid gap-x-grid gap-y-8 lg:grid-cols-12">
    <div class="grid min-w-0 justify-items-start lg:col-span-7">
      {kicker && <Eyebrow class="mb-4">{kicker}</Eyebrow>}
      <h1 id="hero-title" class="max-w-[12em] text-hero text-fg wrap-anywhere hyphens-auto">
        <slot name="title" />
      </h1>
      <p class="mt-6 max-w-measure text-lg text-fg-muted">
        <slot />
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 lg:col-span-7 lg:row-start-2">
      <a
        href={action.href}
        class:list={[button({ size: 'lg' }), 'max-sm:w-full sm:min-w-52']}
        data-umami-event="cta-click"
        data-umami-event-location="home-hero"
      >
        {action.label}
      </a>
      <a
        href={secondaryLink}
        class="inline-flex min-h-11 items-center text-base font-semibold text-accent underline underline-offset-4"
      >
        {secondaryLabel}
      </a>
    </div>
    <div class="min-w-0 lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1 lg:self-center">
      <EventAvailability data={events} location="home-hero" showAction={false} />
    </div>
  </Container>
</section>
