---
import { formatDateCompact } from '@lib/shared/time'
import { afterWords, splitWords } from '@lib/shared/words'
import { button, label } from '@lib/ui'

import SeatRing from '../brand/SeatRing.astro'
import type { PublicEvents } from '../event/types'
import Container from '../ui/Container.astro'
import Eyebrow from '../ui/Eyebrow.astro'

interface Props {
  events: PublicEvents | null
  kicker: string
  secondaryLabel: string
  secondaryLink: string
}

const { events, kicker, secondaryLabel, secondaryLink } = Astro.props
const next = events?.events[0]
const action = next?.view.action ?? { href: '/event', label: 'Termine ansehen' }
const title = splitWords(await Astro.slots.render('title'))
const beat = (n: number) => afterWords(title.count, n)

/** The next evening in one open line under the action: date, time and place, how full it is. */
const nextLine = next
  ? {
      date: next.view.title,
      time: next.view.facts.time,
      place: next.view.facts.place,
      datetime: next.view.datetime,
      meta: [next.view.facts.time, next.view.facts.place].filter(Boolean).join(' · '),
      seats: next.view.facts.seats,
    }
  : null
---

{/* The desktop opening, on the dark ground and one screen tall (taller only where the window is
     too short for it), set like a poster and without a picture: behind it four
     pale circles of the accent drift over the ink (global.css, "The opening"),
     high and to the right, so the statement below stands on plain ink; across the
     whole width the statement at poster size; under it one row on the grid, the
     explanation and the action on the left, the next evening as open lines on the
     right. The opening arrives once on load. */}
<section
  data-hero
  data-opening
  aria-labelledby="hero-title"
  class="surface-dark relative flex flex-col justify-center overflow-clip pt-[calc(var(--spacing-header)+2.5rem)] pb-12 sm:pb-16 lg:min-h-svh lg:pt-[calc(var(--spacing-header)+3rem)]"
>
  <div
    data-hero-glow
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 overflow-clip"
  >
    <span></span>
    <span></span>
    <span></span>
    <span></span>
  </div>

  <Container class="relative grid gap-x-grid gap-y-8 sm:gap-y-12 lg:grid-cols-12 lg:gap-y-[clamp(3rem,6vh,5rem)]">
    <div class="min-w-0 lg:col-span-12">
      {kicker && (
        <Eyebrow
          class="mb-6 lg:mb-8"
          data-enter
        >
          {kicker}
        </Eyebrow>
      )}
      <h1
        id="hero-title"
        data-enter="words"
        class="max-w-[10.4em] text-hero font-semibold text-fg wrap-anywhere hyphens-auto leading-[1.08] lg:text-[clamp(5rem,7.8vw,8.5rem)] [&_em]:text-accent"
        set:html={title.html}
      />
    </div>

    <div class="grid min-w-0 content-start justify-items-start gap-y-7 sm:gap-y-9 lg:col-span-6">
      <p
        data-enter
        style={beat(0)}
        class="max-w-[30rem] text-lg text-fg-soft"
      >
        <slot />
      </p>
      {nextLine && (
        <p class="grid w-full gap-y-1.5 border-t border-line-strong pt-5 text-base text-fg lg:hidden">
          <span class="block text-sm text-fg-muted">Nächster Termin</span>
          <span class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <time datetime={nextLine.datetime} class="font-semibold">{formatDateCompact(nextLine.datetime)}</time>
            <span>{nextLine.time}</span>
          </span>
          <span class="block text-sm text-fg-soft">{nextLine.place} · {nextLine.seats}</span>
        </p>
      )}
      <div
        data-enter
        style={beat(1)}
        class="flex w-full flex-wrap items-center gap-x-8 gap-y-3"
      >
        <a
          href={action.href}
          class:list={[button({ size: 'lg' }), 'min-w-44 sm:min-w-52']}
          data-hero-action
          data-umami-event="cta-click"
          data-umami-event-location="home-hero"
        >
          {action.label}
        </a>
        <a
          href={secondaryLink}
          class="group/link inline-flex min-h-11 items-center gap-2 text-base font-semibold text-fg underline decoration-accent decoration-2 underline-offset-4 hover:decoration-fg"
        >
          {secondaryLabel}
          <span
            aria-hidden="true"
            class="transition-transform duration-180 group-hover/link:translate-y-0.5"
          >
            ↓
          </span>
        </a>
      </div>
    </div>

    {nextLine && (
      /* The next evening, open under a thin rule: the whole block is the link. */
      <a
        href={action.href}
        data-enter
        style={beat(2)}
        class="group/next hidden min-w-0 content-start gap-2 self-start border-t border-line-strong pt-5 lg:col-span-5 lg:col-start-8 lg:grid"
        data-umami-event="cta-click"
        data-umami-event-location="home-hero-date"
      >
        <span class={label}>Nächster Termin</span>
        <time
          datetime={nextLine.datetime}
          class="font-display text-sub text-fg transition-colors duration-180 group-hover/next:text-accent"
        >
          {nextLine.date.join(' ')}
        </time>
        <span class="text-sm text-fg-muted">
          {nextLine.meta}
          <span class="xl:hidden">{' · '}{nextLine.seats}</span>
        </span>
        {next?.view.seats && (
          <SeatRing
            seats={next.view.seats}
            text={nextLine.seats}
            size="sm"
            class="mt-2 max-xl:hidden"
          />
        )}
      </a>
    )}
    {events && !next && (
      <p
        data-enter
        style={beat(2)}
        class="min-w-0 self-start border-t border-line-strong pt-5 text-base text-fg-muted lg:col-span-5 lg:col-start-8"
      >
        Der nächste Abend ist in Planung.{' '}
        <a
          href="/event#benachrichtigung"
          class="font-semibold text-fg underline decoration-accent decoration-2 underline-offset-4"
        >
          Über neue Termine informieren
        </a>
      </p>
    )}
  </Container>
</section>
