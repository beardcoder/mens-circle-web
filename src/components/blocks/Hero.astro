---
import type { ImageMetadata } from 'astro';

import { afterWords, splitWords } from '@lib/shared/words';
import { button, label } from '@lib/ui';

import SeatRing from '../brand/SeatRing.astro';
import type { PublicEvents } from '../event/types';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  events: PublicEvents | null;
  kicker: string;
  secondaryLabel: string;
  secondaryLink: string;
  /** The photograph, square and ascending by width; the home page is SSR, so these are pre-sized files. */
  images: ImageMetadata[];
  imageAlt: string;
}

const { events, kicker, secondaryLabel, secondaryLink, images, imageAlt } = Astro.props;
const next = events?.events[0];
const action = next?.view.action ?? { href: '/event', label: 'Termine ansehen' };
const largest = images.at(-1)!;
const title = splitWords(await Astro.slots.render('title'));
const beat = (n: number) => afterWords(title.count, n);

/** The next evening in one open line under the action: date, time and place, how full it is. */
const nextLine = next
  ? {
      date: next.view.title,
      datetime: next.view.datetime,
      meta: [next.view.facts.time, next.view.facts.place].filter(Boolean).join(' · '),
      seats: next.view.facts.seats,
    }
  : null;
---

{/* The opening, from edge to edge on the forest, one screen tall from `lg` (taller only
     where the window is too short for it): the statement as large as a poster,
     its phrase in the spark; beside it the photograph in a circle, cut by the window's
     right edge (the bleed), and the next evening's seat ring overlapping it. On load the
     title rises in, the rest follows and the photo settles (global.css, "Motion: the
     opening"); after that the opening stands still. */}
<section
  data-hero
  aria-labelledby="hero-title"
  class="surface-dark relative overflow-clip pt-[calc(var(--spacing-header)+var(--spacing-group))] pb-section lg:grid lg:min-h-svh lg:content-center lg:pb-band"
>
  <Container class="relative grid items-start gap-x-grid gap-y-16 lg:grid-cols-12">
    <div class="grid min-w-0 justify-items-start lg:col-span-9">
      {kicker && (
        <Eyebrow class="mb-6" data-enter>
          {kicker}
        </Eyebrow>
      )}
      <h1
        id="hero-title"
        data-enter="words"
        class="max-w-[11em] text-hero font-semibold text-fg wrap-anywhere hyphens-auto [&_em]:text-spark"
        set:html={title.html}
      />
      <p data-enter style={beat(0)} class="mt-7 max-w-measure text-lg text-fg-soft">
        <slot />
      </p>
      <div data-enter style={beat(1)} class="mt-10 flex w-full flex-wrap items-center gap-x-8 gap-y-3">
        <a
          href={action.href}
          class:list={[button({ size: 'lg' }), 'max-sm:w-full sm:min-w-56']}
          data-hero-action
          data-umami-event="cta-click"
          data-umami-event-location="home-hero"
        >
          {action.label}
        </a>
        <a
          href={secondaryLink}
          class="group/link inline-flex min-h-11 items-center gap-2 text-base font-semibold text-accent hover:text-accent-strong"
        >
          {secondaryLabel}
          <span aria-hidden="true" class="transition-transform duration-180 group-hover/link:translate-y-0.5">
            ↓
          </span>
        </a>
      </div>

      {nextLine && (
        <a
          href={action.href}
          data-enter
          style={beat(2)}
          class="group/next mt-14 grid w-full max-w-md gap-3"
          data-umami-event="cta-click"
          data-umami-event-location="home-hero-date"
        >
          <span class={label}>Nächster Termin</span>
          <span class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <time
              datetime={nextLine.datetime}
              class="font-display text-sub text-fg transition-colors duration-180 group-hover/next:text-accent"
            >
              {nextLine.date.map((line) => (
                <span class="max-sm:block">{line} </span>
              ))}
            </time>
            <span class="text-sm text-fg-muted">{nextLine.meta}</span>
          </span>
          <span class="text-sm text-fg-muted">{nextLine.seats}</span>
        </a>
      )}
      {events && !next && (
        <p data-enter style={beat(2)} class="mt-14 max-w-md text-base text-fg-muted">
          Der nächste Abend ist in Planung.{' '}
          <a href="/event#benachrichtigung" class="font-semibold text-accent underline underline-offset-4">
            Über neue Termine informieren
          </a>
        </p>
      )}
    </div>
  </Container>

  {/* The photograph: under the text on phones; from `lg` beside the title, as large as
      a third of the window and cut by its right edge. */}
  <div class="relative mx-auto mt-16 w-[calc(100%-2*var(--spacing-gutter))] max-w-[22rem] sm:max-w-[28rem] lg:absolute lg:top-[calc(50%+var(--spacing-header)/2)] lg:right-0 lg:mt-0 lg:w-[min(36vw,54svh)] lg:max-w-[40rem] lg:translate-x-[16%] lg:-translate-y-1/2">
    <div class="relative">
      <div data-enter="settle" class="relative">
        <img
          src={largest.src}
          srcset={images.map((image) => `${image.src} ${image.width}w`).join(', ')}
          sizes="(min-width: 64rem) min(36vw, 40rem), (min-width: 36rem) 28rem, 22rem"
          width={largest.width}
          height={largest.height}
          alt={imageAlt}
          fetchpriority="high"
          decoding="async"
          class="aspect-square w-full rounded-full object-cover"
        />
      </div>
      {next?.view.seats && (
        /* The next evening's chairs, on a disc of the forest, overlapping the circle's edge. */
        <div
          data-enter
          style={beat(2)}
          class="absolute -bottom-6 -left-4 rounded-full bg-surface p-3 sm:-left-overlap lg:-bottom-overlap"
        >
          <SeatRing seats={next.view.seats} text={nextLine?.seats ?? ''} size="lg" layout="none" />
        </div>
      )}
    </div>
  </div>
</section>
