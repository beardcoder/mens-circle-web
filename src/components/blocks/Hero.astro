---
import HomeEventStatus from '../HomeEventStatus.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';

/**
 * The home opening on the dark focus ground: the statement (its phrase in the
 * italic accent), the short explanation, the main action with the quiet link to
 * the course of an evening, and beside them the next date. Phones stack it:
 * statement, explanation, date, action. One quiet ring stands in the right
 * background. It sizes to its content: no forced screen height.
 */

interface Props {
  data: {
    kicker?: string;
    /** The central sentence. */
    title?: string;
    /** A phrase inside `title` set in the italic accent. */
    titleEmphasis?: string;
    lede?: string;
    secondaryLabel?: string;
    secondaryLink?: string;
  };
}

const { data } = Astro.props;

const title = data.title ?? '';
const emphasis = data.titleEmphasis && title.includes(data.titleEmphasis) ? data.titleEmphasis : '';
const [before, after] = emphasis ? title.split(emphasis) : [title, ''];
---

<section
  data-hero
  aria-labelledby="hero-title"
  class="surface-dark relative overflow-clip pt-[calc(var(--spacing-header)+var(--spacing-group))] pb-section lg:pt-[calc(var(--spacing-header)+var(--spacing-section))]"
>
  {/* The one circle: a ring in the right background, breathing slowly. */}
  <span
    aria-hidden="true"
    class="pointer-events-none absolute top-1/2 right-[-18rem] aspect-square w-[44rem] -translate-y-1/2 rounded-full border border-line-strong motion-safe:animate-ring max-lg:top-auto max-lg:right-[-14rem] max-lg:bottom-[-16rem] max-lg:w-[30rem] max-lg:translate-y-0"
  ></span>

  <Container class="relative grid gap-x-grid gap-y-8 lg:grid-cols-12">
    <div class="grid min-w-0 justify-items-start lg:col-span-7 lg:row-start-1 entrance:animate-fade-in">
      {data.kicker && <Eyebrow class="mb-4">{data.kicker}</Eyebrow>}
      <h1 id="hero-title" class="max-w-[14ch] text-hero text-fg wrap-anywhere hyphens-auto">
        {before}
        {emphasis && <em class="text-accent">{emphasis}</em>}
        {after}
      </h1>
      {data.lede && <p class="mt-6 max-w-measure text-lg text-fg-muted">{data.lede}</p>}
    </div>

    <HomeEventStatus
      placement="hero"
      secondaryLabel={data.secondaryLabel}
      secondaryLink={data.secondaryLink}
      server:defer
    >
      <HomeEventStatus
        placement="hero"
        secondaryLabel={data.secondaryLabel}
        secondaryLink={data.secondaryLink}
        fallback
        slot="fallback"
      />
    </HomeEventStatus>
  </Container>
</section>
