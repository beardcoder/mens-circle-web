---
import type { ImageMetadata } from 'astro';

import { afterWords, splitWords } from '@lib/shared/words';
import { button, label } from '@lib/ui';

import SeatRing from '../brand/SeatRing.astro';
import type { PublicEvents } from '../event/types';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  events: PublicEvents | null;
  kicker: string;
  secondaryLabel: string;
  secondaryLink: string;
  /** The photograph, square and ascending by width; the home page is SSR, so these are pre-sized files. */
  images: ImageMetadata[];
  imageAlt: string;
}

const { events, kicker, secondaryLabel, secondaryLink, images, imageAlt } = Astro.props;
const next = events?.events[0];
const action = next?.view.action ?? { href: '/event', label: 'Termine ansehen' };
const largest = images.at(-1)!;
const title = splitWords(await Astro.slots.render('title'));
const beat = (n: number) => afterWords(title.count, n);

/** The next evening in one open line under the action: date, time and place, how full it is. */
const nextLine = next
  ? {
      date: next.view.title,
      datetime: next.view.datetime,
      meta: [next.view.facts.time, next.view.facts.place].filter(Boolean).join(' · '),
      seats: next.view.facts.seats,
    }
  : null;
---

{/* The opening, on the forest and one screen tall (taller only where the window is
     too short for it), set like a poster: the photograph without a frame in the upper
     right, up to the window's edges and running softly into the ground towards the
     left and the foot (global.css, "The opening"); across the whole width and over
     the photograph's foot the statement at poster size, the one move that breaks the
     grid here; under it one row on the grid, the explanation and the action on the
     left, the next evening as open lines on the right. On a phone the photograph
     fills the top, the statement crosses its foot, the rest follows. The opening
     arrives once on load. */}
<section
  data-hero
  data-opening
  aria-labelledby="hero-title"
  class="surface-dark relative flex min-h-svh flex-col justify-end overflow-clip pt-[calc(var(--spacing-header)+10rem)] pb-8 lg:pb-14"
>
  {/* The photograph: it settles once on load and is never hidden. */}
  <div
    data-hero-frame
    class="absolute inset-x-0 top-0 h-[60svh] overflow-clip lg:inset-y-0 lg:left-auto lg:h-auto lg:w-[62vw]"
  >
    <img
      data-hero-photo
      src={largest.src}
      srcset={images.map((image) => `${image.src} ${image.width}w`).join(', ')}
      sizes="(min-width: 64rem) 62vw, 100vw"
      width={largest.width}
      height={largest.height}
      alt={imageAlt}
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 size-full object-cover object-[35%_20%] lg:object-[40%_30%]"
    />
  </div>

  <Container class="relative grid gap-x-grid lg:grid-cols-12">
    <div class="min-w-0 lg:col-span-12">
      {kicker && (
        <Eyebrow class="mb-4 lg:mb-6" data-enter>
          {kicker}
        </Eyebrow>
      )}
      <h1
        id="hero-title"
        data-enter="words"
        class="max-w-[10.4em] text-hero font-semibold text-fg wrap-anywhere hyphens-auto lg:text-[clamp(5.625rem,8.6vw,9.5rem)] [&_em]:text-spark"
        set:html={title.html}
      />
    </div>

    <div class="mt-6 grid min-w-0 content-start justify-items-start lg:col-span-6 lg:mt-10">
      <p data-enter style={beat(0)} class="max-w-[30rem] text-lg text-fg-soft">
        <slot />
      </p>
      <div data-enter style={beat(1)} class="mt-6 flex w-full flex-wrap items-center gap-x-8 gap-y-1 lg:mt-8">
        <a
          href={action.href}
          class:list={[button({ size: 'lg' }), 'max-sm:w-full sm:min-w-56']}
          data-hero-action
          data-umami-event="cta-click"
          data-umami-event-location="home-hero"
        >
          {action.label}
        </a>
        <a
          href={secondaryLink}
          class="group/link inline-flex min-h-11 items-center gap-2 text-base font-semibold text-accent hover:text-accent-strong"
        >
          {secondaryLabel}
          <span aria-hidden="true" class="transition-transform duration-180 group-hover/link:translate-y-0.5">
            ↓
          </span>
        </a>
      </div>
    </div>

    {nextLine && (
      /* The next evening, open under a thin rule: the whole block is the link. */
      <a
        href={action.href}
        data-enter
        style={beat(2)}
        class="group/next mt-5 grid min-w-0 content-start gap-1 self-end border-t border-line-strong pt-4 lg:col-span-4 lg:col-start-9 lg:mt-10 lg:pt-5"
        data-umami-event="cta-click"
        data-umami-event-location="home-hero-date"
      >
        <span class={label}>Nächster Termin</span>
        <time
          datetime={nextLine.datetime}
          class="font-display text-sub text-fg transition-colors duration-180 group-hover/next:text-accent"
        >
          {nextLine.date.join(' ')}
        </time>
        <span class="text-sm text-fg-muted">
          {nextLine.meta}
          <span class="xl:hidden"> · {nextLine.seats}</span>
        </span>
        {next?.view.seats && (
          <SeatRing seats={next.view.seats} text={nextLine.seats} size="sm" class="mt-2 max-xl:hidden" />
        )}
      </a>
    )}
    {events && !next && (
      <p
        data-enter
        style={beat(2)}
        class="mt-5 min-w-0 self-end border-t border-line-strong pt-4 text-base text-fg-muted lg:col-span-4 lg:col-start-9 lg:mt-10 lg:pt-5"
      >
        Der nächste Abend ist in Planung.{' '}
        <a href="/event#benachrichtigung" class="font-semibold text-accent underline underline-offset-4">
          Über neue Termine informieren
        </a>
      </p>
    )}
  </Container>
</section>
