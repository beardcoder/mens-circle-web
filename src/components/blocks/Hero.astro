---
import HomeEventStatus from '../HomeEventStatus.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';

/**
 * The home opening on the dark focus ground: the statement (its phrase in the
 * italic accent), the short explanation, the main action with the quiet link to
 * the course of an evening, and beside them the next date. Phones stack it:
 * statement, explanation, date, action. The circle stands in the right
 * background: three rings breathing out of phase. The words rise in, one after
 * the other. It sizes to its content: no forced screen height.
 */

interface Props {
  data: {
    kicker?: string;
    /** The central sentence. */
    title?: string;
    /** A phrase inside `title` set in the italic accent. */
    titleEmphasis?: string;
    lede?: string;
    secondaryLabel?: string;
    secondaryLink?: string;
  };
}

const { data } = Astro.props;

const title = data.title ?? '';
const emphasis = data.titleEmphasis && title.includes(data.titleEmphasis) ? data.titleEmphasis : '';
const [before, after] = emphasis ? title.split(emphasis) : [title, ''];
---

<section
  data-hero
  aria-labelledby="hero-title"
  class="surface-dark relative overflow-clip pt-[calc(var(--spacing-header)+var(--spacing-group))] pb-section lg:pt-[calc(var(--spacing-header)+var(--spacing-section))]"
>
  {/* The circle: three rings, breathing out of phase. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute right-[-14rem] bottom-[-15rem] aspect-square w-[30rem] lg:top-[calc(50%-22rem)] lg:right-[-16rem] lg:bottom-auto lg:w-[44rem]"
  >
    <span class="absolute inset-0 rounded-full border border-line-strong motion-safe:animate-ring"></span>
    <span class="absolute inset-[13%] rounded-full border border-line motion-safe:animate-ring-slow motion-safe:animate-delay-[-7s]"></span>
    <span class="absolute inset-[29%] rounded-full border border-accent/45 motion-safe:animate-ring motion-safe:animate-delay-[-11s]"></span>
  </div>

  <Container class="relative grid gap-x-grid gap-y-8 lg:grid-cols-12">
    <div class="grid min-w-0 justify-items-start lg:col-span-7 lg:row-start-1">
      {data.kicker && <Eyebrow class="mb-4 entrance:animate-rise">{data.kicker}</Eyebrow>}
      <h1
        id="hero-title"
        class="max-w-[8.4em] text-hero text-fg wrap-anywhere hyphens-auto entrance:animate-rise entrance:animate-delay-[90ms]"
      >
        {before}
        {emphasis && <em class="text-accent">{emphasis}</em>}
        {after}
      </h1>
      {data.lede && (
        <p class="mt-6 max-w-measure text-lg text-fg-muted entrance:animate-rise entrance:animate-delay-[180ms]">
          {data.lede}
        </p>
      )}
    </div>

    <HomeEventStatus placement="hero" secondaryLabel={data.secondaryLabel} secondaryLink={data.secondaryLink} />
  </Container>
</section>
