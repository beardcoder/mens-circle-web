---
import { type DateStatus, nextDateView, readDateStatus } from '@lib/event-status';

import EventSummary from '../event/EventSummary.astro';
import Button from '../ui/Button.astro';
import TextLink from '../ui/TextLink.astro';

/**
 * The hero's live part, a server island: the next date beside the statement and the
 * main action under it, two cells of the hero's grid. Without `state` it reads the date.
 */

interface Props {
  state?: DateStatus;
  secondaryLabel: string;
  secondaryLink: string;
}

const { secondaryLabel, secondaryLink } = Astro.props;
const view = nextDateView(Astro.props.state ?? (await readDateStatus()), 'overview');
---

<div class="min-w-0 lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1 lg:self-end">
  <EventSummary view={{ ...view, action: null }} />
</div>
<div class="flex flex-wrap items-center gap-x-6 gap-y-3 lg:col-span-7 lg:row-start-2">
  {view.action && (
    <Button
      href={view.action.href}
      size="lg"
      decorate
      class="max-sm:w-full"
      data-umami-event="cta-click"
      data-umami-event-location="home-hero"
      data-umami-event-state={view.state}
    >
      {view.action.label}
    </Button>
  )}
  <TextLink href={secondaryLink}>{secondaryLabel}</TextLink>
</div>
