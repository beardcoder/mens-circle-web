---
interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    text?: string;
    questionsLabel?: string;
    questions?: string[];
    close?: string;
  };
}

/**
 * "Der Kreis" — what an evening is about.
 *
 * A two-column spread: the heading holds the left, the prose the right. Every
 * other section on the page puts a small marker in the left column, so this one
 * is deliberately the odd one out — and an earlier pass that shifted the whole
 * block right instead left a 520x430px hole where the heading now sits.
 *
 * The four questions then break out to full width at poster size: they are the
 * thing to read if you read nothing else on the page, so they get the weight
 * and the prose around them stays small.
 */

const { data } = Astro.props;
const anchor = data.anchor ?? 'ueber';
const questions = data.questions ?? [];
---

<section class="section home-circle" id={anchor} aria-labelledby="ueber-title">
  <div class="container">
    <div class="bay">
      <div class="home-circle__head">
        <p class="marker marker--ruled">{data.eyebrow}</p>
        {
          data.title && (
            <h2 class="section-title" id="ueber-title">
              {data.title}
            </h2>
          )
        }
      </div>

      {data.text && <div class="home-circle__text prose" set:html={data.text} />}
    </div>

    {
      questions.length > 0 && (
        <div class="home-circle__questions">
          <p class="marker home-circle__questions-label">{data.questionsLabel}</p>

          <ul class="home-circle__list" role="list">
            {questions.map((question) => (
              <li class="home-circle__question">{question}</li>
            ))}
          </ul>
        </div>
      )
    }

    {
      data.close && (
        <div class="bay">
          <p class="home-circle__close">{data.close}</p>
        </div>
      )
    }
  </div>
</section>

<style is:global>
  @layer sections {
    /* 5 / 7: the heading takes the narrower column and wraps to three or four
       short lines, which is what gives the spread its edge. */
    .home-circle__head {
      grid-column: 1 / span 5;
    }

    .home-circle__text {
      grid-column: 7 / span 6;
      max-inline-size: var(--measure);
    }

    .home-circle__text p {
      font-size: var(--text-section-body);
    }

    @media (width <= 56em) {
      .home-circle__head,
      .home-circle__text {
        grid-column: 1 / -1;
      }

      .home-circle__text {
        margin-block-start: var(--space-sm);
      }
    }

    .home-circle__questions {
      margin-block: var(--space-xl) var(--space-lg);
    }

    /* `max-inline-size: none` overrides the global paragraph measure: this
       marker carries the rule that the question list hangs from, and a rule
       that stops at 72ch mid-page reads as a mistake rather than a margin. */
    .home-circle__questions-label {
      max-inline-size: none;
      padding-block-end: var(--space-xs);
      margin-block-end: 0;
      border-block-end: 3px solid var(--rule-strong);
    }

    .home-circle__list {
      padding: 0;
      margin: 0;
      list-style: none;
    }

    /* Poster-scale questions on hairlines. Condensed, sentence case rather than
       uppercase — these are questions being asked, not a slogan being shouted. */
    .home-circle__question {
      padding-block: var(--space-sm);
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 0.9rem + 2.6vw, 3.25rem);
      font-weight: 800;
      line-height: 1;
      color: var(--text-primary);
      border-block-end: 1px solid var(--border-medium);
      text-wrap: balance;
    }

    /* Lands under the prose column, mirroring the spread at the top of the
       section. Without an explicit placement it would auto-place into column 1
       of the twelve and squeeze to a twelfth of the width. */
    .home-circle__close {
      grid-column: 7 / span 6;
      max-inline-size: var(--measure);
      margin-block-start: var(--space-sm);
      font-size: var(--text-section-body-lg);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
    }

    @media (width <= 56em) {
      .home-circle__close {
        grid-column: 1 / -1;
      }
    }
  }
</style>
