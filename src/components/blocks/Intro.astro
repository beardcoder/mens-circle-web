---
interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    text?: string;
    questionsLabel?: string;
    questions?: string[];
    close?: string;
  };
}

/**
 * "Der Kreis" — what an evening is about.
 *
 * Sits right of centre, against the ink band above it, so the page's left edge
 * moves rather than every section starting in the same place. The four
 * questions then break back out to the left at poster size: they are the thing
 * to read if you read nothing else on the page, so they get the weight and the
 * prose around them stays small.
 */

const { data } = Astro.props;
const anchor = data.anchor ?? 'ueber';
const questions = data.questions ?? [];
---

<section class="section home-circle" id={anchor} aria-labelledby="ueber-title">
  <div class="container">
    <div class="bay">
      <div class="bay__right home-circle__intro">
        <p class="marker marker--ruled">{data.eyebrow}</p>
        {
          data.title && (
            <h2 class="section-title" id="ueber-title">
              {data.title}
            </h2>
          )
        }
        {data.text && <div class="home-circle__text prose" set:html={data.text} />}
      </div>
    </div>

    {
      questions.length > 0 && (
        <div class="home-circle__questions">
          <p class="marker home-circle__questions-label">{data.questionsLabel}</p>

          <ul class="home-circle__list" role="list">
            {questions.map((question) => (
              <li class="home-circle__question">{question}</li>
            ))}
          </ul>
        </div>
      )
    }

    {
      data.close && (
        <div class="bay">
          <p class="bay__right home-circle__close">{data.close}</p>
        </div>
      )
    }
  </div>
</section>

<style is:global>
  @layer sections {
    .home-circle__text p {
      font-size: var(--text-section-body);
    }

    .home-circle__questions {
      margin-block: var(--space-xl) var(--space-lg);
    }

    .home-circle__questions-label {
      padding-block-end: var(--space-xs);
      margin-block-end: 0;
      border-block-end: 3px solid var(--color-ink);
    }

    .home-circle__list {
      padding: 0;
      margin: 0;
      list-style: none;
    }

    /* Poster-scale questions on hairlines. Condensed, sentence case rather than
       uppercase — these are questions being asked, not a slogan being shouted. */
    .home-circle__question {
      padding-block: var(--space-sm);
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 0.9rem + 2.6vw, 3.25rem);
      font-weight: 800;
      line-height: 1;
      color: var(--text-primary);
      border-block-end: 1px solid var(--border-medium);
      text-wrap: balance;
    }

    /* One question carries the orange, so the block is not a uniform slab. */
    .home-circle__question:first-child {
      color: var(--color-ink);
    }

    .home-circle__close {
      max-inline-size: var(--measure);
      font-size: var(--text-section-body-lg);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
    }
  }
</style>
