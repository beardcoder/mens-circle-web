---
import { margin } from '@lib/ui';

import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Props {
  anchor: string;
  eyebrow: string;
  title: string;
  questionsLabel: string;
  questions: string[];
  close: string;
}

const { anchor, eyebrow, title, questionsLabel, questions, close } = Astro.props;
---

{/* The title starts in the margin and runs into the content; the questions of the
    first round stand in the margin as quiet notes, the text beside them. */}
<Section id={anchor} labelledby="ueber-title">
  <div class:list={[margin.grid, 'gap-y-10']}>
    <SectionHead eyebrow={eyebrow} title={title} titleId="ueber-title" class={margin.cross} />

    {questions.length > 0 && (
      <aside aria-labelledby="ueber-questions-label" class:list={[margin.side, 'max-lg:order-last']}>
        <h3 id="ueber-questions-label" data-reveal class="font-sans text-sm font-semibold text-fg-muted">
          {questionsLabel}
        </h3>
        {/* Asked in the first round, one after the other: a quiet list. */}
        <ul role="list" data-reveal-group class="mt-5 grid gap-4 border-l border-line-strong pl-5">
          {questions.map((question) => (
            <li class="font-display text-xl text-fg">{question}</li>
          ))}
        </ul>
      </aside>
    )}

    <div class={margin.reading}>
      <Prose reveal>
        <slot />
      </Prose>
      {close && (
        <p data-reveal class="mt-8 max-w-measure font-display text-sub text-accent">
          {close}
        </p>
      )}
    </div>
  </div>
</Section>
