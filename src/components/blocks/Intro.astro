---
interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    text?: string;
    questionsLabel?: string;
    questions?: string[];
    close?: string;
  };
}

/** What the evening is about: the title and serif text side by side, then the questions
 *  the circle keeps coming back to, set as voices around the room rather than a list. */

const { data } = Astro.props;
const anchor = data.anchor ?? 'ueber';
const questions = data.questions ?? [];
---

<section class="section home-circle" id={anchor} aria-labelledby="ueber-title">
  <div class="container">
    <div class="bay home-circle__spread">
      {data.title && (
        <h2 class="home-circle__title" id="ueber-title" data-reveal>
          {data.title}
        </h2>
      )}
      {data.text && <div class="home-circle__text prose" data-reveal set:html={data.text} />}
    </div>

    {questions.length > 0 && (
      <figure class="home-circle__questions">
        <figcaption class="home-circle__questions-label">{data.questionsLabel}</figcaption>
        <ul class="home-circle__list" role="list">
          {questions.map((question) => (
            <li class="home-circle__question" data-reveal>
              {question}
            </li>
          ))}
        </ul>
      </figure>
    )}

    {data.close && <p class="home-circle__close">{data.close}</p>}
  </div>
</section>

<style is:global>
  @layer sections {
    .home-circle__title {
      grid-column: 1 / span 5;
      margin: 0;
      font-size: var(--step-4);
    }

    .home-circle__text {
      grid-column: 7 / span 6;
      padding-block-start: 0.4em;
    }

    .home-circle__text p {
      font-size: var(--step-1);
      line-height: 1.55;
    }

    .home-circle__questions {
      margin: var(--rhythm-section) 0 0;
    }

    .home-circle__questions-label {
      margin-block-end: var(--space-md);
      font-family: var(--font-ui);
      font-size: 0.9375rem;
      font-weight: 560;
      color: var(--text-muted);
    }

    .home-circle__list {
      display: grid;
      gap: var(--space-sm);
      padding: 0;
      margin: 0;
    }

    /* Each question enters from a different seat: the indents step across the
       grid like voices taking turns. Serif italic, because these are spoken. */
    .home-circle__question {
      --indent: 0%;

      max-inline-size: 22ch;
      margin-inline-start: var(--indent);
      font-family: var(--font-body);
      font-size: var(--step-4);
      font-style: italic;
      font-weight: 360;
      line-height: 1.08;
      color: var(--text-primary);
      letter-spacing: -0.015em;
      text-wrap: balance;
    }

    .home-circle__question:nth-child(2) {
      --indent: 34%;
    }

    .home-circle__question:nth-child(3) {
      --indent: 12%;
    }

    .home-circle__question:nth-child(4) {
      --indent: 46%;
    }

    .home-circle__close {
      max-inline-size: 30ch;
      margin: var(--rhythm-group) 0 0 auto;
      font-family: var(--font-ui);
      font-size: var(--step-1);
      font-weight: 520;
      line-height: var(--leading-snug);
      color: var(--text-secondary);
    }

    @media (width <= 56em) {
      .home-circle__text {
        margin-block-start: var(--space-md);
        padding: 0;
      }

      .home-circle__question:nth-child(n) {
        --indent: 0%;
      }

      .home-circle__question:nth-child(even) {
        margin-inline-start: auto;
        text-align: end;
      }

      .home-circle__close {
        margin-inline-start: 0;
      }
    }
  }
</style>
