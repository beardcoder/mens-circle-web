---
import Breath from '../Breath.astro';
import SeatCircle from '../SeatCircle.astro';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    text?: string;
    questionsLabel?: string;
    questions?: string[];
    close?: string;
  };
}

/** What an evening is about: an editorial spread, then the questions seated around the circle. */

const { data } = Astro.props;
const anchor = data.anchor ?? 'ueber';
const questions = (data.questions ?? []).slice(0, 4);
---

<section class="section home-circle" id={anchor} aria-labelledby="ueber-title">
  <div class="container">
    <div class="home-circle__spread">
      <div class="home-circle__head">
        <p class="marker">{data.eyebrow}</p>
        {data.title && (
          <h2 class="display home-circle__title" id="ueber-title" data-reveal>
            {data.title}
          </h2>
        )}
      </div>

      {data.text && <div class="home-circle__text prose" set:html={data.text} data-reveal />}
    </div>

    {questions.length > 0 && (
      <figure class="home-circle__questions" aria-labelledby="ueber-questions-label">
        <figcaption class="home-circle__label" id="ueber-questions-label">
          {data.questionsLabel}
        </figcaption>

        <div class="home-circle__center" aria-hidden="true">
          <SeatCircle ember seatSize={5} class="home-circle__mark" />
          <Breath class="home-circle__breath" />
        </div>

        <ul class="home-circle__list" role="list">
          {questions.map((question, i) => (
            <li class={`home-circle__question home-circle__question--${i + 1}`} data-reveal>
              {question}
            </li>
          ))}
        </ul>
      </figure>
    )}

    {data.close && (
      <p class="home-circle__close" data-reveal>
        {data.close}
      </p>
    )}
  </div>
</section>

<style is:global>
  @layer sections {
    .home-circle__spread {
      display: grid;
      grid-template-columns: var(--split-columns);
      gap: var(--space-lg) var(--split-gap);
      align-items: start;
    }

    .home-circle__title {
      max-inline-size: 12ch;
      margin: 0;
    }

    .home-circle__text {
      max-inline-size: 54ch;
    }

    /* Wide: the marker runs over both columns, the title sits in the rail and the
       reading starts level with it. */
    @media (width > 56em) {
      .home-circle__spread {
        row-gap: var(--space-sm);
      }

      .home-circle__head {
        display: contents;
      }

      .home-circle__head .marker {
        grid-column: 1 / -1;
        margin: 0;
      }

      .home-circle__text {
        padding-block-start: 0.4em;
      }
    }

    .home-circle__text p {
      font-size: var(--text-section-body-lg);
    }

    /* The questions sit around the circle like the men they belong to: north,
       east, south, west — read clockwise, in DOM order. */
    .home-circle__questions {
      display: grid;
      grid-template-areas:
        'label label label'
        '.  q1    .'
        'q4 c     q2'
        '.  q3    .';
      grid-template-columns: minmax(0, 1fr) minmax(14rem, 20rem) minmax(0, 1fr);
      gap: var(--space-md) var(--space-lg);
      align-items: center;
      margin-block: var(--space-2xl) 0;
    }

    .home-circle__label {
      grid-area: label;
      font-size: var(--text-marker);
      font-weight: 600;
      color: var(--text-muted);
      text-align: center;
      text-transform: uppercase;
      letter-spacing: var(--tracking-marker);
    }

    /* The empty middle of the circle breathes; the breath stays inside the stroke. */
    .home-circle__center {
      position: relative;
      grid-area: c;
    }

    .home-circle__breath {
      inset: 16%;
    }

    .home-circle__mark {
      inline-size: 100%;
    }

    .home-circle__list {
      display: contents;
    }

    .home-circle__question {
      font-family: var(--font-quote);
      font-size: clamp(1.75rem, 0.9rem + 1.5vw, 2.5rem);
      font-style: italic;
      line-height: 1.2;
      color: var(--text-primary);
      text-wrap: balance;
    }

    .home-circle__question--1 {
      grid-area: q1;
      text-align: center;
    }

    .home-circle__question--2 {
      grid-area: q2;
      max-inline-size: 16ch;
    }

    .home-circle__question--3 {
      grid-area: q3;
      text-align: center;
    }

    .home-circle__question--4 {
      grid-area: q4;
      max-inline-size: 16ch;
      justify-self: end;
      text-align: end;
    }

    .home-circle__close {
      max-inline-size: 36ch;
      margin: var(--space-lg) auto 0;
      font-size: var(--text-section-body-lg);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
      text-align: center;
    }

    @media (width <= 56em) {
      .home-circle__spread {
        grid-template-columns: minmax(0, 1fr);
        align-items: start;
      }

      /* Phone: the circle becomes a small mark and the questions a ladder that
         hangs from it, each one starting at a seat. */
      .home-circle__questions {
        grid-template-areas:
          'c label'
          'list list';
        grid-template-columns: 4.5rem minmax(0, 1fr);
        gap: var(--space-md);
        margin-block-start: var(--space-xl);
      }

      .home-circle__label {
        text-align: start;
      }

      .home-circle__list {
        display: grid;
        grid-area: list;
        padding: 0;
        margin: 0;
        border-block-start: 1px solid var(--border-light);
      }

      /* The desktop's named areas do not exist in this grid: without resetting
         them every question lands in the same implicit cell. */
      .home-circle__question,
      .home-circle__question--4 {
        grid-area: auto;
        display: flex;
        gap: var(--space-sm);
        align-items: baseline;
        max-inline-size: none;
        padding-block: var(--space-sm);
        font-size: var(--text-xl);
        text-align: start;
        border-block-end: 1px solid var(--border-light);
        justify-self: stretch;
      }

      .home-circle__question::before {
        flex: none;
        inline-size: 0.55rem;
        block-size: 0.55rem;
        content: '';
        background: var(--accent);
        border-radius: 50%;
        translate: 0 -0.15em;
      }

      .home-circle__close {
        margin-block-start: var(--space-xl);
        margin-inline: 0;
        text-align: start;
      }
    }
  }
</style>
