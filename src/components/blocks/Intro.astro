---
import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Props {
  anchor: string;
  eyebrow: string;
  title: string;
  questionsLabel: string;
  questions: string[];
  close: string;
}

const { anchor, eyebrow, title, questionsLabel, questions, close } = Astro.props;
---

<Section id={anchor} labelledby="ueber-title" innerClass="grid gap-x-grid gap-y-6 lg:grid-cols-12">
  <SectionHead eyebrow={eyebrow} title={title} titleId="ueber-title" class="lg:col-span-12" />
  <div class="lg:col-span-7">
    <Prose>
      <slot />
    </Prose>
    {close && <p class="mt-6 max-w-measure text-md font-semibold text-fg">{close}</p>}
  </div>

  {questions.length > 0 && (
    <aside
      aria-labelledby="ueber-questions-label"
      class="border-line max-lg:mt-4 max-lg:border-t max-lg:pt-8 lg:col-span-4 lg:col-start-9 lg:self-start lg:border-l lg:pl-8"
    >
      <h3 id="ueber-questions-label" class="font-sans text-base font-semibold text-fg">
        {questionsLabel}
      </h3>
      <ul role="list" class="mt-4 grid gap-3">
        {questions.map((question, i) => (
          <li class="reveal reveal-stagger text-md text-fg-soft" style={`--motion-order: ${i}`}>
            {question}
          </li>
        ))}
      </ul>
    </aside>
  )}
</Section>
