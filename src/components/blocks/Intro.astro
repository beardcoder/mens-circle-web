---
import { caps, card } from '@lib/ui';
import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    text?: string;
    questionsLabel?: string;
    questions?: string[];
    close?: string;
  };
}

/** What an evening is about: the reading on the left, the questions it often turns on beside it, on a card around the seat circle. */

const { data } = Astro.props;
const anchor = data.anchor ?? 'ueber';
const questions = (data.questions ?? []).slice(0, 4);
---

<Section id={anchor} labelledby="ueber-title" innerClass="grid items-start gap-y-12 lg:grid-cols-12 lg:gap-x-grid">
  <div class="grid gap-6 lg:col-span-6">
    <SectionHead eyebrow={data.eyebrow} title={data.title} titleId="ueber-title" size="display-2" />
    {data.text && <Prose html={data.text} size="lg" />}
    {data.close && <p class="max-w-measure font-serif text-xl text-fg italic">{data.close}</p>}
  </div>

  {questions.length > 0 && (
    <figure
      class:list={[card, 'reveal p-6 sm:p-8 lg:col-span-5 lg:col-start-8']}
      aria-labelledby="ueber-questions-label"
    >
      <figcaption id="ueber-questions-label" class={`${caps} mb-6 text-fg-muted`}>
        {data.questionsLabel}
      </figcaption>
      <ul role="list" class="divide-y divide-line">
        {questions.map((question) => (
          <li class="py-4 font-serif text-xl leading-snug text-fg italic first:pt-0 last:pb-0">{question}</li>
        ))}
      </ul>
    </figure>
  )}
</Section>
