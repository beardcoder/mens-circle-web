---
import { label, margin } from '@lib/ui'

import Prose from '../ui/Prose.astro'
import Section from '../ui/Section.astro'
import SectionHead from '../ui/SectionHead.astro'

interface Props {
  anchor: string
  eyebrow?: string
  title: string
  questionsLabel: string
  questions: string[]
  /** The label of the facts in the `facts` slot (`Fact` items), the section's last row. */
  factsLabel: string
}

const { anchor, eyebrow, title, questionsLabel, questions, factsLabel } = Astro.props
---

{/* The title starts in the margin and runs into the content; the questions of the
    first round stand in the margin as quiet notes, the text beside them. The facts
    of an evening close the section as one row: too short for a section of their own. */}
<Section
  id={anchor}
  labelledby="ueber-title"
>
  <div class:list={[margin.grid, 'gap-y-10']}>
    <SectionHead
      eyebrow={eyebrow}
      title={title}
      titleId="ueber-title"
      class={margin.cross}
    />

    {questions.length > 0 && (
      <aside
        aria-labelledby="ueber-questions-label"
        class:list={[margin.side, 'max-lg:order-last']}
      >
        <h3
          id="ueber-questions-label"
          class="font-sans text-sm font-semibold text-fg-muted"
        >
          {questionsLabel}
        </h3>
        {/* Asked in the first round, one after the other: a quiet list. */}
        <ul
          role="list"
          class="mt-5 grid gap-4 border-l border-line-strong pl-5"
        >
          {questions.map((question) => (
            <li class="font-display text-xl text-fg">{question}</li>
          ))}
        </ul>
      </aside>
    )}

    <div class={margin.reading}>
      <Prose>
        <slot />
      </Prose>
    </div>

    <h3 class:list={[label, margin.side, 'mt-6 max-lg:order-last lg:mt-16 lg:pt-5']}>{factsLabel}</h3>
    <dl class:list={[margin.content, 'grid grid-cols-2 gap-x-grid gap-y-8 max-lg:order-last lg:mt-16 lg:grid-cols-4']}>
      <slot name="facts" />
    </dl>
  </div>
  {Astro.slots.has('close') && <p class="mt-group border-t border-line pt-6 font-display text-section text-fg [&_em]:text-accent">
    <slot name="close" />
  </p>}
</Section>
