---
import HalfBleed from '../ui/HalfBleed.astro';
import Prose from '../ui/Prose.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    titleEmphasis?: string;
    text?: string;
    questionsLabel?: string;
    questions?: string[];
    close?: string;
  };
}

/** What an evening is about: the reading on the paper, the questions it often turns on in the brown panel beside it, set large in the serif's italic. */

const { data } = Astro.props;
const anchor = data.anchor ?? 'ueber';
const questions = (data.questions ?? []).slice(0, 4);
---

<HalfBleed id={anchor} labelledby="ueber-title">
  <div slot="start" class="grid justify-items-start gap-6">
    <SectionHead
      eyebrow={data.eyebrow}
      title={data.title}
      titleEmphasis={data.titleEmphasis}
      titleId="ueber-title"
      size="display-3"
    />
    {data.text && <Prose html={data.text} size="lg" />}
    {data.close && <p class="max-w-measure font-serif text-xl text-accent italic">{data.close}</p>}
  </div>

  {questions.length > 0 && (
    <figure aria-labelledby="ueber-questions-label" class="reveal grid gap-8">
      <figcaption id="ueber-questions-label" class="text-xs font-bold tracking-[0.2em] text-fg-muted uppercase">
        {data.questionsLabel}
      </figcaption>
      <ul role="list" class="divide-y divide-line border-y border-line">
        {questions.map((question) => (
          <li class="py-5 font-serif text-[clamp(1.375rem,1rem+1.2vw,2rem)] leading-snug text-fg italic">{question}</li>
        ))}
      </ul>
    </figure>
  )}
</HalfBleed>
