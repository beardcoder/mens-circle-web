---
import { label, margin } from '@lib/ui'

import Prose from '../ui/Prose.astro'
import Section from '../ui/Section.astro'
import SectionHead from '../ui/SectionHead.astro'

interface Props {
  anchor: string
  eyebrow?: string
  title: string
  promptLabel: string
  prompt: string
  /** The label of the facts in the `facts` slot (`Fact` items), the section's last row. */
  factsLabel: string
}

const { anchor, eyebrow, title, promptLabel, prompt, factsLabel } = Astro.props
---

<Section
  id={anchor}
  labelledby="ueber-title"
>
  <div class:list={[margin.grid, 'gap-y-10']}>
    <SectionHead
      eyebrow={eyebrow}
      title={title}
      titleId="ueber-title"
      class={margin.cross}
    />

    <aside aria-labelledby="ueber-prompt-label" class={margin.side}>
      <h3 id="ueber-prompt-label" class={label}>{promptLabel}</h3>
      <p class="mt-3 max-w-[16em] font-display text-sub text-fg">{prompt}</p>
    </aside>
    <Prose class={margin.reading}>
      <slot />
    </Prose>

    <h3 class:list={[label, margin.side, 'mt-6 lg:mt-16 lg:pt-5']}>{factsLabel}</h3>
    <dl class:list={[margin.content, 'grid grid-cols-2 gap-x-grid gap-y-8 lg:mt-16 lg:grid-cols-4']}>
      <slot name="facts" />
    </dl>
  </div>
  {Astro.slots.has('close') && <p class="mt-group border-t border-line pt-6 font-display text-section text-fg [&_em]:text-accent">
    <slot name="close" />
  </p>}
</Section>
