---
interface Props {
  title: string;
  number: number;
}

const { title, number } = Astro.props;
---

<li
  itemprop="itemListElement"
  itemscope
  itemtype="https://schema.org/ListItem"
  class="relative grid grid-cols-[3rem_minmax(0,1fr)] content-start gap-x-5 not-last:before:absolute not-last:before:top-12 not-last:before:-bottom-8 not-last:before:left-6 not-last:before:w-px not-last:before:bg-line-strong lg:grid-cols-1 lg:gap-y-5 lg:not-last:before:top-6 lg:not-last:before:-right-(--spacing-grid) lg:not-last:before:bottom-auto lg:not-last:before:left-12 lg:not-last:before:h-px lg:not-last:before:w-auto"
>
  <meta itemprop="position" content={String(number)} />
  <span
    aria-hidden="true"
    class="relative grid size-12 place-items-center rounded-full border border-line-strong bg-raised font-display text-xl text-accent"
  >
    {number}
  </span>
  <div class="grid content-start gap-2 pt-2 lg:pt-0">
    <h3 itemprop="name" class="text-sub text-fg">
      {title}
    </h3>
    <p itemprop="description" class="max-w-measure text-md text-fg-soft">
      <slot />
    </p>
  </div>
</li>
