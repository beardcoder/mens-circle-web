---
import { margin } from '@lib/ui';

import Index from '../ui/Index.astro';

interface Props {
  title: string;
  number: number;
}

const { title, number } = Astro.props;
---

{/* One step: its number in the margin, its title and text beside it, under a thin rule. */}
<li
  itemprop="itemListElement"
  itemscope
  itemtype="https://schema.org/ListItem"
  class:list={[margin.grid, 'gap-y-3 border-t border-line-strong py-8 last:border-b lg:py-10']}
>
  <meta itemprop="position" content={String(number)} />
  <Index value={number} class={margin.side} />
  <div class:list={[margin.reading, 'grid content-start gap-3 lg:pt-2']}>
    <h3 itemprop="name" class="text-sub text-fg">
      {title}
    </h3>
    <p itemprop="description" class="max-w-measure text-md text-fg-soft">
      <slot />
    </p>
  </div>
</li>
