---
interface Props {
  title: string
  number: number
}

const { title, number } = Astro.props
---

<li
  itemprop="itemListElement"
  itemscope
  itemtype="https://schema.org/ListItem"
  class="relative pb-8 pl-7 last:pb-0 sm:pl-9 before:absolute before:top-[0.75em] before:left-0 before:size-2 before:rounded-full before:bg-accent after:absolute after:top-[calc(0.75em+0.5rem)] after:-bottom-[0.75em] after:left-[3.5px] after:w-px after:bg-line-strong last:after:hidden"
>
  <meta
    itemprop="position"
    content={String(number)}
  />
  <h3
    itemprop="name"
    class="text-sub text-fg"
  >
    {title}
  </h3>
  <p
    itemprop="description"
    class="mt-2 max-w-measure text-md text-fg-soft"
  >
    <slot />
  </p>
</li>
