---
import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Step {
  title?: string;
  description?: string;
}

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    subtitle?: string;
    steps?: Step[];
    close?: string;
  };
}

/**
 * The evening in four phases, in order: four equal columns on the desktop, two
 * on the tablet, one running list on phones. Each phase reads on its own: a
 * small number, its title, its description.
 */

const { data } = Astro.props;
const anchor = data.anchor ?? 'reise';
const steps = (data.steps ?? []).slice(0, 4);
---

<Section id={anchor} labelledby="ablauf-title">
  <SectionHead eyebrow={data.eyebrow} title={data.title} titleId="ablauf-title" lead={data.subtitle} />

  {steps.length > 0 && (
    <ol role="list" class="mt-group grid gap-x-grid gap-y-8 md:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <li class="reveal grid content-start gap-3">
          <span aria-hidden="true" class="draw mb-2 block h-px bg-line-strong"></span>
          <span class="font-sans text-lg font-semibold text-accent tabular-nums" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          {step.title && <h3 class="text-sub text-fg">{step.title}</h3>}
          {step.description && <p class="text-md text-fg-soft">{step.description}</p>}
        </li>
      ))}
    </ol>
  )}

  {data.close && <Prose html={data.close} class="mt-group" />}
</Section>
