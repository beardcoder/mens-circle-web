---
import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Step {
  title?: string;
  description?: string;
}

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    subtitle?: string;
    steps?: Step[];
    close?: string;
  };
}

/** The evening in four steps, in order: each under a heavy rule with its number, so the sequence reads at a glance. */

const { data } = Astro.props;
const anchor = data.anchor ?? 'reise';
const steps = (data.steps ?? []).slice(0, 4);
---

<Section id={anchor} ground="sand" labelledby="ablauf-title">
  <SectionHead eyebrow={data.eyebrow} title={data.title} titleId="ablauf-title" lead={data.subtitle} size="display-2" />

  {steps.length > 0 && (
    <ol role="list" class="mt-group grid gap-x-grid gap-y-10 sm:grid-cols-2 xl:grid-cols-4">
      {steps.map((step, i) => (
        <li class="reveal grid content-start gap-3 border-t-3 border-fg pt-5">
          <span class="font-serif text-display-3 leading-none font-semibold text-accent" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          {step.title && <h3 class="mt-2 text-2xl text-fg">{step.title}</h3>}
          {step.description && <p class="text-base text-fg-soft">{step.description}</p>}
        </li>
      ))}
    </ol>
  )}

  {data.close && <Prose html={data.close} class="mt-group" />}
</Section>
