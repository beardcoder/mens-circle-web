---
import { margin } from '@lib/ui'

import Section from '../ui/Section.astro'
import SectionHead from '../ui/SectionHead.astro'

interface Props {
  anchor: string
  eyebrow?: string
  title: string
  subtitle: string
}

const { anchor, eyebrow, title, subtitle } = Astro.props
---

<Section
  id={anchor}
  ground="alt"
  labelledby="ablauf-title"
>
  <div
    itemscope
    itemtype="https://schema.org/ItemList"
    class:list={[margin.grid, 'gap-y-group']}
  >
    <meta
      itemprop="name"
      content={title}
    />
    <meta
      itemprop="description"
      content={subtitle}
    />
    <SectionHead
      eyebrow={eyebrow}
      title={title}
      titleId="ablauf-title"
      lead={subtitle}
      class="lg:col-span-5"
    />

    <ol
      role="list"
      class="min-w-0 lg:col-span-6 lg:col-start-7"
    >
      <slot name="steps" />
    </ol>
  </div>
</Section>
