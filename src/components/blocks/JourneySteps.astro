---
import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Props {
  anchor: string;
  eyebrow: string;
  title: string;
  subtitle: string;
}

const { anchor, eyebrow, title, subtitle } = Astro.props;
---

<Section id={anchor} labelledby="ablauf-title">
  <div itemscope itemtype="https://schema.org/ItemList">
    <meta itemprop="name" content={title} />
    <meta itemprop="description" content={subtitle} />
    <SectionHead eyebrow={eyebrow} title={title} titleId="ablauf-title" lead={subtitle} />

    <ol role="list" class="journey-flow mt-group grid items-start gap-x-grid gap-y-8 md:grid-cols-2 lg:grid-cols-4">
      <slot name="steps" />
    </ol>

    <Prose class="mt-group">
      <slot name="close" />
    </Prose>
  </div>
</Section>
