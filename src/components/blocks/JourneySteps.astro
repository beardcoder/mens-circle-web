---
interface Step {
  number?: string;
  title?: string;
  description?: string;
}

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    subtitle?: string;
    steps?: Step[];
    close?: string;
  };
}

/**
 * "Wie ein Abend abläuft" — the evening as an open sequence.
 *
 * Big condensed numerals in the margin, a full-width rule above each step, and
 * the text set against the numeral rather than inside a box. Reading down a
 * ruled ladder, not across a row of cards and not along a process diagram with
 * arrows.
 *
 * The numerals are `aria-hidden`: the ordered list already conveys the order to
 * assistive technology, and reading "one" twice per step is noise.
 *
 * The `#reise` id is kept even though the label is "Ablauf" — that anchor has
 * been linked from the nav, the footer and /event for as long as the page has
 * existed.
 */

const { data } = Astro.props;
const anchor = data.anchor ?? 'reise';
const steps = data.steps ?? [];
---

<section class="section home-evening" id={anchor} aria-labelledby="ablauf-title">
  <div class="container">
    <div class="bay home-evening__head">
      <p class="marker marker--ruled bay__marker">{data.eyebrow}</p>

      <div class="bay__beside-marker">
        {
          data.title && (
            <h2 class="section-title" id="ablauf-title">
              {data.title}
            </h2>
          )
        }
        {data.subtitle && <p class="section-intro">{data.subtitle}</p>}
      </div>
    </div>

    {
      steps.length > 0 && (
        <ol class="home-evening__list" role="list">
          {steps.map((step) => (
            <li class="home-evening__step">
              <p class="home-evening__number" aria-hidden="true">
                {step.number}
              </p>
              <div class="home-evening__text-col">
                {step.title && <h3 class="home-evening__title">{step.title}</h3>}
                {step.description && <p class="home-evening__text">{step.description}</p>}
              </div>
            </li>
          ))}
        </ol>
      )
    }

    {data.close && <div class="home-evening__close prose" set:html={data.close} />}
  </div>
</section>

<style is:global>
  @layer sections {
    .home-evening__head {
      margin-block-end: var(--space-lg);
    }

    .home-evening__list {
      padding: 0;
      margin: 0;
      list-style: none;
    }

    /* Each step is a full-width row with a 3px rule on top — the ladder reads
       as one continuous structure rather than four separate objects. */
    .home-evening__step {
      display: grid;
      grid-template-columns: minmax(0, 3.5fr) minmax(0, 8.5fr);
      column-gap: var(--col-gap);
      align-items: start;
      padding-block: var(--space-md) var(--space-lg);
      border-block-start: 3px solid var(--rule-strong);
    }

    .home-evening__number {
      margin: 0;
      font-family: var(--font-display);
      font-size: var(--display-numeral);
      font-weight: 800;
      line-height: 0.8;
      /* The deep orange, not the signal one: at this size the numeral is large
         text and owes 3:1. Signal orange on paper measures 2.64:1, the deep
         orange 3.52:1. */
      color: var(--color-orange-deep);
      letter-spacing: -0.03em;
    }

    .home-evening__title {
      margin-block-end: var(--space-xs);
      font-size: var(--text-3xl);
      line-height: 1;
      color: var(--text-primary);
      text-transform: uppercase;
      letter-spacing: -0.01em;
    }

    .home-evening__text {
      max-inline-size: var(--measure);
      margin: 0;
      font-size: var(--text-section-body);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
    }

    .home-evening__close {
      max-inline-size: var(--measure);
      padding-block-start: var(--space-md);
      margin-block-start: 0;
      border-block-start: 3px solid var(--rule-strong);
    }

    .home-evening__close p {
      font-size: var(--text-section-body);
    }

    @media (width <= 56em) {
      .home-evening__step {
        grid-template-columns: minmax(0, 1fr);
        row-gap: var(--space-2xs);
        padding-block: var(--space-sm) var(--space-md);
      }

      .home-evening__number {
        font-size: clamp(2.75rem, 2rem + 4vw, 4rem);
      }
    }
  }
</style>
