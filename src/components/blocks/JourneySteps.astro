---
interface Step {
  title?: string;
  description?: string;
}

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    subtitle?: string;
    steps?: Step[];
    close?: string;
  };
}

/** The evening in four steps, unnumbered: each sits a little lower than the one before, so the row reads as a way through the evening, not a checklist. */

const { data } = Astro.props;
const anchor = data.anchor ?? 'reise';
const steps = (data.steps ?? []).slice(0, 4);
---

<section class="section surface-sand home-evening" id={anchor} aria-labelledby="ablauf-title">
  <div class="container">
    <div class="home-evening__head">
      <p class="marker">{data.eyebrow}</p>
      {data.title && (
        <h2 class="display home-evening__title" id="ablauf-title">
          {data.title}
        </h2>
      )}
      {data.subtitle && <p class="section-intro home-evening__intro">{data.subtitle}</p>}
    </div>

    {steps.length > 0 && (
      <ol class="home-evening__list" role="list">
        {steps.map((step, i) => (
          <li class="home-evening__step" style={`--i: ${i}; --pair: ${i % 2}`} data-reveal>
            {step.title && <h3 class="home-evening__step-title">{step.title}</h3>}
            {step.description && <p class="home-evening__text">{step.description}</p>}
          </li>
        ))}
      </ol>
    )}

    {data.close && <div class="home-evening__close prose" set:html={data.close} />}
  </div>
</section>

<style is:global>
  @layer sections {
    .home-evening__head {
      display: grid;
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: 0 var(--space-xl);
      align-items: end;
      margin-block-end: var(--space-xl);
    }

    .home-evening__head .marker {
      grid-column: 1 / -1;
    }

    .home-evening__title {
      max-inline-size: 11ch;
      margin: 0;
    }

    .home-evening__intro {
      max-inline-size: 46ch;
    }

    .home-evening__list {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-lg);
      padding: 0;
      margin: 0;
      list-style: none;
    }

    /* No numbers and no rules between them: the descent carries the order. */
    .home-evening__step {
      container-type: inline-size;
      display: grid;
      gap: var(--space-sm);
      align-content: start;
      margin-block-start: calc(var(--i) * var(--space-lg));
    }

    .home-evening__step-title {
      /* One word per step, four abreast: capped so the longest fits its column. */
      font-size: min(clamp(2rem, 1.3rem + 1.8vw, 3.25rem), 17cqi);
      line-height: 1.05;
    }

    .home-evening__text {
      margin: 0;
      font-size: var(--text-section-body);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
    }

    .home-evening__close {
      max-inline-size: 60ch;
      padding-block-start: var(--space-md);
      margin-block-start: var(--space-xl);
      border-block-start: 1px solid var(--border-medium);
    }

    .home-evening__close p {
      font-size: var(--text-section-body);
    }

    @media (width <= 72em) {
      .home-evening__list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        row-gap: var(--space-xl);
      }

      .home-evening__step {
        margin-block-start: calc(var(--pair) * var(--space-xl));
      }
    }

    @media (width <= 56em) {
      .home-evening__head {
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-md);
        margin-block-end: var(--space-lg);
      }
    }

    /* Phone: one after another, the descent turned into a gentle indent. */
    @media (width <= 36em) {
      .home-evening__list {
        grid-template-columns: minmax(0, 1fr);
        row-gap: var(--space-lg);
      }

      .home-evening__step {
        margin-block-start: 0;
        margin-inline-start: calc(var(--i) * var(--space-sm));
      }
    }
  }
</style>
