---
import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Props {
  anchor: string;
  eyebrow: string;
  title: string;
  subtitle: string;
}

const { anchor, eyebrow, title, subtitle } = Astro.props;
---

<Section id={anchor} ground="alt" labelledby="ablauf-title">
  <div itemscope itemtype="https://schema.org/ItemList">
    <meta itemprop="name" content={title} />
    <meta itemprop="description" content={subtitle} />
    <SectionHead eyebrow={eyebrow} title={title} titleId="ablauf-title" lead={subtitle} />

    {/* One path through the evening: a line through the numbered circles, down on phones, across on the desktop. */}
    <ol role="list" data-reveal-group class="mt-group grid gap-y-8 lg:grid-cols-4 lg:gap-x-grid">
      <slot name="steps" />
    </ol>

    <Prose class="mt-group">
      <slot name="close" />
    </Prose>
  </div>
</Section>
