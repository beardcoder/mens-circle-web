---
import { card } from '@lib/ui';
import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Step {
  title?: string;
  description?: string;
}

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    subtitle?: string;
    steps?: Step[];
    close?: string;
  };
}

/** The evening in four steps, in order: one card each, numbered, so the sequence reads at a glance. */

const { data } = Astro.props;
const anchor = data.anchor ?? 'reise';
const steps = (data.steps ?? []).slice(0, 4);
---

<Section id={anchor} ground="sand" labelledby="ablauf-title">
  <SectionHead eyebrow={data.eyebrow} title={data.title} titleId="ablauf-title" lead={data.subtitle} size="display-2" />

  {steps.length > 0 && (
    <ol role="list" class="mt-group grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {steps.map((step, i) => (
        <li class:list={[card, 'reveal grid content-start gap-3 p-6']}>
          <span
            class="grid size-10 place-items-center rounded-full bg-accent-soft font-serif text-lg font-semibold text-accent"
            aria-hidden="true"
          >
            {i + 1}
          </span>
          {step.title && <h3 class="mt-2 text-2xl text-fg">{step.title}</h3>}
          {step.description && <p class="text-base text-fg-soft">{step.description}</p>}
        </li>
      ))}
    </ol>
  )}

  {data.close && <Prose html={data.close} class="mt-group" />}
</Section>
