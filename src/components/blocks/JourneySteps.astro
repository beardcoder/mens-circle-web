---
interface Step {
  number?: string;
  title?: string;
  description?: string;
}

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    subtitle?: string;
    steps?: Step[];
    close?: string;
  };
}

/** The evening in four steps, side by side; each carries a small circle with its own quarter filled. */

const { data } = Astro.props;
const anchor = data.anchor ?? 'reise';
const steps = (data.steps ?? []).slice(0, 4);
---

<section class="section surface-sand home-evening" id={anchor} aria-labelledby="ablauf-title">
  <div class="container">
    <div class="home-evening__head">
      <p class="marker">{data.eyebrow}</p>
      {data.title && (
        <h2 class="display home-evening__title" id="ablauf-title">
          {data.title}
        </h2>
      )}
      {data.subtitle && <p class="section-intro home-evening__intro">{data.subtitle}</p>}
    </div>

    {steps.length > 0 && (
      <ol class="home-evening__list" role="list">
        {steps.map((step, i) => (
          <li class="home-evening__step" data-reveal>
            <p class="home-evening__number" aria-hidden="true">
              <svg class="home-evening__glyph" viewBox="0 0 24 24" focusable="false">
                <circle cx="12" cy="12" r="10" fill="none"></circle>
                <path d="M12 12 L12 2 A10 10 0 0 1 22 12 Z" transform={`rotate(${i * 90} 12 12)`}></path>
              </svg>
              {step.number?.padStart(2, '0')}
            </p>
            {step.title && <h3 class="home-evening__step-title">{step.title}</h3>}
            {step.description && <p class="home-evening__text">{step.description}</p>}
          </li>
        ))}
      </ol>
    )}

    {data.close && <div class="home-evening__close prose" set:html={data.close} />}
  </div>
</section>

<style is:global>
  @layer sections {
    .home-evening__head {
      display: grid;
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: 0 var(--space-xl);
      align-items: end;
      margin-block-end: var(--space-xl);
    }

    .home-evening__head .marker {
      grid-column: 1 / -1;
    }

    .home-evening__title {
      max-inline-size: 11ch;
      margin: 0;
    }

    .home-evening__intro {
      max-inline-size: 46ch;
    }

    .home-evening__list {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-lg);
      padding: 0;
      margin: 0;
      list-style: none;
    }

    .home-evening__step {
      container-type: inline-size;
      display: grid;
      grid-template-rows: auto auto 1fr;
      gap: var(--space-sm);
      align-content: start;
      padding-block-start: var(--space-md);
      border-block-start: 1px solid var(--rule-strong);
    }

    .home-evening__number {
      display: flex;
      gap: var(--space-xs);
      align-items: center;
      margin: 0;
      font-size: var(--text-caption);
      font-weight: 700;
      color: var(--text-muted);
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.1em;
    }

    /* The small circle: the evening, with this step's quarter filled. */
    .home-evening__glyph {
      flex: none;
      inline-size: 2.25rem;
      block-size: 2.25rem;
    }

    .home-evening__glyph circle {
      stroke: var(--border-dark);
      stroke-width: 1px;
      vector-effect: non-scaling-stroke;
    }

    .home-evening__glyph path {
      fill: var(--accent);
    }

    .home-evening__step-title {
      /* One word per step, four abreast: capped so the longest fits its column. */
      font-size: min(clamp(1.75rem, 1.2rem + 1.6vw, 2.75rem), 16cqi);
      line-height: 1.05;
    }

    .home-evening__text {
      margin: 0;
      font-size: var(--text-section-body);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
    }

    .home-evening__close {
      max-inline-size: 60ch;
      padding-block-start: var(--space-md);
      margin-block-start: var(--space-xl);
      border-block-start: 1px solid var(--border-medium);
    }

    .home-evening__close p {
      font-size: var(--text-section-body);
    }

    @media (width <= 72em) {
      .home-evening__list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        row-gap: var(--space-xl);
      }
    }

    @media (width <= 56em) {
      .home-evening__head {
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-md);
        margin-block-end: var(--space-lg);
      }
    }

    /* Phone: a ladder, the circle beside each step. */
    @media (width <= 36em) {
      .home-evening__list {
        grid-template-columns: minmax(0, 1fr);
        row-gap: 0;
      }

      .home-evening__step {
        grid-template-columns: 3rem minmax(0, 1fr);
        grid-template-rows: none;
        column-gap: var(--space-sm);
        padding-block: var(--space-md);
      }

      .home-evening__number {
        grid-row: 1 / span 2;
        flex-direction: column;
        align-items: flex-start;
      }

      .home-evening__glyph {
        inline-size: 2rem;
        block-size: 2rem;
      }
    }
  }
</style>
