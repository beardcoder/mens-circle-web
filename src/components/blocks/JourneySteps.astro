---
import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Step {
  title?: string;
  description?: string;
}

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    subtitle?: string;
    steps?: Step[];
    close?: string;
  };
}

/**
 * The evening in four steps, unnumbered: each stands level on its own hairline
 * with a seat where it begins, read in order like the seats around the circle.
 * One after another on a phone, two by two on a tablet, four abreast when wide.
 */

const { data } = Astro.props;
const anchor = data.anchor ?? 'reise';
const steps = (data.steps ?? []).slice(0, 4);
---

<Section id={anchor} ground="sand" labelledby="ablauf-title">
  <SectionHead eyebrow={data.eyebrow} title={data.title} titleId="ablauf-title" lead={data.subtitle} layout="split" />

  {steps.length > 0 && (
    <ol role="list" class="mt-group grid grid-cols-1 gap-x-8 gap-y-group sm:grid-cols-2 xl:grid-cols-4">
      {steps.map((step) => (
        <li class="reveal @container relative grid content-start gap-4 border-t border-line-strong pt-8 before:absolute before:-top-[calc(0.4rem+0.5px)] before:left-0 before:size-3 before:rounded-full before:border-[1.5px] before:border-accent before:bg-surface">
          {/* One word per step: capped so the longest fits its column. */}
          {step.title && (
            <h3 class="text-[length:min(clamp(2rem,1.3rem+1.8vw,2.75rem),17cqi)] leading-[1.05] font-medium tracking-[-0.015em] text-fg">
              {step.title}
            </h3>
          )}
          {step.description && <p class="max-w-[30em] text-md text-fg-soft">{step.description}</p>}
        </li>
      ))}
    </ol>
  )}

  {data.close && <Prose html={data.close} class="mt-group max-w-[38em]" />}
</Section>
