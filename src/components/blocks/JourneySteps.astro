---
interface Step {
  title?: string;
  description?: string;
}

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    subtitle?: string;
    steps?: Step[];
    close?: string;
  };
}

/** The evening in four steps, unnumbered: each stands on its own hairline with a seat where it begins, read in order like the seats around the circle. */

const { data } = Astro.props;
const anchor = data.anchor ?? 'reise';
const steps = (data.steps ?? []).slice(0, 4);
---

<section class="section surface-sand home-evening" id={anchor} aria-labelledby="ablauf-title">
  <div class="container">
    <div class="home-evening__head">
      <p class="marker">{data.eyebrow}</p>
      {data.title && (
        <h2 class="display home-evening__title" id="ablauf-title">
          {data.title}
        </h2>
      )}
      {data.subtitle && <p class="section-intro home-evening__intro">{data.subtitle}</p>}
    </div>

    {steps.length > 0 && (
      <ol class="home-evening__list" role="list">
        {steps.map((step) => (
          <li class="home-evening__step" data-reveal>
            {step.title && <h3 class="home-evening__step-title">{step.title}</h3>}
            {step.description && <p class="home-evening__text">{step.description}</p>}
          </li>
        ))}
      </ol>
    )}

    {data.close && <div class="home-evening__close prose" set:html={data.close} />}
  </div>
</section>

<style is:global>
  @layer sections {
    .home-evening__head {
      display: grid;
      gap: var(--space-md);
      margin-block-end: var(--space-xl);
    }

    .home-evening__head .marker {
      margin: 0;
    }

    .home-evening__title {
      max-inline-size: 11ch;
      margin: 0;
    }

    .home-evening__intro {
      max-inline-size: 34em;
    }

    /* One step after another on a phone, two by two on a tablet, four abreast on a
       wide screen; tops always level. */
    .home-evening__list {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl) var(--space-lg);
      padding: 0;
      margin: 0;
      list-style: none;
    }

    /* No numbers: each step stands on its own hairline, with a seat where it
       begins, like the seats around the circle. */
    .home-evening__step {
      position: relative;
      container-type: inline-size;
      display: grid;
      gap: var(--space-sm);
      align-content: start;
      padding-block-start: var(--space-lg);
      border-block-start: 1px solid var(--border-medium);
    }

    .home-evening__step::before {
      position: absolute;
      inset-block-start: calc(-0.4rem - 0.5px);
      inset-inline-start: 0;
      inline-size: 0.8rem;
      block-size: 0.8rem;
      content: '';
      background: var(--surface);
      border: 1.5px solid var(--accent);
      border-radius: 50%;
    }

    .home-evening__step-title {
      /* One word per step: capped so the longest fits its column. */
      font-size: min(clamp(2rem, 1.3rem + 1.8vw, 2.75rem), 17cqi);
      line-height: 1.05;
    }

    .home-evening__text {
      max-inline-size: 30em;
      margin: 0;
      font-size: var(--text-section-body);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
    }

    .home-evening__close {
      max-inline-size: 38em;
      margin-block-start: var(--space-xl);
    }

    .home-evening__close p {
      font-size: var(--text-section-body);
    }

    @media (width > 36em) {
      .home-evening__list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    /* Wide: the title and its reading at the top left, the steps under them. */
    @media (width > 56em) {
      .home-evening__head {
        grid-template-columns: var(--field);
        column-gap: var(--field-gap);
      }

      .home-evening__head > * {
        grid-column: 1 / span 6;
      }

      .home-evening__title {
        max-inline-size: none;
      }
    }

    @media (width > 72em) {
      .home-evening__list {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }
  }
</style>
