---
import CropPicture from '../CropPicture.astro';
import { resolveAssetImage } from '../../lib/images';
import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import TextLink from '../ui/TextLink.astro';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    name?: string;
    quote?: string;
    bio?: string;
    image?: string;
    imageAlt?: string;
    linkLabel?: string;
    linkUrl?: string;
  };
}

/**
 * Markus: his photograph and his words at about 5 : 7 on the shared grid. On
 * phones the title comes first, then a photo of moderate height, then the text,
 * so the photo never pushes the orientation down by screens. His sentence stays
 * below the size of the section's title.
 */

const { data } = Astro.props;
const anchor = data.anchor ?? 'moderator';
const photo = resolveAssetImage(data.image);
---

<Section id={anchor} labelledby="person-title" innerClass="grid gap-x-grid gap-y-8 lg:grid-cols-12">
  <SectionHead
    eyebrow={data.eyebrow}
    title={data.name}
    titleId="person-title"
    class="lg:col-span-7 lg:col-start-6 lg:row-start-1"
  />

  {photo && (
    <figure class="lg:col-span-5 lg:col-start-1 lg:row-span-2 lg:row-start-1 lg:self-start">
      <CropPicture
        src={photo}
        class="block aspect-4/3 w-full rounded-card object-cover object-[30%_45%] lg:aspect-4/5"
        breakpoint="64em"
        narrow={{ ratio: 4 / 3, widths: [400, 640, 960], sizes: 'calc(100vw - 2.5rem)' }}
        wide={{ ratio: 4 / 5, widths: [400, 560, 800], sizes: 'min(30rem, 38vw)' }}
        loading="lazy"
        alt={data.imageAlt ?? ''}
      />
    </figure>
  )}

  <div class="grid content-start justify-items-start gap-6 lg:col-span-7 lg:col-start-6 lg:row-start-2">
    {data.quote && (
      <blockquote class="max-w-measure border-l-2 border-line-strong pl-5 font-serif text-quote text-fg">
        <p>„{data.quote}“</p>
      </blockquote>
    )}
    {data.bio && <Prose html={data.bio} />}
    {data.linkLabel && data.linkUrl && (
      <TextLink href={data.linkUrl} data-astro-prefetch="hover">
        {data.linkLabel}
      </TextLink>
    )}
  </div>
</Section>
