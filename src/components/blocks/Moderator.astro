---
import type { ImageMetadata } from 'astro';

import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import TextLink from '../ui/TextLink.astro';

interface Props {
  anchor: string;
  eyebrow: string;
  name: string;
  quote: string;
  /** A small square of his face, signing the quote. Pre-sized: the home page is SSR. */
  avatar: ImageMetadata;
  imageAlt: string;
  signature: string;
  signatureNote: string;
  linkLabel: string;
  linkUrl: string;
}

const { anchor, eyebrow, name, quote, avatar, imageAlt, signature, signatureNote, linkLabel, linkUrl } = Astro.props;
---

{/* Markus introduces himself; beside him his quote stands in a large ring that the window
    cuts on the right (the bleed), the quote crossing the ring's edge, his face a chair on it. */}
<Section id={anchor} labelledby="person-title" innerClass="grid items-center gap-x-grid gap-y-16 lg:grid-cols-12">
  <div class="grid min-w-0 content-start justify-items-start gap-6 lg:col-span-6">
    <SectionHead eyebrow={eyebrow} title={name} titleId="person-title" />
    <Prose reveal>
      <slot />
    </Prose>
    {linkLabel && linkUrl && (
      <TextLink href={linkUrl} data-reveal>
        {linkLabel}
      </TextLink>
    )}
  </div>

  {quote && (
    <figure data-reveal class="relative grid min-w-0 content-center py-12 lg:col-span-5 lg:col-start-8 lg:py-24">
      <span
        aria-hidden="true"
        data-ring-open
        class="absolute top-1/2 left-[14%] aspect-square w-[118%] -translate-y-1/2 rounded-full border border-line-strong lg:left-[22%] lg:w-[132%]"
      ></span>
      <blockquote class="relative max-w-[16em] font-display text-quote text-fg">
        <p>„{quote}“</p>
      </blockquote>
      <figcaption class="relative mt-8 flex items-center gap-4">
        <img
          src={avatar.src}
          width={avatar.width}
          height={avatar.height}
          alt={imageAlt}
          loading="lazy"
          decoding="async"
          class="size-16 shrink-0 rounded-full object-cover ring-4 ring-surface"
        />
        <span class="grid">
          <span class="font-semibold text-fg">{signature}</span>
          <span class="text-sm text-fg-muted">{signatureNote}</span>
        </span>
      </figcaption>
    </figure>
  )}
</Section>
