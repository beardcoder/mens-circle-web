---
interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    name?: string;
    bio?: string;
    linkLabel?: string;
    linkUrl?: string;
  };
}

/**
 * Who holds the evening — deliberately the quietest section on the page.
 *
 * Sitting between the poster questions above and the orange field below, this
 * is where the page stops shouting: a marker, a name, two paragraphs and a
 * link, on a narrow measure, on the warm sand ground. The contrast with its
 * neighbours is the point — it is the calm beat before the loudest one.
 *
 * No portrait here — it is already at full size in the hero a screen above, and
 * running it twice would be the same picture and the same introduction twice.
 * The long version is its own page, one link away.
 */

const { data } = Astro.props;
const anchor = data.anchor ?? 'moderator';
---

<section class="section section--sand home-person" id={anchor} aria-labelledby="person-title">
  <div class="container">
    <div class="bay">
      <p class="marker bay__marker">{data.eyebrow}</p>

      <div class="bay__beside-marker home-person__body">
        {
          data.name && (
            <h2 class="home-person__name" id="person-title">
              {data.name}
            </h2>
          )
        }

        {data.bio && <div class="home-person__bio prose" set:html={data.bio} />}

        {
          data.linkLabel && data.linkUrl && (
            <p class="home-person__link">
              <a href={data.linkUrl} class="link">
                {data.linkLabel}
              </a>
            </p>
          )
        }
      </div>
    </div>
  </div>
</section>

<style is:global>
  @layer sections {
    .home-person__body {
      max-inline-size: 62ch;
    }

    .home-person__name {
      margin-block-end: var(--space-sm);
      font-size: var(--text-3xl);
      line-height: 1.02;
    }

    .home-person__bio p {
      font-size: var(--text-section-body);
    }

    .home-person__link {
      margin-block-start: var(--space-md);
      font-size: var(--text-section-body);
    }
  }
</style>
