---
import CropPicture from '../CropPicture.astro';
import { resolveAssetImage } from '../../lib/images';
import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import TextLink from '../ui/TextLink.astro';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    name?: string;
    /** A phrase of the name line set in the italic accent. */
    titleEmphasis?: string;
    quote?: string;
    bio?: string;
    image?: string;
    imageAlt?: string;
    linkLabel?: string;
    linkUrl?: string;
  };
}

/** Markus, on the sand band: his portrait floating gently on the left; his name set large, his own words, and his sentence beside an accent rule on the right. */

const { data } = Astro.props;
const anchor = data.anchor ?? 'moderator';
const photo = resolveAssetImage(data.image);
---

<Section
  id={anchor}
  ground="sand"
  labelledby="person-title"
  defer
  innerClass="grid items-center gap-y-12 lg:grid-cols-12 lg:gap-x-grid"
>
  {photo && (
    <figure class="reveal max-w-md lg:col-span-5 lg:max-w-none">
      <div class="aspect-2/3 overflow-clip rounded-card bg-ground-alt shadow-lift motion-safe:animate-float [&_picture]:block [&_picture]:h-full">
        <CropPicture
          src={photo}
          class="block size-full object-cover object-[30%_50%]"
          breakpoint="56.25em"
          narrow={{ ratio: 2 / 3, widths: [320, 480, 640], sizes: 'min(28rem, 90vw)' }}
          wide={{ ratio: 2 / 3, widths: [400, 600, 800], sizes: 'min(32rem, 40vw)' }}
          loading="lazy"
          alt={data.imageAlt ?? ''}
        />
      </div>
    </figure>
  )}

  <div class="grid content-start justify-items-start gap-8 lg:col-span-6 lg:col-start-7">
    <SectionHead
      eyebrow={data.eyebrow}
      title={data.name}
      titleEmphasis={data.titleEmphasis}
      titleId="person-title"
      size="display-2"
    />

    {data.bio && <Prose html={data.bio} class="reveal" />}

    {data.linkLabel && data.linkUrl && (
      <TextLink href={data.linkUrl} data-astro-prefetch="hover">
        {data.linkLabel}
      </TextLink>
    )}

    {data.quote && (
      <blockquote class="reveal mt-4 border-l-2 border-fill pl-6 font-serif text-[clamp(1.375rem,1rem+1.4vw,2rem)] leading-snug text-fg-soft italic sm:pl-8">
        <p>„{data.quote}“</p>
      </blockquote>
    )}
  </div>
</Section>
