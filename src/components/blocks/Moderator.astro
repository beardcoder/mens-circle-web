---
import type { ImageMetadata } from 'astro';

import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import TextLink from '../ui/TextLink.astro';

interface Props {
  anchor: string;
  eyebrow: string;
  name: string;
  quote: string;
  /** The portrait, pre-sized at 4 : 5 and ascending by width: the home page is SSR, so
   *  nothing may go through the on-demand image endpoint. */
  images: ImageMetadata[];
  imageAlt: string;
  linkLabel: string;
  linkUrl: string;
}

const { anchor, eyebrow, name, quote, images, imageAlt, linkLabel, linkUrl } = Astro.props;
const largest = images.at(-1)!;
---

<Section id={anchor} labelledby="person-title" innerClass="grid gap-x-grid gap-y-8 lg:grid-cols-12">
  <SectionHead
    eyebrow={eyebrow}
    title={name}
    titleId="person-title"
    class="lg:col-span-7 lg:col-start-6 lg:row-start-1"
  />

  <figure class="home-portrait aspect-4/3 overflow-clip lg:col-span-5 lg:col-start-1 lg:row-span-2 lg:row-start-1 lg:aspect-4/5 lg:self-start">
    <img
      src={largest.src}
      srcset={images.map((image) => `${image.src} ${image.width}w`).join(', ')}
      sizes="(min-width: 80rem) 480px, (min-width: 64rem) 42vw, (min-width: 48rem) calc(100vw - 4rem), calc(100vw - 2.5rem)"
      width={largest.width}
      height={largest.height}
      alt={imageAlt}
      loading="lazy"
      decoding="async"
      class="block size-full object-cover"
    />
  </figure>

  <div class="grid content-start justify-items-start gap-6 lg:col-span-7 lg:col-start-6 lg:row-start-2">
    {quote && (
      <blockquote class="max-w-measure border-l-2 border-line-strong pl-5 font-serif text-quote text-fg">
        <p>„{quote}“</p>
      </blockquote>
    )}
    <Prose>
      <slot />
    </Prose>
    {linkLabel && linkUrl && (
      <TextLink href={linkUrl} data-astro-prefetch="hover">
        {linkLabel}
      </TextLink>
    )}
  </div>
</Section>
