---
import type { ImageMetadata } from 'astro';

import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import TextLink from '../ui/TextLink.astro';

interface Props {
  anchor: string;
  eyebrow?: string;
  name: string;
  quote: string;
  /** A small square of his face, signing the quote. Pre-sized: the home page is SSR. */
  avatar: ImageMetadata;
  imageAlt: string;
  signature: string;
  signatureNote: string;
  linkLabel: string;
  linkUrl: string;
}

const { anchor, eyebrow, name, quote, avatar, imageAlt, signature, signatureNote, linkLabel, linkUrl } = Astro.props;
---

{/* Markus introduces himself; beside him one sentence of his under a rule, signed with his face. */}
<Section id={anchor} labelledby="person-title" innerClass="grid items-center gap-x-grid gap-y-16 lg:grid-cols-12">
  <div class="grid min-w-0 content-start justify-items-start gap-6 lg:col-span-6">
    <SectionHead eyebrow={eyebrow} title={name} titleId="person-title" />
    <Prose>
      <slot />
    </Prose>
    {linkLabel && linkUrl && <TextLink href={linkUrl}>{linkLabel}</TextLink>}
  </div>

  {quote && (
    <figure class="grid min-w-0 content-center border-t border-line-strong pt-8 lg:col-span-5 lg:col-start-8">
      <blockquote class="max-w-[16em] font-display text-quote text-fg">
        <p>„{quote}“</p>
      </blockquote>
      <figcaption class="mt-8 flex items-center gap-4">
        <img
          src={avatar.src}
          width={avatar.width}
          height={avatar.height}
          alt={imageAlt}
          loading="lazy"
          decoding="async"
          class="size-16 shrink-0 rounded-full object-cover ring-4 ring-surface"
        />
        <span class="grid">
          <span class="font-semibold text-fg">{signature}</span>
          <span class="text-sm text-fg-muted">{signatureNote}</span>
        </span>
      </figcaption>
    </figure>
  )}
</Section>
