---
import type { ImageMetadata } from 'astro';

import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import TextLink from '../ui/TextLink.astro';

interface Props {
  anchor: string;
  eyebrow: string;
  name: string;
  quote: string;
  /** A small square of his face, signing the quote. Pre-sized: the home page is SSR. */
  avatar: ImageMetadata;
  imageAlt: string;
  signature: string;
  signatureNote: string;
  linkLabel: string;
  linkUrl: string;
}

const { anchor, eyebrow, name, quote, avatar, imageAlt, signature, signatureNote, linkLabel, linkUrl } = Astro.props;
---

<Section id={anchor} labelledby="person-title" innerClass="grid items-start gap-x-grid gap-y-10 lg:grid-cols-12">
  {/* A quote behind an ember rule, as every quote on the site; on phones after the introduction. */}
  {quote && (
    <figure class="grid content-start border-l-4 border-fill pl-6 max-lg:order-last sm:pl-8 lg:col-span-5 lg:mt-2">
      <blockquote class="font-display text-quote text-fg">
        <p>{quote}</p>
      </blockquote>
      <figcaption class="mt-8 flex items-center gap-4">
        <img
          src={avatar.src}
          width={avatar.width}
          height={avatar.height}
          alt={imageAlt}
          loading="lazy"
          decoding="async"
          class="size-14 shrink-0 rounded-full object-cover"
        />
        <span class="grid">
          <span class="font-semibold text-fg">{signature}</span>
          <span class="text-sm text-fg-muted">{signatureNote}</span>
        </span>
      </figcaption>
    </figure>
  )}

  <div class="grid content-start justify-items-start gap-6 lg:col-span-6 lg:col-start-7">
    <SectionHead eyebrow={eyebrow} title={name} titleId="person-title" />
    <Prose>
      <slot />
    </Prose>
    {linkLabel && linkUrl && <TextLink href={linkUrl}>{linkLabel}</TextLink>}
  </div>
</Section>
