---
import CropPicture from '../CropPicture.astro';
import { resolveAssetImage } from '../../lib/images';
import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import TextLink from '../ui/TextLink.astro';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    name?: string;
    quote?: string;
    bio?: string;
    image?: string;
    imageAlt?: string;
    linkLabel?: string;
    linkUrl?: string;
  };
}

/** Markus, in his own words: a closer crop than the hero beside his sentence and his role in the circle. */

const { data } = Astro.props;
const anchor = data.anchor ?? 'moderator';
const photo = resolveAssetImage(data.image);
---

<Section
  id={anchor}
  labelledby="person-title"
  defer
  innerClass="grid items-start gap-y-10 lg:grid-cols-12 lg:gap-x-grid"
>
  {photo && (
    <figure class="reveal max-w-md lg:sticky lg:top-[calc(var(--spacing-clearance)+1rem)] lg:col-span-5 lg:max-w-none">
      <div class="aspect-4/5 overflow-clip rounded-card bg-ground-alt [&_picture]:block [&_picture]:h-full">
        <CropPicture
          src={photo}
          class="block size-full origin-[22%_34%] scale-[1.45] object-cover object-[12%_50%]"
          breakpoint="60em"
          narrow={{ ratio: 4 / 5, widths: [320, 480, 640], sizes: 'min(28rem, 90vw)' }}
          wide={{ ratio: 4 / 5, widths: [400, 600, 800], sizes: 'min(30rem, 38vw)' }}
          loading="lazy"
          alt={data.imageAlt ?? ''}
        />
      </div>
    </figure>
  )}

  <div class="grid content-start gap-8 lg:col-span-6 lg:col-start-7">
    <SectionHead eyebrow={data.eyebrow} title={data.name} titleId="person-title" size="display-2" />

    {data.quote && (
      <blockquote class="reveal border-l-4 border-accent py-1 pl-6 font-serif text-2xl leading-snug text-fg italic">
        <p>{data.quote}</p>
      </blockquote>
    )}

    {data.bio && <Prose html={data.bio} size="lg" class="reveal" />}

    {data.linkLabel && data.linkUrl && (
      <p>
        <TextLink href={data.linkUrl} data-astro-prefetch="hover">
          {data.linkLabel}
        </TextLink>
      </p>
    )}
  </div>
</Section>
