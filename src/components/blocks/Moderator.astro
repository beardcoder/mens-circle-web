---
import type { ImageMetadata } from 'astro';

import CropPicture from '../CropPicture.astro';
import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import TextLink from '../ui/TextLink.astro';

interface Props {
  anchor: string;
  eyebrow: string;
  name: string;
  quote: string;
  bio: string;
  image: ImageMetadata;
  imageAlt: string;
  linkLabel: string;
  linkUrl: string;
}

/**
 * Markus: his photograph and his words at about 5 : 7 on the shared grid. On
 * phones the title comes first, then a photo of moderate height, then the text,
 * so the photo never pushes the orientation down by screens. His sentence stays
 * below the size of the section's title.
 */

const { anchor, eyebrow, name, quote, bio, image, imageAlt, linkLabel, linkUrl } = Astro.props;

// The photo's column: the container (gutters 20 / 32 / 48px) below `lg`; from it,
// 5 of 12 columns, i.e. 5/12 of the content less 7/12 of a grid gap.
const NARROW_SIZES = '(min-width: 48rem) calc(100vw - 4rem), calc(100vw - 2.5rem)';
const WIDE_SIZES = '(min-width: 80rem) 29.5rem, calc(41.67vw - 2.83rem)';
---

<Section id={anchor} labelledby="person-title" innerClass="grid gap-x-grid gap-y-8 lg:grid-cols-12">
  <SectionHead
    eyebrow={eyebrow}
    title={name}
    titleId="person-title"
    class="lg:col-span-7 lg:col-start-6 lg:row-start-1"
  />

  <figure class="aspect-4/3 overflow-clip lg:col-span-5 lg:col-start-1 lg:row-span-2 lg:row-start-1 lg:aspect-4/5 lg:self-start [&_picture]:block [&_picture]:h-full">
    <CropPicture
      src={image}
      class="block size-full object-cover"
      breakpoint="64em"
      narrow={{ ratio: 4 / 3, widths: [400, 640, 800, 1024], sizes: NARROW_SIZES, position: 'center' }}
      wide={{ ratio: 4 / 5, widths: [400, 600, 800], sizes: WIDE_SIZES, position: 'left' }}
      loading="lazy"
      alt={imageAlt}
    />
  </figure>

  <div class="grid content-start justify-items-start gap-6 lg:col-span-7 lg:col-start-6 lg:row-start-2">
    {quote && (
      <blockquote class="max-w-measure border-l-2 border-line-strong pl-5 font-serif text-quote text-fg">
        <p>„{quote}“</p>
      </blockquote>
    )}
    {bio && <Prose html={bio} />}
    {linkLabel && linkUrl && (
      <TextLink href={linkUrl} data-astro-prefetch="hover">
        {linkLabel}
      </TextLink>
    )}
  </div>
</Section>
