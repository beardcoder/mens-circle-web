---
import NewsletterForm from '../islands/NewsletterForm.svelte';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    text?: string;
  };
  /** Analytics context forwarded to the form island. */
  context?: Record<string, string | number | boolean>;
}

/**
 * A standalone notification sign-up, for pages that need one outside the
 * Termine block (the home page and /event both carry their own).
 *
 * The copy must not promise more than the list actually sends: it carries the
 * announcement of the next date and nothing else.
 */

const { data, context = { location: 'newsletter-block' } } = Astro.props;
const anchor = data.anchor ?? 'newsletter';
---

<section class="section section--ruled newsletter-section" id={anchor} aria-labelledby="newsletter-title">
  <div class="container">
    <div class="spine">
      {data.eyebrow && <p class="rail-heading">{data.eyebrow}</p>}

      <div class="spine__body">
        {data.title && <h2 class="newsletter__title" id="newsletter-title" data-reveal="up" set:html={data.title} />}

        {
          data.text && (
            <p class="newsletter__text" data-reveal="up">
              {data.text}
            </p>
          )
        }

        <NewsletterForm client:visible context={context} />
      </div>
    </div>
  </div>
</section>

<style is:global>
  @layer sections {
    .newsletter__title {
      margin-block-end: var(--space-xs);
      font-size: var(--text-3xl);
      line-height: 1.15;
      text-wrap: balance;
    }

    .newsletter__text {
      max-inline-size: var(--measure);
      margin-block-end: var(--space-sm);
      font-size: var(--text-section-body);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
    }
  }
</style>
