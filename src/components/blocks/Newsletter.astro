---
import { link } from '@lib/ui';

import NewsletterForm from '../forms/NewsletterForm.astro';
import Section from '../ui/Section.astro';

interface Props {
  title: string;
  text: string;
  whatsappTitle: string;
  whatsappText: string;
  whatsappLink: string;
  whatsappLabel: string;
}

const { title, text, whatsappTitle, whatsappText, whatsappLink, whatsappLabel } = Astro.props;
---

<Section id="newsletter" labelledby="newsletter-title" space="band">
  <div class="grid gap-x-grid gap-y-10 rounded-2xl border border-line bg-raised p-7 shadow-card sm:p-10 lg:grid-cols-12 lg:p-12">
    <div class="lg:col-span-7">
      <h2 id="newsletter-title" class="text-section text-fg">
        {title}
      </h2>
      <p class="mt-4 max-w-measure text-md text-fg-soft">{text}</p>
      <NewsletterForm context={{ location: 'home-dates' }} variant="primary" class="mt-7" />
    </div>
    {whatsappLink && (
      <div class="grid content-start gap-2 rounded-xl bg-tint p-6 sm:p-7 lg:col-span-4 lg:col-start-9 lg:self-center">
        <h2 class="font-sans text-base font-semibold text-fg">{whatsappTitle}</h2>
        <p class="text-md text-fg-soft">
          {whatsappText}{' '}
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[link, 'font-semibold']}
            data-umami-event="whatsapp-click"
            data-umami-event-type="community-join"
          >
            {whatsappLabel}
            <span class="sr-only"> (öffnet WhatsApp in einem neuen Tab)</span>
          </a>
        </p>
      </div>
    )}
  </div>
</Section>
