---
import { link } from '@lib/ui';

import Stamp from '../brand/Stamp.astro';
import NewsletterForm from '../forms/NewsletterForm.astro';
import Section from '../ui/Section.astro';

interface Props {
  title: string;
  text: string;
  whatsappTitle: string;
  whatsappText: string;
  whatsappLink: string;
  whatsappLabel: string;
}

const { title, text, whatsappTitle, whatsappText, whatsappLink, whatsappLabel } = Astro.props;
---

{/* The last band, on the forest, running into the footer: the dates by mail and, parted
    by a line, the WhatsApp group; the stamp large and cut by the window's right edge. */}
<Section id="newsletter" ground="dark" labelledby="newsletter-title">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-1/2 right-[-12rem] hidden w-[34rem] -translate-y-1/2 text-line-strong lg:block xl:right-[-8rem]"
  >
    <Stamp turn />
  </div>
  <div class="relative grid gap-x-grid gap-y-10 lg:grid-cols-12">
    <div data-reveal-group class="lg:col-span-7">
      <h2 id="newsletter-title" class="text-section text-fg">
        {title}
      </h2>
      <p class="mt-5 max-w-measure text-md text-fg-soft">{text}</p>
      <NewsletterForm context={{ location: 'home-dates' }} variant="primary" class="mt-10" />
    </div>
    {whatsappLink && (
      <div data-reveal class="grid content-start gap-3 border-t border-line pt-10 lg:col-span-7 lg:max-w-measure">
        <h2 class="font-sans text-base font-semibold text-fg">{whatsappTitle}</h2>
        <p class="text-md text-fg-soft">
          {whatsappText}{' '}
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[link, 'font-semibold']}
            data-umami-event="whatsapp-click"
            data-umami-event-type="community-join"
          >
            {whatsappLabel}
            <span class="sr-only"> (öffnet WhatsApp in einem neuen Tab)</span>
          </a>
        </p>
      </div>
    )}
  </div>
</Section>
