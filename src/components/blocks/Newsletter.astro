---
import { link } from '@lib/ui';

import NewsletterForm from '../forms/NewsletterForm.astro';
import Section from '../ui/Section.astro';

interface Props {
  title: string;
  text: string;
  whatsappTitle: string;
  whatsappText: string;
  whatsappLink: string;
  whatsappLabel: string;
}

const { title, text, whatsappTitle, whatsappText, whatsappLink, whatsappLabel } = Astro.props;
---

<Section
  id="newsletter"
  labelledby="newsletter-title"
  space="band"
  innerClass="grid gap-x-grid gap-y-10 py-4 lg:grid-cols-12"
>
  <div class="lg:col-span-7">
    <h2 id="newsletter-title" class="text-sub text-fg">
      {title}
    </h2>
    <p class="mt-3 max-w-measure text-md text-fg-soft">{text}</p>
    <NewsletterForm context={{ location: 'home-dates' }} class="mt-6" />
  </div>
  {whatsappLink && (
    <div class="border-line max-lg:border-t max-lg:pt-8 lg:col-span-4 lg:col-start-9 lg:border-l lg:pl-8">
      <h2 class="font-sans text-base font-semibold text-fg">{whatsappTitle}</h2>
      <p class="mt-2 text-md text-fg-soft">
        {whatsappText}{' '}
        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[link, 'font-semibold']}
          data-umami-event="whatsapp-click"
          data-umami-event-type="community-join"
        >
          {whatsappLabel}
          <span class="sr-only"> (öffnet WhatsApp in einem neuen Tab)</span>
        </a>
      </p>
    </div>
  )}
</Section>
