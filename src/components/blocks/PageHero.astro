---
import { Picture } from 'astro:assets';
import { resolveAssetImage } from '../../lib/images';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    lead?: string;
    align?: 'left' | 'center';
    buttonText?: string;
    buttonLink?: string;
    image?: string;
    imageAlt?: string;
    imageCaption?: string;
  };
}

/**
 * The opening block of a sub-page (the Haltung page, the legal pages).
 *
 * Same shape as the home page's opening — text beside an optional photograph, on
 * the page's own ground. It used to be a dark panel with a radial gradient, two
 * ring ornaments, a drop-shadowed offset-framed image and a floating animation.
 *
 * `align: 'center'` is kept for the legal pages, which have a title and nothing
 * else and would look stranded in a wide left-aligned column.
 */

const { data } = Astro.props;
const align = data.align === 'center' ? 'center' : 'left';
const hasImage = Boolean(data.image);
const hasButton = Boolean(data.buttonText && data.buttonLink);
const buttonExternal = data.buttonLink?.startsWith('http') ?? false;
const imageAsset = resolveAssetImage(data.image);
---

<section class={`page-hero page-hero--${align}${hasImage ? ' page-hero--with-image' : ''}`} id={data.anchor}>
  <div class="container">
    <div class="page-hero__layout">
      <div class="page-hero__content">
        {data.eyebrow && <p class="marker marker--ruled page-hero__eyebrow">{data.eyebrow}</p>}
        {data.title && <h1 class="page-hero__title" set:html={data.title} />}
        {data.lead && <p class="page-hero__lead">{data.lead}</p>}

        {
          hasButton && (
            <p class="page-hero__cta">
              <a
                href={data.buttonLink}
                class="btn btn--primary btn--large"
                target={buttonExternal ? '_blank' : undefined}
                rel={buttonExternal ? 'noopener noreferrer' : undefined}
              >
                {data.buttonText}
              </a>
            </p>
          )
        }
      </div>

      {
        hasImage && (
          <figure class="page-hero__media">
            {imageAsset ? (
              <Picture
                src={imageAsset}
                class="page-hero__image"
                widths={[400, 600, 900]}
                sizes="(max-width: 860px) 92vw, 380px"
                formats={['avif', 'webp']}
                loading="eager"
                fetchpriority="high"
                alt={data.imageAlt ?? ''}
              />
            ) : (
              <img
                src={data.image}
                class="page-hero__image"
                loading="eager"
                fetchpriority="high"
                alt={data.imageAlt ?? ''}
              />
            )}
            {data.imageCaption && <figcaption class="caption">{data.imageCaption}</figcaption>}
          </figure>
        )
      }
    </div>
  </div>
</section>

<style is:global>
  @layer sections {
    .page-hero {
      padding-block: calc(var(--header-clearance) + var(--space-md)) var(--space-lg);
      border-block-end: 2px solid var(--rule-strong);
    }

    .page-hero__layout {
      display: grid;
      gap: var(--space-lg);
      align-items: start;
    }

    /* Capped in both units — see the note in blocks/Hero.astro. */
    .page-hero--with-image .page-hero__layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, min(22rem, 32%));
    }

    .page-hero--center .page-hero__layout {
      grid-template-columns: 1fr;
      max-inline-size: var(--measure-wide);
    }

    .page-hero__content {
      max-inline-size: 36rem;
    }

    .page-hero__eyebrow {
      margin-block-end: var(--space-sm);
      color: var(--text-primary);
    }

    .page-hero__title {
      margin-block-end: var(--space-sm);
      font-size: var(--display-3);
      line-height: 0.95;
      text-transform: uppercase;
      letter-spacing: -0.01em;
      text-wrap: balance;
    }

    .page-hero__lead {
      max-inline-size: var(--measure);
      margin: 0;
      font-size: var(--text-section-body-lg);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
    }

    .page-hero__cta {
      margin-block-start: var(--space-md);
      margin-block-end: 0;
    }

    .page-hero__media {
      margin: 0;
    }

    .page-hero__image {
      display: block;
      inline-size: 100%;
      aspect-ratio: 4 / 5;
      object-fit: cover;
      /* A centred crop on this portrait takes the torso; bias it upward. */
      object-position: center 28%;
      border-radius: 0;
    }

    @media (width <= 54em) {
      .page-hero--with-image .page-hero__layout {
        grid-template-columns: 1fr;
        gap: var(--space-md);
      }

      .page-hero__content {
        max-inline-size: none;
      }

      .page-hero__image {
        aspect-ratio: 3 / 2;
        object-position: center 25%;
      }
    }

    @media (width <= 480px) {
      .page-hero__cta .btn {
        inline-size: 100%;
      }
    }
  }
</style>
