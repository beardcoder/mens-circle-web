---
import CropPicture from '../CropPicture.astro';
import { resolveAssetImage } from '../../lib/images';
import PageIntro from '../PageIntro.astro';
import Button from '../ui/Button.astro';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    lead?: string;
    /** Kept for the content files; every opening stands on the reading line. */
    align?: 'left' | 'center';
    buttonText?: string;
    buttonLink?: string;
    image?: string;
    imageAlt?: string;
    imageCaption?: string;
  };
}

/** The opening of a content sub-page: the compact PageIntro, with the photograph beside it where there is one (12px corners, no frame). */

const { data } = Astro.props;
const hasButton = Boolean(data.buttonText && data.buttonLink);
const buttonExternal = data.buttonLink?.startsWith('http') ?? false;
const imageAsset = resolveAssetImage(data.image);
---

<PageIntro id={data.anchor} eyebrow={data.eyebrow} title={data.title ?? ''} titleHtml>
  {data.lead && <Fragment slot="lead">{data.lead}</Fragment>}
  {hasButton && (
    <Button
      href={data.buttonLink}
      size="lg"
      target={buttonExternal ? '_blank' : undefined}
      rel={buttonExternal ? 'noopener noreferrer' : undefined}
    >
      {data.buttonText}
    </Button>
  )}
  {imageAsset && (
    <figure slot="media">
      <CropPicture
        src={imageAsset}
        class="block aspect-4/3 w-full rounded-card object-cover object-[22%_40%] lg:aspect-4/5"
        breakpoint="64em"
        narrow={{ ratio: 4 / 3, widths: [420, 700, 960], sizes: 'calc(100vw - 2.5rem)' }}
        wide={{ ratio: 4 / 5, widths: [400, 560, 800], sizes: 'min(30rem, 38vw)' }}
        loading="eager"
        fetchpriority="high"
        alt={data.imageAlt ?? ''}
      />
      {data.imageCaption && <figcaption class="mt-3 text-sm text-fg-muted">{data.imageCaption}</figcaption>}
    </figure>
  )}
</PageIntro>
