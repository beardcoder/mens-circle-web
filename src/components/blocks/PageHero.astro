---
import CropPicture from '../CropPicture.astro';
import { resolveAssetImage } from '../../lib/images';
import PageOpening from '../PageOpening.astro';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    lead?: string;
    /** Kept for the content files; every opening stands on the split line now. */
    align?: 'left' | 'center';
    buttonText?: string;
    buttonLink?: string;
    image?: string;
    imageAlt?: string;
    imageCaption?: string;
  };
}

/** The opening of a content sub-page: title and lead, then — when there is one — the photograph as a wide band. */

const { data } = Astro.props;
const hasButton = Boolean(data.buttonText && data.buttonLink);
const buttonExternal = data.buttonLink?.startsWith('http') ?? false;
const imageAsset = resolveAssetImage(data.image);
---

<div id={data.anchor}>
  <PageOpening eyebrow={data.eyebrow} title={data.title ?? ''} titleHtml joined={Boolean(imageAsset)}>
    {data.lead && <Fragment slot="lead">{data.lead}</Fragment>}
    {hasButton && (
      <Button
        href={data.buttonLink}
        size="lg"
        target={buttonExternal ? '_blank' : undefined}
        rel={buttonExternal ? 'noopener noreferrer' : undefined}
      >
        {data.buttonText}
      </Button>
    )}
  </PageOpening>

  {imageAsset && (
    /* The landscape gets the width it was taken for. */
    <Container class="pb-group">
      <figure class="entrance:animate-fade-in entrance:animate-delay-160">
        <CropPicture
          src={imageAsset}
          class="block aspect-4/3 w-full rounded-card object-cover object-[22%_40%] lg:aspect-21/9 lg:object-[50%_4%]"
          breakpoint="60em"
          narrow={{ ratio: 4 / 3, widths: [420, 700, 960], sizes: 'calc(100vw - 2.5rem)' }}
          wide={{ ratio: 21 / 9, widths: [960, 1280], sizes: 'min(100vw, 78rem)' }}
          loading="eager"
          fetchpriority="high"
          alt={data.imageAlt ?? ''}
        />
        {data.imageCaption && <figcaption class="mt-3 text-sm text-fg-muted">{data.imageCaption}</figcaption>}
      </figure>
    </Container>
  )}
</div>
