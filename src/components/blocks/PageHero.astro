---
import CropPicture from '../CropPicture.astro';
import { resolveAssetImage } from '../../lib/images';
import PageOpening from '../PageOpening.astro';
import Button from '../ui/Button.astro';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    lead?: string;
    /** Kept for the content files; every opening stands on the reading line now. */
    align?: 'left' | 'center';
    buttonText?: string;
    buttonLink?: string;
    image?: string;
    imageAlt?: string;
    imageCaption?: string;
  };
}

/** The opening of a content sub-page on the dark frame: title and lead, and — when there is one — the photograph beside them. */

const { data } = Astro.props;
const hasButton = Boolean(data.buttonText && data.buttonLink);
const buttonExternal = data.buttonLink?.startsWith('http') ?? false;
const imageAsset = resolveAssetImage(data.image);
---

<PageOpening id={data.anchor} eyebrow={data.eyebrow} title={data.title ?? ''} titleHtml>
  {data.lead && <Fragment slot="lead">{data.lead}</Fragment>}
  {hasButton && (
    <Button
      href={data.buttonLink}
      size="lg"
      target={buttonExternal ? '_blank' : undefined}
      rel={buttonExternal ? 'noopener noreferrer' : undefined}
    >
      {data.buttonText}
    </Button>
  )}
  {imageAsset && (
    <figure slot="media" class="relative">
      {/* A hairline frame set off the photo. */}
      <span aria-hidden="true" class="absolute -inset-3 rounded-card border border-sand/20 max-lg:hidden"></span>
      <CropPicture
        src={imageAsset}
        class="relative block aspect-4/3 w-full rounded-card object-cover object-[22%_40%] shadow-lift lg:aspect-4/5"
        breakpoint="56.25em"
        narrow={{ ratio: 4 / 3, widths: [420, 700, 960], sizes: 'calc(100vw - 2.5rem)' }}
        wide={{ ratio: 4 / 5, widths: [480, 720, 960], sizes: 'min(36vw, 32rem)' }}
        loading="eager"
        fetchpriority="high"
        alt={data.imageAlt ?? ''}
      />
      {data.imageCaption && <figcaption class="mt-4 text-sm text-sand">{data.imageCaption}</figcaption>}
    </figure>
  )}
</PageOpening>
