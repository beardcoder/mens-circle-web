---
import CropPicture from '../CropPicture.astro';
import SeatRing from '../SeatRing.astro';
import { resolveAssetImage } from '../../lib/images';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    lead?: string;
    align?: 'left' | 'center';
    buttonText?: string;
    buttonLink?: string;
    image?: string;
    imageAlt?: string;
    imageCaption?: string;
  };
}

/** The opening of a sub-page: a large title and the serif lead, with the photograph
 *  and a small circle of seats beside it when there is one. */

const { data } = Astro.props;
const compact = data.align === 'center';
const imageAsset = resolveAssetImage(data.image);
const hasButton = Boolean(data.buttonText && data.buttonLink);
---

<section
  class:list={['page-hero', compact && 'page-hero--compact', imageAsset && 'page-hero--with-image']}
  id={data.anchor}
>
  <div class="container page-hero__layout">
    <div class="page-hero__content">
      {data.eyebrow && <p class="kicker">{data.eyebrow}</p>}
      {data.title && <h1 class="page-hero__title display" set:html={data.title} />}
      {data.lead && <p class="page-hero__lead">{data.lead}</p>}

      {hasButton && (
        <p class="page-hero__cta">
          <a href={data.buttonLink} class="btn btn--primary btn--large">
            {data.buttonText}
          </a>
        </p>
      )}
    </div>

    {imageAsset && (
      <figure class="page-hero__media">
        <div class="page-hero__frame">
          <CropPicture
            src={imageAsset}
            class="page-hero__image"
            breakpoint="56em"
            narrow={{ ratio: 4 / 3, widths: [420, 700, 900], sizes: '100vw' }}
            wide={{ ratio: 4 / 5, widths: [400, 560, 800], sizes: 'min(30vw, 26rem)' }}
            loading="eager"
            fetchpriority="high"
            alt={data.imageAlt ?? ''}
          />
        </div>
        <SeatRing class="page-hero__seats" seats={12} open={[7]} seatSize={5.5} enter />
        {data.imageCaption && <figcaption class="caption">{data.imageCaption}</figcaption>}
      </figure>
    )}
  </div>
</section>
