---
import CropPicture from '../CropPicture.astro';
import { resolveAssetImage } from '../../lib/images';
import PageOpening from '../PageOpening.astro';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    lead?: string;
    /** Kept for the content files; every opening stands on the split line now. */
    align?: 'left' | 'center';
    buttonText?: string;
    buttonLink?: string;
    image?: string;
    imageAlt?: string;
    imageCaption?: string;
  };
}

/** The opening of a content sub-page: title and lead, then — when there is one — the photograph as a wide band. */

const { data } = Astro.props;
const hasButton = Boolean(data.buttonText && data.buttonLink);
const buttonExternal = data.buttonLink?.startsWith('http') ?? false;
const imageAsset = resolveAssetImage(data.image);
---

<div id={data.anchor}>
  <PageOpening
    eyebrow={data.eyebrow}
    title={data.title ?? ''}
    titleHtml
    joined={Boolean(imageAsset)}
    aside={Boolean(data.lead || hasButton)}
  >
    {data.lead && <Fragment slot="lead">{data.lead}</Fragment>}
    {hasButton && (
      <Button
        href={data.buttonLink}
        size="lg"
        target={buttonExternal ? '_blank' : undefined}
        rel={buttonExternal ? 'noopener noreferrer' : undefined}
        class="max-lg:w-full"
      >
        {data.buttonText}
      </Button>
    )}
  </PageOpening>

  {imageAsset && (
    <figure class="pb-group">
      {/* The landscape gets the width it was taken for; phones run it edge to edge. */}
      <div class="mx-auto max-w-page lg:px-gutter entrance:animate-fade-in entrance:animate-delay-160">
        <CropPicture
          src={imageAsset}
          class="block aspect-4/3 w-full object-cover object-[22%_40%] lg:aspect-21/9 lg:rounded-control lg:object-[50%_4%]"
          breakpoint="56em"
          narrow={{ ratio: 4 / 3, widths: [420, 700, 960], sizes: '100vw' }}
          wide={{ ratio: 21 / 9, widths: [960], sizes: 'min(100vw, 1360px)' }}
          loading="eager"
          fetchpriority="high"
          alt={data.imageAlt ?? ''}
        />
      </div>
      {data.imageCaption && (
        <Container>
          <figcaption class="mt-2 text-sm text-fg-muted">{data.imageCaption}</figcaption>
        </Container>
      )}
    </figure>
  )}
</div>
