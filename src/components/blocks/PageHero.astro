---
import type { ImageMetadata } from 'astro';

import CropPicture from '../CropPicture.astro';
import PageIntro from '../PageIntro.astro';
import Button from '../ui/Button.astro';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    lead?: string;
    /** Kept for the content files; every opening stands on the reading line. */
    align?: 'left' | 'center';
    buttonText?: string;
    buttonLink?: string;
    image?: ImageMetadata;
    imageAlt?: string;
    imageCaption?: string;
  };
}

/** The opening of a content sub-page: the compact PageIntro, with the photograph beside it where there is one (square, no frame). */

const { data } = Astro.props;
const hasButton = Boolean(data.buttonText && data.buttonLink);
const buttonExternal = data.buttonLink?.startsWith('http') ?? false;
const imageAsset = data.image;

// The photo's column: the container (gutters 20 / 32 / 48px) below `lg`; from it,
// 4 of 12 columns, i.e. a third of the content less two thirds of a grid gap.
const NARROW_SIZES = '(min-width: 48rem) calc(100vw - 4rem), calc(100vw - 2.5rem)';
const WIDE_SIZES = '(min-width: 80rem) 23rem, calc(33.33vw - 2.67rem)';
---

<PageIntro id={data.anchor} eyebrow={data.eyebrow} title={data.title ?? ''} titleHtml>
  {data.lead && <Fragment slot="lead">{data.lead}</Fragment>}
  {hasButton && (
    <Button
      href={data.buttonLink}
      size="lg"
      target={buttonExternal ? '_blank' : undefined}
      rel={buttonExternal ? 'noopener noreferrer' : undefined}
    >
      {data.buttonText}
    </Button>
  )}
  {imageAsset && (
    <figure slot="media">
      <CropPicture
        src={imageAsset}
        class="block aspect-4/3 w-full object-cover lg:aspect-4/5"
        breakpoint="64em"
        narrow={{ ratio: 4 / 3, widths: [400, 640, 800, 1024], sizes: NARROW_SIZES, position: 'center' }}
        wide={{ ratio: 4 / 5, widths: [300, 400, 600, 800], sizes: WIDE_SIZES, position: 'left' }}
        loading="eager"
        fetchpriority="high"
        alt={data.imageAlt ?? ''}
      />
      {data.imageCaption && <figcaption class="mt-3 text-sm text-fg-muted">{data.imageCaption}</figcaption>}
    </figure>
  )}
</PageIntro>
