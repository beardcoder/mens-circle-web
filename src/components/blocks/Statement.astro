---
import Breath from '../Breath.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Section from '../ui/Section.astro';
import TextLink from '../ui/TextLink.astro';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    /** Lines in the poster register. Each becomes its own block and settles independently. */
    lines?: string[];
    text?: string;
    linkLabel?: string;
    linkUrl?: string;
    /** A short line beside the small breathing circle. */
    breathGuide?: string;
  };
}

/**
 * The one flame field on the page, set like the flyer: night capitals on flame.
 * Wide: the slogan over columns 1–5, the label and the reading from column 7,
 * the reading level with the slogan's last line. Narrow: the same poster, stacked.
 */

const { data } = Astro.props;
const anchor = data.anchor ?? 'haltung';
const lines = data.lines ?? [];
---

<Section
  id={anchor}
  ground="flame"
  space="none"
  labelledby="statement-title"
  class="overflow-clip py-section"
  innerClass="relative @container grid grid-cols-1 gap-y-group lg:grid-cols-12 lg:grid-rows-[auto_1fr] lg:gap-x-grid lg:gap-y-8"
>
  {/* A light breath across the field: lightening the orange behind night text only raises the contrast. */}
  <Breath slot="before" variant="glow" light class="top-1/2 left-[30%] w-[max(70vw,40rem)] -translate-1/2" />

  {data.eyebrow && (
    <Eyebrow plain tone="fg" class="lg:col-span-6 lg:col-start-7 lg:row-start-1 lg:self-start">
      {data.eyebrow}
    </Eyebrow>
  )}

  {/* Capitals with room for umlaut dots. "Aus dem", the widest line, is 4.45em. */}
  <h2
    id="statement-title"
    class="text-[length:min(21cqi,7.5rem)] leading-[1.04] tracking-[-0.02em] text-fg uppercase lg:col-span-5 lg:col-start-1 lg:row-span-2 lg:row-start-1 lg:self-start lg:text-[length:min(8.8cqi,9rem)]"
  >
    {lines.map((line, i) => (
      <span
        class:list={[
          'block',
          'max-lg:scroll-motion:animate-[rise_linear_both] lg:scroll-motion:animate-[settle_linear_both] scroll-motion:[animation-range:entry_10%_cover_40%] scroll-motion:[animation-timeline:view()]',
          i === 1 && '[--settle-from:12%]',
        ]}
      >
        {line}
      </span>
    ))}
  </h2>

  {(data.text || data.linkLabel) && (
    <div class="grid justify-items-start gap-4 border-t-2 border-fg pt-6 lg:col-span-6 lg:col-start-7 lg:row-start-2 lg:self-end">
      {data.text && <p class="max-w-[42ch] text-lg font-medium text-fg lg:max-w-[34em]">{data.text}</p>}
      {data.breathGuide && (
        /* The breath to follow: a small circle on the same 10-second cycle. Still,
             the circle cannot guide a breath, so the line goes with it. */
        <p class="flex items-center gap-4 font-serif text-lg leading-[1.3] text-fg italic motion-reduce:hidden">
          <span
            class="size-11 shrink-0 animate-breathe rounded-full border-2 border-fg [--alpha:1] [--rest:0.45]"
            aria-hidden="true"
            data-breath
          />
          {data.breathGuide}
        </p>
      )}
      {data.linkLabel && data.linkUrl && (
        <TextLink href={data.linkUrl} strong>
          {data.linkLabel}
        </TextLink>
      )}
    </div>
  )}
</Section>
