---
import BreathField from '../BreathField.astro';
import Contours from '../Contours.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Section from '../ui/Section.astro';
import TextLink from '../ui/TextLink.astro';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    /** The statement, one line each. */
    lines?: string[];
    text?: string;
    linkLabel?: string;
    linkUrl?: string;
    /** A short line beside the small breathing circle. */
    breathGuide?: string;
  };
}

/** The dark band: the statement on the middle axis over the hill country's contours, a breath to follow, a warm glow behind. */

const { data } = Astro.props;
const anchor = data.anchor ?? 'haltung';
const lines = data.lines ?? [];
---

<Section
  id={anchor}
  ground="night"
  labelledby="statement-title"
  class="overflow-clip"
  innerClass="relative grid justify-items-center gap-6 text-center"
>
  <Contours slot="before" />
  {/* The breathing light, faint enough that every contrast holds. */}
  <BreathField slot="before" strength="strong" class="top-1/2 left-1/2 w-[min(120vw,60rem)] -translate-1/2" />

  {data.eyebrow && <Eyebrow>{data.eyebrow}</Eyebrow>}

  <h2 id="statement-title" class="text-display-1 text-fg">
    {lines.map((line, i) => (
      <span class:list={['block', i > 0 && 'text-accent']}>{line}</span>
    ))}
  </h2>

  {data.text && <p class="max-w-[40rem] text-lg text-fg-soft">{data.text}</p>}

  {data.breathGuide && (
    /* The breath to follow: a small circle on the same 10-second cycle. Still, it
         cannot guide a breath, so the line goes with it under reduced motion. */
    <p class="mt-2 flex items-center gap-4 text-left font-serif text-lg text-fg italic motion-reduce:hidden">
      <span
        class="size-11 shrink-0 animate-breathe rounded-full border-2 border-accent [--alpha:1] [--rest:0.45]"
        aria-hidden="true"
        data-breath
      />
      {data.breathGuide}
    </p>
  )}

  {data.linkLabel && data.linkUrl && (
    <TextLink href={data.linkUrl} class="mt-2">
      {data.linkLabel}
    </TextLink>
  )}
</Section>
