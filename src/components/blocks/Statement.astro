---
import Breath from '../Breath.astro';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    /** Lines in the poster register. Each becomes its own block and settles independently. */
    lines?: string[];
    text?: string;
    linkLabel?: string;
    linkUrl?: string;
    /** A short line beside the small breathing circle. */
    breathGuide?: string;
  };
}

/** The one orange field on the page, set like the flyer: night capitals on flame. */

const { data } = Astro.props;
const anchor = data.anchor ?? 'haltung';
const lines = data.lines ?? [];
---

<section class="section surface-flame section--clip statement" id={anchor} aria-labelledby="statement-title">
  <Breath variant="glow" class="statement__breath" />

  <div class="container statement__inner">
    {data.eyebrow && <p class="marker marker--plain statement__marker">{data.eyebrow}</p>}

    <h2 class="display display--heavy statement__display" id="statement-title">
      {lines.map((line) => (
        <span class="display__line statement__line">{line}</span>
      ))}
    </h2>

    {(data.text || data.linkLabel) && (
      <div class="statement__foot">
        {data.text && <p class="statement__text">{data.text}</p>}
        {data.breathGuide && (
          <p class="statement__guide">
            <span class="statement__guide-circle" aria-hidden="true" data-breath></span>
            {data.breathGuide}
          </p>
        )}
        {data.linkLabel && data.linkUrl && (
          <a href={data.linkUrl} class="text-link statement__link">
            {data.linkLabel}
          </a>
        )}
      </div>
    )}
  </div>
</section>

<style is:global>
  @layer sections {
    .statement {
      padding-block: var(--space-2xl);
    }

    /* A light breath across the field. Lightening the orange behind night text
       only raises the contrast. */
    .statement__breath {
      --breath-color: #fff4e6;
      --breath-glow: 34%;

      inset-block-start: 50%;
      inset-inline-start: 30%;
      inline-size: max(70vw, 40rem);
      translate: -50% -50%;
    }

    /* The capitals run across the field like the flyer's slogan; the reading
       follows below them, on the content line. */
    .statement__inner {
      position: relative;
      display: grid;
      grid-template-columns: var(--split-columns);
      gap: var(--space-lg) var(--split-gap);
      align-items: end;
    }

    .statement__display {
      grid-column: 1 / -1;
    }

    .statement__foot {
      grid-column: 2;
    }

    .statement__marker {
      grid-column: 1 / -1;
      color: var(--text-primary);
    }

    .statement__display {
      margin: 0;
      font-size: clamp(2.5rem, 1rem + 5vw, 5.5rem);
      /* Umlaut dots rise above the cap height; this keeps them off the line above. */
      line-height: 1.12;
      color: var(--text-primary);
    }

    /* Wide: a poster on the split line, two columns of equal height. The slogan
       stands in four lines over columns 1–5 ("Aus dem", the widest, is 4.45em of
       capitals, so 8.8cqi fills them); from column 7 the label at the top and the
       reading at the foot, level with the slogan's last line. */
    @media (width > 56em) {
      .statement__inner {
        container-type: inline-size;
        grid-template-rows: auto 1fr;
        grid-template-columns: var(--field);
        gap: var(--space-lg) var(--field-gap);
        align-items: stretch;
      }

      .statement__marker {
        grid-row: 1;
        grid-column: 7 / span 6;
        align-self: start;
        margin: 0;
      }

      .statement__display {
        grid-row: 1 / span 2;
        grid-column: 1 / span 5;
        align-self: start;
        font-size: min(8.8cqi, 9rem);
        line-height: 1.04;
      }

      .statement__foot {
        grid-row: 2;
        grid-column: 7 / span 6;
        align-self: end;
      }

      .statement__text {
        max-inline-size: 34em;
      }
    }

    .statement__foot {
      display: grid;
      gap: var(--space-sm);
      justify-items: start;
      padding-block-start: var(--space-md);
      border-block-start: 2px solid var(--rule-strong);
    }

    .statement__text {
      max-inline-size: 42ch;
      margin: 0;
      font-size: var(--text-section-body-lg);
      font-weight: 500;
      line-height: var(--leading-relaxed);
      color: var(--text-primary);
    }

    /* The breath to follow: a small circle on the same 10-second cycle. */
    .statement__guide {
      display: flex;
      gap: var(--space-sm);
      align-items: center;
      margin: 0;
      font-family: var(--font-quote);
      font-size: var(--text-lg);
      font-style: italic;
      font-weight: 400;
      line-height: 1.3;
      color: var(--text-primary);
    }

    .statement__guide-circle {
      --rest: 0.45;
      --alpha: 1;

      flex: none;
      inline-size: 2.75rem;
      block-size: 2.75rem;
      border: 2px solid var(--text-primary);
      border-radius: 50%;
      animation: breathe 10s infinite both;
    }

    /* Still, the circle cannot guide a breath; the line goes with it. */
    @media (prefers-reduced-motion: reduce) {
      .statement__guide {
        display: none;
      }
    }

    .statement__link {
      font-weight: 700;
      text-decoration-color: var(--text-primary);
    }

    @media (prefers-reduced-motion: no-preference) {
      @supports (animation-timeline: view()) {
        .statement__line {
          animation: statement-settle linear both;
          animation-timeline: view();
          animation-range: entry 10% cover 40%;
        }

        .statement__line:nth-child(2) {
          --statement-from: 12%;
        }
      }
    }

    /* Narrow: the same poster, stacked. The slogan stands in four lines across the
       full width ("Aus dem", the widest, is 4.45em, so 21cqi fills it), the reading
       under it. */
    @media (width <= 56em) {
      .statement__inner {
        container-type: inline-size;
        grid-template-columns: minmax(0, 1fr);
        row-gap: var(--space-xl);
      }

      .statement__display {
        font-size: min(21cqi, 7.5rem);
        line-height: 1.04;
      }

      .statement__foot {
        grid-column: auto;
      }

      @supports (animation-timeline: view()) {
        .statement__line {
          animation-name: rise;
        }
      }
    }
  }
</style>
