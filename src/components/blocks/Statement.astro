---
import { button } from '@lib/ui';

import Eyebrow from '../ui/Eyebrow.astro';
import Section from '../ui/Section.astro';
import TextLink from '../ui/TextLink.astro';

interface Props {
  anchor: string;
  eyebrow: string;
  lines: string[];
  text: string;
  linkLabel: string;
  linkUrl: string;
  breathGuide: string;
}

const { anchor, eyebrow, lines, text, linkLabel, linkUrl, breathGuide } = Astro.props;
---

<Section id={anchor} ground="dark" labelledby="statement-title" class="overflow-clip">
  {/* The hills of the Bavarian Forest at dusk; the breath rises above them. */}
  <svg
    aria-hidden="true"
    viewBox="0 0 1200 120"
    preserveAspectRatio="none"
    class="pointer-events-none absolute inset-x-0 bottom-0 h-14 w-full sm:h-20 lg:h-24"
  >
    <path class="fill-raised/50" d="M0 70C120 40 220 38 330 55S520 30 640 42 860 20 980 46 1140 50 1200 36V120H0Z" />
    <path class="fill-raised" d="M0 92C140 70 260 78 380 88S600 64 760 80 1000 96 1200 70V120H0Z" />
  </svg>
  <div class="relative grid items-center gap-x-grid gap-y-8 lg:grid-cols-12">
    <div data-reveal class="grid justify-items-start lg:col-span-7">
      {eyebrow && <Eyebrow class="mb-4">{eyebrow}</Eyebrow>}
      <h2 id="statement-title" class="text-page text-fg">
        {lines.map((line, i) => (i > 0 ? <em class="block">{line}</em> : <span class="block">{line}</span>))}
      </h2>
      {text && <p class="mt-6 max-w-measure text-md text-fg-soft">{text}</p>}
      {linkLabel && linkUrl && (
        <TextLink href={linkUrl} class="mt-4">
          {linkLabel}
        </TextLink>
      )}
    </div>

    {breathGuide && (
      <div
        data-breath
        data-reveal
        class="group/breath flex flex-wrap items-center gap-6 lg:col-span-4 lg:col-start-9 lg:flex-col lg:text-center"
      >
        <span class="breath-orbit relative grid size-32 shrink-0 place-items-center lg:size-56" aria-hidden="true">
          <span class="breath-ring absolute inset-0 rounded-full border border-glow/40 [--rest:0.62]"></span>
          <span class="breath-ring absolute inset-[14%] rounded-full border border-glow/50 [--rest:0.55]"></span>
          <span class="breath-ring absolute inset-[30%] rounded-full bg-fill/25 [--rest:0.5]"></span>
          <span class="size-3 rounded-full bg-glow shadow-[0_0_24px_4px_var(--color-glow)]"></span>
        </span>
        <div class="grid flex-1 justify-items-start gap-3 lg:justify-items-center">
          <p id="breath-guide" class="max-w-[25ch] text-base text-fg-soft">
            {breathGuide}
          </p>
          <span
            aria-hidden="true"
            class="breath-phase invisible grid font-display text-xl text-accent group-data-running/breath:visible motion-reduce:hidden"
          >
            <span class="breath-in col-start-1 row-start-1">Einatmen</span>
            <span class="breath-out col-start-1 row-start-1">Ausatmen</span>
          </span>
          <button
            type="button"
            data-breath-toggle
            hidden
            aria-pressed="false"
            aria-describedby="breath-guide"
            class:list={[button({ variant: 'secondary', size: 'sm' }), 'motion-reduce:hidden']}
          >
            Rhythmus starten
          </button>
        </div>
      </div>
    )}
  </div>
</Section>

<script>
  /** An optional breath rhythm, stopped when it leaves the screen or the tab hides. */
  function initBreath(): void {
    const guide = document.querySelector<HTMLElement>('[data-breath]');
    const toggle = guide?.querySelector<HTMLButtonElement>('[data-breath-toggle]');

    if (!guide || !toggle) return;

    const motion = matchMedia('(prefers-reduced-motion: reduce)');

    const render = (running: boolean): void => {
      guide.toggleAttribute('data-running', running);
      toggle.setAttribute('aria-pressed', String(running));
      toggle.textContent = running ? 'Rhythmus stoppen' : 'Rhythmus starten';
    };

    toggle.hidden = false;
    toggle.addEventListener('click', () => render(!motion.matches && !guide.hasAttribute('data-running')));
    motion.addEventListener('change', () => render(false));
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) render(false);
    });
    new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) render(false);
    }).observe(guide);
  }

  initBreath();
</script>
