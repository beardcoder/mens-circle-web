---
import { button } from '@lib/ui';

import Eyebrow from '../ui/Eyebrow.astro';
import Section from '../ui/Section.astro';
import TextLink from '../ui/TextLink.astro';

interface Props {
  anchor: string;
  eyebrow: string;
  lines: string[];
  text: string;
  linkLabel: string;
  linkUrl: string;
  breathGuide: string;
}

const { anchor, eyebrow, lines, text, linkLabel, linkUrl, breathGuide } = Astro.props;
---

<Section id={anchor} ground="alt" labelledby="statement-title">
  <div class="grid items-center gap-x-grid gap-y-8 lg:grid-cols-12">
    <div class="grid justify-items-start lg:col-span-7">
      {eyebrow && <Eyebrow class="mb-3">{eyebrow}</Eyebrow>}
      <h2 id="statement-title" class="text-section text-fg">
        {lines.map((line, i) =>
          i > 0 ? (
            <em class="block font-serif font-normal text-accent [--slide-from:12%]">{line}</em>
          ) : (
            <span class="block">{line}</span>
          ),
        )}
      </h2>
      {text && <p class="mt-6 max-w-measure text-md text-fg-soft">{text}</p>}
      {linkLabel && linkUrl && (
        <TextLink href={linkUrl} class="mt-4">
          {linkLabel}
        </TextLink>
      )}
    </div>

    {breathGuide && (
      <div
        data-breath
        class="group/breath flex flex-wrap items-center gap-6 lg:col-span-4 lg:col-start-9 lg:flex-col lg:text-center"
      >
        <span class="breath-orbit relative grid size-28 shrink-0 place-items-center lg:size-44" aria-hidden="true">
          <span class="breath-ring absolute inset-0 rounded-full border border-fill/50 [--alpha:1] [--rest:0.62]"></span>
          <span class="breath-ring absolute inset-[14%] rounded-full border border-fill/40 [--alpha:1] [--rest:0.55]"></span>
          <span class="breath-ring absolute inset-[30%] rounded-full bg-fill/15 [--alpha:1] [--rest:0.5]"></span>
          <span class="size-2 rounded-full bg-fill"></span>
        </span>
        <div class="grid flex-1 justify-items-start gap-3 lg:justify-items-center">
          <p id="breath-guide" class="max-w-[25ch] text-base text-fg-soft">
            {breathGuide}
          </p>
          <span
            aria-hidden="true"
            class="breath-phase invisible grid font-serif text-xl text-accent group-data-running/breath:visible motion-reduce:hidden"
          >
            <span class="breath-in col-start-1 row-start-1">Einatmen</span>
            <span class="breath-out col-start-1 row-start-1">Ausatmen</span>
          </span>
          <button
            type="button"
            data-breath-toggle
            hidden
            aria-pressed="false"
            aria-describedby="breath-guide"
            class:list={[button({ variant: 'secondary', size: 'sm' }), 'motion-reduce:hidden']}
          >
            Rhythmus starten
          </button>
        </div>
      </div>
    )}
  </div>
</Section>

<script>
  /** An optional breath rhythm, stopped when it leaves the screen or the tab hides. */
  function initBreath(): void {
    const guide = document.querySelector<HTMLElement>('[data-breath]');
    const toggle = guide?.querySelector<HTMLButtonElement>('[data-breath-toggle]');

    if (!guide || !toggle) return;

    const motion = matchMedia('(prefers-reduced-motion: reduce)');

    const render = (running: boolean): void => {
      guide.toggleAttribute('data-running', running);
      toggle.setAttribute('aria-pressed', String(running));
      toggle.textContent = running ? 'Rhythmus stoppen' : 'Rhythmus starten';
    };

    toggle.hidden = false;
    toggle.addEventListener('click', () => render(!motion.matches && !guide.hasAttribute('data-running')));
    motion.addEventListener('change', () => render(false));
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) render(false);
    });
    new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) render(false);
    }).observe(guide);
  }

  initBreath();
</script>
