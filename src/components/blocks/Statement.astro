---
interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    /** Lines in the poster register. Each becomes its own block and settles independently. */
    lines?: string[];
    text?: string;
    linkLabel?: string;
    linkUrl?: string;
  };
}

/** The one orange field on the page, set like the flyer: night capitals on flame. */

const { data } = Astro.props;
const anchor = data.anchor ?? 'haltung';
const lines = data.lines ?? [];
---

<section class="section surface-flame section--clip statement" id={anchor} aria-labelledby="statement-title">
  <div class="container statement__inner">
    {data.eyebrow && <p class="marker marker--plain statement__marker">{data.eyebrow}</p>}

    <h2 class="display display--heavy statement__display" id="statement-title">
      {lines.map((line) => (
        <span class="display__line statement__line">{line}</span>
      ))}
    </h2>

    {(data.text || data.linkLabel) && (
      <div class="statement__foot">
        {data.text && <p class="statement__text">{data.text}</p>}
        {data.linkLabel && data.linkUrl && (
          <a href={data.linkUrl} class="text-link statement__link">
            {data.linkLabel}
          </a>
        )}
      </div>
    )}
  </div>
</section>

<style is:global>
  @layer sections {
    .statement {
      padding-block: var(--space-2xl);
    }

    .statement__inner {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-lg) var(--space-xl);
      align-items: end;
    }

    .statement__marker {
      grid-column: 1 / -1;
      color: var(--text-primary);
    }

    .statement__display {
      margin: 0;
      font-size: clamp(2.5rem, 1rem + 5.6vw, 6.5rem);
      /* Figtree's Ö dots rise above the cap height; this keeps them off the line above. */
      line-height: 1.12;
      color: var(--text-primary);
    }

    .statement__foot {
      display: grid;
      gap: var(--space-sm);
      justify-items: start;
      padding-block-start: var(--space-md);
      border-block-start: 2px solid var(--rule-strong);
    }

    .statement__text {
      max-inline-size: 42ch;
      margin: 0;
      font-size: var(--text-section-body-lg);
      font-weight: 500;
      line-height: var(--leading-relaxed);
      color: var(--text-primary);
    }

    .statement__link {
      font-weight: 700;
      text-decoration-color: var(--text-primary);
    }

    @media (prefers-reduced-motion: no-preference) {
      @supports (animation-timeline: view()) {
        .statement__line {
          animation: statement-settle linear both;
          animation-timeline: view();
          animation-range: entry 10% cover 40%;
        }

        .statement__line:nth-child(2) {
          --statement-from: 12%;
        }
      }
    }

    @media (width <= 56em) {
      .statement__inner {
        grid-template-columns: minmax(0, 1fr);
      }

      @supports (animation-timeline: view()) {
        .statement__line {
          animation-name: rise;
        }
      }
    }
  }
</style>
