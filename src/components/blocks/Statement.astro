---
import { splitWords } from '@lib/shared/words';

import Section from '../ui/Section.astro';

/** The statement, as the slot's inline markup; an `<em>` is its strong word. */
const words = splitWords(await Astro.slots.render('default'));
---

{/* One statement on a screen of its own, the page's one scroll-led moment: its words
    turn to ink one after the other as it crosses the window (global.css, "Motion:
    scroll"). Whole and in full ink without motion or view timelines. */}
<Section class="grid min-h-svh content-center">
  <p
    data-statement
    class="max-w-[12em] font-display text-page font-medium text-fg [&_em]:text-accent"
    set:html={words.html}
  />
</Section>
