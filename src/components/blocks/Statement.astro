---
interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    /** Lines in the heavy register. Each becomes its own block and settles independently. */
    lines?: string[];
    text?: string;
    linkLabel?: string;
    linkUrl?: string;
  };
}

/** The one moss ground on the page: breath and body, in the heavy register. */

const { data } = Astro.props;
const anchor = data.anchor ?? 'haltung';
const lines = data.lines ?? [];
---

<section class="section surface-moss section--clip statement" id={anchor} aria-labelledby="statement-title">
  <span class="statement__breath" aria-hidden="true">
    {[0, 1, 2, 3, 4].map((i) => (
      <span style={`--i: ${i}`}></span>
    ))}
  </span>

  <div class="container statement__inner">
    {data.eyebrow && <p class="marker statement__marker">{data.eyebrow}</p>}

    <h2 class="display display--heavy statement__display" id="statement-title">
      {lines.map((line) => (
        <span class="display__line statement__line">{line}</span>
      ))}
    </h2>

    {(data.text || data.linkLabel) && (
      <div class="statement__foot">
        {data.text && <p class="statement__text">{data.text}</p>}
        {data.linkLabel && data.linkUrl && (
          <a href={data.linkUrl} class="text-link statement__link">
            {data.linkLabel}
          </a>
        )}
      </div>
    )}
  </div>
</section>

<style is:global>
  @layer sections {
    .statement {
      padding-block: var(--space-3xl);
    }

    .statement__inner {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-lg) var(--space-xl);
      align-items: end;
    }

    .statement__marker {
      grid-column: 1 / -1;
    }

    .statement__display {
      margin: 0;
      font-size: clamp(2.75rem, 1rem + 6.4vw, 7.5rem);
      color: var(--text-primary);
    }

    .statement__line:nth-child(2) {
      font-style: italic;
      font-weight: 400;
      text-transform: none;
      color: var(--accent);
    }

    .statement__foot {
      display: grid;
      gap: var(--space-sm);
      justify-items: start;
    }

    .statement__text {
      max-inline-size: 42ch;
      margin: 0;
      font-size: var(--text-section-body-lg);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
    }

    /* Breath: concentric rings off the right edge that widen and narrow as the
       section passes — one slow exhale across the scroll. */
    .statement__breath {
      position: absolute;
      inset-block-start: 50%;
      inset-inline-end: -14vw;
      inline-size: min(70vw, 56rem);
      aspect-ratio: 1;
      translate: 0 -50%;
      pointer-events: none;
    }

    .statement__breath span {
      position: absolute;
      inset: calc(var(--i) * 10%);
      border: 1px solid var(--border-light);
      border-radius: 50%;
    }

    @media (prefers-reduced-motion: no-preference) {
      @supports (animation-timeline: view()) {
        .statement__breath span {
          animation: breath linear both;
          animation-timeline: view();
          animation-range: cover 0% cover 100%;
        }

        .statement__line {
          animation: statement-settle linear both;
          animation-timeline: view();
          animation-range: entry 10% cover 40%;
        }

        .statement__line:nth-child(2) {
          --statement-from: 12%;
        }
      }
    }

    @media (width <= 56em) {
      .statement {
        padding-block: var(--space-2xl);
      }

      .statement__inner {
        grid-template-columns: minmax(0, 1fr);
      }

      .statement__breath {
        inset-block-start: 0;
        inset-inline-end: -40vw;
        inline-size: 110vw;
        translate: 0 -30%;
      }

      @supports (animation-timeline: view()) {
        .statement__line {
          animation-name: rise;
        }
      }
    }
  }
</style>
