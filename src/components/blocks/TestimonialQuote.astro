---
import type { TestimonialDTO } from '@lib/shared/dto';
import { margin } from '@lib/ui';

interface Props {
  item: TestimonialDTO;
  /** The one short voice set large. Otherwise a row: the author in the margin, the words beside. */
  featured?: boolean;
}

const { item, featured = false } = Astro.props;
const byline = [item.author, item.role].filter(Boolean).join(' · ');
---

{featured ? (
  <figure class="grid content-start gap-6">
    <blockquote class="font-display text-section text-fg wrap-anywhere">„{item.quote}“</blockquote>
    {byline && (
      <figcaption>
        <cite class="text-sm font-semibold text-fg-muted not-italic">{byline}</cite>
      </figcaption>
    )}
  </figure>
) : (
  <figure class="contents">
    <figcaption class:list={[margin.side, 'lg:pt-1']}>
      {byline && <cite class="text-sm font-semibold text-fg not-italic">{byline}</cite>}
    </figcaption>
    <blockquote class:list={[margin.reading, 'max-w-measure text-lg whitespace-pre-line text-fg-soft wrap-anywhere']}>
      „{item.quote}“
    </blockquote>
  </figure>
)}
