---
import type { Testimonial } from '@lib/types';

/** Submitted and moderated entries, quoted as written — nothing is added or reworded. With none published the section shrinks to an invitation. */

interface Props {
  data?: { anchor?: string; eyebrow?: string; title?: string };
  testimonials?: Testimonial[];
  loading?: boolean;
}

const { data, loading = false } = Astro.props;
const testimonials =
  Astro.props.testimonials ?? (await (await import('../../lib/server/testimonials')).fetchTestimonials());
const anchor = data?.anchor ?? 'stimmen';
const empty = testimonials.length === 0;
---

<section
  class:list={[
    'section',
    'testimonials-section',
    loading && 'testimonials-section--pending',
    empty && !loading && 'testimonials-section--empty',
  ]}
  id={anchor}
  aria-labelledby="testimonials-title"
>
  <div class="container">
    <div class="testimonials__head">
      <p class="marker">{data?.eyebrow ?? 'Aus dem Kreis'}</p>
      <h2 class="display display--sm testimonials__title" id="testimonials-title">
        {data?.title ?? 'Was Teilnehmer geschrieben haben'}
      </h2>
    </div>

    {empty ? (
      <p class="testimonials__empty">
        {loading
          ? 'Erfahrungen von Teilnehmern werden geladen.'
          : 'Erfahrungen von Teilnehmern erscheinen hier, sobald sie freigegeben sind.'}
      </p>
    ) : (
      <ul class="testimonials__list" role="list">
        {testimonials.map((t) => (
          <li class="testimonial-item" data-reveal>
            <blockquote class="testimonial-item__quote">{t.quote}</blockquote>
            {(t.author || t.role) && (
              <p class="testimonial-item__author">
                {t.author && <cite class="testimonial-item__name">{t.author}</cite>}
                {t.role && <span class="testimonial-item__role">{t.role}</span>}
              </p>
            )}
          </li>
        ))}
      </ul>
    )}

    <p class="testimonials__note">
      {!empty && 'Die Zitate stammen von Männern, die beim Kreis waren. '}
      <a class="link" href="/teile-deine-erfahrung">
        Du warst dabei und möchtest etwas beitragen?
      </a>
    </p>
  </div>
</section>

<style is:global>
  @layer sections {
    .testimonials-section--pending {
      min-block-size: 24rem;
    }

    .testimonials__head {
      margin-block-end: var(--space-xl);
    }

    .testimonials__title {
      max-inline-size: 18ch;
      margin: 0;
    }

    .testimonials__list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
      gap: var(--space-xl) var(--space-lg);
      padding: 0;
      margin: 0;
      list-style: none;
    }

    /* Every voice is set alike: one size, one rule above, no voice louder than another. */
    .testimonial-item {
      display: grid;
      gap: var(--space-sm);
      align-content: start;
      padding-block-start: var(--space-md);
      border-block-start: 1px solid var(--rule-strong);
    }

    .testimonial-item__quote {
      max-inline-size: 52ch;
      margin: 0;
      font-family: var(--font-quote);
      font-size: var(--text-lg);
      font-style: italic;
      line-height: 1.5;
      color: var(--text-primary);
      text-wrap: pretty;
    }

    .testimonial-item__quote::before {
      content: '„';
      color: var(--accent);
    }

    .testimonial-item__quote::after {
      content: '“';
      color: var(--accent);
    }

    .testimonial-item__author {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3xs) var(--space-xs);
      align-items: baseline;
      margin: 0;
    }

    .testimonial-item__name {
      font-size: var(--text-caption);
      font-style: normal;
      font-weight: 600;
      color: var(--text-primary);
    }

    .testimonial-item__role {
      font-size: var(--text-caption);
      color: var(--text-muted);
    }

    .testimonials__empty {
      max-inline-size: var(--measure);
      font-size: var(--text-section-body-lg);
      color: var(--text-secondary);
    }

    .testimonials__note {
      max-inline-size: var(--measure);
      margin-block-start: var(--space-lg);
      font-size: var(--text-caption);
      line-height: var(--leading-relaxed);
      color: var(--text-muted);
    }

    /* No published voices yet: a quiet two-line band, not an empty stage. */
    .testimonials-section--empty {
      padding-block: var(--space-xl);
    }

    .testimonials-section--empty .testimonials__head {
      margin-block-end: var(--space-sm);
    }

    .testimonials-section--empty .testimonials__note {
      margin-block-start: var(--space-xs);
    }
  }
</style>
