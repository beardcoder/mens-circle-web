---
import type { TestimonialDTO } from '@lib/shared/dto'
import { margin } from '@lib/ui'

import Section from '../ui/Section.astro'
import SectionHead from '../ui/SectionHead.astro'
import TextLink from '../ui/TextLink.astro'
import TestimonialList from './TestimonialList.astro'

interface Props {
  items: TestimonialDTO[] | null
  anchor: string
  eyebrow?: string
  title: string
  errorText: string
  linkUrl: string
  linkLabel: string
}

const { items, anchor, eyebrow, title, errorText, linkUrl, linkLabel } = Astro.props
---

{items?.length ? (
  <Section id={anchor} ground="dark" labelledby="testimonials-title">
    <div class:list={[margin.grid, 'gap-y-group']}>
      <SectionHead eyebrow={eyebrow} title={title} titleId="testimonials-title" class={margin.cross} />
      <div class="lg:col-span-12"><TestimonialList items={items} /></div>
      <p class={margin.content}><TextLink href={linkUrl}>{linkLabel}</TextLink></p>
    </div>
  </Section>
) : (
  <Section id={anchor} space="none" labelledby="testimonials-title" class="border-b border-line py-4">
    <h2 id="testimonials-title" class="sr-only">{title}</h2>
    {items === null && <p class="text-fg-muted">{errorText}</p>}
    <TextLink href={linkUrl}>{linkLabel}</TextLink>
  </Section>
)}
