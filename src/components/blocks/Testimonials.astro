---
import type { Testimonial } from '@lib/types';

/**
 * Submitted and moderated entries, quoted as written — nothing is added or
 * reworded, and the section renders nothing when none is published.
 *
 * A server island on the static home page: supplied testimonials feed the
 * build-time fallback only, live requests read the database.
 */

interface Props {
  data?: { anchor?: string; eyebrow?: string; title?: string };
  testimonials?: Testimonial[];
  loading?: boolean;
}

const { data, loading = false } = Astro.props;
const testimonials =
  Astro.props.testimonials ?? (await (await import('../../lib/server/testimonials')).fetchTestimonials());
const anchor = data?.anchor ?? 'stimmen';
---

{
  (
    <section class="section section--sand testimonials-section" id={anchor} aria-labelledby="testimonials-title">
      <div class="container">
        <div class="spine">
          <p class="rail-heading">{data?.eyebrow ?? 'Aus dem Kreis'}</p>

          <div class="spine__body--wide">
            <h2 class="section-title" id="testimonials-title">
              {data?.title ?? 'Was Teilnehmer geschrieben haben'}
            </h2>

            {testimonials.length === 0 && (
              <p>
                {loading
                  ? 'Erfahrungen von Teilnehmern werden geladen.'
                  : 'Erfahrungen veröffentlichen wir nach ihrer Freigabe.'}
              </p>
            )}
            <ul class="testimonials__list" role="list">
              {testimonials.map((t) => (
                <li class="testimonial-item">
                  <blockquote class="testimonial-item__quote">{t.quote}</blockquote>
                  {(t.author || t.role) && (
                    <p class="testimonial-item__author">
                      {t.author && <cite class="testimonial-item__name">{t.author}</cite>}
                      {t.role && <span class="testimonial-item__role">{t.role}</span>}
                    </p>
                  )}
                </li>
              ))}
            </ul>

            <p class="testimonials__note">
              Die Zitate stammen von Männern, die beim Kreis waren.{' '}
              <a class="link" href="/teile-deine-erfahrung">
                Du warst dabei und möchtest etwas beitragen?
              </a>
            </p>
          </div>
        </div>
      </div>
    </section>
  )
}

<style is:global>
  @layer sections {
    .testimonials-section {
      min-block-size: 30rem;
    }
    /* A single column, not a two-up grid. Submitted quotes run from two lines
       to fifteen, so a grid left one cell half-empty beside a wall of text and
       halved the measure of both. Read down instead. */
    .testimonials__list {
      max-inline-size: var(--measure);
      margin-block-start: var(--space-md);
      padding: 0;
      list-style: none;
      border-block-start: 1px solid var(--border-light);
    }

    .testimonial-item {
      padding-block: var(--space-md);
      border-block-end: 1px solid var(--border-light);
    }

    .testimonial-item__quote {
      margin: 0;
      font-family: var(--font-display);
      font-size: var(--text-lg);
      line-height: var(--leading-normal);
      color: var(--text-primary);
      text-wrap: pretty;
    }

    .testimonial-item__author {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3xs) var(--space-xs);
      align-items: baseline;
      margin: 0;
      padding-block-start: var(--space-xs);
    }

    .testimonial-item__name {
      font-size: var(--text-caption);
      font-style: normal;
      font-weight: 600;
      color: var(--text-primary);
    }

    .testimonial-item__role {
      font-size: var(--text-caption);
      color: var(--text-muted);
    }

    .testimonials__note {
      max-inline-size: var(--measure);
      margin-block-start: var(--space-md);
      font-size: var(--text-caption);
      line-height: var(--leading-relaxed);
      color: var(--text-muted);
    }
  }
</style>
