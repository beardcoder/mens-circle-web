---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import TextLink from '../ui/TextLink.astro';
import TestimonialList from './TestimonialList';

interface Props {
  anchor: string;
  eyebrow: string;
  title: string;
  emptyText: string;
  errorText: string;
  linkUrl: string;
  linkLabel: string;
}

const { anchor, eyebrow, title, emptyText, errorText, linkUrl, linkLabel } = Astro.props;
---

<Section id={anchor} labelledby="testimonials-title">
  <SectionHead eyebrow={eyebrow} title={title} titleId="testimonials-title" />

  <TestimonialList client:visible={{ rootMargin: '300px' }} emptyText={emptyText} errorText={errorText} />
  <p class="mt-6">
    <TextLink href={linkUrl}>{linkLabel}</TextLink>
  </p>
</Section>
