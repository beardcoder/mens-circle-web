---
import type { Testimonial } from '@lib/types';
import Quote from '../ui/Quote.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import TextLink from '../ui/TextLink.astro';

/**
 * Submitted and moderated entries, quoted as written — nothing is added or
 * reworded — on the parchment band: a centred head, then the voices in a field
 * of cells parted by hairlines (two abreast; a last odd one runs across). With
 * none published the band shrinks to a quiet invitation.
 */

interface Props {
  data?: { anchor?: string; eyebrow?: string; title?: string; titleEmphasis?: string };
  testimonials?: Testimonial[];
  loading?: boolean;
}

const { data, loading = false } = Astro.props;
const testimonials =
  Astro.props.testimonials ?? (await (await import('../../lib/server/testimonials')).fetchTestimonials());
const anchor = data?.anchor ?? 'stimmen';
const empty = testimonials.length === 0;
---

<Section
  id={anchor}
  ground="alt"
  labelledby="testimonials-title"
  space={empty && !loading ? 'compact' : 'default'}
  class:list={[loading && 'min-h-96']}
  data-llms-skip
>
  <SectionHead
    eyebrow={data?.eyebrow ?? 'Aus dem Kreis'}
    title={data?.title ?? 'Was Teilnehmer geschrieben haben'}
    titleEmphasis={data?.titleEmphasis}
    titleId="testimonials-title"
    size="display-3"
    align="center"
    class="mx-auto max-w-prose"
  />

  {empty ? (
    <p class="mx-auto mt-4 max-w-measure text-center text-lg text-fg-soft">
      {loading
        ? 'Erfahrungen von Teilnehmern werden geladen.'
        : 'Erfahrungen von Teilnehmern erscheinen hier, sobald sie freigegeben sind.'}
    </p>
  ) : (
    <>
      <p class="mx-auto mt-4 max-w-prose text-center text-base text-fg-muted italic">
        Die Zitate stammen von Männern, die schon dabei waren.
      </p>
      <ul role="list" class="mt-group grid border-y border-line md:grid-cols-2">
        {testimonials.map((t) => (
          <li class="reveal border-line px-1 py-10 max-md:not-first:border-t md:px-10 md:even:border-l md:nth-[n+3]:border-t md:last:odd:col-span-2 lg:px-14">
            <Quote quote={t.quote} author={t.author} role={t.role} />
          </li>
        ))}
      </ul>
    </>
  )}

  <p class:list={['text-center', empty ? 'mt-4' : 'mt-10']}>
    <TextLink href="/teile-deine-erfahrung">Du warst dabei? Teile deine Erfahrung</TextLink>
  </p>
</Section>
