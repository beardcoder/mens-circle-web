---
import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Split from '../ui/Split.astro';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    content?: string;
  };
  /** The essay opening the page: its first paragraph starts with a dropped initial. */
  opening?: boolean;
}

/**
 * Prose on the split line — the essay register of the sub-pages: label and title
 * on the left, the text from column 7. Legal pages pass only content: the text
 * reads from the left edge and follows its title without a section's pause.
 */

const { data, opening = false } = Astro.props;
const slug = (data.title ?? '')
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-+|-+$/g, '');
const anchor = data.anchor ?? slug;
const hasHead = Boolean(data.eyebrow || data.title);
---

<Section id={anchor || undefined} space={hasHead ? 'default' : 'none'} class:list={[!hasHead && 'pb-section']}>
  <Split alignToTitle={hasHead}>
    {hasHead && <SectionHead slot="head" eyebrow={data.eyebrow} title={data.title} size="display-3" class="reveal" />}
    {data.content && (
      <Prose
        html={data.content}
        size="lg"
        class:list={[
          hasHead ? 'max-w-[36em]' : 'max-w-[62ch]',
          opening &&
            'supports-[(initial-letter:3)_or_(-webkit-initial-letter:3)]:[&>p:first-child]:first-letter:mr-[0.12em] supports-[(initial-letter:3)_or_(-webkit-initial-letter:3)]:[&>p:first-child]:first-letter:font-serif supports-[(initial-letter:3)_or_(-webkit-initial-letter:3)]:[&>p:first-child]:first-letter:text-accent supports-[(initial-letter:3)_or_(-webkit-initial-letter:3)]:[&>p:first-child]:first-letter:[-webkit-initial-letter:3] supports-[(initial-letter:3)_or_(-webkit-initial-letter:3)]:[&>p:first-child]:first-letter:[initial-letter:3]',
        ]}
      />
    )}
  </Split>
</Section>
