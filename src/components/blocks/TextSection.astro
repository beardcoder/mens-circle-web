---
import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Split from '../ui/Split.astro';

interface Props {
  anchor?: string;
  eyebrow: string;
  title: string;
  content: string;
}

/** Essay sections share the FAQ grid: a compact heading beside a readable text column. */

const { anchor, eyebrow, title, content } = Astro.props;

const slug = title
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-+|-+$/g, '');

const sectionId = anchor ?? slug;
const hasHead = Boolean(eyebrow || title);
---

<Section
  id={sectionId || undefined}
  space="band"
>
  {hasHead ? (
    <Split>
      <SectionHead
        slot="head"
        eyebrow={eyebrow}
        title={title}
        size="sub"
      />
      {content && <Prose html={content} />}
    </Split>
  ) : (
    content && <Prose html={content} />
  )}
</Section>
