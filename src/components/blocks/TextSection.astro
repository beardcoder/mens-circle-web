---
import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Split from '../ui/Split.astro';

interface Props {
  anchor: string;
  eyebrow: string;
  title: string;
}

const { anchor, eyebrow, title } = Astro.props;
---

<Section id={anchor} space="band">
  <Split>
    <SectionHead slot="head" eyebrow={eyebrow} title={title} size="sub" />
    <Prose reveal>
      <slot />
    </Prose>
  </Split>
</Section>
