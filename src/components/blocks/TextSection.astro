---
import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    content?: string;
  };
  /** The essay opening the page: its first paragraph starts with a dropped initial. */
  opening?: boolean;
}

/**
 * Prose on one reading line — the essay register of the sub-pages: eyebrow and
 * title above the text. Legal pages pass only content: the text follows the page
 * title without a section's pause.
 */

const { data, opening = false } = Astro.props;
const slug = (data.title ?? '')
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-+|-+$/g, '');
const anchor = data.anchor ?? slug;
const hasHead = Boolean(data.eyebrow || data.title);
---

<Section
  id={anchor || undefined}
  space={hasHead ? 'compact' : 'none'}
  class:list={[!hasHead && 'pb-section']}
  innerClass="grid gap-6"
>
  {hasHead && <SectionHead eyebrow={data.eyebrow} title={data.title} class="reveal" />}
  {data.content && (
    <Prose
      html={data.content}
      size="lg"
      class:list={[
        'max-w-[42rem]',
        opening &&
          'supports-[(initial-letter:3)_or_(-webkit-initial-letter:3)]:[&>p:first-child]:first-letter:mr-[0.12em] supports-[(initial-letter:3)_or_(-webkit-initial-letter:3)]:[&>p:first-child]:first-letter:font-serif supports-[(initial-letter:3)_or_(-webkit-initial-letter:3)]:[&>p:first-child]:first-letter:font-semibold supports-[(initial-letter:3)_or_(-webkit-initial-letter:3)]:[&>p:first-child]:first-letter:text-accent supports-[(initial-letter:3)_or_(-webkit-initial-letter:3)]:[&>p:first-child]:first-letter:[-webkit-initial-letter:3] supports-[(initial-letter:3)_or_(-webkit-initial-letter:3)]:[&>p:first-child]:first-letter:[initial-letter:3]',
      ]}
    />
  )}
</Section>
