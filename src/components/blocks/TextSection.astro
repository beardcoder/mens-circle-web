---
import { margin } from '@lib/ui';

import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Props {
  anchor: string;
  eyebrow?: string;
  title: string;
}

const { anchor, eyebrow, title } = Astro.props;
---

{/* A heading in the margin, the text beside it on the reading line. */}
<Section id={anchor} space="band">
  <div class:list={[margin.grid, 'gap-y-6']}>
    <SectionHead eyebrow={eyebrow} title={title} size="sub" class={margin.side} />
    <Prose class={margin.reading}>
      <slot />
    </Prose>
  </div>
</Section>
