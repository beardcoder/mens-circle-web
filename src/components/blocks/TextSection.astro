---
interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    content?: string;
  };
}

/** Prose in the serif voice, with a short label that stays beside it while it is read. */

const { data } = Astro.props;
const slug = (data.title ?? '')
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-+|-+$/g, '');
const anchor = data.anchor ?? slug;
---

<section class="section section--ruled text-section" id={anchor || undefined}>
  <div class="container">
    <div class="spine">
      {data.eyebrow ? <p class="rail-heading">{data.eyebrow}</p> : <span aria-hidden="true" />}

      <div class="spine__body">
        {data.title && (
          <h2 class="text-section__title" data-reveal>
            {data.title}
          </h2>
        )}

        {data.content && <div class="prose text-section__prose" set:html={data.content} />}
      </div>
    </div>
  </div>
</section>

<style is:global>
  @layer sections {
    .text-section__title {
      max-inline-size: 22ch;
      margin-block-end: var(--space-md);
      font-size: var(--step-3);
    }

    .text-section__prose p {
      font-size: var(--step-1);
      line-height: 1.6;
    }
  }
</style>
