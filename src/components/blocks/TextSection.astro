---
import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    content?: string;
  };
}

/**
 * Prose on one reading column, aligned with the page's left edge: the essay
 * register of the sub-pages (a label and a subheading above the text) and the
 * legal pages (content only). Consecutive sections read as one column: their
 * space is the band's, not a section's.
 */

const { data } = Astro.props;

const slug = (data.title ?? '')
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-+|-+$/g, '');

const anchor = data.anchor ?? slug;
const hasHead = Boolean(data.eyebrow || data.title);
---

<Section id={anchor || undefined} space="band">
  <div class="grid max-w-column gap-6">
    {hasHead && <SectionHead eyebrow={data.eyebrow} title={data.title} size="sub" />}
    {data.content && <Prose html={data.content} />}
  </div>
</Section>
