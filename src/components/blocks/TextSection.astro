---
interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    content?: string;
  };
}

/**
 * A passage of running prose with a marginal heading.
 *
 * The same asymmetric spine the home page uses, so a long personal text reads as
 * one continuous piece with its subheads in the margin, rather than as a stack
 * of centred slides.
 */

const { data } = Astro.props;
const slug = (data.title ?? '')
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-+|-+$/g, '');
const anchor = data.anchor ?? slug;
---

<section class="section section--ruled text-section" id={anchor || undefined}>
  <div class="container">
    <div class="spine">
      {data.eyebrow && <p class="rail-heading">{data.eyebrow}</p>}

      <div class="spine__body">
        {
          data.title && (
            <h2 class="text-section__title" data-reveal="up">
              {data.title}
            </h2>
          )
        }

        {data.content && <div class="prose" data-reveal="up" set:html={data.content} />}
      </div>
    </div>
  </div>
</section>

<style is:global>
  @layer sections {
    .text-section__title {
      margin-block-end: var(--space-sm);
      font-size: var(--text-3xl);
      line-height: 1.15;
      text-wrap: balance;
    }

    .text-section .prose p {
      font-size: var(--text-section-body-lg);
    }
  }
</style>
