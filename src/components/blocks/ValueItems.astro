---
import { margin } from '@lib/ui';

import Index from '../ui/Index.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Item {
  title: string;
  description: string;
}

interface Props {
  anchor: string;
  eyebrow: string;
  title: string;
  intro: string;
  items: Item[];
}

const { anchor, eyebrow, title, intro, items } = Astro.props;
---

{/* The values as rows in the content column: the index number, the value, what it means. */}
<Section id={anchor} space="band">
  <div class:list={[margin.grid, 'gap-y-10']}>
    <SectionHead eyebrow={eyebrow} title={title} lead={intro} size="sub" class={margin.cross} />

    {items.length > 0 && (
      <ul role="list" data-reveal-group class:list={[margin.content, 'grid border-b border-line-strong']}>
        {items.map((item, i) => (
          <li class="grid grid-cols-[3rem_minmax(0,1fr)] items-baseline gap-x-4 gap-y-2 border-t border-line-strong py-6 md:grid-cols-[3.5rem_minmax(0,2fr)_minmax(0,3fr)] md:gap-x-grid">
            <Index value={i + 1} size="sub" />
            <h3 class="font-sans text-xl font-semibold text-fg">{item.title}</h3>
            {item.description && (
              <p class="max-w-measure text-md text-fg-soft max-md:col-start-2">{item.description}</p>
            )}
          </li>
        ))}
      </ul>
    )}
  </div>
</Section>
