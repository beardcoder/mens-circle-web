---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Item {
  title?: string;
  description?: string;
}

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    intro?: string;
    items?: Item[];
  };
}

/**
 * Positions set as pairs: "Ehrlichkeit statt Fassade" becomes the word that
 * counts, large, and what it replaces, quiet beside it. On the night ground, so
 * the essay page has one turn of colour. Unnumbered, held apart by hairlines.
 */

const { data } = Astro.props;
const items = (data.items ?? []).map((item) => {
  const [keep, ...rest] = (item.title ?? '').split(' statt ');
  return { ...item, keep, instead: rest.join(' statt ') };
});
---

<Section id={data.anchor} ground="night" defer>
  <SectionHead eyebrow={data.eyebrow} title={data.title} titleHtml lead={data.intro} layout="split" />

  {items.length > 0 && (
    <ul role="list" class="mt-group border-t border-line">
      {items.map((item) => (
        <li class="reveal grid items-baseline gap-x-grid gap-y-2 border-b border-line py-6 lg:grid-cols-12">
          <h3 class="text-display-3 text-fg lg:col-span-6">
            {item.keep}
            {item.instead && (
              <span class="font-serif text-[0.5em] tracking-normal whitespace-nowrap text-fg-muted italic">
                {' '}
                statt {item.instead}
              </span>
            )}
          </h3>
          {item.description && (
            <p class="max-w-[38ch] text-md text-fg-soft lg:col-span-6 lg:col-start-7">{item.description}</p>
          )}
        </li>
      ))}
    </ul>
  )}
</Section>
