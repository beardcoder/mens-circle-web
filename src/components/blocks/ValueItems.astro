---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Item {
  title?: string;
  description?: string;
}

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    intro?: string;
    items?: Item[];
  };
}

/**
 * Positions set as pairs: "Ehrlichkeit statt Fassade" becomes the word that
 * counts and, in the italic, what it replaces — a field of equal cells parted by
 * hairlines, on the stone band.
 */

const { data } = Astro.props;
const items = (data.items ?? []).map((item) => {
  const [keep, ...rest] = (item.title ?? '').split(' statt ');
  return { ...item, keep, instead: rest.join(' statt ') };
});
---

<Section id={data.anchor} ground="sand" defer>
  <SectionHead eyebrow={data.eyebrow} title={data.title} titleHtml lead={data.intro} size="display-2" />

  {items.length > 0 && (
    <ul role="list" class="mt-group grid border-t border-line sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <li class="reveal grid content-start gap-3 border-b border-line px-1 py-10 sm:px-8 sm:max-lg:even:border-l lg:not-nth-[3n+1]:border-l">
          <h3 class="text-2xl text-fg">
            {item.keep} {item.instead && <span class="block text-lg text-fg-muted italic">statt {item.instead}</span>}
          </h3>
          {item.description && <p class="text-base text-fg-soft">{item.description}</p>}
        </li>
      ))}
    </ul>
  )}
</Section>
