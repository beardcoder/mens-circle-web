---
import { margin } from '@lib/ui';

import Index from '../ui/Index.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Item {
  title: string;
  description: string;
}

interface Props {
  anchor: string;
  eyebrow: string;
  title: string;
  intro: string;
  items: Item[];
}

const { anchor, eyebrow, title, intro, items } = Astro.props;
---

{/* The values in the content column, two by two, each under its index number. */}
<Section id={anchor} space="band">
  <div class:list={[margin.grid, 'gap-y-10']}>
    <SectionHead eyebrow={eyebrow} title={title} lead={intro} size="sub" class={margin.cross} />

    {items.length > 0 && (
      <ul role="list" data-reveal-group class:list={[margin.content, 'grid gap-x-grid gap-y-10 md:grid-cols-2']}>
        {items.map((item, i) => (
          <li class="grid content-start gap-3 border-t border-line-strong pt-5">
            <Index value={i + 1} size="sub" />
            <h3 class="font-sans text-xl font-semibold text-fg">{item.title}</h3>
            {item.description && <p class="max-w-measure text-md text-fg-soft">{item.description}</p>}
          </li>
        ))}
      </ul>
    )}
  </div>
</Section>
