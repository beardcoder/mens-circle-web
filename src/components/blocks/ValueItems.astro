---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Item {
  title?: string;
  description?: string;
}

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    intro?: string;
    items?: Item[];
  };
}

/**
 * Positions set as pairs: "Ehrlichkeit statt Fassade" becomes the word that
 * counts and, quieter, what it replaces — an ordered list in two columns under
 * thin lines, like the agreements on the home page.
 */

const { data } = Astro.props;
const items = (data.items ?? []).map((item) => {
  const [keep, ...rest] = (item.title ?? '').split(' statt ');
  return { ...item, keep, instead: rest.join(' statt ') };
});
---

<Section id={data.anchor} space="band">
  <SectionHead eyebrow={data.eyebrow} title={data.title} titleHtml lead={data.intro} size="sub" />

  {items.length > 0 && (
    <ul role="list" class="mt-8 grid gap-x-grid gap-y-6 md:grid-cols-2">
      {items.map((item) => (
        <li class="reveal grid content-start gap-2">
          <span aria-hidden="true" class="draw mb-3 block h-px bg-line-strong"></span>
          <h3 class="font-sans text-xl font-semibold text-fg">
            {item.keep}
            {item.instead && <span class="block text-base font-normal text-fg-muted">statt {item.instead}</span>}
          </h3>
          {item.description && <p class="max-w-measure text-md text-fg-soft">{item.description}</p>}
        </li>
      ))}
    </ul>
  )}
</Section>
