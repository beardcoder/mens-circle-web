---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Item {
  title: string;
  description: string;
}

interface Props {
  anchor: string;
  eyebrow: string;
  title: string;
  intro: string;
  items: Item[];
}

const { anchor, eyebrow, title, intro, items } = Astro.props;
---

<Section id={anchor} space="band">
  <SectionHead eyebrow={eyebrow} title={title} lead={intro} size="sub" />

  {items.length > 0 && (
    <ul role="list" data-reveal-group class="mt-8 grid gap-x-grid gap-y-6 md:grid-cols-2">
      {items.map((item) => (
        <li class="grid content-start gap-2">
          <span aria-hidden="true" class="mb-3 block h-px bg-line-strong"></span>
          <h3 class="font-sans text-xl font-semibold text-fg">{item.title}</h3>
          {item.description && <p class="max-w-measure text-md text-fg-soft">{item.description}</p>}
        </li>
      ))}
    </ul>
  )}
</Section>
