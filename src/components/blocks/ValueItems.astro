---
import { card } from '@lib/ui';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Item {
  title?: string;
  description?: string;
}

interface Props {
  data: {
    anchor?: string;
    eyebrow?: string;
    title?: string;
    intro?: string;
    items?: Item[];
  };
}

/**
 * Positions set as pairs: "Ehrlichkeit statt Fassade" becomes the word that
 * counts and, quieter, what it replaces — one card each, on the stone band.
 */

const { data } = Astro.props;
const items = (data.items ?? []).map((item) => {
  const [keep, ...rest] = (item.title ?? '').split(' statt ');
  return { ...item, keep, instead: rest.join(' statt ') };
});
---

<Section id={data.anchor} ground="sand" defer>
  <SectionHead eyebrow={data.eyebrow} title={data.title} titleHtml lead={data.intro} size="display-2" />

  {items.length > 0 && (
    <ul role="list" class="mt-group grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <li class:list={[card, 'reveal grid content-start gap-2 p-6']}>
          <h3 class="text-2xl text-fg">
            {item.keep}{' '}
            {item.instead && (
              <span class="block font-sans text-sm font-normal text-fg-muted">statt {item.instead}</span>
            )}
          </h3>
          {item.description && <p class="text-base text-fg-soft">{item.description}</p>}
        </li>
      ))}
    </ul>
  )}
</Section>
