---
import type { EventDTO } from '@lib/types';
import { escapeHtml } from '@lib/server/format';

interface Props {
  event: EventDTO;
}

/**
 * Whatever Markus wrote about this particular evening, in the admin.
 *
 * That text is the whole point of the section, so it is the whole of the
 * section: the invented pull quote ("»Gemeinsam wachsen, einander stärken«")
 * that used to sit beside it inside three concentric rings is gone — nobody
 * said it, and it competed with the words that someone actually wrote.
 *
 * Renders nothing when the evening has no description.
 */

const { event } = Astro.props;

// Plain-text description → HTML with hard line breaks (matches admin input).
const description = event.description?.trim() ?? '';
const descriptionHtml = escapeHtml(description).replace(/\r\n|\r|\n/g, '<br />');
---

{
  description && (
    <section class="section section--ruled event-about-section" aria-labelledby="ueber-den-abend">
      <div class="container">
        <div class="spine">
          <h2 class="rail-heading" id="ueber-den-abend">
            Zu diesem Abend
          </h2>

          <div class="event-about__text spine__body" data-reveal="up" set:html={descriptionHtml} />
        </div>
      </div>
    </section>
  )
}

<style is:global>
  @layer sections {
    .event-about__text {
      font-size: var(--text-section-body-lg);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
      text-wrap: pretty;
    }
  }
</style>
