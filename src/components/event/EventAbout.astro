---
import type { EventDTO } from '@lib/types';
import { escapeHtml } from '@lib/server/format';

interface Props {
  event: EventDTO;
}

/** The admin's own text about this event, and nothing else. Renders nothing when the event has no description. */

const { event } = Astro.props;

// Plain text to HTML with hard line breaks, matching the admin input.
const description = event.description?.trim() ?? '';
const descriptionHtml = escapeHtml(description).replace(/\r\n|\r|\n/g, '<br />');
---

{description && (
  <div class="reveal px-1">
    <h2 id="ueber-den-abend" class="mb-3 text-2xl text-fg">
      Zu diesem Abend
    </h2>
    <p class="max-w-measure text-lg text-fg-soft" set:html={descriptionHtml} />
  </div>
)}
