---
import type { EventDTO } from '@lib/types';
import { escapeHtml } from '@lib/server/format';
import Split from '../ui/Split.astro';

interface Props {
  event: EventDTO;
}

/** The admin's own text about this event, and nothing else: a head beside the text. Renders nothing when the event has no description. */

const { event } = Astro.props;

// Plain text to HTML with hard line breaks, matching the admin input.
const description = event.description?.trim() ?? '';
const descriptionHtml = escapeHtml(description).replace(/\r\n|\r|\n/g, '<br />');
---

{description && (
  <Split class="reveal">
    <h2 slot="head" id="ueber-den-abend" class="text-display-3 text-fg">
      Zu diesem <em>Abend</em>
    </h2>
    <p class="max-w-measure text-lg leading-[1.9] text-fg-soft" set:html={descriptionHtml} />
  </Split>
)}
