---
import type { EventDTO } from '@lib/types';
import { escapeHtml } from '@lib/server/format';

interface Props {
  event: EventDTO;
}

const { event } = Astro.props;

// Plain-text description → HTML with hard line breaks (matches admin input).
const descriptionHtml = escapeHtml(event.description).replace(/\r\n|\r|\n/g, '<br />');
---

<section class="event-about-section">
  <div class="event-about__layout">
    <div class="event-about__content" data-reveal-group="100">
      <p class="eyebrow" data-reveal="up">Über das Treffen</p>
      <h2 class="section-title section-title--lg event-about__title" data-reveal="blur">
        Ein Raum für <br /><span class="text-italic">echte Begegnung</span>
      </h2>
      <div class="event-about__text" data-reveal="up" set:html={descriptionHtml} />
    </div>
    <div class="event-about__visual">
      <div class="event-about__quote-area">
        <div class="event-about__circles" aria-hidden="true">
          <div class="event-about__circle event-about__circle--1"></div>
          <div class="event-about__circle event-about__circle--2"></div>
          <div class="event-about__circle event-about__circle--3"></div>
        </div>
        <p class="event-about__quote" data-reveal="zoom">
          »Gemeinsam<br />
          <span class="text-italic">wachsen</span>,<br />
          einander<br />
          <span class="text-italic">stärken</span>«
        </p>
      </div>
    </div>
  </div>
</section>

<style is:global>
  @layer sections {
    .event-about-section {
      background: var(--bg-primary);
      overflow: hidden;
    }

    .event-about__layout {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      min-block-size: 80vh;
    }

    @media (width <= 1000px) {
      .event-about__layout {
        grid-template-columns: 1fr;
        min-block-size: auto;
      }
    }

    .event-about__content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: var(--space-xl) var(--space-lg);
      padding-inline-end: var(--space-xl);
    }

    @media (width <= 1000px) {
      .event-about__content {
        order: 2;
        padding: var(--space-xl) var(--space-md);
      }
    }

    .event-about__title {
      max-inline-size: var(--content-max-wide);
    }

    .event-about__text {
      max-inline-size: var(--content-max-text);
      color: var(--text-secondary);
      font-size: var(--text-section-body-lg);
      line-height: var(--leading-relaxed);
    }

    .event-about__text p {
      margin-block-end: 1em;
    }

    .event-about__visual {
      display: flex;
      position: relative;
      justify-content: center;
      align-items: center;
      background: var(--bg-section-alt);
      overflow: hidden;
    }

    @media (width <= 1000px) {
      .event-about__visual {
        order: 1;
        min-block-size: 50vh;
      }
    }

    .event-about__quote-area {
      --_surface-noise-opacity: 0.05;
      display: flex;

      position: absolute;
      justify-content: center;
      align-items: center;
      inset: 0;
      overflow: hidden;
    }

    .event-about__circles {
      opacity: 0.2;
    }

    .event-about__circle--1 {
      animation: breathe 20s var(--ease-ambient) infinite;
      inset-block-start: -20%;
      inset-inline-start: -20%;
      inline-size: 140%;
      block-size: 140%;
    }

    .event-about__circle--2 {
      transform: translate(-50%, -50%);
      animation: breathe-slow 28s var(--ease-ambient) infinite -5s;
      inset-block-start: 50%;
      inset-inline-start: 50%;
      aspect-ratio: 1 / 1;
      inline-size: 80%;
    }

    .event-about__circle--3 {
      animation: breathe 24s var(--ease-ambient) infinite -10s;
      inset-block-end: -10%;
      inset-inline-end: -10%;
      aspect-ratio: 1 / 1;
      inline-size: 50%;
    }

    .event-about__quote {
      position: relative;
      z-index: 1;
      margin-block-end: 0;
      max-inline-size: 500px;
      color: var(--text-on-dark);
      font-style: italic;
      font-size: clamp(2rem, 4vw, 3.5rem);
      line-height: 1.3;
      font-family: var(--font-display);
      text-align: center;
    }

    .event-about__quote .text-italic {
      color: var(--accent-secondary);
    }
  }
</style>
