---
import { isoDay } from '@lib/server/format';
import type { EventDTO } from '@lib/types';

import Container from '../ui/Container.astro';

interface Props {
  event: EventDTO;
  /** The intro's date line and hours, word for word: they mark where the intro's own elements land. */
  dateLabel: string;
  hours: string;
}

const { event, dateLabel, hours } = Astro.props;
const isCircleTitle = event.title.trim().toLocaleLowerCase('de') === 'männerkreis';
---

{/* A visual continuation of the existing heading, never a second heading or focus target. */}
<div
  data-event-dock
  hidden
  aria-hidden="true"
  class="pointer-events-none fixed inset-x-0 top-header z-30 overflow-clip text-fg print:hidden"
>
  <div data-event-dock-ground class="absolute inset-0 border-b border-line bg-ground"></div>
  <Container class="relative flex min-h-14 items-center justify-between gap-4 py-2">
    <p data-event-dock-title class="min-w-0 truncate text-sub leading-[1.02] font-medium tracking-[-0.065em]">
      {isCircleTitle ? (
        <span>
          Männer<span class="font-serif font-normal tracking-[-0.035em] text-accent italic">kreis</span>
        </span>
      ) : (
        <span class="font-serif font-normal tracking-normal italic">{event.title}</span>
      )}
    </p>
    <p class="shrink-0 text-right text-xs leading-snug sm:text-sm">
      <time data-event-dock-date datetime={isoDay(event.event_date)} class="inline-block text-fg">
        {dateLabel}
      </time>
      {hours && (
        <span data-event-dock-hours class="mt-0.5 block text-fg-muted sm:mt-0 sm:ml-5 sm:inline-block">
          {hours}
        </span>
      )}
    </p>
  </Container>
</div>

<script>
  /**
   * The intro's date, hours and title morph into the dock as the page scrolls, one
   * after the other, on one scroll timeline (the browser runs it, no scroll
   * handler): each element moves and shrinks onto its place in the dock and stays
   * pinned there, so there is never a second copy to hand over to. The dock's own
   * copies are only the fallback: without scroll timelines, with reduced motion or
   * for a title that wraps, they simply appear once the title has left.
   */
  const dock = document.querySelector<HTMLElement>('[data-event-dock]');
  const title = document.querySelector<HTMLElement>('[data-event-title]');

  interface Box {
    top: number;
    left: number;
    width: number;
    height: number;
  }

  /** Layout position at scroll 0, unaffected by transforms (the fixed dock is its own origin). */
  function pageBox(element: HTMLElement): Box {
    let top = 0;
    let left = 0;

    for (let node: HTMLElement | null = element; node; node = node.offsetParent as HTMLElement | null) {
      top += node.offsetTop;
      left += node.offsetLeft;
    }

    return { top, left, width: element.offsetWidth, height: element.offsetHeight };
  }

  const fontSize = (element: HTMLElement) => parseFloat(getComputedStyle(element).fontSize);

  if (dock && title) {
    const ground = dock.querySelector<HTMLElement>('[data-event-dock-ground]')!;
    const dockTitle = dock.querySelector<HTMLElement>('[data-event-dock-title]')!;

    const pieces: [HTMLElement | null, HTMLElement | null, number, number][] = [
      // [intro element, its place in the dock, start, end] as fractions of the flight.
      // The hours go first, so the date never crosses them on its way right.
      [document.querySelector('[data-event-hours]'), dock.querySelector('[data-event-dock-hours]'), 0, 0.45],
      [document.querySelector('[data-event-date]'), dock.querySelector('[data-event-dock-date]'), 0.15, 0.75],
      [title, dockTitle, 0, 1],
    ];

    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const supported = typeof ScrollTimeline !== 'undefined';
    let animations: Animation[] = [];
    let observer: IntersectionObserver | undefined;

    const visible = [{ opacity: 0 }, { opacity: 1 }];

    function reset() {
      animations.forEach((animation) => animation.cancel());
      animations = [];
      observer?.disconnect();
      pieces.forEach(([, twin]) => twin?.style.removeProperty('visibility'));
    }

    /** The plain dock: shown once the title has passed under the bar. */
    function staticDock(headerBottom: number) {
      observer = new IntersectionObserver(
        ([entry]) => {
          dock!.hidden = entry.boundingClientRect.bottom > headerBottom;
        },
        { rootMargin: `-${headerBottom}px 0px 0px 0px` },
      );
      observer.observe(title!);
    }

    function setup() {
      reset();
      dock!.hidden = false;

      const dockBox = pageBox(dock!);
      const headerBottom = dockBox.top;

      if (reducedMotion.matches || !supported) {
        dock!.hidden = true;
        staticDock(headerBottom);

        return;
      }

      const titleBox = pageBox(title!);
      const dockBottom = dockBox.top + dockBox.height;
      // The flight ends as the title's own space has scrolled up to the dock.
      const flight = Math.max(titleBox.top + titleBox.height - dockBottom, 160);
      // The content under the title must not show through before the ground is in.
      const next = title!.nextElementSibling as HTMLElement | null;
      const arrival = next ? Math.max(pageBox(next).top - dockBottom, 1) : flight;
      // Past the flight a piece moves down exactly as far as the page scrolls up: it rests in the dock.
      const pinned = Math.max(document.documentElement.scrollHeight, flight) * 4;
      const timeline = new ScrollTimeline({ source: document.documentElement, axis: 'block' });

      const range = (start: number, end: number): KeyframeAnimationOptions => ({
        timeline,
        rangeStart: `${Math.round(start)}px`,
        rangeEnd: `${Math.round(end)}px`,
        fill: 'both',
      });

      // A title that wraps cannot land on one truncated line; it scrolls away and the dock's copy fades in.
      const titleFlies = titleBox.height < fontSize(title!) * 1.6;

      for (const [piece, twin, from, to] of pieces) {
        if (!piece || !twin) continue;

        if (piece === title && !titleFlies) {
          animations.push(twin.animate(visible, range(flight * 0.6, flight)));
          continue;
        }

        const start = Math.round(from * flight);
        const end = Math.round(to * flight);
        const a = pageBox(piece);
        const b = pageBox(twin);
        const scale = fontSize(twin) / fontSize(piece);
        // Where the piece must sit, relative to its own place, when the page has scrolled `end`.
        const x = Math.round(b.left - a.left);
        const y = Math.round(b.top + (b.height - a.height * scale) / 2 + end - a.top);
        const landed = (end - start) / (pinned - start);

        twin.style.visibility = 'hidden';
        animations.push(
          piece.animate(
            [
              { translate: '0 0', scale: '1' },
              { translate: `${x}px ${y}px`, scale: `${scale}`, offset: landed },
              { translate: `${x}px ${y + pinned - end}px`, scale: `${scale}` },
            ],
            range(start, pinned),
          ),
        );
      }

      animations.push(
        ground.animate({ opacity: [0, 1] }, range(Math.min(arrival, flight) * 0.7, Math.min(arrival, flight))),
      );
    }

    let frame = 0;

    const schedule = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(setup);
    };

    setup();
    // Widths change once the web fonts are in, and with the window. A phone's
    // toolbar changes only the height while scrolling: that needs no new flight.
    let width = innerWidth;

    void document.fonts.ready.then(schedule);
    addEventListener('resize', () => {
      if (innerWidth === width) return;

      width = innerWidth;
      schedule();
    });
    reducedMotion.addEventListener('change', schedule);
  }
</script>
