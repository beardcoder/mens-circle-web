---
import type { EventDTO } from '@lib/shared/dto';
import { eventDay } from '@lib/shared/time';
import { accentLastWord } from '@lib/shared/words';

import Container from '../ui/Container.astro';

interface Props {
  event: EventDTO;
  /** The intro's date line and hours, word for word. */
  dateLabel: string;
  hours: string;
}

const { event, dateLabel, hours } = Astro.props;
const title = accentLastWord(event.title);
---

{/* A visual continuation of the existing heading, never a second heading or focus target. */}
<div
  data-event-dock
  hidden
  aria-hidden="true"
  class="pointer-events-none fixed inset-x-0 top-header z-30 -translate-y-2 overflow-clip text-fg opacity-0 transition-[opacity,translate] duration-300 ease-out print:hidden data-visible:translate-y-0 data-visible:opacity-100 motion-reduce:transition-none"
>
  <div data-event-dock-ground class="absolute inset-0 border-b border-line bg-ground/88 backdrop-blur-xl"></div>
  <Container class="relative flex min-h-14 items-center justify-between gap-4 py-2">
    <p data-event-dock-title class="min-w-0 truncate font-display text-sub leading-[1.02] tracking-[-0.045em]">
      <span>
        {title.lead}
        {title.accent && <span class="text-accent">{` ${title.accent}`}</span>}
      </span>
    </p>
    <p class="shrink-0 text-right text-xs leading-snug sm:text-sm">
      <time data-event-dock-date datetime={eventDay(event.event_date)} class="inline-block text-fg">
        {dateLabel}
      </time>
      {hours && (
        <span data-event-dock-hours class="mt-0.5 block text-fg-muted sm:mt-0 sm:ml-5 sm:inline-block">
          {hours}
        </span>
      )}
    </p>
  </Container>
</div>
<script>
  /**
   * The dock appears once the title has passed under the bar and leaves when it
   * comes back: one observer on the title, an attribute on the dock, and CSS fades
   * and slides it (opacity and translation only). No layout reads, no copies.
   */
  const dock = document.querySelector<HTMLElement>('[data-event-dock]');
  const title = document.querySelector<HTMLElement>('[data-event-title]');

  if (dock && title) {
    dock.hidden = false;
    new IntersectionObserver(
      ([entry]) => dock.toggleAttribute('data-visible', !entry.isIntersecting && entry.boundingClientRect.top < 0),
      // The bar is 72px (--spacing-header): the title counts as gone once it is under it.
      { rootMargin: '-72px 0px 0px 0px' },
    ).observe(title);
  }
</script>
