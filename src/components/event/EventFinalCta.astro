---
import type { EventDTO } from '@lib/types';

interface Props {
  event: EventDTO;
}

/**
 * The page's exit.
 *
 * For an upcoming evening this is not a second call to action — the form is a
 * screen above and repeating "Melde dich jetzt an" under it would just be the
 * same button twice. It points at the things someone might still want to read.
 * For a past evening it is the one place to leave a way forward.
 */

const { event } = Astro.props;
---

<section class="section section--ruled event-cta-section" aria-labelledby="weiter-title">
  <div class="container">
    <div class="spine">
      <h2 class="rail-heading" id="weiter-title">Weiter</h2>

      <ul class="event-cta__list spine__body--wide" role="list">
        {
          event.is_past && (
            <li>
              <a href="/#termine">Bei neuen Terminen benachrichtigen</a>
            </li>
          )
        }
        <li>
          <a href="/event">Alle Termine</a>
        </li>
        <li>
          <a href="/#ueber">Worum es an so einem Abend geht</a>
        </li>
        <li>
          <a href="/warum-ich-den-maennerkreis-leite">Warum ich den Männerkreis leite</a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style is:global>
  @layer sections {
    .event-cta__list {
      padding: 0;
      margin: 0;
      list-style: none;
      border-block-start: 1px solid var(--border-light);
    }

    .event-cta__list li {
      border-block-end: 1px solid var(--border-light);
    }

    .event-cta__list a {
      display: flex;
      align-items: center;
      min-block-size: 44px;
      padding-block: var(--space-xs);
      font-family: var(--font-display);
      font-size: var(--text-lg);
      color: var(--text-primary);
      transition: color var(--motion-quick);
    }

    .event-cta__list a:hover,
    .event-cta__list a:focus-visible {
      color: var(--accent-text);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }
</style>
