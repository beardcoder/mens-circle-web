---
import type { EventDTO } from '@lib/types';

interface Props {
  event: EventDTO;
}

/** The page's exit. */

const { event } = Astro.props;
---

<section class="section section--ruled event-cta-section" aria-labelledby="weiter-title">
  <div class="container">
    <div class="spine">
      <h2 class="rail-heading" id="weiter-title">
        Weiter
      </h2>

      <ul class="event-cta__list spine__body--wide" role="list">
        {event.is_past && (
          <li>
            <a href="/#termine">Bei neuen Terminen benachrichtigen</a>
          </li>
        )}
        <li>
          <a href="/event">Alle Termine</a>
        </li>
        <li>
          <a href="/#ueber">Worum es an so einem Abend geht</a>
        </li>
        <li>
          <a href="/warum-ich-den-maennerkreis-leite">Warum ich den Männerkreis leite</a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style is:global>
  @layer sections {
    .event-cta__list {
      padding: 0;
      margin: 0;
      list-style: none;
      border-block-start: 1px solid var(--border-light);
    }

    .event-cta__list li {
      border-block-end: 1px solid var(--border-light);
    }

    .event-cta__list a {
      display: flex;
      gap: var(--space-sm);
      align-items: center;
      justify-content: space-between;
      min-block-size: 44px;
      padding-block: var(--space-sm);
      font-family: var(--font-display);
      font-size: var(--text-2xl);
      line-height: 1.2;
      color: var(--text-primary);
      transition: color var(--motion-quick);
    }

    .event-cta__list a::after {
      flex: none;
      inline-size: 1.4rem;
      block-size: 1.4rem;
      content: '';
      background-color: var(--accent);
      mask: var(--arrow-icon) center / contain no-repeat;
      transition: translate var(--motion-standard);
    }

    .event-cta__list a:hover,
    .event-cta__list a:focus-visible {
      color: var(--accent);
    }

    .event-cta__list a:hover::after {
      translate: 0.35rem 0;
    }
  }
</style>
