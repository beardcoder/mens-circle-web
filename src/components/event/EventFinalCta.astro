---
import type { EventDTO } from '@lib/types';

import LinkList from '../ui/LinkList.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Split from '../ui/Split.astro';

interface Props {
  event: EventDTO;
}

/** The page's exit, as a compact band: where someone who has read the date goes next. */

const { event } = Astro.props;

const items = [
  ...(event.is_past ? [{ href: '/event#benachrichtigung', title: 'Termine per E-Mail erhalten' }] : []),
  { href: '/event', title: 'Alle Termine' },
  { href: '/#ueber', title: 'Worum es an so einem Abend geht' },
  { href: '/warum-ich-den-maennerkreis-leite', title: 'Warum ich den Männerkreis leite', prefetch: true },
];
---

<Section ground="alt" space="band" labelledby="weiter-title">
  <Split>
    <SectionHead slot="head" eyebrow="Weiter" title="Wohin als Nächstes" titleId="weiter-title" size="sub" />
    <LinkList items={items} />
  </Split>
</Section>
