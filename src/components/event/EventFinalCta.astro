---
import type { EventDTO } from '@lib/types';

interface Props {
  event: EventDTO;
}

const { event } = Astro.props;
---

<section class="event-cta-section">
  <div class="event-cta__circles" aria-hidden="true">
    <div class="event-cta__circle event-cta__circle--1"></div>
    <div class="event-cta__circle event-cta__circle--2"></div>
  </div>
  <div class="container">
    <div class="event-cta__content" data-reveal-group="100">
      {
        event.is_past ? (
          <>
            <p class="eyebrow" data-reveal="up">
              Interesse geweckt?
            </p>
            <h2 class="section-title event-cta__title" data-reveal="blur">
              Bleib <span class="text-italic">informiert</span>
            </h2>
            <a href="/#newsletter" class="btn btn--primary btn--large" data-reveal="up">
              Newsletter abonnieren
            </a>
          </>
        ) : (
          <>
            <p class="eyebrow" data-reveal="up">
              Bereit?
            </p>
            <h2 class="section-title event-cta__title" data-reveal="blur">
              Melde dich <span class="text-italic">jetzt</span> an
            </h2>
            <a href="#anmeldung" class="btn btn--primary btn--large" data-reveal="up">
              Zur Anmeldung
            </a>
          </>
        )
      }
    </div>
  </div>
</section>

<style is:global>
  @layer sections {
    .event-cta-section {
      --_surface-noise-opacity: 0.03;

      position: relative;
      background: var(--bg-dark);
      padding: var(--space-2xl) 0;
      overflow: hidden;
      color: var(--text-on-dark);
      text-align: center;
    }

    .event-cta__circles {
      opacity: 0.15;
    }

    .event-cta__circle--1 {
      transform: translate(-50%, -50%);
      animation: breathe 22s var(--ease-ambient) infinite;
      inset-block-start: 50%;
      inset-inline-start: 50%;
      inline-size: 70vw;
      block-size: 70vw;
    }

    .event-cta__circle--2 {
      transform: translate(-50%, -50%);
      animation: breathe-slow 30s var(--ease-ambient) infinite -5s;
      inset-block-start: 50%;
      inset-inline-start: 50%;
      inline-size: 50vw;
      block-size: 50vw;
    }

    .event-cta__content {
      display: flex;
      position: relative;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 1;
    }

    .event-cta__title {
      margin-block-end: var(--space-lg);
      color: var(--text-on-dark);
    }

    .event-register__form .form-label-optional,
    .event-register__form .form-helper,
    .event-register__form .form-checkbox span {
      opacity: 0.7;
      color: var(--color-sand);
    }
  }
</style>
