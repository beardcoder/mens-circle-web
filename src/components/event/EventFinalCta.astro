---
import type { EventDTO } from '@lib/types';

interface Props {
  event: EventDTO;
}

/** The page's exit. */

const { event } = Astro.props;
---

<section class="section section--ruled event-cta-section" aria-labelledby="weiter-title">
  <div class="container">
    <h2 class="event-cta__title" id="weiter-title">
      Weiterlesen
    </h2>

    <ul class="doors" role="list">
      {event.is_past && (
        <li>
          <a class="doors__link" href="/#termine">
            <span class="doors__title">Benachrichtigt werden</span>
            <span class="doors__text">Eine kurze Nachricht, sobald der nächste Abend feststeht.</span>
          </a>
        </li>
      )}
      <li>
        <a class="doors__link" href="/event">
          <span class="doors__title">Alle Termine</span>
          <span class="doors__text">Der aktuelle Stand und die Benachrichtigung.</span>
        </a>
      </li>
      <li>
        <a class="doors__link" href="/#ueber">
          <span class="doors__title">Worum es an einem Abend geht</span>
          <span class="doors__text">Was im Kreis passiert und was dort gilt.</span>
        </a>
      </li>
      <li>
        <a class="doors__link" href="/warum-ich-den-maennerkreis-leite">
          <span class="doors__title">Warum ich den Kreis leite</span>
          <span class="doors__text">Ein persönlicher Text von Markus.</span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style is:global>
  @layer sections {
    .event-cta__title {
      margin-block-end: var(--space-lg);
      font-size: var(--step-3);
    }
  }
</style>
