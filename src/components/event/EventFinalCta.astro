---
import type { EventDTO } from '@lib/types';
import LinkList from '../ui/LinkList.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Split from '../ui/Split.astro';

interface Props {
  event: EventDTO;
  ground?: 'default' | 'sand';
}

/** The page's exit: where someone who has read the date goes next. */

const { event, ground = 'default' } = Astro.props;

const items = [
  ...(event.is_past ? [{ href: '/event#benachrichtigung', title: 'Bei neuen Terminen benachrichtigen' }] : []),
  { href: '/event', title: 'Alle Termine' },
  { href: '/#ueber', title: 'Worum es an so einem Abend geht' },
  { href: '/warum-ich-den-maennerkreis-leite', title: 'Warum ich den Männerkreis leite', prefetch: true },
];
---

<Section ground={ground} labelledby="weiter-title" defer>
  <Split>
    <SectionHead
      slot="head"
      eyebrow="Weiter"
      title="Wohin als Nächstes"
      titleEmphasis="Nächstes"
      titleId="weiter-title"
    />
    <LinkList items={items} />
  </Split>
</Section>
