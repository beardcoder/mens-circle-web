---
import type { EventDTO } from '@lib/types';
import { formatDayMonthYearDE, formatWeekdayDE, isoDay, timeRange } from '@lib/server/format';
import HeroFrame from '../HeroFrame.astro';
import SeatMeter from '../SeatMeter.astro';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  event: EventDTO;
}

/**
 * The opening of a single event's page, on the dark frame: the date set large as
 * the title (the weekday in the italic accent), time, place and fee as one line
 * parted by dots (stacked on phones), the action; the seats beside it, open on
 * the dark ground behind a hairline.
 */

const { event } = Astro.props;
const dateOnly = isoDay(event.event_date);
const weekday = formatWeekdayDE(event.event_date);
const dayMonthYear = formatDayMonthYearDE(event.event_date);
const time = timeRange(event.start_time, event.end_time);
const taken = Math.max(0, event.max_participants - event.available_spots);
const seatsLabel = event.is_full
  ? `Alle ${event.max_participants} Plätze vergeben`
  : `${event.available_spots} von ${event.max_participants} Plätzen frei`;
const meta = [time, event.location, event.cost_basis, 'Ohne Vorerfahrung'].filter(Boolean);
---

<HeroFrame height="tall" innerClass="grid items-end gap-x-grid gap-y-12 lg:grid-cols-12">
  <div class="grid justify-items-start gap-6 lg:col-span-8">
    <Eyebrow class="entrance:animate-fade-in-up">
      {event.is_past ? 'Vergangenes Treffen' : 'Männerkreis · Nächstes Treffen'}
    </Eyebrow>

    <h1 class="text-display-2 text-bone entrance:animate-fade-in-up entrance:animate-delay-80">
      <time datetime={dateOnly}>
        <em>{weekday},</em>
        <br />
        {dayMonthYear}
      </time>
    </h1>

    <ul
      role="list"
      class="flex flex-wrap items-center gap-x-4 gap-y-2 text-base text-sand max-sm:flex-col max-sm:items-start entrance:animate-fade-in-up entrance:animate-delay-160"
    >
      {meta.map((item) => (
        <li class="flex items-center gap-4 sm:not-first:before:size-1 sm:not-first:before:rounded-full sm:not-first:before:bg-fill">
          {item}
        </li>
      ))}
    </ul>

    {!event.is_past && (
      <Button
        href="#anmeldung"
        size="lg"
        class="mt-2 entrance:animate-fade-in-up entrance:animate-delay-240 max-sm:w-full"
      >
        {event.is_full ? 'Zur Warteliste' : 'Jetzt anmelden'}
      </Button>
    )}
  </div>

  {!event.is_past && (
    /* The seats stand open on the dark ground, set off by a hairline (above them on
       phones, beside them from `lg`): the count large, the fields under it. */
    <figure class="grid content-end gap-5 border-line-strong entrance:animate-fade-in-up entrance:animate-delay-320 max-lg:border-t max-lg:pt-8 lg:col-span-4 lg:col-start-9 lg:border-l lg:pl-10">
      <Eyebrow as="span">Plätze</Eyebrow>
      <figcaption class="grid gap-2">
        {event.is_full ? (
          <span class="font-serif text-display-3 text-bone">Ausgebucht</span>
        ) : (
          <span class="flex items-baseline gap-3 font-serif text-bone">
            <span class="text-display-2">{event.available_spots}</span>
            <span class="text-2xl text-sand">von {event.max_participants} frei</span>
          </span>
        )}
        <span class="text-sm text-sand">
          {event.is_full
            ? 'Warteliste möglich: Wird ein Platz frei, rückst du nach.'
            : 'Gefüllte Felder sind vergebene Plätze.'}
        </span>
      </figcaption>
      <SeatMeter seats={event.max_participants} taken={taken} label={seatsLabel} size="lg" />
    </figure>
  )}
</HeroFrame>
