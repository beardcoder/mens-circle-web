---
import type { EventDTO } from '@lib/types';
import { formatDayMonthYearDE, formatWeekdayDE, isoDay, timeRange } from '@lib/server/format';
import SeatCircle from '../SeatCircle.astro';

interface Props {
  event: EventDTO;
}

/** The opening of a single event's page, set like the flyer: the date in orange capitals, then time and place. */

const { event } = Astro.props;
const dateOnly = isoDay(event.event_date);
const weekday = formatWeekdayDE(event.event_date);
const dayMonthYear = formatDayMonthYearDE(event.event_date);
const time = timeRange(event.start_time, event.end_time);
const taken = Math.max(0, event.max_participants - event.available_spots);
const seatsLabel = event.is_full
  ? `Alle ${event.max_participants} Plätze vergeben`
  : `${event.available_spots} von ${event.max_participants} Plätzen frei`;
---

<section class="hero event-hero surface-night">
  <div class="container event-hero__grid">
    <div class="event-hero__copy">
      <p class="marker marker--plain hero__label">
        {event.is_past ? 'Vergangenes Treffen' : 'Männerkreis · Nächstes Treffen'}
      </p>

      <h1 class="event-hero__title">
        <time datetime={dateOnly}>
          <span class="sr-only">
            {weekday}, {dayMonthYear}
          </span>
          <span class="date-line event-hero__date" aria-hidden="true">
            {weekday.slice(0, 2)} · {dayMonthYear}
          </span>
        </time>
      </h1>

      <div class="event-hero__meta">
        {time && <p>{time}</p>}
        {event.location && <p>{event.location}</p>}
      </div>

      <p class="event-hero__facts">Ohne Vorerfahrung{event.cost_basis ? ` · ${event.cost_basis}` : ''}</p>

      {!event.is_past && (
        <p class="event-hero__cta">
          <a href="#anmeldung" class="btn btn--primary btn--large">
            {event.is_full ? 'Zur Warteliste' : 'Zur Anmeldung'}
          </a>
        </p>
      )}
    </div>

    {!event.is_past && (
      <figure class="event-hero__seats">
        <SeatCircle seats={event.max_participants} taken={taken} ember label={seatsLabel} />
        <figcaption>{seatsLabel}</figcaption>
      </figure>
    )}
  </div>
</section>

<style is:global>
  @layer sections {
    .event-hero__grid {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: var(--space-xl);
      align-items: center;
    }

    .event-hero__title {
      margin-block: var(--space-md);
      font-size: inherit;
      letter-spacing: normal;
    }

    .event-hero__date {
      display: block;
      font-size: clamp(2rem, 1rem + 4.2vw, 4.5rem);
      line-height: 1;
      letter-spacing: 0.02em;
    }

    .event-hero__meta p {
      margin: 0;
      font-size: var(--text-3xl);
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: -0.015em;
      color: var(--text-primary);
    }

    .event-hero__facts {
      max-inline-size: 30rem;
      padding-block-start: var(--space-sm);
      margin: var(--space-md) 0 0;
      font-size: var(--text-marker);
      font-weight: 500;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: var(--tracking-marker);
      border-block-start: 2px solid var(--accent);
    }

    .event-hero__cta {
      margin-block: var(--space-lg) 0;
    }

    .event-hero__seats {
      display: grid;
      gap: var(--space-sm);
      justify-items: center;
      margin: 0;
    }

    .event-hero__seats .seat-circle {
      inline-size: min(100%, 18rem);
    }

    .event-hero__seats figcaption {
      font-size: var(--text-lg);
      font-weight: 700;
      color: var(--text-secondary);
    }

    @media (prefers-reduced-motion: no-preference) {
      .event-hero__date,
      .event-hero__meta,
      .event-hero__cta,
      .event-hero__seats {
        animation: rise var(--duration-slow) var(--ease-settle) both;
      }

      .event-hero__meta,
      .event-hero__cta {
        animation-delay: var(--stagger-2);
      }

      .event-hero__seats {
        animation-delay: 200ms;
      }

      .vt-arrival :is(.event-hero__date, .event-hero__meta, .event-hero__cta, .event-hero__seats) {
        animation: none;
      }
    }

    @media (width <= 56em) {
      .event-hero__grid {
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-lg);
      }

      .event-hero__seats {
        grid-template-columns: 6rem minmax(0, 1fr);
        justify-items: start;
        align-items: center;
      }

      .event-hero__cta .btn {
        inline-size: 100%;
      }
    }
  }
</style>
