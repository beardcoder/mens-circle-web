---
import type { EventDTO } from '@lib/types';
import { formatDayMonthYearDE, formatWeekdayDE, isoDay, timeRange } from '@lib/server/format';
import SeatCircle from '../SeatCircle.astro';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Section from '../ui/Section.astro';

interface Props {
  event: EventDTO;
}

/** The opening of a single event's page, set like the flyer: the date in orange capitals, then time and place, the seats, the action. */

const { event } = Astro.props;
const dateOnly = isoDay(event.event_date);
const weekday = formatWeekdayDE(event.event_date);
const dayMonthYear = formatDayMonthYearDE(event.event_date);
const time = timeRange(event.start_time, event.end_time);
const taken = Math.max(0, event.max_participants - event.available_spots);
const seatsLabel = event.is_full
  ? `Alle ${event.max_participants} Plätze vergeben`
  : `${event.available_spots} von ${event.max_participants} Plätzen frei`;
---

<Section
  ground="night"
  space="none"
  class="pt-[calc(var(--spacing-header)+var(--spacing-group))] pb-section"
  innerClass="grid items-center gap-group lg:grid-cols-12 lg:gap-x-grid"
>
  <div class:list={['@container', event.is_past ? 'lg:col-span-12' : 'lg:col-span-8']}>
    <Eyebrow plain tone="fg" class="entrance:animate-rise">
      {event.is_past ? 'Vergangenes Treffen' : 'Männerkreis · Nächstes Treffen'}
    </Eyebrow>

    <h1 class="my-6">
      <time datetime={dateOnly}>
        <span class="sr-only">
          {weekday}, {dayMonthYear}
        </span>
        <span
          class="block font-sans text-[clamp(2.5rem,1.2rem+4.8vw,5.5rem)] leading-none font-bold tracking-[0.02em] text-accent uppercase entrance:animate-rise lg:text-[length:min(5.5rem,7cqi)]"
          aria-hidden="true"
        >
          {weekday.slice(0, 2)} · {dayMonthYear}
        </span>
      </time>
    </h1>

    <div class="text-3xl font-medium tracking-[-0.015em] text-fg entrance:animate-rise entrance:animate-delay-120">
      {time && <p>{time}</p>}
      {event.location && <p>{event.location}</p>}
    </div>

    <p class="mt-6 max-w-[30rem] border-t-2 border-accent pt-4 text-xs font-medium tracking-label text-fg-muted uppercase">
      Ohne Vorerfahrung{event.cost_basis ? ` · ${event.cost_basis}` : ''}
    </p>

    {!event.is_past && (
      <Button href="#anmeldung" size="lg" class="mt-8 entrance:animate-rise entrance:animate-delay-120 max-sm:w-full">
        {event.is_full ? 'Zur Warteliste' : 'Zur Anmeldung'}
      </Button>
    )}
  </div>

  {!event.is_past && (
    <figure class="grid grid-cols-[6rem_minmax(0,1fr)] items-center gap-4 entrance:animate-rise entrance:animate-delay-200 lg:col-span-3 lg:col-start-10 lg:grid-cols-1 lg:justify-items-center">
      <SeatCircle
        seats={event.max_participants}
        taken={taken}
        ember
        label={seatsLabel}
        class="w-full lg:w-[min(100%,18rem)]"
      />
      <figcaption class="text-lg font-bold text-fg-soft">{seatsLabel}</figcaption>
    </figure>
  )}
</Section>
