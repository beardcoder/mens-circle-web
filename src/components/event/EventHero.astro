---
import type { EventDTO } from '@lib/types';
import { card } from '@lib/ui';
import { formatDayMonthYearDE, formatWeekdayDE, isoDay, timeRange } from '@lib/server/format';
import SeatCircle from '../SeatCircle.astro';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Section from '../ui/Section.astro';

interface Props {
  event: EventDTO;
}

/** The opening of a single event's page: the date as the title, time, place and fee as quiet chips, the seats beside it. */

const { event } = Astro.props;
const dateOnly = isoDay(event.event_date);
const weekday = formatWeekdayDE(event.event_date);
const dayMonthYear = formatDayMonthYearDE(event.event_date);
const time = timeRange(event.start_time, event.end_time);
const taken = Math.max(0, event.max_participants - event.available_spots);
const seatsLabel = event.is_full
  ? `Alle ${event.max_participants} Plätze vergeben`
  : `${event.available_spots} von ${event.max_participants} Plätzen frei`;
const chips = [time, event.location, event.cost_basis, 'Ohne Vorerfahrung'].filter(Boolean);
---

<Section
  space="none"
  class="pt-[calc(var(--spacing-header)+var(--spacing-group))] pb-group"
  innerClass="grid items-center gap-10 lg:grid-cols-12 lg:gap-x-grid"
>
  <div class="grid justify-items-start gap-5 lg:col-span-8">
    <Eyebrow class="entrance:animate-rise">
      {event.is_past ? 'Vergangenes Treffen' : 'Männerkreis · Nächstes Treffen'}
    </Eyebrow>

    <h1 class="text-display-2 text-fg entrance:animate-rise entrance:animate-delay-60">
      <time datetime={dateOnly}>
        {weekday},<br />
        {dayMonthYear}
      </time>
    </h1>

    <ul role="list" class="flex flex-wrap gap-2 entrance:animate-rise entrance:animate-delay-120">
      {chips.map((chip) => (
        <li class="rounded-full border border-line-strong bg-raised px-3.5 py-1.5 text-sm font-medium text-fg-soft">
          {chip}
        </li>
      ))}
    </ul>

    {!event.is_past && (
      <Button href="#anmeldung" size="lg" class="mt-3 entrance:animate-rise entrance:animate-delay-160 max-sm:w-full">
        {event.is_full ? 'Zur Warteliste' : 'Zur Anmeldung'}
      </Button>
    )}
  </div>

  {!event.is_past && (
    <figure
      class:list={[
        card,
        'flex items-center gap-5 p-6 entrance:animate-rise entrance:animate-delay-200 lg:col-span-4 lg:flex-col lg:p-8 lg:text-center',
      ]}
    >
      <SeatCircle
        seats={event.max_participants}
        taken={taken}
        ember
        label={seatsLabel}
        class="size-24 shrink-0 lg:size-40"
      />
      <figcaption class="grid gap-1">
        <span class="text-lg font-semibold text-fg">{seatsLabel}</span>
        <span class="text-sm text-fg-muted">
          {event.is_full ? 'Warteliste möglich' : 'Gefüllte Punkte sind vergebene Plätze.'}
        </span>
      </figcaption>
    </figure>
  )}
</Section>
