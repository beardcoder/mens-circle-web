---
import type { EventDTO } from '@lib/types';
import { formatDayMonthYearDE, formatWeekdayDE, toDate } from '@lib/server/format';

interface Props {
  event: EventDTO;
}

/**
 * The opening of a single event's page. The date is the heading, because the
 * date is what this page is. The event's own image is never painted behind it:
 * the text has to stay readable over whatever an admin uploaded.
 */

const { event } = Astro.props;
const dateOnly = toDate(event.event_date)?.toISOString().slice(0, 10) ?? '';
const weekday = formatWeekdayDE(event.event_date);
const dayMonthYear = formatDayMonthYearDE(event.event_date);
const timeRange = event.start_time ? `${event.start_time}${event.end_time ? `–${event.end_time}` : ''} Uhr` : '';
---

<section class="hero event-hero">
  <div class="container">
    <div class="hero__content">
      <p class="hero__label">{event.is_past ? 'Vergangenes Treffen' : 'Nächstes Treffen'}</p>

      <h1 class="hero__title">
        <time datetime={dateOnly}>{weekday}, {dayMonthYear}</time>
      </h1>

      <div class="hero__bottom">
        {
          /* Built as a string rather than as JSX fragments: the whitespace
            between elements in the template becomes real text nodes, which put
            gaps around the en dash of the time range. */
        }
        <p class="hero__meta">{[timeRange, event.location].filter(Boolean).join(' · ')}</p>

        {
          !event.is_past && (
            <span class="hero__cta">
              <a href="#anmeldung" class="btn btn--primary">
                {event.is_full ? 'Zur Warteliste' : 'Zur Anmeldung'}
              </a>
            </span>
          )
        }
      </div>
    </div>
  </div>
</section>
