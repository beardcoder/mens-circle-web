---
import type { EventData, EventDTO } from '@lib/types';
import { formatDayMonthYearDE, formatWeekdayDE, toDate } from '@lib/server/format';
import CalendarModal from '../islands/CalendarModal.svelte';

interface Props {
  event: EventDTO;
}

/**
 * The evening's facts, in the same hairline definition list the home page and
 * /event use — four "cards" with icons and a 16rem "TERMIN" watermark behind
 * them said nothing these four rows don't.
 *
 * Only rows with an actual value are rendered: an evening with no end time
 * should not print "bis  Uhr".
 */

const { event } = Astro.props;

// The EventData shape consumed by the add-to-calendar island. The event date is
// stored as an ISO timestamp; the calendar wants the plain calendar day.
const dateOnly = toDate(event.event_date)?.toISOString().slice(0, 10) ?? '';
const calendarData: EventData = {
  title: event.title,
  description: event.description,
  location: event.location,
  startDate: dateOnly,
  startTime: event.start_time,
  endDate: dateOnly,
  endTime: event.end_time,
};

const timeValue = event.start_time ? `${event.start_time}${event.end_time ? `–${event.end_time}` : ''} Uhr` : '';

const rows = [
  {
    label: 'Datum',
    value: `${formatWeekdayDE(event.event_date)}, ${formatDayMonthYearDE(event.event_date)}`,
    sub: '',
  },
  { label: 'Uhrzeit', value: timeValue, sub: '' },
  { label: 'Ort', value: event.location, sub: 'Die genaue Adresse bekommst du mit der Anmeldebestätigung.' },
  {
    label: 'Plätze',
    value: event.is_past
      ? `Maximal ${event.max_participants}`
      : event.is_full
        ? 'Ausgebucht – Warteliste möglich'
        : `${event.available_spots} von ${event.max_participants} frei`,
    sub: '',
  },
  { label: 'Beitrag', value: event.cost_basis, sub: '' },
].filter((row) => Boolean(row.value));
---

<section class="section section--ruled event-info-section" aria-labelledby="termin-fakten">
  <div class="container">
    <div class="spine">
      <h2 class="rail-heading" id="termin-fakten">Der Termin</h2>

      <div class="spine__body--wide">
        <dl class="deflist" data-reveal-group="55">
          {
            rows.map((row) => (
              <div class="deflist__row" data-reveal="up">
                <dt class="deflist__term">{row.label}</dt>
                <dd class="deflist__desc">
                  {row.value}
                  {row.sub && <span class="deflist__note">{row.sub}</span>}
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="event-info__calendar">
          <CalendarModal client:visible event={calendarData} />
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  @layer sections {
    .event-info__calendar {
      margin-block-start: var(--space-md);
    }
  }
</style>
