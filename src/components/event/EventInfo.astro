---
import type { EventData, EventDTO } from '@lib/types';
import { formatDayMonthYearDE, formatWeekdayDE, toDate } from '@lib/server/format';
import CalendarModal from '../islands/CalendarModal.svelte';

interface Props {
  event: EventDTO;
}

const { event } = Astro.props;

// The EventData shape consumed by the add-to-calendar island. The event date
// is stored as an ISO timestamp; the calendar wants the plain calendar day.
const dateOnly = toDate(event.event_date)?.toISOString().slice(0, 10) ?? '';
const calendarData: EventData = {
  title: event.title,
  description: event.description,
  location: event.location,
  startDate: dateOnly,
  startTime: event.start_time,
  endDate: dateOnly,
  endTime: event.end_time,
};

const cards = [
  {
    modifier: 'date',
    label: 'Datum',
    value: formatWeekdayDE(event.event_date),
    sub: formatDayMonthYearDE(event.event_date),
  },
  { modifier: 'time', label: 'Uhrzeit', value: `${event.start_time} Uhr`, sub: `bis ${event.end_time} Uhr` },
  { modifier: 'location', label: 'Ort', value: event.location, sub: 'Genaue Adresse nach Anmeldung' },
  { modifier: 'participants', label: 'Teilnehmer', value: `Max. ${event.max_participants}`, sub: event.cost_basis },
];
---

<section class="event-info-section">
  <div class="event-info__bg-text" aria-hidden="true">TERMIN</div>
  <div class="container">
    {/* Key facts as a definition list — each card is a term/definition pair. */}
    <dl class="event-info__grid" data-reveal-group="90">
      {
        cards.map((card) => (
          <div class:list={['event-info__card', `event-info__card--${card.modifier}`]} data-reveal="up">
            <dt class="event-info__card-label">{card.label}</dt>
            <dd class="event-info__card-value">
              {card.modifier === 'time' ? (
                <>
                  <time datetime={event.start_time}>{event.start_time}</time> Uhr
                </>
              ) : (
                card.value
              )}
            </dd>
            <dd class="event-info__card-sub">
              {card.modifier === 'date' ? <time datetime={dateOnly}>{card.sub}</time> : card.sub}
            </dd>
          </div>
        ))
      }
    </dl>

    <CalendarModal client:visible event={calendarData} />
  </div>
</section>

<style is:global>
  @layer sections {
    .event-info-section {
      position: relative;
      background: var(--bg-primary);
      padding: var(--space-2xl) 0;
      overflow: hidden;
    }

    .event-info__bg-text {
      position: absolute;
      transform: translateY(-50%);
      opacity: 0.25;
      inset-block-start: 50%;
      inset-inline-end: var(--space-md);
      pointer-events: none;
      color: var(--border-light);
      font-weight: 800;
      font-size: clamp(6rem, 18vw, 16rem);
      line-height: 0.8;
      font-family: var(--font-display);
      letter-spacing: 0.02em;
      white-space: nowrap;
    }

    @media (width <= 800px) {
      .event-info__bg-text {
        display: none;
      }
    }

    .event-info__grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      border-block-start: 1px solid var(--border-light);
      border-block-end: 1px solid var(--border-light);
    }

    @media (width <= 1000px) {
      .event-info__grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (width <= 600px) {
      .event-info__grid {
        grid-template-columns: 1fr;
      }
    }

    .event-info__card {
      position: relative;
      border-inline-end: 1px solid var(--border-light);
      padding: var(--space-lg);
      overflow: hidden;
    }

    .event-info__card:last-child {
      border-inline-end: none;
    }

    @media (width <= 1000px) {
      .event-info__card:nth-child(2n) {
        border-inline-end: none;
      }

      .event-info__card:nth-child(1),
      .event-info__card:nth-child(2) {
        border-block-end: 1px solid var(--border-light);
      }
    }

    @media (width <= 600px) {
      .event-info__card {
        border-inline-end: none;
        border-block-end: 1px solid var(--border-light);
      }

      .event-info__card:last-child {
        border-block-end: none;
      }
    }

    /* Decorative corner ring — a pseudo-element so the <dl> grid contains only
       valid dt/dd groups. */
    .event-info__card::before {
      position: absolute;
      opacity: 0.3;
      inset-block-start: -30%;
      inset-inline-end: -30%;
      pointer-events: none;
      content: '';
      border: 1px solid var(--border-light);
      border-radius: 50%;
      aspect-ratio: 1 / 1;
      inline-size: 60%;
    }

    .event-info__card-label {
      position: relative;
      margin-block-end: var(--space-xs);
      color: var(--text-secondary);
      font-weight: 600;
      font-size: var(--text-xs);
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    .event-info__card-value {
      margin-block-end: 0.25rem;
      color: var(--text-primary);
      font-weight: 600;
      font-size: clamp(1.5rem, 3vw, 2.25rem);
      line-height: 1.1;
      font-family: var(--font-display);

      /* Long German location names ("Gemeinschaftsraum …") must wrap inside the
         card, not clip at its overflow edge. */
      overflow-wrap: break-word;
      hyphens: auto;
    }

    .event-info__card-sub {
      color: var(--text-secondary);
      font-size: var(--text-body-compact);
    }

    .event-info__calendar {
      margin-block-start: var(--space-xl);
      text-align: center;
    }
  }
</style>
