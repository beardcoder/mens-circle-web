---
import { eventView, splitFee } from '@lib/event-status';
import { publicEvent } from '@lib/server/public-data';
import type { EventDTO } from '@lib/types';
import { link } from '@lib/ui';

import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import CalendarButton from './CalendarButton.astro';
import LiveSummary from './LiveSummary';

interface Props {
  event: EventDTO;
}

const { event } = Astro.props;
const view = eventView(event, 'Dieser Abend', false);
const [weekday, date] = view.title;
const [day, ...monthYear] = date.split(' ');
const hasPlace = !!(event.location || event.street || event.city);
---

<section
  aria-labelledby="event-title"
  class="event-opening pt-[calc(var(--spacing-header)+2rem)] pb-8 sm:pt-[calc(var(--spacing-header)+3rem)] lg:pb-12"
>
  <Container>
    <a href="/event" class={`${link} inline-flex min-h-11 items-center text-sm`}>
      Alle Termine
    </a>
    <div class="mt-5 grid items-start gap-x-grid gap-y-8 lg:mt-10 lg:grid-cols-12">
      <div class="min-w-0 lg:col-span-7">
        <p class="mb-4 text-sm text-fg-muted entrance:animate-rise">
          {event.is_past ? 'Ein vergangener Abend im Kreis' : 'Ein Abend im Kreis'}
        </p>
        <h1
          id="event-title"
          class="max-w-[12em] text-page text-fg sm:text-hero entrance:animate-rise entrance:animate-delay-90"
        >
          {event.title}
          {event.city && <span class="block">in {event.city}</span>}
        </h1>
        <p class="mt-6 max-w-[28em] text-lg text-fg-soft entrance:animate-rise entrance:animate-delay-180">
          {event.is_past
            ? 'Dieser Abend hat bereits stattgefunden. Bei den aktuellen Terminen findest du die nächsten Treffen.'
            : 'Zeit für ehrliche Gespräche unter Männern. Darüber, was dich im Alltag beschäftigt und was sonst oft unausgesprochen bleibt.'}
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-3 entrance:animate-rise entrance:animate-delay-260">
          {event.is_past ? (
            <Button href="/event" size="lg" class="max-sm:w-full">
              Aktuelle Termine ansehen
            </Button>
          ) : (
            <>
              <Button href="#anmeldung" size="lg" class="max-sm:w-full">
                {event.is_full ? 'Zur Warteliste' : 'Zur Anmeldung'}
              </Button>
              <CalendarButton event={event} />
            </>
          )}
        </div>
      </div>
      <div class="event-date-parallax min-w-0 lg:col-span-4 lg:col-start-9 lg:mt-14">
        <time
          datetime={view.datetime}
          class="flex items-center gap-5 border-t border-line pt-5 lg:block lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8 entrance:animate-rise entrance:animate-delay-180"
        >
          <span class="block font-serif text-[clamp(5rem,15vw,11rem)] leading-none tracking-display text-fg">
            {day}
          </span>
          <span class="block text-md text-fg-muted lg:mt-4">
            <span class="block text-fg">{monthYear.join(' ')}</span>
            <span class="block">{weekday.replace(',', '')}</span>
          </span>
        </time>
      </div>
    </div>
    <div class="mt-9 lg:mt-14">
      <LiveSummary
        client:load
        initial={publicEvent(event)}
        venue={event.location || event.city}
        feeNote={splitFee(event.cost_basis).note}
        hasPlace={hasPlace}
      />
    </div>
  </Container>
</section>
