---
import { Image } from 'astro:assets';

import { eventView } from '@lib/event-status';
import { timeRange } from '@lib/server/format';
import type { EventDTO } from '@lib/types';
import { link } from '@lib/ui';

import photo from '../../assets/images/markus-sommer.jpg';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import CalendarButton from './CalendarButton.astro';

interface Props {
  event: EventDTO;
}

const { event } = Astro.props;
const view = eventView(event, 'Dieser Abend', false);
const [weekday, date] = view.title;
const [day, ...monthYear] = date.split(' ');
const hasPlace = !!(event.location || event.street || event.city);
---

<section
  aria-labelledby="event-title"
  class="pt-[calc(var(--spacing-header)+1.5rem)] pb-0 sm:pb-8 lg:pt-[calc(var(--spacing-header)+3.5rem)] lg:pb-12"
>
  <Container class="grid items-start gap-x-grid gap-y-7 lg:grid-cols-12 lg:gap-y-0">
    <div class="min-w-0 lg:col-span-6 lg:pr-4">
      <time datetime={view.datetime} class="flex items-center gap-4 lg:gap-6">
        <span class="block shrink-0 font-serif text-[clamp(3.75rem,12vw,8rem)] leading-none tracking-display text-fg">
          {day}
        </span>
        <span class="block border-l border-line-strong pl-4 text-sm text-fg-muted lg:pl-6 lg:text-base">
          <span class="block text-fg">{monthYear.join(' ')}</span>
          <span class="block">
            {weekday.replace(',', '')}
            {event.start_time && ` · ${timeRange(event.start_time, event.end_time)}`}
          </span>
        </span>
      </time>
      <h1 id="event-title" class="mt-5 text-page text-fg lg:mt-9 lg:text-hero">
        <span class="block font-serif">{event.title}</span>
        {event.city && (
          <span class="mt-2 block text-xl font-normal tracking-normal lg:mt-4 lg:text-quote">in {event.city}</span>
        )}
      </h1>
      <p class="mt-4 max-w-[25em] text-md text-fg-soft lg:mt-7 lg:text-lg">
        {event.is_past
          ? 'Dieser Abend hat bereits stattgefunden. Bei den aktuellen Terminen findest du die nächsten Treffen.'
          : 'Ein Abend für das, was dich gerade beschäftigt. Mit Männern, die dir zuhören.'}
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm lg:mt-7 lg:text-base">
        <a href="#ueber-den-abend" class={`${link} inline-flex min-h-9 items-center`}>
          Was dich erwartet
        </a>
        {hasPlace && (
          <a href="#anfahrt" class={`${link} inline-flex min-h-9 items-center`}>
            Adresse &amp; Anfahrt
          </a>
        )}
      </div>
      {event.is_past && (
        <Button href="/event" class="mt-5">
          Aktuelle Termine ansehen
        </Button>
      )}
    </div>

    <div class="min-w-0 lg:col-span-5 lg:col-start-8 lg:row-span-2">
      <slot />
    </div>

    <div class="min-w-0 border-t border-line pt-6 pb-7 sm:pb-0 lg:col-span-6 lg:col-start-1 lg:row-start-2 lg:mt-10 lg:pt-8">
      <div class="mb-6 flex items-start gap-5">
        <Image
          data-event-portrait
          src={photo}
          alt="Markus Sommer, der den Männerkreis leitet"
          width={128}
          height={160}
          densities={[1, 2]}
          position="left"
          class="-mt-10 block h-28 w-22 shrink-0 object-cover lg:h-40 lg:w-32"
        />
        <div class="min-w-0">
          <p class="max-w-[22em] text-base text-fg">Ich halte den Rahmen, damit du in Ruhe sprechen kannst.</p>
          <a href="/warum-ich-den-maennerkreis-leite" class={`${link} mt-2 inline-flex min-h-9 items-center text-sm`}>
            Markus Sommer · Über mich
          </a>
        </div>
      </div>
      {event.location && (
        <p class="mb-5 max-w-measure text-sm text-fg-muted">
          Treffpunkt: <span class="text-fg">{event.location}</span>
        </p>
      )}
      {!event.is_past && <CalendarButton event={event} />}
    </div>
  </Container>
</section>

<script>
  // Morph only the portrait's mask. Its box and every reading/interaction target stay fixed.
  const portrait = document.querySelector<HTMLElement>('[data-event-portrait]');

  if (portrait && typeof ViewTimeline !== 'undefined') {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let morph: Animation | undefined;

    function updateMorph() {
      morph?.cancel();

      if (reducedMotion.matches) return;

      morph = portrait!.animate(
        { clipPath: ['inset(0 round 0%)', 'inset(0 round 50% 50% 8% 8%)'] },
        {
          timeline: new ViewTimeline({ subject: portrait!, axis: 'block' }),
          rangeStart: 'entry 0%',
          rangeEnd: 'cover 60%',
          fill: 'both',
        },
      );
    }

    updateMorph();
    reducedMotion.addEventListener('change', updateMorph);
  }
</script>
