---
import { eventView } from '@lib/event-status';
import type { EventDTO } from '@lib/types';

import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import CalendarButton from './CalendarButton.astro';
import EventSummary from './EventSummary.astro';

interface Props {
  event: EventDTO;
}

/**
 * The compact opening of one event's page, on the paper: the date as the title,
 * one line on what the evening is, the action (registration, waiting list — a
 * past date has none) and the calendar; beside it the same EventSummary as
 * everywhere: time, place, fee, seats.
 */

const { event } = Astro.props;
const view = eventView(event, 'Auf einen Blick', false);
const [weekday, dayMonthYear] = view.title;
---

<section aria-labelledby="event-title" class="pt-[calc(var(--spacing-header)+var(--spacing-group))] pb-group">
  <Container class="grid items-end gap-x-grid gap-y-10 lg:grid-cols-12">
    <div class="grid justify-items-start lg:col-span-7">
      <Eyebrow class="mb-3 entrance:animate-rise">
        {event.is_past ? 'Vergangenes Treffen' : 'Männerkreis · Nächstes Treffen'}
      </Eyebrow>
      <h1 id="event-title" class="max-w-[9.6em] text-page text-fg entrance:animate-rise entrance:animate-delay-[90ms]">
        <time datetime={view.datetime}>
          <span class="block">{weekday}</span>
          <span class="block">{dayMonthYear}</span>
        </time>
      </h1>
      <p class="mt-6 max-w-measure text-lg text-fg-muted entrance:animate-rise entrance:animate-delay-[180ms]">
        {event.is_past
          ? 'Dieser Abend hat bereits stattgefunden. Eine Anmeldung ist nicht mehr möglich.'
          : event.is_full
            ? 'Der Abend ist ausgebucht. Über die Warteliste rückst du nach, sobald ein Platz frei wird.'
            : 'Ein Abend im Kreis, ohne Vorerfahrung. Für die Anmeldung genügen Name und E-Mail-Adresse.'}
      </p>
      <div class="mt-8 flex w-full flex-wrap items-center gap-3 entrance:animate-rise entrance:animate-delay-[260ms]">
        {event.is_past ? (
          <Button href="/event" size="lg" class="max-sm:w-full">
            Aktuelle Termine ansehen
          </Button>
        ) : (
          <>
            <Button href="#anmeldung" size="lg" class="max-sm:w-full">
              {event.is_full ? 'Zur Warteliste' : 'Jetzt anmelden'}
            </Button>
            <CalendarButton event={event} />
          </>
        )}
      </div>
    </div>
    <div class="min-w-0 lg:col-span-5 lg:col-start-8 entrance:animate-rise entrance:animate-delay-[200ms]">
      <EventSummary view={view} showTitle={false} />
    </div>
  </Container>
</section>
