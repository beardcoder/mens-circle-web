---
import { eventView } from '@lib/event-status';
import { timeRange } from '@lib/server/format';
import type { EventDTO } from '@lib/types';
import { link } from '@lib/ui';

import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import CalendarButton from './CalendarButton.astro';
import EventDock from './EventDock.astro';

interface Props {
  event: EventDTO;
}

const { event } = Astro.props;
const view = eventView(event, 'Dieser Abend', false);
const dateLabel = view.title.join(' ');
const hours = timeRange(event.start_time, event.end_time);
const hasPlace = !!(event.location || event.street || event.city);
const isCircleTitle = event.title.trim().toLocaleLowerCase('de') === 'männerkreis';
---

{/* The date line and the title morph into the dock as the page scrolls (EventDock's script). */}
<section
  aria-labelledby="event-title"
  class="@container pt-[calc(var(--spacing-header)+1.25rem)] pb-band lg:pt-[calc(var(--spacing-header)+2.75rem)]"
>
  <Container>
    <div class="flex flex-wrap items-baseline justify-between gap-x-5 gap-y-1 border-t border-line pt-3 text-sm lg:pt-4">
      <time
        data-event-date
        datetime={view.datetime}
        class="relative z-31 inline-block origin-top-left text-fg print:opacity-100!"
      >
        {dateLabel}
      </time>
      {hours && (
        <p data-event-hours class="relative z-31 origin-top-left text-fg-muted print:opacity-100!">
          {hours}
        </p>
      )}
    </div>
    <h1
      id="event-title"
      data-event-title
      aria-label={event.title}
      class:list={[
        'relative z-31 mt-4 origin-top-left font-display tracking-[-0.045em] text-fg lg:mt-6 print:opacity-100!',
        isCircleTitle
          ? 'w-fit text-[clamp(2.75rem,14vw,13rem)] leading-[1.02] whitespace-nowrap'
          : 'text-page wrap-anywhere hyphens-auto lg:text-hero',
      ]}
    >
      {isCircleTitle ? (
        <span>
          <span class="inline-block">Männer</span>
          <span class="inline-block text-accent">kreis</span>
        </span>
      ) : (
        <span>{event.title}</span>
      )}
    </h1>

    <div class="mt-8 grid items-start gap-x-grid gap-y-8 lg:mt-14 lg:grid-cols-12">
      <div class="min-w-0 lg:col-span-6">
        {event.city && <p class="text-base text-fg-muted lg:text-xl">in {event.city}</p>}
        <p class="mt-4 max-w-[25em] text-md text-fg-soft lg:mt-6 lg:text-lg">
          {event.is_past
            ? 'Dieser Abend hat bereits stattgefunden. Bei den aktuellen Terminen findest du die nächsten Treffen.'
            : 'Ein Abend für das, was dich gerade beschäftigt. Mit Männern, die dir zuhören.'}
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm lg:mt-6 lg:text-base">
          <a href="#ueber-den-abend" class={`${link} inline-flex min-h-9 items-center`}>
            Was dich erwartet
          </a>
          {hasPlace && (
            <a href="#anfahrt" class={`${link} inline-flex min-h-9 items-center`}>
              Adresse &amp; Anfahrt
            </a>
          )}
        </div>
        {event.is_past && (
          <Button href="/event" class="mt-5">
            Aktuelle Termine ansehen
          </Button>
        )}
        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4 lg:mt-12">
          {event.location && (
            <p class="max-w-[22em] text-sm text-fg-muted">
              Treffpunkt: <span class="text-fg">{event.location}</span>
            </p>
          )}
          {!event.is_past && <CalendarButton event={event} />}
        </div>
      </div>

      <div class="min-w-0 lg:col-span-5 lg:col-start-8">
        <slot />
      </div>
    </div>
  </Container>
</section>

<EventDock event={event} dateLabel={dateLabel} hours={hours} />
