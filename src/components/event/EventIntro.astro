---
import { eventView } from '@lib/event-status';
import { timeRange } from '@lib/server/format';
import type { EventDTO } from '@lib/types';
import { link } from '@lib/ui';

import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import CalendarButton from './CalendarButton.astro';
import EventDock from './EventDock.astro';

interface Props {
  event: EventDTO;
}

const { event } = Astro.props;
const view = eventView(event, 'Dieser Abend', false);
const hasPlace = !!(event.location || event.street || event.city);
const isCircleTitle = event.title.trim().toLocaleLowerCase('de') === 'männerkreis';
---

<section
  aria-labelledby="event-title"
  class="pt-[calc(var(--spacing-header)+1.25rem)] pb-0 sm:pb-8 lg:pt-[calc(var(--spacing-header)+2.75rem)] lg:pb-12"
>
  <Container class="grid items-start gap-x-grid gap-y-6 lg:grid-cols-12 lg:grid-rows-[min-content_1fr] lg:gap-y-0">
    <div class="min-w-0 lg:col-span-7 lg:pr-8">
      <div class="flex flex-wrap items-baseline justify-between gap-x-5 gap-y-1 border-t border-line-strong pt-3 text-sm lg:pt-4">
        <time datetime={view.datetime} class="text-fg">
          {view.title.join(' ')}
        </time>
        {event.start_time && <p class="text-fg-muted">{timeRange(event.start_time, event.end_time)}</p>}
      </div>
      <h1
        id="event-title"
        data-event-title
        aria-label={event.title}
        class:list={[
          'mt-5 font-sans font-medium tracking-[-0.065em] text-fg lg:mt-8 print:opacity-100!',
          isCircleTitle
            ? 'text-[clamp(2.5rem,6.4vw,5.75rem)] leading-[1.05] whitespace-nowrap'
            : 'text-page wrap-anywhere hyphens-auto lg:text-hero',
        ]}
      >
        {isCircleTitle ? (
          <span>
            Männer<span class="font-serif font-normal tracking-[-0.035em] text-accent italic">kreis</span>
          </span>
        ) : (
          <span class="font-serif font-normal tracking-normal italic">{event.title}</span>
        )}
      </h1>
      {event.city && <p class="mt-3 text-base text-fg-muted lg:mt-6 lg:text-xl">in {event.city}</p>}
      <p class="mt-4 max-w-[25em] text-base text-fg-soft lg:mt-6 lg:text-lg">
        {event.is_past
          ? 'Dieser Abend hat bereits stattgefunden. Bei den aktuellen Terminen findest du die nächsten Treffen.'
          : 'Ein Abend für das, was dich gerade beschäftigt. Mit Männern, die dir zuhören.'}
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm lg:mt-6 lg:text-base">
        <a href="#ueber-den-abend" class={`${link} inline-flex min-h-9 items-center`}>
          Was dich erwartet
        </a>
        {hasPlace && (
          <a href="#anfahrt" class={`${link} inline-flex min-h-9 items-center`}>
            Adresse &amp; Anfahrt
          </a>
        )}
      </div>
      {event.is_past && (
        <Button href="/event" class="mt-5">
          Aktuelle Termine ansehen
        </Button>
      )}
    </div>

    <div class="min-w-0 lg:col-span-5 lg:col-start-8 lg:row-span-2">
      <slot />
    </div>

    <div class="min-w-0 pt-4 pb-8 sm:pb-0 lg:col-span-7 lg:col-start-1 lg:row-start-2 lg:mt-10 lg:pt-0 lg:pr-8">
      <div class="flex flex-wrap items-center justify-between gap-4 border-t border-line pt-5">
        {event.location && (
          <p class="max-w-[22em] text-sm text-fg-muted">
            Treffpunkt: <span class="text-fg">{event.location}</span>
          </p>
        )}
        {!event.is_past && <CalendarButton event={event} />}
      </div>
    </div>
  </Container>
</section>

<EventDock event={event} />
