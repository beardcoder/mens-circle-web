---
import { buildEventFaq } from '@lib/event-landing';
import type { DateStatus } from '@lib/event-status';
import type { Testimonial } from '@lib/types';
import Faq from '../blocks/Faq.astro';
import LandingHero from './landing/LandingHero.astro';
import LandingNextDate from './landing/LandingNextDate.astro';
import LandingFacts from './landing/LandingFacts.astro';
import LandingVoice from './landing/LandingVoice.astro';
import LandingMore from './landing/LandingMore.astro';

/**
 * The permanent /event landing page.
 *
 * Never redirects to /event/<slug>: this is the URL that has to rank and to
 * work when nothing is scheduled. Registration stays on /event/<slug>, which
 * remains canonical for a single evening and carries its own Event markup.
 *
 * This page used to be thirteen sections and retold the whole of the home page
 * — what a Männerkreis is, the evening's rhythm, the ground rules, the
 * boundary against therapy, who Markus is. All of that now lives once, on the
 * home page, and this page does the job its URL promises: the date, the
 * practical facts, the way to take part or to be told about the next one, and
 * the questions that come up right before an evening.
 *
 * Section order: invitation, the live date, the facts, one real voice, the
 * practical questions, and finally the links into the depth.
 *
 * Static HTML apart from the notification form inside LandingNextDate.
 */

interface Props {
  /** Scheduling state, resolved once per request by the page. */
  state: DateStatus;
  /** One published testimonial for the pull quote, or null when none exists. */
  voice: Testimonial | null;
}

const { state, voice } = Astro.props;

// Same call the page makes for the JSON-LD, so the rendered questions and the
// FAQPage markup are guaranteed to be the identical strings.
const faqItems = buildEventFaq(state.next);
---

<LandingHero place={state.next?.place ?? null} />
<LandingNextDate state={state} />
<LandingFacts next={state.next} />
<LandingVoice voice={voice} />

<Faq
  data={{
    anchor: 'fragen-zum-termin',
    eyebrow: 'Vor dem Termin',
    title: 'Fragen zu Termin und Anmeldung',
    items: faqItems,
  }}
/>

<LandingMore />
