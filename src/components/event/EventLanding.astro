---
import { buildEventFaq, type NextEventSummary } from '@lib/event-landing';
import type { Testimonial } from '@lib/types';
import Faq from '../blocks/Faq.astro';
import Newsletter from '../blocks/Newsletter.astro';
import WhatsappCommunity from '../blocks/WhatsappCommunity.astro';
import LandingHero from './landing/LandingHero.astro';
import LandingNextDate from './landing/LandingNextDate.astro';
import LandingEveryday from './landing/LandingEveryday.astro';
import LandingEvening from './landing/LandingEvening.astro';
import LandingFirstTime from './landing/LandingFirstTime.astro';
import LandingVoice from './landing/LandingVoice.astro';
import LandingFit from './landing/LandingFit.astro';
import LandingNotThis from './landing/LandingNotThis.astro';
import LandingFrame from './landing/LandingFrame.astro';
import LandingFacts from './landing/LandingFacts.astro';
import LandingGuide from './landing/LandingGuide.astro';
import LandingMore from './landing/LandingMore.astro';

/**
 * The permanent /event landing page.
 *
 * Never redirects to /event/<slug>: this is the URL that has to rank and to work
 * when nothing is scheduled. Registration stays on /event/<slug>, which remains
 * canonical for a single evening and carries its own Event markup.
 *
 * Where the home page says what the Männerkreis is, this page answers "what is
 * it actually like to go, and do I dare try once" — written for someone who
 * arrived from a WhatsApp link and has never been near a men's circle. Hence
 * recognition before explanation, the evening told from a first-timer's seat,
 * and a hard boundary section. Capacity numbers appear only when a real event
 * supplies them.
 *
 * Section order is deliberate: invitation, the live date, recognition, then the
 * doubts in the order they surface, and only then newsletter/WhatsApp.
 *
 * Static HTML apart from the two form islands.
 */

interface Props {
  /** The next upcoming event reduced to display strings, or null when none. */
  next: NextEventSummary | null;
  /** One published testimonial for the pull quote, or null when none exists. */
  voice: Testimonial | null;
}

const { next, voice } = Astro.props;

// Same call the page makes for the JSON-LD, so the rendered questions and the
// FAQPage markup are guaranteed to be the identical strings.
const faqItems = buildEventFaq(next);
---

<LandingHero place={next?.place ?? null} />
<LandingNextDate next={next} />

<LandingEveryday />
<LandingEvening />
<LandingFirstTime />
<LandingVoice voice={voice} />
<LandingFit />
<LandingNotThis />
<LandingFrame />
<LandingFacts next={next} />
<LandingGuide />

<Faq
  data={{
    anchor: 'fragen-zum-termin',
    eyebrow: 'Bevor du kommst',
    title: 'Was Männer vor ihrem<br><span class="text-italic">ersten Abend</span> fragen',
    items: faqItems,
  }}
/>

<Newsletter
  data={{
    eyebrow: 'Newsletter',
    title: 'Termin <span class="text-italic">nicht verpassen</span>',
    text: 'Du bekommst einen kurzen Hinweis, sobald der nächste Männerkreis feststeht. Nicht mehr.',
  }}
  context={{ page: 'event-landing' }}
/>

<WhatsappCommunity />

<LandingMore />
