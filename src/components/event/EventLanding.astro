---
import { buildEventFaq, type NextEventSummary } from '@lib/event-landing';
import Faq from '../blocks/Faq.astro';
import Newsletter from '../blocks/Newsletter.astro';
import WhatsappCommunity from '../blocks/WhatsappCommunity.astro';
import LandingHero from './landing/LandingHero.astro';
import LandingNextDate from './landing/LandingNextDate.astro';
import LandingEveryday from './landing/LandingEveryday.astro';
import LandingEvening from './landing/LandingEvening.astro';
import LandingFirstTime from './landing/LandingFirstTime.astro';
import LandingFit from './landing/LandingFit.astro';
import LandingNotThis from './landing/LandingNotThis.astro';
import LandingFrame from './landing/LandingFrame.astro';
import LandingFacts from './landing/LandingFacts.astro';
import LandingGuide from './landing/LandingGuide.astro';
import LandingMore from './landing/LandingMore.astro';

/**
 * The permanent /event landing page.
 *
 * This URL never redirects to /event/<slug>: it is the page that has to rank and
 * that has to work when nothing is scheduled. Registration still happens on
 * /event/<slug>, which stays canonical for a single evening and carries its own
 * Event markup — this page links there rather than duplicating it.
 *
 * The division of labour with the home page is the whole point of the copy here.
 * The home page answers "what is the Männerkreis and what does it stand for":
 * values, Markus, Die Reise (Ankommen → Öffnen → Wachsen → Integrieren), the
 * general FAQ. This page answers a different question — "what is it actually
 * like to go there, and do I dare try it once" — for someone who arrived from a
 * WhatsApp link, an Instagram post or a Google search and has never been near a
 * men's circle. Hence recognition before explanation, the evening told from a
 * first-timer's seat, an explicit "you don't need to be able to do anything",
 * and a hard boundary section. No Wachstum/Transformation/Spiegelung vocabulary,
 * and no manufactured scarcity: real capacity numbers appear only when a real
 * event supplies them.
 *
 * The section order is deliberate — establish the invitation, show the one live
 * date, build recognition, then answer the doubts in the order they surface, and
 * only afterwards hand over to newsletter/WhatsApp and further reading.
 *
 * Everything is static HTML except the two form islands inside Newsletter and
 * WhatsappCommunity, which already existed.
 */

interface Props {
  /** The next upcoming event reduced to display strings, or null when none. */
  next: NextEventSummary | null;
}

const { next } = Astro.props;

// Same call the page makes for the JSON-LD, so the rendered questions and the
// FAQPage markup are guaranteed to be the identical strings.
const faqItems = buildEventFaq(next);
---

<LandingHero />
<LandingNextDate next={next} />

<LandingEveryday />
<LandingEvening />
<LandingFirstTime />
<LandingFit />
<LandingNotThis />
<LandingFrame />
<LandingFacts next={next} />
<LandingGuide />

<Faq
  data={{
    anchor: 'fragen-zum-termin',
    eyebrow: 'Bevor du kommst',
    title: 'Was Männer vor ihrem<br><span class="text-italic">ersten Abend</span> fragen',
    items: faqItems,
  }}
/>

<Newsletter
  data={{
    eyebrow: 'Newsletter',
    title: 'Termin <span class="text-italic">nicht verpassen</span>',
    text: 'Du bekommst einen kurzen Hinweis, sobald der nächste Männerkreis feststeht. Nicht mehr.',
  }}
  context={{ page: 'event-landing' }}
/>

<WhatsappCommunity />

<LandingMore />
