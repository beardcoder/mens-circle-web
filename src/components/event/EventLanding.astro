---
import { buildEventFaq } from '@lib/event-landing';
import type { DateStatus } from '@lib/event-status';
import type { Testimonial } from '@lib/types';
import Faq from '../blocks/Faq.astro';
import LandingHero from './landing/LandingHero.astro';
import LandingNextDate from './landing/LandingNextDate.astro';
import LandingFacts from './landing/LandingFacts.astro';
import LandingVoice from './landing/LandingVoice.astro';
import LandingMore from './landing/LandingMore.astro';

/**
 * The permanent /event landing page: the date, the practical facts, the way to
 * take part or be notified, and the questions asked right before an evening.
 * Registration stays on /event/<slug>, which carries its own Event markup.
 *
 * Static HTML apart from the notification form inside LandingNextDate.
 */

interface Props {
  /** Scheduling state, resolved once per request by the page. */
  state: DateStatus;
  /** One published testimonial for the pull quote, or null when none exists. */
  voice: Testimonial | null;
}

const { state, voice } = Astro.props;

// The same call the page makes for the JSON-LD, so the rendered questions and
// the markup are the identical strings.
const faqItems = buildEventFaq(state.next);
---

<LandingHero place={state.next?.place ?? null} />
<LandingNextDate state={state} />
<LandingFacts next={state.next} />
<LandingVoice voice={voice} />

<Faq
  data={{
    anchor: 'fragen-zum-termin',
    eyebrow: 'Vor dem Termin',
    title: 'Fragen zu Termin und Anmeldung',
    items: faqItems,
  }}
/>

<LandingMore />
