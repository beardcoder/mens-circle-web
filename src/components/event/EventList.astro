---
import site from '@data/site.json';
import { link } from '@lib/ui';

import NewsletterForm from '../forms/NewsletterForm.astro';
import Section from '../ui/Section.astro';
import EventAvailability from './EventAvailability.astro';
import EventSummary from './EventSummary.astro';
import type { PublicEvents } from './types';

interface Props {
  events: PublicEvents | null;
}

const { events } = Astro.props;

/**
 * The dates on /event — what the page is for: every upcoming date as the same
 * EventSummary (the soonest first), and beside them, smaller, the way to hear
 * about the next ones. Three states: dates, none, and a failed read, which
 * never reads as "no date planned".
 */

const whatsapp = site.whatsappCommunityLink;
---

<Section
  id="naechster-termin"
  labelledby="termine-liste-title"
  space="none"
  class="pb-section"
  innerClass="grid items-start gap-x-grid gap-y-12 lg:grid-cols-12"
>
  <div class="min-w-0 lg:col-span-6">
    <h2 id="termine-liste-title" class="text-sub text-fg">
      Kommende Termine
    </h2>
    {events?.events.length ? (
      <ul role="list" class="mt-6 grid gap-stack">
        {events.events.map((event, i) => (
          <li>
            <EventSummary
              view={{ ...event.view, kicker: i === 0 ? 'Nächster Termin' : 'Weiterer Termin' }}
              location="event-landing"
            />
          </li>
        ))}
      </ul>
    ) : (
      <div class="mt-6">
        <EventAvailability data={events} location="event-landing" />
      </div>
    )}
  </div>

  <aside
    id="benachrichtigung"
    aria-labelledby="benachrichtigung-title"
    class="scroll-mt-(--spacing-clearance) rounded-2xl bg-tint p-card lg:sticky lg:top-(--spacing-clearance) lg:col-span-5 lg:col-start-8"
  >
    <h2 id="benachrichtigung-title" class="font-sans text-xl font-semibold text-fg">
      Termine per E-Mail erhalten
    </h2>
    <p class="mt-3 text-base text-fg-soft">
      Du bekommst eine kurze Nachricht, sobald ein neuer Termin feststeht. Mehr wird über diesen Verteiler nicht
      verschickt.
    </p>
    <NewsletterForm id="event-newsletter" context={{ page: 'event-landing' }} class="mt-6" />
    {whatsapp && (
      <p class="mt-6 border-t border-line pt-6 text-base text-fg-soft" id="whatsapp-community">
        Lieber zwischendurch austauschen? Es gibt außerdem eine{' '}
        <a
          class={link}
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          data-umami-event="whatsapp-click"
          data-umami-event-type="community-join"
        >
          WhatsApp-Gruppe<span class="sr-only"> (öffnet WhatsApp in einem neuen Tab)</span>
        </a>
        .
      </p>
    )}
  </aside>
</Section>
