---
import type { EventDTO } from '@lib/types';
import { fullAddress } from '@lib/server/format';
import { link } from '@lib/ui';
import Button from '../ui/Button.astro';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Props {
  /** Event with non-null coordinates; the caller guards. */
  event: EventDTO;
  lat: number;
  lng: number;
  ground?: 'default' | 'sand';
}

/**
 * Anfahrt: the address, the BayernAtlas web component (`<bayern-atlas>`, an iframe of
 * the Bavarian survey's map, which carries its own attribution) whose script loads
 * only when the map is about to scroll into view, and the route links, which work
 * even when the map cannot draw itself.
 */

const { event, lat, lng, ground = 'default' } = Astro.props;

const address =
  fullAddress({ street: event.street, postalCode: event.postal_code, city: event.city }) || event.location;
---

<Section ground={ground} labelledby="anfahrt-title" innerClass="grid justify-items-center gap-group" defer>
  <SectionHead
    eyebrow="Anfahrt"
    title="So findest du zu uns"
    titleEmphasis="zu uns"
    titleId="anfahrt-title"
    align="center"
  >
    <p class="font-serif text-xl text-fg-soft italic">{address}</p>
  </SectionHead>

  <div class="w-full max-w-5xl">
    {/* A fixed frame so the map can never push the page around as it loads. */}
    <div class="aspect-4/3 overflow-clip rounded-card border border-line has-data-[state=failed]:aspect-auto sm:aspect-video">
      <div
        data-map
        data-state="idle"
        data-lat={lat}
        data-lng={lng}
        data-title={event.location}
        aria-label="Karte zum Veranstaltungsort"
        class="group/map relative isolate block h-full overflow-hidden bg-ground-alt [contain:paint]"
      >
        <div class="relative size-full min-h-[280px] bg-ground-alt before:pointer-events-none before:absolute before:inset-0 before:z-1 before:animate-skeleton before:bg-[repeating-linear-gradient(135deg,color-mix(in_srgb,var(--color-line)_60%,transparent)_0_12px,transparent_12px_24px)] group-data-[state=failed]/map:hidden group-data-[state=ready]/map:before:hidden">
          {/* Inert until the script defines it; reads its attributes once, on connect.
                `c` is lon,lat (EPSG:4326). The map stays still until the reader
                activates it, so it never swallows the page's scroll. */}
          <bayern-atlas
            data-map-canvas
            c={`${lng},${lat}`}
            z="16"
            ec_map_activation="true"
            ec_link_to_app="true"
            class="absolute inset-0 block size-full"
          ></bayern-atlas>
        </div>
        <p data-map-fallback hidden class="p-4 text-sm text-balance text-fg-muted">
          Die Karte lässt sich gerade nicht laden. Die Adresse steht über dieser Box, und die Routen-Links darunter
          funktionieren weiterhin.
        </p>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap justify-center gap-3 max-sm:flex-col">
      <Button
        href={`https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`}
        variant="secondary"
        target="_blank"
        rel="noopener"
      >
        Route planen (Google Maps)
      </Button>
      <Button
        href={`https://atlas.bayern.de/?c=${lng},${lat}&z=16&crh=true`}
        variant="secondary"
        target="_blank"
        rel="noopener"
      >
        Im BayernAtlas öffnen
      </Button>
    </div>

    <p class="mt-3 text-center text-sm text-fg-muted">
      Karte:{' '}
      <a href="https://atlas.bayern.de" target="_blank" rel="noopener" class={link}>
        BayernAtlas
      </a>
      , Bayerische Vermessungsverwaltung
    </p>
  </div>
</Section>

<script>
  /**
   * The BayernAtlas web component; it defines `<bayern-atlas>`. A classic script, not
   * `type="module"` as its docs show: a module is fetched with CORS, and atlas.bayern.de
   * allows only a few origins. The file is a plain bundle, so it runs either way.
   */
  const SCRIPT_URL = 'https://atlas.bayern.de/wc.js';

  interface BayernAtlas extends HTMLElement {
    addMarker(coordinate: [number, number], options?: { id?: string; label?: string }): string;
  }

  let script: Promise<void> | undefined;

  /** Loads the component script once, however many maps a page has. */
  function loadScript(): Promise<void> {
    script ??= new Promise((resolve, reject) => {
      const element = Object.assign(document.createElement('script'), { src: SCRIPT_URL });
      element.addEventListener('load', () => resolve());
      element.addEventListener('error', () => reject(new Error(`Could not load ${SCRIPT_URL}`)));
      document.head.append(element);
    });
    return script;
  }

  function fail(root: HTMLElement): void {
    root.dataset.state = 'failed';
    root.querySelector<HTMLElement>('[data-map-fallback]')!.hidden = false;
  }

  async function draw(root: HTMLElement): Promise<void> {
    const map = root.querySelector<BayernAtlas>('[data-map-canvas]');
    if (!map) return;
    const { lat, lng, title = '' } = root.dataset;
    root.dataset.state = 'loading';

    // The iframe answers with `baLoad`; commands sent before it would be lost.
    map.addEventListener(
      'baLoad',
      () => {
        // A label makes the marker selectable, which shows the place's name.
        map.addMarker([Number(lng), Number(lat)], { label: title });
        root.dataset.state = 'ready';
      },
      { once: true },
    );

    try {
      await loadScript();
    } catch {
      fail(root);
    }
  }

  // The component loads only when the map is about to scroll into view.
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        void draw(entry.target as HTMLElement);
      }
    },
    { rootMargin: '200px' },
  );
  for (const root of document.querySelectorAll('[data-map]')) observer.observe(root);
</script>
