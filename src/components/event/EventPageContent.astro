---
import type { EventDTO } from '@lib/types';
import EventAbout from './EventAbout.astro';
import EventFinalCta from './EventFinalCta.astro';
import EventHero from './EventHero.astro';
import EventInfo from './EventInfo.astro';
import EventMapSection from './EventMapSection.astro';
import EventRegister from './EventRegister.astro';

/**
 * The server-rendered body of /event/<slug>. Only the interactive pieces hydrate
 * as islands — registration form, add-to-calendar dialog, map, newsletter form.
 *
 * The event is required: the route redirects to /event when a slug resolves to
 * nothing, and EventLanding.astro owns the empty state.
 */

interface Props {
  /** The event this page is about, read from the DB per request. */
  event: EventDTO;
}

const { event } = Astro.props;
---

<EventHero event={event} />
<EventRegister event={event} />
<EventInfo event={event} />
{
  event.latitude !== null && event.longitude !== null && (
    <EventMapSection event={event} lat={event.latitude} lng={event.longitude} />
  )
}
<EventAbout event={event} />
<EventFinalCta event={event} />
