---
import site from '@data/site.json';
import { splitFee } from '@lib/event-status';
import { publicEvent } from '@lib/server/public-data';
import type { EventDTO } from '@lib/types';
import { link } from '@lib/ui';

import RegistrationForm from '../forms/RegistrationForm';

interface Props {
  event: EventDTO;
}

const { event } = Astro.props;
const contribution = splitFee(event.cost_basis);
---

<div
  id="anmeldung"
  class:list={[
    // Below lg a forest band from edge to edge; beside the intro it runs out to the
    // window's right edge (the section is the container that 100cqw measures).
    'surface-dark min-w-0 scroll-mt-14 rounded-2xl scheme-dark p-panel max-lg:-mx-gutter max-lg:rounded-none max-lg:px-gutter lg:-mr-[max(var(--spacing-gutter),calc((100cqw-75rem)/2))] lg:rounded-r-none lg:pr-[max(var(--spacing-gutter),calc((100cqw-75rem)/2))]',
    !event.is_past && 'has-[astro-island[ssr]]:min-h-[51rem]',
  ]}
>
  <RegistrationForm client:only="preact" initial={publicEvent(event)} contribution={contribution}>
    <div slot="fallback">
      <h2 id="anmeldung-title" class="text-sub text-fg">
        {event.is_past ? 'Dieser Abend hat stattgefunden' : 'Dein Platz im Kreis'}
      </h2>
      <p role="status" class="mt-3 text-md text-fg-soft">
        Die Anmeldung wird geladen …
      </p>
      <noscript>
        <p class="mt-4 text-sm text-fg-muted">
          Beitrag: {contribution.main}
          {contribution.note && ` (${contribution.note})`}
        </p>
        <p class="mt-4 text-base">
          Für die Online-Anmeldung benötigst du JavaScript. Du kannst dich auch per E-Mail an{' '}
          <a class={link} href={`mailto:${site.contactEmail}`}>
            {site.contactEmail}
          </a>{' '}
          anmelden.
        </p>
      </noscript>
    </div>
  </RegistrationForm>
</div>
