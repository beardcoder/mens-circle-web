---
import { plainTextToHtml } from '@lib/server/format';
import type { EventDTO } from '@lib/types';
import { card } from '@lib/ui';

import RegistrationForm from '../forms/RegistrationForm.astro';
import Button from '../ui/Button.astro';
import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';

interface Props {
  event: EventDTO;
}

/**
 * What the page is for, as one composition on the paper: the evening's own
 * description (paragraphs and real lists) beside the registration — open,
 * waiting list or past. The form sits in a quiet card; nothing decorates it.
 */

const { event } = Astro.props;
const description = event.description?.trim() ?? '';

const heading = event.is_past ? 'Dieser Abend hat stattgefunden' : event.is_full ? 'Auf die Warteliste' : 'Anmeldung';
---

<Section
  id="anmeldung"
  labelledby="anmeldung-title"
  class="scroll-mt-header"
  innerClass="grid items-start gap-x-grid gap-y-12 lg:grid-cols-12"
>
  <div class="min-w-0 lg:col-span-5">
    <h2
      id="ueber-den-abend"
      class="text-sub text-fg"
    >
      Zu diesem Abend
    </h2>
    {description ? (
      <Prose
        html={plainTextToHtml(description)}
        class="mt-5"
      />
    ) : (
      <p class="mt-5 max-w-measure text-md text-fg-soft">
        Wir sitzen im Kreis, hören einander zu und sprechen über das, was gerade da ist.
      </p>
    )}
    {!event.is_past && (
      <p class="mt-6 max-w-measure text-base text-fg-muted">
        Die genaue Adresse bekommst du mit der Anmeldebestätigung per E-Mail.
      </p>
    )}
  </div>

  <div class:list={[card, 'min-w-0 p-6 sm:p-8 lg:col-span-6 lg:col-start-7']}>
    <h2
      id="anmeldung-title"
      class="text-sub text-fg"
    >
      {heading}
    </h2>
    {event.is_past ? (
      <>
        <p class="mt-3 max-w-measure text-md text-fg-soft">
          Eine Anmeldung ist nicht mehr möglich. Wenn du beim nächsten Mal dabei sein möchtest, lass dich
          benachrichtigen, sobald ein neuer Termin feststeht.
        </p>
        <Button
          href="/event#benachrichtigung"
          size="lg"
          class="mt-6 max-sm:w-full"
        >
          Termine per E-Mail erhalten
        </Button>
      </>
    ) : (
      <>
        <p class="mt-3 mb-6 max-w-measure text-md text-fg-soft">
          {event.is_full
            ? 'Dieser Abend ist ausgebucht. Trag dich trotzdem ein: Wird ein Platz frei, rückst du automatisch nach und bekommst sofort eine E-Mail.'
            : `Von ${event.max_participants} Plätzen sind noch ${event.available_spots} frei. Den genauen Treffpunkt bekommst du mit der Bestätigung per E-Mail.`}
        </p>
        <RegistrationForm
          eventId={event.id}
          isFull={event.is_full}
        />
      </>
    )}
  </div>
</Section>
