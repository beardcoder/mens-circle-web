---
import type { EventDTO } from '@lib/types';
import { formatDateShortDE, toDate } from '@lib/server/format';
import RegistrationForm from '../islands/RegistrationForm.svelte';

interface Props {
  event: EventDTO;
}

/**
 * Registration for one evening — three states: open, waiting list, past.
 *
 * The heading now names the state plainly ("Anmeldung", "Warteliste",
 * "Dieser Abend hat stattgefunden") instead of selling it ("Sichere dir deinen
 * Platz"), and the seat count is a sentence rather than a 2rem numeral. The
 * form itself sits on the page's own ground: it used to be a 100svh dark split
 * with two breathing rings behind the heading.
 *
 * The island, its endpoint and its validation are untouched.
 */

const { event } = Astro.props;
const dateOnly = toDate(event.event_date)?.toISOString().slice(0, 10) ?? '';

const heading = event.is_past ? 'Dieser Abend hat stattgefunden' : event.is_full ? 'Warteliste' : 'Anmeldung';
---

<section class="section section--ruled event-register-section" id="anmeldung" aria-labelledby="anmeldung-title">
  <div class="container">
    <div class="spine">
      <p class="rail-heading">{event.is_past ? 'Rückblick' : 'Teilnehmen'}</p>

      <div class="spine__body">
        <h2 class="event-register__title" id="anmeldung-title">{heading}</h2>

        {
          event.is_past ? (
            <p class="event-register__text">
              Der Abend am <time datetime={dateOnly}>{formatDateShortDE(event.event_date)}</time> ist vorbei, eine
              Anmeldung ist nicht mehr möglich. Wenn du beim nächsten Mal dabei sein möchtest, lass dich
              benachrichtigen, sobald der nächste Termin feststeht.
            </p>
          ) : event.is_full ? (
            <p class="event-register__text">
              Dieser Abend ist ausgebucht. Du kannst dich trotzdem eintragen: Wird ein Platz frei, rückst du automatisch
              nach und bekommst sofort eine E-Mail.
            </p>
          ) : (
            <p class="event-register__text">
              Von {event.max_participants} Plätzen sind noch {event.available_spots} frei. Für die Anmeldung genügen
              Vor- und Nachname und eine E-Mail-Adresse; den genauen Treffpunkt bekommst du mit der Bestätigung.
            </p>
          )
        }

        <div class="event-register__form-wrap">
          {
            event.is_past ? (
              <a href="/#termine" class="btn btn--primary">
                Bei neuen Terminen benachrichtigen
              </a>
            ) : (
              <RegistrationForm client:visible event={event} />
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  @layer sections {
    .event-register__title {
      margin-block-end: var(--space-xs);
      font-size: var(--text-3xl);
      line-height: 1.15;
    }

    .event-register__text {
      max-inline-size: var(--measure);
      margin-block-end: var(--space-md);
      font-size: var(--text-section-body-lg);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
    }

    .event-register__form-wrap {
      max-inline-size: var(--content-max-form);
    }

    .event-register__form {
      inline-size: 100%;
    }

    .event-register__submit {
      margin-block-start: var(--space-sm);
      inline-size: 100%;
    }
  }
</style>
