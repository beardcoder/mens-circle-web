---
import type { EventDTO } from '@lib/types';
import { formatDateShortDE, isoDay } from '@lib/server/format';
import RegistrationForm from '../forms/RegistrationForm.astro';

interface Props {
  event: EventDTO;
}

/** Registration for one event, in three states: open, waiting list, past. */

const { event } = Astro.props;
const dateOnly = isoDay(event.event_date);

const heading = event.is_past ? 'Dieser Abend hat stattgefunden' : event.is_full ? 'Warteliste' : 'Anmeldung';
---

<section class="section section--sand event-register-section" id="anmeldung" aria-labelledby="anmeldung-title">
  <div class="container bay">
    <div class="event-register__intro">
      <h2 class="event-register__title" id="anmeldung-title">
        {heading}
      </h2>

      {event.is_past ? (
        <p class="event-register__text">
          Der Abend am <time datetime={dateOnly}>{formatDateShortDE(event.event_date)}</time> ist vorbei, eine Anmeldung
          ist nicht mehr möglich. Wenn du beim nächsten Mal dabei sein möchtest, lass dich benachrichtigen, sobald der
          nächste Termin feststeht.
        </p>
      ) : event.is_full ? (
        <p class="event-register__text">
          Dieser Abend ist ausgebucht. Du kannst dich trotzdem eintragen: Wird ein Platz frei, rückst du automatisch
          nach und bekommst sofort eine E-Mail.
        </p>
      ) : (
        <p class="event-register__text">
          Von {event.max_participants} Plätzen sind noch {event.available_spots} frei. Für die Anmeldung genügen Vor-
          und Nachname und eine E-Mail-Adresse; den genauen Treffpunkt bekommst du mit der Bestätigung.
        </p>
      )}
    </div>

    <div class="event-register__form-wrap">
      {event.is_past ? (
        <a href="/#termine" class="btn btn--primary">
          Bei neuen Terminen benachrichtigen
        </a>
      ) : (
        <RegistrationForm eventId={event.id} isFull={event.is_full} />
      )}
    </div>
  </div>
</section>

<style is:global>
  @layer sections {
    .event-register__intro {
      grid-column: 1 / span 5;
    }

    .event-register__title {
      margin-block-end: var(--space-md);
      font-size: var(--step-4);
    }

    .event-register__text {
      max-inline-size: 40ch;
      margin: 0;
      font-family: var(--font-body);
      font-size: var(--step-1);
      line-height: 1.5;
      color: var(--text-secondary);
    }

    /* The form sits on the raised ground: the one surface on the page you write on. */
    .event-register__form-wrap {
      grid-column: 7 / span 6;
      padding: var(--space-lg);
      background: var(--bg-elevated);
      border: 1px solid var(--rule);
      border-radius: var(--radius);
    }

    .event-register__form {
      inline-size: 100%;
    }

    .event-register__submit {
      margin-block-start: var(--space-sm);
      inline-size: 100%;
    }

    @media (width <= 56em) {
      .event-register__form-wrap {
        margin-block-start: var(--space-lg);
        padding: var(--space-md);
      }
    }
  }
</style>
