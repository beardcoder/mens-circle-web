---
import site from '@data/site.json';
import { plainTextToHtml } from '@lib/server/format';
import type { EventDTO } from '@lib/types';
import { link } from '@lib/ui';

import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';

interface Props {
  event: EventDTO;
}

const { event } = Astro.props;
const description = event.description?.trim() ?? '';
---

<Section ground="alt" labelledby="ueber-den-abend" innerClass="grid items-start gap-x-grid gap-y-8 lg:grid-cols-12">
  {/* The question stays beside the text while it is read; the circle repeats the seating motif. */}
  <div class="min-w-0 lg:sticky lg:top-[calc(var(--spacing-header)+5.5rem)] lg:col-span-5">
    <h2 id="ueber-den-abend" class="max-w-[10em] scroll-mt-14 text-page text-fg">
      Was beschäftigt dich gerade?
    </h2>
    <div aria-hidden="true" class="relative mt-10 hidden size-44 lg:block xl:size-52">
      <svg viewBox="0 0 100 100" class="size-full -rotate-90 overflow-visible">
        <circle
          cx="50"
          cy="50"
          r="49"
          pathLength="1"
          fill="none"
          class="stroke-line"
          vector-effect="non-scaling-stroke"
        />
        <circle
          cx="50"
          cy="50"
          r="49"
          pathLength="1"
          fill="none"
          stroke-dasharray="1"
          class="stroke-accent"
          vector-effect="non-scaling-stroke"
        />
      </svg>
      <span class="absolute inset-0">
        <span class="absolute top-0 left-1/2 size-2.5 -translate-1/2 rounded-full bg-accent"></span>
      </span>
    </div>
    <p class="mt-8 text-base text-fg-muted lg:mt-10">
      Noch eine Frage vor dem Abend?{' '}
      <a class={link} href={`mailto:${site.contactEmail}`}>
        Schreib mir.
      </a>
      <span class="mt-2 block">Markus</span>
    </p>
  </div>
  <div class="min-w-0 lg:col-span-6 lg:col-start-7">
    {description ? (
      <Prose html={plainTextToHtml(description)} />
    ) : (
      <Prose>
        <p>
          Zwischen Arbeit und Alltag bleibt manches liegen. Im Kreis nehmen wir uns Zeit dafür. Du kannst erzählen, was
          dich gerade fordert, was dir fehlt oder worüber du dich freust.
        </p>
        <p>
          Wenn einer spricht, hören die anderen zu. Wir lassen einander ausreden und verzichten auf ungefragte
          Ratschläge. Zu Beginn vereinbaren wir miteinander: Persönliches bleibt im Kreis.
        </p>
      </Prose>
    )}
    <div class="mt-10 rounded-xl bg-raised p-card">
      <h3 class="text-sub text-fg">Du kannst erst einmal zuhören.</h3>
      <p class="mt-3 max-w-measure text-md text-fg-soft">
        Du brauchst keine Vorerfahrung und musst nichts vorbereiten. Ich erkläre den Rahmen zu Beginn. Wie viel du
        erzählst und ob du bei einer Atem- oder Körperübung mitmachst, entscheidest du selbst.
      </p>
    </div>
  </div>
</Section>
