---
import type { SummaryView } from '@lib/event-status';
import { button, card, label } from '@lib/ui';

interface Props {
  view: SummaryView;
  showAction?: boolean;
  location?: string;
}

const { view, showAction = true, location } = Astro.props;
---

<div data-summary data-state={view.state} class:list={[card, 'grid content-start p-6 sm:p-8']}>
  <p class={label}>{view.kicker}</p>
  <p class="mt-3 font-serif text-sub text-fg">
    <time datetime={view.datetime}>
      {view.title.map((line) => (
        <span class="block wrap-anywhere">{line}</span>
      ))}
    </time>
  </p>
  <dl class="mt-5 grid gap-3 border-t border-line pt-5">
    {view.rows.map((row) => (
      <div class="grid min-w-0 gap-x-3 min-[22.5rem]:grid-cols-[4.5rem_minmax(0,1fr)] sm:grid-cols-[5.5rem_minmax(0,1fr)]">
        <dt class="text-sm leading-6 text-fg-muted">{row.label}</dt>
        <dd class="text-base leading-6 text-fg wrap-anywhere">{row.value}</dd>
      </div>
    ))}
  </dl>
  {showAction && view.action && (
    <a
      href={view.action.href}
      class:list={[button({ variant: view.state === 'full' ? 'secondary' : 'primary', block: true }), 'mt-6']}
      data-umami-event="cta-click"
      data-umami-event-location={location}
      data-umami-event-state={view.state}
    >
      {view.action.label}
    </a>
  )}
</div>
