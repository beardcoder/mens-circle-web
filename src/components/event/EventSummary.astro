---
import type { SummaryView } from '@lib/event-status';
import { card } from '@lib/ui';
import Button from '../ui/Button.astro';

/**
 * One event at a glance — the one family for every date on the site: the label,
 * the date on two fixed lines, time, place, fee and seats as four rows, and the
 * action that fits the state. Every line is one line at every width (below 360px
 * a row stacks its label over its value), so a loading summary and a loaded one
 * stand the same height. A flat, square card.
 */
interface Props {
  view: SummaryView;
  /** The date's element: a heading where the summary heads its own block. */
  as?: 'p' | 'h2' | 'h3';
  titleId?: string;
  /** Off where the date already stands as the page's title: the label and the rows only. */
  showTitle?: boolean;
  /** Analytics: where the action sits. */
  location?: string;
  class?: string;
}

const { view, as: Title = 'p', titleId, showTitle = true, location, class: className }: Props = Astro.props;
const [lead, rest] = view.title;
const isDate = Boolean(view.datetime);
---

<div data-summary data-state={view.state} class:list={[card, 'grid content-start p-6 sm:p-8', className]}>
  <p class="text-xs font-semibold tracking-label text-fg-muted uppercase">{view.kicker}</p>
  {showTitle && (
    <Title id={titleId} class="mt-3 font-serif text-sub text-fg">
      {isDate ? (
        <time datetime={view.datetime}>
          <span class="block truncate">{lead}</span>
          <span class="block truncate">{rest}</span>
        </time>
      ) : (
        <>
          <span class="block truncate">{lead}</span>
          <span class="block truncate">{rest}</span>
        </>
      )}
    </Title>
  )}
  <dl
    class:list={[
      'grid gap-y-3 min-[22.5rem]:grid-cols-[4.5rem_minmax(0,1fr)] min-[22.5rem]:gap-x-3 min-[22.5rem]:gap-y-2 sm:grid-cols-[5.5rem_minmax(0,1fr)] sm:gap-x-4',
      showTitle ? 'mt-5 border-t border-line pt-5' : 'mt-4',
    ]}
  >
    {view.rows.map((row) => (
      <div class="grid min-w-0 min-[22.5rem]:col-span-2 min-[22.5rem]:grid-cols-subgrid">
        <dt class="truncate text-sm leading-6 text-fg-muted">{row.label}</dt>
        <dd class="truncate text-base leading-6 text-fg">{row.value}</dd>
      </div>
    ))}
  </dl>
  {view.action && (
    <Button
      href={view.action.href}
      variant={view.state === 'full' ? 'secondary' : 'primary'}
      block
      decorate
      class="mt-6"
      data-umami-event="cta-click"
      data-umami-event-location={location}
      data-umami-event-state={view.state}
    >
      {view.action.label}
    </Button>
  )}
</div>
