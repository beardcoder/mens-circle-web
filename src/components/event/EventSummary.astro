---
import type { SummaryView } from '@lib/event-status';
import { button, label } from '@lib/ui';

import SeatBar from './SeatBar.astro';

interface Props {
  view: SummaryView;
  showAction?: boolean;
  location?: string;
}

const { view, showAction = true, location } = Astro.props;

/** The date's seal: the day and a short month in a circle ("01" / "Jan."). */
const day = new Date(`${view.datetime}T12:00:00Z`);
const valid = !Number.isNaN(day.getTime());
const dayNumber = valid ? String(day.getUTCDate()).padStart(2, '0') : '';
const month = valid ? new Intl.DateTimeFormat('de-DE', { month: 'short', timeZone: 'UTC' }).format(day) : '';
const seal = view.state === 'past' ? 'bg-line text-fg-muted' : 'bg-accent-soft text-accent';

/** With seats to show, the seats row becomes the bar; a past evening keeps it in words. */
const seatsRow = view.seats ? view.rows.find((row) => row.label === 'Plätze') : undefined;
const rows = seatsRow ? view.rows.filter((row) => row !== seatsRow) : view.rows;
---

{/* Open on its ground, no card: the seal and the date, the facts as small columns,
     how full the circle is, and the fitting action. */}
<div data-summary data-state={view.state} data-reveal class="@container grid grid-cols-[minmax(0,1fr)] content-start">
  <p class={label}>{view.kicker}</p>
  <div class="mt-4 flex items-center gap-4">
    {dayNumber && (
      <span
        aria-hidden="true"
        class:list={['grid size-16 shrink-0 place-content-center rounded-full text-center', seal]}
      >
        <span class="font-display text-[1.5rem] leading-none">{dayNumber}</span>
        <span class="mt-0.5 text-xs leading-none font-semibold">{month}</span>
      </span>
    )}
    <p class="min-w-0 font-display text-sub text-fg">
      <time datetime={view.datetime}>
        {view.title.map((line) => (
          <span class="block truncate">{line}</span>
        ))}
      </time>
    </p>
  </div>
  <dl class="mt-7 grid grid-cols-2 gap-x-6 gap-y-5 @md:grid-cols-3">
    {rows.map((row) => (
      <div class="grid min-w-0 content-start gap-1">
        <dt class="text-sm text-fg-muted">{row.label}</dt>
        <dd class="text-base leading-6 font-medium text-fg wrap-anywhere">{row.value}</dd>
      </div>
    ))}
  </dl>
  {seatsRow && <SeatBar seats={view.seats} text={seatsRow.value} class="mt-6" />}
  {showAction && view.action && (
    <a
      href={view.action.href}
      class:list={[
        button({ variant: view.state === 'full' ? 'secondary' : 'primary', size: 'lg' }),
        'mt-8 w-fit max-sm:w-full',
      ]}
      data-umami-event="cta-click"
      data-umami-event-location={location}
      data-umami-event-state={view.state}
    >
      {view.action.label}
    </a>
  )}
</div>
