---
import type { SummaryView } from '@lib/shared/event-status';
import { button, label } from '@lib/ui';

import SeatRing from '../brand/SeatRing.astro';

interface Props {
  view: SummaryView;
  showAction?: boolean;
  location?: string;
}

const { view, showAction = true, location } = Astro.props;

/** With seats to show, the seats become the ring; a past evening keeps them in words. */
const rows = [
  { label: 'Zeit', value: view.facts.time },
  { label: 'Ort', value: view.facts.place },
  { label: 'Beitrag', value: view.facts.fee },
  ...(view.seats ? [] : [{ label: 'Plätze', value: view.facts.seats }]),
];
---

{/* Open on its ground, no card: the date, the facts as small columns, the seat ring
     (how full the circle is) and the fitting action. */}
<div
  data-summary
  data-reveal-group
  data-state={view.state}
  class="@container grid grid-cols-[minmax(0,1fr)] content-start"
>
  <p class={label}>{view.kicker}</p>
  <p class="mt-3 min-w-0 font-display text-sub text-fg">
    <time datetime={view.datetime}>
      {view.title.map((line) => (
        <span class="block truncate">{line}</span>
      ))}
    </time>
  </p>
  <dl class="mt-7 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-line pt-5 @md:grid-cols-3">
    {rows.map((row) => (
      <div class="grid min-w-0 content-start gap-1">
        <dt class="text-sm text-fg-muted">{row.label}</dt>
        <dd class="text-base leading-6 font-medium text-fg wrap-anywhere">{row.value}</dd>
      </div>
    ))}
  </dl>
  {view.seats && <SeatRing seats={view.seats} text={view.facts.seats} class="mt-6" />}
  {showAction && view.action && (
    <a
      href={view.action.href}
      class:list={[
        button({ variant: view.state === 'full' ? 'secondary' : 'primary', size: 'lg' }),
        'mt-8 w-fit max-sm:w-full',
      ]}
      data-umami-event="cta-click"
      data-umami-event-location={location}
      data-umami-event-state={view.state}
    >
      {view.action.label}
    </a>
  )}
</div>
