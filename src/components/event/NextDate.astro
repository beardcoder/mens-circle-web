---
import { type DateStatus, nextDateView, readDateStatus } from '@lib/event-status';
import { card } from '@lib/ui';

import Button from '../ui/Button.astro';
import EventSummary from './EventSummary.astro';

/**
 * The next date beside the e-mail notification, a server island; without `state` it
 * reads the date. With none planned it offers the notification; failed reads retain their own state.
 */

interface Props {
  state?: DateStatus;
  location: string;
}

const { location } = Astro.props;
const view = nextDateView(Astro.props.state ?? (await readDateStatus()), 'notify');
---

{view.state === 'none' ? (
  <div class:list={[card, 'grid gap-4 p-6 sm:p-8']}>
    <h3 class="text-sub text-fg">Der nächste Termin folgt</h3>
    <p class="text-md text-fg-soft">
      Zurzeit steht kein Termin fest. Wenn du möchtest, bekommst du eine E-Mail, sobald der nächste Abend geplant ist.
    </p>
    <Button
      href="#newsletter"
      variant="secondary"
      decorate
      class="justify-self-start max-sm:w-full"
    >
      Per E-Mail erfahren
    </Button>
  </div>
) : (
  <EventSummary
    view={view}
    location={location}
  />
)}
