---
import site from '@data/site.json';
import { primaryAction, type DateStatus } from '@lib/event-status';
import { link } from '@lib/ui';
import NewsletterForm from '../forms/NewsletterForm.astro';
import SeatCircle from '../SeatCircle.astro';
import Button from '../ui/Button.astro';
import DefList from '../ui/DefList.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Section from '../ui/Section.astro';
import Split from '../ui/Split.astro';

/**
 * The one block on /event that depends on live data, on the night ground right
 * under the page opening: the date as the flyer sets it, its facts, the seats and
 * the action; then the way to hear about the next one. Three states: scheduled,
 * none, and a failed read, which never reads as "no date planned".
 */

interface Props {
  state: DateStatus;
}

const { state } = Astro.props;
const { next } = state;
const action = primaryAction(state, '#benachrichtigung');
const whatsapp = site.whatsappCommunityLink;
// "Freitag, 23. Oktober 2026" → weekday, day, month and year, for the poster layout only.
const [, weekday = '', day = '', monthYear = ''] = next?.dateLabel.match(/^(.+?),\s*(\d+)\.\s*(.+)$/) ?? [];
const seatsLabel = next
  ? state.isFull
    ? `Alle ${next.maxParticipants} Plätze vergeben`
    : `${next.availableSpots} von ${next.maxParticipants} Plätzen frei`
  : '';

const rows = next
  ? [
      ...(next.timeRange ? [{ label: 'Uhrzeit', value: next.timeRange }] : []),
      { label: 'Ort', value: next.place, note: 'Die genaue Adresse bekommst du mit der Anmeldebestätigung.' },
      {
        label: 'Plätze',
        value: state.isFull
          ? 'Ausgebucht – du kannst auf die Warteliste'
          : `${next.availableSpots} von ${next.maxParticipants} frei`,
        note: state.isFull
          ? 'Wird ein Platz frei, rückst du automatisch nach.'
          : 'Für die Anmeldung genügen Vor- und Nachname und eine E-Mail-Adresse.',
      },
      ...(next.costBasis ? [{ label: 'Beitrag', value: next.costBasis }] : []),
    ]
  : [];
---

<Section id="naechster-termin" ground="night" space="none" class="pt-8 pb-section" labelledby="naechster-termin-title">
  {next ? (
    <div class="grid items-center gap-group lg:grid-cols-12 lg:gap-x-grid">
      <div class="lg:col-span-7">
        <Eyebrow plain tone="fg">
          Nächster Termin
        </Eyebrow>
        <h2 id="naechster-termin-title" class="mt-4 mb-8">
          <time datetime={next.slug}>
            <span class="sr-only">{next.dateLabel}</span>
            <span
              class="block font-sans text-[clamp(1.875rem,1rem+3.4vw,3.75rem)] leading-[1.05] font-bold tracking-[0.02em] text-accent uppercase"
              aria-hidden="true"
            >
              {day ? `${weekday.slice(0, 2)} · ${day}. ${monthYear}` : next.dateLabel}
            </span>
          </time>
        </h2>

        <DefList rows={rows} />

        <Button
          href={action.href}
          size="lg"
          class="mt-8 max-sm:w-full"
          data-umami-event="cta-click"
          data-umami-event-location="event-landing"
          data-umami-event-state={state.status}
        >
          {action.label}
        </Button>
      </div>

      <figure class="grid grid-cols-[6rem_minmax(0,1fr)] items-center gap-4 lg:col-span-4 lg:col-start-9 lg:grid-cols-1 lg:justify-items-center">
        <SeatCircle
          seats={next.maxParticipants}
          taken={next.maxParticipants - next.availableSpots}
          ember
          label={seatsLabel}
          class="w-full lg:w-[min(100%,20rem)]"
        />
        <figcaption class="text-lg font-bold text-fg-soft">{seatsLabel}</figcaption>
      </figure>
    </div>
  ) : (
    <Split alignToTitle>
      <div slot="head" class="grid gap-5">
        <Eyebrow>Nächster Termin</Eyebrow>
        <h2 id="naechster-termin-title" class="max-w-[16ch] text-display-2 text-fg">
          {state.status === 'unavailable' ? 'Termine gerade nicht abrufbar' : 'Zurzeit steht kein Termin fest'}
        </h2>
      </div>
      {/* A failed read is not a calm "nothing scheduled": it is marked. */}
      <p
        data-status={state.status}
        class="max-w-measure text-lg text-fg-soft data-[status=unavailable]:border-l-2 data-[status=unavailable]:border-accent data-[status=unavailable]:pl-4 data-[status=unavailable]:text-fg"
      >
        {state.status === 'unavailable'
          ? 'Die Termine lassen sich im Moment nicht laden. Das heißt nicht, dass keiner geplant ist – bitte versuche es später noch einmal oder schreib mir kurz.'
          : 'Sobald der nächste Abend geplant ist, steht er hier. Du musst dafür nicht regelmäßig nachsehen: Trag dich unten ein, dann bekommst du eine kurze Nachricht.'}
      </p>
    </Split>
  )}

  <div id="benachrichtigung" class="mt-group scroll-mt-(--spacing-clearance) border-t border-line pt-group">
    <Split>
      <div slot="head" class="grid gap-3">
        <h3 class="text-2xl text-fg">Bei neuen Terminen benachrichtigen</h3>
        <p class="max-w-measure text-md text-fg-soft">
          Du bekommst eine kurze Nachricht, sobald der nächste Männerkreis feststeht. Mehr wird über diesen Verteiler
          nicht verschickt.
        </p>
      </div>

      <NewsletterForm context={{ page: 'event-landing' }} />

      {whatsapp && (
        <p class="mt-6 max-w-measure text-sm text-fg-muted" id="whatsapp-community">
          Wenn du dich lieber zwischendurch austauschen möchtest, gibt es außerdem eine{' '}
          <a
            class={link}
            href={whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event="whatsapp-click"
            data-umami-event-type="community-join"
          >
            WhatsApp-Gruppe
            <span class="sr-only"> (öffnet WhatsApp in einem neuen Tab)</span>
          </a>
          .
        </p>
      )}
    </Split>
  </div>
</Section>
