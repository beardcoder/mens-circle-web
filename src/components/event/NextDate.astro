---
import site from '@data/site.json';
import { primaryAction, type DateStatus } from '@lib/event-status';
import { capPanel, link, panel } from '@lib/ui';
import NewsletterForm from '../forms/NewsletterForm.astro';
import SeatMeter from '../SeatMeter.astro';
import Button from '../ui/Button.astro';
import DefList from '../ui/DefList.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Section from '../ui/Section.astro';

/**
 * The one block on /event that depends on live data: the next date as a large
 * card (when, where, seats, the action) beside the way to hear about the next
 * one. Three states: scheduled, none, and a failed read, which never reads as
 * "no date planned".
 */

interface Props {
  state: DateStatus;
}

const { state } = Astro.props;
const { next } = state;
const action = primaryAction(state, '#benachrichtigung');
const [weekday, ...rest] = next ? next.dateLabel.split(', ') : [''];
const dayMonthYear = rest.join(', ');
const whatsapp = site.whatsappCommunityLink;
const seatsLabel = next
  ? state.isFull
    ? `Alle ${next.maxParticipants} Plätze vergeben`
    : `${next.availableSpots} von ${next.maxParticipants} Plätzen frei`
  : '';

const rows = next
  ? [
      ...(next.timeRange ? [{ label: 'Uhrzeit', value: next.timeRange }] : []),
      { label: 'Ort', value: next.place, note: 'Die genaue Adresse bekommst du mit der Anmeldebestätigung.' },
      {
        label: 'Plätze',
        value: state.isFull
          ? 'Ausgebucht – du kannst auf die Warteliste'
          : `${next.availableSpots} von ${next.maxParticipants} frei`,
        note: state.isFull
          ? 'Wird ein Platz frei, rückst du automatisch nach.'
          : 'Für die Anmeldung genügen Vor- und Nachname und eine E-Mail-Adresse.',
      },
      ...(next.costBasis ? [{ label: 'Beitrag', value: next.costBasis }] : []),
    ]
  : [];
---

<Section
  id="naechster-termin"
  labelledby="naechster-termin-title"
  innerClass="grid items-start gap-6 lg:grid-cols-12 lg:gap-x-grid"
>
  <div class:list={[capPanel, 'lg:col-span-7']}>
    {next ? (
      <>
        <Eyebrow>Nächster Termin</Eyebrow>
        <h2 id="naechster-termin-title" class="mt-4 text-display-3 text-fg">
          {/* The weekday in the italic accent on its own line, as in an event's opening. */}
          <time datetime={next.slug}>
            <em>{weekday},</em>
            <br />
            {dayMonthYear}
          </time>
        </h2>
        <SeatMeter
          seats={next.maxParticipants}
          taken={next.maxParticipants - next.availableSpots}
          label={seatsLabel}
          class="mt-5"
        />

        <DefList rows={rows} class="mt-6 border-t border-line pt-5" />

        <Button
          href={action.href}
          size="lg"
          class="mt-8 max-sm:w-full"
          data-umami-event="cta-click"
          data-umami-event-location="event-landing"
          data-umami-event-state={state.status}
        >
          {action.label}
        </Button>
      </>
    ) : (
      <>
        <Eyebrow>Nächster Termin</Eyebrow>
        <h2 id="naechster-termin-title" class="mt-4 text-display-3 text-fg">
          {state.status === 'unavailable' ? 'Termine gerade nicht abrufbar' : 'Zurzeit steht kein Termin fest'}
        </h2>
        {/* A failed read is not a calm "nothing scheduled": it is marked. */}
        <p
          data-status={state.status}
          class="mt-4 max-w-measure text-lg text-fg-soft data-[status=unavailable]:rounded-r-control data-[status=unavailable]:border-l-3 data-[status=unavailable]:border-accent data-[status=unavailable]:bg-accent-soft data-[status=unavailable]:px-4 data-[status=unavailable]:py-3 data-[status=unavailable]:text-fg"
        >
          {state.status === 'unavailable'
            ? 'Die Termine lassen sich im Moment nicht laden. Das heißt nicht, dass keiner geplant ist – bitte versuche es später noch einmal oder schreib mir kurz.'
            : 'Sobald der nächste Abend geplant ist, steht er hier. Du musst dafür nicht regelmäßig nachsehen: Trag dich ein, dann bekommst du eine kurze Nachricht.'}
        </p>
      </>
    )}
  </div>

  <div id="benachrichtigung" class:list={[panel, 'scroll-mt-(--spacing-clearance) lg:col-span-5']}>
    <Eyebrow>In Verbindung bleiben</Eyebrow>
    <h3 class="mt-4 text-2xl text-fg">
      Bei neuen Terminen <em>benachrichtigen</em>
    </h3>
    <p class="mt-2 mb-6 text-base text-fg-soft">
      Du bekommst eine kurze Nachricht, sobald der nächste Männerkreis feststeht. Mehr wird über diesen Verteiler nicht
      verschickt.
    </p>

    <NewsletterForm context={{ page: 'event-landing' }} />

    {whatsapp && (
      <p class="mt-5 text-sm text-fg-muted" id="whatsapp-community">
        Wenn du dich lieber zwischendurch austauschen möchtest, gibt es außerdem eine{' '}
        <a
          class={link}
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          data-umami-event="whatsapp-click"
          data-umami-event-type="community-join"
        >
          WhatsApp-Gruppe
          <span class="sr-only"> (öffnet WhatsApp in einem neuen Tab)</span>
        </a>
        .
      </p>
    )}
  </div>
</Section>
