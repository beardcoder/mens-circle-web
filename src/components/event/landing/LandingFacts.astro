---
import { buildEventFacts, type NextEventSummary } from '@lib/event-landing';

/**
 * The quick-scan facts, same builder as the home page's list, so the two pages
 * cannot state different facts. Never more precise than the city: the exact
 * address goes out with the registration confirmation.
 */

interface Props {
  next: NextEventSummary | null;
}

const { next } = Astro.props;
const facts = buildEventFacts(next);
---

<section class="section section--ruled event-landing-facts" aria-labelledby="fakten-title">
  <div class="container">
    <div class="spine">
      <h2 class="rail-heading" id="fakten-title">Gut zu wissen</h2>

      <dl class="deflist spine__body--wide" data-reveal-group="55">
        {
          facts.map((fact) => (
            <div class="deflist__row" data-reveal="up">
              <dt class="deflist__term">{fact.label}</dt>
              <dd class="deflist__desc">
                {fact.value}
                <span class="deflist__note">{fact.sub}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
