---
import site from '@data/site.json';

/**
 * /event opening.
 *
 * Short on purpose: this page is about a date, so the heading names the page
 * and the very next block carries the date itself. The invitation copy that
 * used to run here — three paragraphs explaining what an evening is — is on the
 * home page, where someone arriving cold actually needs it.
 *
 * Non-breaking spaces in the kicker so a phone breaks after "Männerkreis ·"
 * instead of orphaning "Niederbayern".
 */

interface Props {
  /** City of the next scheduled event, or null when nothing is scheduled. */
  place: string | null;
}

const { place } = Astro.props;

const kicker = 'Männerkreis · Straubing / Niederbayern';
const locality = place && place !== site.geo.locality ? place : site.geo.locality;
---

<section class="page-opening">
  <div class="container">
    <div class="page-opening__inner">
      <p class="marker marker--ruled page-opening__eyebrow">{kicker}</p>

      <h1 class="page-opening__title">Termine und Anmeldung</h1>

      <p class="page-opening__lead">
        Wir treffen uns alle zwei bis vier Wochen in {locality} in Niederbayern. Ein Abend dauert zwei bis drei Stunden, läuft
        auf Spendenbasis und setzt keine Vorerfahrung voraus. Wenn du noch nicht weißt, was dich erwartet, lies zuerst, <a
          class="link"
          href="/#ueber">worum es an so einem Abend geht</a
        >.
      </p>
    </div>
  </div>
</section>

<style is:global>
  @layer sections {
    .page-opening {
      padding-block: calc(var(--header-clearance) + var(--space-md)) var(--space-lg);
    }

    .page-opening__inner {
      max-inline-size: var(--measure-wide);
    }

    .page-opening__eyebrow {
      margin-block-end: var(--space-sm);
      color: var(--text-primary);
    }

    .page-opening__title {
      margin-block-end: var(--space-sm);
      font-size: var(--display-3);
      line-height: 0.98;
      letter-spacing: -0.015em;
      text-wrap: balance;
    }

    .page-opening__lead {
      max-inline-size: var(--measure);
      margin: 0;
      font-size: var(--text-section-body-lg);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
    }

    .page-opening__cta {
      margin-block-start: var(--space-md);
    }
  }
</style>
