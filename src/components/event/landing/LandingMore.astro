---
/**
 * Weiterlesen — the page's exit, not a link dump.
 *
 * Reordered by what a hesitant first-timer actually wants next: who holds the
 * evening, what a Männerkreis is at all, what other men say, and finally
 * something he can do right now without committing to anything. The first link
 * carries the weight of a lead-in; the rest stay quiet.
 */
const links = [
  {
    href: '/warum-ich-den-maennerkreis-leite',
    title: 'Meine Haltung',
    text: 'Warum ich diesen Kreis leite, was mir wichtig ist und was du von mir erwarten kannst.',
    feature: true,
  },
  {
    href: '/#ueber',
    title: 'Was ist ein Männerkreis?',
    text: 'Worum es im Kreis geht – und worum ausdrücklich nicht.',
    feature: false,
  },
  {
    href: '/#stimmen',
    title: 'Stimmen aus dem Kreis',
    text: 'Was Männer nach einem Abend erzählt haben.',
    feature: false,
  },
  {
    href: '/atemuebung',
    title: 'Atemübung',
    text: 'Eine geführte Übung, die du sofort ausprobieren kannst.',
    feature: false,
  },
];
---

<section class="section event-landing-more" aria-labelledby="mehr-title">
  <div class="container">
    <div class="section-header section-header--start" data-reveal-group>
      <p class="eyebrow" data-reveal="up">Weiterlesen</p>
      <h2 class="section-title" id="mehr-title" data-reveal="blur">
        Bevor du <span class="text-italic">dabei bist</span>
      </h2>
    </div>

    <ul class="event-landing-more__list" role="list" data-reveal-group="90">
      {
        links.map((link) => (
          <li
            class:list={['event-landing-more__item', link.feature && 'event-landing-more__item--feature']}
            data-reveal="up"
          >
            <a href={link.href} data-hover="lift">
              <h3>{link.title}</h3>
              <p>{link.text}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style is:global>
  @layer sections {
    .event-landing-more__list {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-sm);
      padding: 0;
      margin: 0;
      list-style: none;

      @media (width <= 1000px) {
        grid-template-columns: repeat(2, 1fr);
      }

      @media (width <= 600px) {
        grid-template-columns: 1fr;
      }
    }

    /* The lead-in link spans the row above the other three. */
    .event-landing-more__item--feature {
      grid-column: 1 / -1;
    }

    .event-landing-more__item a {
      display: block;
      block-size: 100%;
      padding: var(--space-sm);
      color: inherit;
      text-decoration: none;
      background: var(--bg-elevated);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      transition: border-color var(--motion-quick);
    }

    .event-landing-more__item a:hover,
    .event-landing-more__item a:focus-visible {
      border-color: var(--accent-primary);
    }

    .event-landing-more__item--feature a {
      padding: var(--space-md);
      border-inline-start: 3px solid var(--accent-primary);
    }

    .event-landing-more__item h3 {
      margin-block-end: var(--space-3xs);
      font-size: var(--text-base);
      color: var(--text-primary);
    }

    .event-landing-more__item--feature h3 {
      font-size: var(--text-xl);
      line-height: 1.15;
    }

    .event-landing-more__item p {
      font-size: var(--text-sm);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
      text-wrap: pretty;
    }

    .event-landing-more__item--feature p {
      max-inline-size: var(--content-max-description);
      font-size: var(--text-section-body);
    }
  }
</style>
