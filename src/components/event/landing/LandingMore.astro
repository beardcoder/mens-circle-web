---
/**
 * Weiterlesen — the page's exit.
 *
 * A plain hairline list, ordered by what someone who has just read the date
 * actually wants next: what an evening is, who holds it, and something he can
 * try on his own. It used to be a three-up card grid with a feature card
 * spanning the row.
 */
const links = [
  {
    href: '/#ueber',
    title: 'Worum es an so einem Abend geht',
    text: 'Der Ablauf, der Rahmen und was der Kreis ausdrücklich nicht ist.',
  },
  {
    href: '/warum-ich-den-maennerkreis-leite',
    title: 'Warum ich den Männerkreis leite',
    text: 'Ein persönlicher Text von Markus: was ihm wichtig ist und was du von ihm erwarten kannst.',
  },
  {
    href: '/#stimmen',
    title: 'Stimmen aus dem Kreis',
    text: 'Was Männer nach einem Abend geschrieben haben.',
  },
  {
    href: '/atemuebung',
    title: 'Atemübung',
    text: 'Eine geführte Übung, die du sofort ausprobieren kannst. Für den Männerkreis brauchst du sie nicht.',
  },
];
---

<section class="section section--ruled event-landing-more" aria-labelledby="mehr-title">
  <div class="container">
    <div class="spine">
      <h2 class="rail-heading" id="mehr-title">Weiterlesen</h2>

      <ul class="event-landing-more__list spine__body--wide" role="list" data-reveal-group="55">
        {
          links.map((link) => (
            <li class="event-landing-more__item" data-reveal="up">
              <a href={link.href}>
                <span class="event-landing-more__title">{link.title}</span>
                <span class="event-landing-more__text">{link.text}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style is:global>
  @layer sections {
    .event-landing-more__list {
      padding: 0;
      margin: 0;
      list-style: none;
      border-block-start: 1px solid var(--border-light);
    }

    .event-landing-more__item {
      border-block-end: 1px solid var(--border-light);
    }

    .event-landing-more__item a {
      display: grid;
      gap: var(--space-3xs);
      padding-block: var(--space-sm);
      color: inherit;
      text-decoration: none;
    }

    .event-landing-more__item a:hover .event-landing-more__title,
    .event-landing-more__item a:focus-visible .event-landing-more__title {
      color: var(--accent-text);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    .event-landing-more__item a:focus-visible {
      outline: 2px solid var(--accent-primary);
      outline-offset: 2px;
    }

    .event-landing-more__title {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      line-height: 1.25;
      color: var(--text-primary);
      transition: color var(--motion-quick);
    }

    .event-landing-more__text {
      max-inline-size: var(--measure);
      font-size: var(--text-section-body);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
    }
  }
</style>
