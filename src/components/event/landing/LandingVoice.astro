---
import type { Testimonial } from '@lib/types';

/**
 * One real voice. Deliberately not a second testimonials grid — that would put
 * the same quotes on two indexed URLs and cost another full query. Takes the top
 * curated entry as a pull quote, quoted as submitted, and renders nothing when
 * none is published.
 */

interface Props {
  voice: Testimonial | null;
}

const { voice } = Astro.props;
---

{
  voice && (
    <section class="section section--ruled event-landing-voice" aria-label="Stimme aus dem Kreis">
      <div class="container">
        <div class="spine">
          <p class="rail-heading">Aus dem Kreis</p>

          <figure class="event-landing-voice__figure spine__body" data-reveal="fade">
            <blockquote class="event-landing-voice__quote">{voice.quote}</blockquote>
            {(voice.author || voice.role) && (
              <figcaption class="event-landing-voice__author">
                {voice.author && <cite class="event-landing-voice__name">{voice.author}</cite>}
                {voice.role && <span class="event-landing-voice__role">{voice.role}</span>}
              </figcaption>
            )}
          </figure>
        </div>
      </div>
    </section>
  )
}

<style is:global>
  @layer sections {
    .event-landing-voice__figure {
      max-inline-size: var(--measure);
      margin: 0;
    }

    /* Sized to be read, not to be admired: submitted quotes run to a dozen
       lines, and a dozen lines of 2rem display serif is a wall. */
    .event-landing-voice__quote {
      margin: 0;
      font-family: var(--font-display);
      font-size: var(--text-lg);
      line-height: var(--leading-normal);
      color: var(--text-primary);
      text-wrap: pretty;
    }

    .event-landing-voice__author {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3xs) var(--space-xs);
      align-items: baseline;
      margin-block-start: var(--space-sm);
    }

    .event-landing-voice__name {
      font-size: var(--text-caption);
      font-style: normal;
      font-weight: 600;
      color: var(--text-primary);
    }

    .event-landing-voice__role {
      font-size: var(--text-caption);
      color: var(--text-muted);
    }
  }
</style>
