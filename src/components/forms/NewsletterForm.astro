---
import Button from '../ui/Button.astro';
import Honeypot from './Honeypot.astro';
import { control, fieldError, fieldLabel } from '@lib/ui';

/** "Bei neuen Terminen benachrichtigen" — one address into the listmonk list. */
interface Props {
  /** Analytics context sent with the Umami events. */
  context?: Record<string, string>;
  /** The form's id; also prefixes the field ids, so a page can render it twice. */
  id?: string;
}

const { context = {}, id = 'newsletter-form' } = Astro.props;
---

<form
  id={id}
  data-form="newsletter"
  data-track="newsletter"
  data-track-context={JSON.stringify(context)}
  class="flex max-w-lg flex-col items-stretch gap-x-4 gap-y-2 sm:flex-row sm:items-end"
>
  <Honeypot />

  {/* A real, visible <label>, not an aria-label over a placeholder. */}
  <div class="min-w-0 flex-1">
    <label class={fieldLabel} for={`${id}-email`}>
      E-Mail-Adresse
    </label>
    <input
      id={`${id}-email`}
      type="email"
      name="email"
      placeholder="name@beispiel.de"
      required
      autocomplete="email"
      inputmode="email"
      aria-describedby={`${id}-email-error`}
      class={control()}
    />
  </div>

  <Button type="submit" decorate={false}>
    Anmelden
  </Button>
</form>
{/* After the form, not inside it: a third item would compete with the input/button pair for the line. */}
<span class={fieldError} id={`${id}-email-error`} hidden></span>

<script>
  import { actions } from 'astro:actions';
  import { enhanceForms } from '@lib/form';

  enhanceForms('newsletter', actions.subscribeNewsletter);
</script>
