---
import { checkbox, control, fieldError, link } from '@lib/ui';
import Button from '../ui/Button.astro';
import Field from '../ui/Field.astro';
import Honeypot from './Honeypot.astro';

/** Registration for one event: name, email, an optional phone number and the privacy consent. */
interface Props {
  eventId: string;
  isFull: boolean;
}

const { eventId, isFull } = Astro.props;
---

<form
  id="register"
  autocomplete="on"
  data-form="register"
  data-track="event-registration"
  data-track-context={JSON.stringify({ event_id: eventId })}
  class="grid gap-5"
>
  <input type="hidden" name="event_id" value={eventId} />
  <Honeypot />

  <div class="grid gap-5 sm:grid-cols-2 sm:gap-4">
    <Field for="firstName" label="Vorname" errorId="register-first_name-error">
      <input
        type="text"
        id="firstName"
        name="first_name"
        placeholder="Dein Vorname"
        required
        autocomplete="given-name"
        aria-describedby="register-first_name-error"
        class={control()}
      />
    </Field>

    <Field for="lastName" label="Nachname" errorId="register-last_name-error">
      <input
        type="text"
        id="lastName"
        name="last_name"
        placeholder="Dein Nachname"
        required
        autocomplete="family-name"
        aria-describedby="register-last_name-error"
        class={control()}
      />
    </Field>
  </div>

  <Field for="email" label="E-Mail" errorId="register-email-error">
    <input
      type="email"
      id="email"
      name="email"
      placeholder="deine@email.de"
      required
      autocomplete="email"
      inputmode="email"
      aria-describedby="register-email-error"
      class={control()}
    />
  </Field>

  <Field
    for="phone"
    label="Handynummer"
    optional
    hint="Falls wir dich am Veranstaltungstag kurzfristig erreichen müssen."
    hintId="register-phone-hint"
  >
    <input
      type="tel"
      id="phone"
      name="phone_number"
      placeholder="+49 170 1234567"
      autocomplete="tel"
      inputmode="tel"
      aria-describedby="register-phone-hint"
      class={control()}
    />
  </Field>

  <div>
    <label class="flex cursor-pointer items-start gap-3">
      <input type="checkbox" name="privacy" required aria-describedby="register-privacy-error" class={checkbox} />
      <span class="text-sm text-fg-soft">
        Ich habe die{' '}
        <a href="/datenschutz" target="_blank" rel="noopener" class={link}>
          Datenschutzerklärung<span class="sr-only"> (öffnet in neuem Tab)</span>
        </a>{' '}
        gelesen und stimme der Verarbeitung meiner Daten zu.
      </span>
    </label>
    <span class={fieldError} id="register-privacy-error" hidden></span>
  </div>

  <Button type="submit" size="lg" block class="mt-2">
    {isFull ? 'Auf Warteliste eintragen' : 'Verbindlich anmelden'}
  </Button>
</form>

<script>
  import { actions } from 'astro:actions';
  import { enhanceForms } from '@lib/form';

  enhanceForms('register', actions.register);
</script>
