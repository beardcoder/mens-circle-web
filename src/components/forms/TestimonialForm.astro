---
import { checkbox, control, fieldError, link } from '@lib/ui';
import Button from '../ui/Button.astro';
import Field from '../ui/Field.astro';
import Honeypot from './Honeypot.astro';

/** "Teile deine Erfahrung" — stored unpublished for moderation. Required fields carry `required`; the rest say "(optional)". */
---

<form id="testimonial" data-form="testimonial" data-track="testimonial" data-track-context="{}" class="grid gap-6">
  <Honeypot />

  <Field for="quote" label="Deine Erfahrung" errorId="testimonial-quote-error">
    <textarea
      id="quote"
      name="quote"
      rows="6"
      placeholder="z. B. „Hier kann ich ich selbst sein, ohne Maske und ohne Leistungsdruck …“"
      required
      minlength="10"
      maxlength="1000"
      aria-describedby="testimonial-quote-error testimonial-quote-hint"
      class:list={[control(), 'min-h-40 resize-y']}
    ></textarea>
    {/* The rule and the live count on one line under the field. */}
    <span class="mt-1.5 flex justify-between gap-4 text-sm text-fg-muted">
      <span id="testimonial-quote-hint">Mindestens 10, höchstens 1000 Zeichen.</span>
      <span class="tabular-nums" aria-hidden="true">
        <span data-char-count>0</span>/1000
      </span>
    </span>
  </Field>

  <Field for="author_name" label="Dein Name" optional hint="Leer lassen, wenn du anonym bleiben möchtest.">
    <input
      type="text"
      id="author_name"
      name="author_name"
      placeholder="z. B. Michael"
      maxlength="255"
      class={control()}
    />
  </Field>

  <Field for="role" label="Rolle oder Beschreibung" optional>
    <input
      type="text"
      id="role"
      name="role"
      placeholder="z. B. Teilnehmer seit 2023"
      maxlength="255"
      class={control()}
    />
  </Field>

  <Field
    for="testimonial_email"
    label="E-Mail-Adresse"
    hint="Wird nicht veröffentlicht. Nur für Rückfragen."
    hintId="testimonial-email-hint"
    errorId="testimonial-email-error"
  >
    <input
      type="email"
      id="testimonial_email"
      name="email"
      placeholder="deine@email.de"
      required
      maxlength="255"
      autocomplete="email"
      aria-describedby="testimonial-email-error testimonial-email-hint"
      class={control()}
    />
  </Field>

  <div>
    <label class="flex cursor-pointer items-start gap-3">
      <input type="checkbox" name="privacy" required aria-describedby="testimonial-privacy-error" class={checkbox} />
      <span class="text-base text-fg">
        Ich habe die{' '}
        <a href="/datenschutz" target="_blank" rel="noopener" class={link}>
          Datenschutzerklärung<span class="sr-only"> (öffnet in neuem Tab)</span>
        </a>{' '}
        zur Kenntnis genommen und bin damit einverstanden, dass meine Daten zum Zwecke der Veröffentlichung gespeichert
        werden.
      </span>
    </label>
    <span class={fieldError} id="testimonial-privacy-error" hidden></span>
  </div>

  <div class="grid justify-items-start gap-3">
    <Button type="submit" size="lg" class="max-sm:w-full">
      Erfahrung teilen
    </Button>
    <p class="text-sm text-fg-muted">Dein Text wird erst nach Prüfung veröffentlicht.</p>
  </div>
</form>

<script>
  import { actions } from 'astro:actions';
  import { enhanceForms } from '@lib/form';

  enhanceForms('testimonial', actions.submitTestimonial);

  // Live character count under the textarea; reset with the form.
  const quote = document.querySelector<HTMLTextAreaElement>('#quote');
  const count = document.querySelector('[data-char-count]');
  const update = (): void => {
    if (quote && count) count.textContent = String(quote.value.length);
  };
  quote?.addEventListener('input', update);
  quote?.form?.addEventListener('reset', () => setTimeout(update));
</script>
