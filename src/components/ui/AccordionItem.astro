---
interface Props {
  question: string;
}

const { question } = Astro.props;
---

<details
  itemprop="mainEntity"
  itemscope
  itemtype="https://schema.org/Question"
  data-accordion
  class="group/item border-t border-line"
>
  <summary
    class="group/q flex min-h-18 list-none items-center justify-between gap-6 py-5 text-left [&::-webkit-details-marker]:hidden"
    data-umami-event="faq-expand"
    data-umami-event-question={question.slice(0, 50)}
  >
    <span
      itemprop="name"
      class="font-sans text-xl font-semibold text-pretty text-fg transition-colors duration-180 group-hover/q:text-accent"
    >
      {question}
    </span>
    {/* A plus whose upright bar folds away into a minus when open. */}
    <span
      aria-hidden="true"
      class="relative grid size-9 shrink-0 place-items-center rounded-full bg-accent-soft text-accent transition-[background-color,color,rotate] duration-200 ease-out item-open:rotate-180 item-open:bg-fill item-open:text-on-fill before:absolute before:h-[1.5px] before:w-3 before:bg-current after:absolute after:h-3 after:w-[1.5px] after:bg-current after:transition-[scale] after:duration-180 item-open:after:scale-y-0"
    />
  </summary>
  <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer" data-accordion-panel>
    <div
      itemprop="text"
      class="max-w-measure pb-7 text-md text-fg-soft [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-[3px]"
    >
      <slot />
    </div>
  </div>
</details>

<script>
  /**
   * The answer unfolds and folds on the compositor (FLIP): the layout changes once,
   * at the press; then everything after the item (its siblings, the sections below,
   * the footer) slides from where it stood, while the answer is uncovered by a clip
   * on the same spring, so their edges meet. No height is animated, so no frame
   * needs a layout. The item stays open until its answer has closed (`data-closing`
   * turns the marker back at once); a press while it moves waits for the end. Under
   * reduced motion the native toggle stays.
   */
  import { spring } from 'motion';
  import { animate } from 'motion/mini';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const unfold = { type: spring, visualDuration: 0.6, bounce: 0 } as const;
  const fold = { type: spring, visualDuration: 0.45, bounce: 0 } as const;

  /** What comes after the item in the page and moves with it: never fixed bars or hidden nodes. */
  const followers = (item: Element): HTMLElement[] => {
    const found: HTMLElement[] = [];

    for (let node: Element | null = item; node && node !== document.body; node = node.parentElement) {
      for (let next = node.nextElementSibling; next; next = next.nextElementSibling) {
        if (next instanceof HTMLElement && (next.checkVisibility?.() ?? true)) found.push(next);
      }
    }

    return found.filter((el) => getComputedStyle(el).position !== 'fixed');
  };

  for (const item of document.querySelectorAll<HTMLDetailsElement>('details[data-accordion]')) {
    const summary = item.querySelector('summary');
    const panel = item.querySelector<HTMLElement>('[data-accordion-panel]');
    const text = panel?.firstElementChild;
    let busy = false;

    if (!summary || !panel || !text) continue;

    const play = (moving: HTMLElement[], open: boolean, delta: number) => {
      const shut = 'inset(0 0 100% 0)';
      const whole = 'inset(0 0 0% 0)';
      const options = open ? unfold : fold;
      const away = `translateY(${-delta}px)`;

      busy = true;
      animate(panel, { clipPath: open ? [shut, whole] : [whole, shut] }, options);

      if (open) {
        animate(
          text,
          { opacity: [0, 1], transform: ['translateY(-0.375rem)', 'none'] },
          { ...unfold, opacity: { duration: 0.8, ease: [0.33, 0, 0.2, 1] } },
        );
      }

      const slide = moving.map((el) => animate(el, { transform: open ? [away, 'none'] : ['none', away] }, options));

      return Promise.all(slide).then(() => {
        busy = false;
      });
    };

    summary.addEventListener('click', (event) => {
      if (reduced.matches) return;

      event.preventDefault();

      if (busy) return;

      // Read everything first, then write: one layout for the whole press.
      const moving = followers(item);

      if (item.open) {
        const delta = panel.offsetHeight;

        item.setAttribute('data-closing', '');
        void play(moving, false, delta).then(() => {
          item.open = false;
          item.removeAttribute('data-closing');
          panel.style.removeProperty('clip-path');

          for (const el of moving) el.style.removeProperty('transform');
        });

        return;
      }

      item.open = true;
      void play(moving, true, panel.offsetHeight).then(() => {
        panel.style.removeProperty('clip-path');

        for (const el of moving) el.style.removeProperty('transform');
      });
    });
  }
</script>
