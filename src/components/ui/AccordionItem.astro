---
interface Props {
  question: string;
}

const { question } = Astro.props;
---

<details
  itemprop="mainEntity"
  itemscope
  itemtype="https://schema.org/Question"
  class="group/item rounded-xl border border-line bg-raised px-card transition-[border-color,box-shadow] duration-180 open:border-line-strong open:shadow-card [&::details-content]:h-0 [&::details-content]:overflow-clip [&::details-content]:transition-[height,content-visibility] [&::details-content]:duration-200 [&::details-content]:[transition-behavior:allow-discrete] open:[&::details-content]:h-auto"
>
  <summary
    class="group/q flex min-h-18 list-none items-center justify-between gap-6 py-5 text-left [&::-webkit-details-marker]:hidden"
    data-umami-event="faq-expand"
    data-umami-event-question={question.slice(0, 50)}
  >
    <span
      itemprop="name"
      class="font-sans text-xl font-semibold text-pretty text-fg transition-colors duration-180 group-hover/q:text-accent"
    >
      {question}
    </span>
    {/* A plus whose upright bar folds away into a minus when open. */}
    <span
      aria-hidden="true"
      class="relative grid size-9 shrink-0 place-items-center rounded-full bg-accent-soft text-accent transition-[background-color,color,rotate] duration-200 ease-out group-open/item:rotate-180 group-open/item:bg-fill group-open/item:text-on-fill before:absolute before:h-[1.5px] before:w-3 before:bg-current after:absolute after:h-3 after:w-[1.5px] after:bg-current after:transition-[scale] after:duration-180 group-open/item:after:scale-y-0"
    />
  </summary>
  <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
    <div
      itemprop="text"
      class="motion-safe:group-open/item:animate-fade-in max-w-measure pb-card text-md text-fg-soft [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-[3px]"
    >
      <slot />
    </div>
  </div>
</details>
