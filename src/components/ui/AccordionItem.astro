---
/**
 * One FAQ item: a native `<details>`, so keyboard and screen readers work as
 * always. The answer opens and closes with a height transition on
 * `::details-content` where `interpolate-size` exists (global.css, "FAQ"); elsewhere,
 * and under reduced motion, it toggles at once.
 */
interface Props {
  question: string;
}

const { question } = Astro.props;
---

<details
  itemprop="mainEntity"
  itemscope
  itemtype="https://schema.org/Question"
  data-accordion
  class="group/item border-t border-line"
>
  <summary
    class="group/q flex min-h-18 list-none items-center justify-between gap-6 py-5 text-left [&::-webkit-details-marker]:hidden"
    data-umami-event="faq-expand"
    data-umami-event-question={question.slice(0, 50)}
  >
    <span
      itemprop="name"
      class="font-sans text-xl font-semibold text-pretty text-fg transition-colors duration-180 group-hover/q:text-accent"
    >
      {question}
    </span>
    {/* A plus whose upright bar folds away into a minus when open. */}
    <span
      aria-hidden="true"
      class="relative grid size-9 shrink-0 place-items-center rounded-full bg-accent-soft text-accent transition-[background-color,color,rotate,scale] duration-200 ease-out group-active/q:scale-90 item-open:rotate-180 item-open:bg-fill item-open:text-on-fill before:absolute before:h-[1.5px] before:w-3 before:bg-current after:absolute after:h-3 after:w-[1.5px] after:bg-current after:transition-[scale] after:duration-180 item-open:after:scale-y-0"
    />
  </summary>
  <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
    <div
      itemprop="text"
      class="max-w-measure pb-7 text-md text-fg-soft [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-[3px]"
    >
      <slot />
    </div>
  </div>
</details>
