---
import { Icon } from 'astro-icon/components';
import { button, type ButtonSize, type ButtonVariant } from '@lib/ui';

/**
 * A link styled as a button when it has an `href`, a real `<button>` otherwise.
 * `decorate` adds an arrow after the label.
 */
interface Props {
  href?: string;
  variant?: ButtonVariant;
  size?: ButtonSize;
  /** Full width. */
  block?: boolean;
  /** An arrow after the label. */
  decorate?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  [attribute: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  block = false,
  decorate = false,
  type = 'button',
  class: className,
  ...attributes
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={href ? undefined : type}
  class:list={[button({ variant, size, block }), className]}
  {...attributes}
>
  <span data-label>
    <slot />
  </span>
  {decorate && (
    <Icon
      name="arrow"
      aria-hidden="true"
      class="size-[1.1em] shrink-0 transition-transform duration-180 group-hover/btn:translate-x-0.5"
    />
  )}
</Tag>
