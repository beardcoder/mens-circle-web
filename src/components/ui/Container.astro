---
/** The page's width: up to 1200px of content, 28 / 44 / 60px from the window in every section (`--page-pad`; a sheet pads less, as it stands in). Header, sections and footer share these edges. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={['mx-auto w-full max-w-[calc(var(--container-content)+2*var(--page-pad))] px-(--page-pad)', className]}
>
  <slot />
</div>
