---
/** The page's width: up to 1200px of content between the side margins (20 / 32 / 48px). Header, sections and footer share these edges. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['mx-auto w-full max-w-page px-gutter', className]}>
  <slot />
</div>
