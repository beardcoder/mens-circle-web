---
import { caps } from '@lib/ui';
/** Facts as a quiet definition list: the term in small capitals, the value set firm, rows parted by hairlines. */
interface Row {
  label: string;
  value: string;
  note?: string;
}

interface Props {
  rows: Row[];
  class?: string;
}

const { rows, class: className } = Astro.props;
---

<dl class:list={['divide-y divide-line', className]}>
  {rows.map((row) => (
    <div class="grid gap-x-6 gap-y-0.5 py-3.5 first:pt-0 last:pb-0 sm:grid-cols-[8rem_minmax(0,1fr)]">
      <dt class={`${caps} pt-1 text-fg-muted`}>{row.label}</dt>
      <dd class="text-base font-semibold text-fg">
        {row.value}
        {row.note && <span class="mt-0.5 block text-sm font-normal text-fg-muted">{row.note}</span>}
      </dd>
    </div>
  ))}
</dl>
