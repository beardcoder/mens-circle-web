---
/**
 * The line above a title: tiny bold capitals spaced wide, in the accent, behind a
 * fading rule. `center` gives it a rule on each side, mirrored, so a centred head's
 * label sits on the axis instead of leaning left.
 */
interface Props {
  as?: 'p' | 'span' | 'h2';
  id?: string;
  center?: boolean;
  class?: string;
}

const { as: Tag = 'p', id, center = false, class: className } = Astro.props;
const rule = 'h-[1.5px] w-[clamp(2.5rem,5vw,5rem)] shrink-0 from-transparent via-current/70 via-25% to-current/70';
---

<Tag
  id={id}
  class:list={[
    'inline-flex items-center gap-3 font-sans text-[0.7rem] leading-normal font-bold tracking-eyebrow text-accent uppercase',
    className,
  ]}
>
  <span class:list={[rule, 'bg-linear-to-r']} aria-hidden="true"></span>
  {/* The spaced capitals carry trailing tracking; a negative margin takes it back so the text sits centred. */}
  <span class:list={[center && '-mr-[0.32em]']}>
    <slot />
  </span>
  {center && <span class:list={[rule, 'bg-linear-to-l']} aria-hidden="true"></span>}
</Tag>
