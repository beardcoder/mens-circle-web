---
import { caps } from '@lib/ui';
/** The line above a title: small capitals in the accent, spaced like a stamp, behind a short bar. */
interface Props {
  as?: 'p' | 'span' | 'h2';
  id?: string;
  class?: string;
}

const { as: Tag = 'p', id, class: className } = Astro.props;
---

<Tag id={id} class:list={[caps, 'flex items-center gap-3 font-sans text-accent', className]}>
  <span class="h-0.5 w-6 shrink-0 bg-accent" aria-hidden="true"></span>
  <slot />
</Tag>
