---
/** A short label above a title: sentence case in the accent, after a small ember dot (the circle, once more). */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'p'>;

const { class: className, ...rest }: Props = Astro.props;
---

<p
  {...rest}
  class:list={[
    'inline-flex items-center gap-2.5 font-sans text-sm font-semibold text-accent before:size-2 before:shrink-0 before:rounded-full before:bg-fill',
    className,
  ]}
>
  <slot />
</p>
