---
/** The line above a title: small, in the accent, with a dot of flame in front. */
interface Props {
  as?: 'p' | 'span' | 'h2';
  id?: string;
  class?: string;
}

const { as: Tag = 'p', id, class: className } = Astro.props;
---

<Tag id={id} class:list={['flex items-center gap-2 font-sans text-sm font-semibold text-accent', className]}>
  <span class="size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
  <slot />
</Tag>
