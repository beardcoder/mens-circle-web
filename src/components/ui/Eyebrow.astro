---
/** The line above a title: tiny bold capitals spaced wide, in the accent, behind a fading rule. */
interface Props {
  as?: 'p' | 'span' | 'h2';
  id?: string;
  class?: string;
}

const { as: Tag = 'p', id, class: className } = Astro.props;
---

<Tag
  id={id}
  class:list={[
    'inline-flex items-center gap-3 font-sans text-[0.7rem] leading-normal font-bold tracking-eyebrow text-accent uppercase',
    className,
  ]}
>
  <span
    class="h-[1.5px] w-[clamp(2.5rem,5vw,5rem)] shrink-0 bg-linear-to-r from-transparent via-current/70 via-25% to-current/70"
    aria-hidden="true"
  ></span>
  <slot />
</Tag>
