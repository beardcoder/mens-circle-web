---
/**
 * An index number in the margin ("01"): Cormorant, in the accent on every
 * ground. Decoration beside a
 * title or a step that already says its place; hidden from assistive technology.
 */
interface Props {
  value: number
  /** `index` in the margin; `sub` above a short item in a list. */
  size?: 'index' | 'sub'
  class?: string
}

const SIZES = {
  index: 'text-index',
  sub: 'text-sub',
} as const

const { value, size = 'index', class: className } = Astro.props
---

<span
  aria-hidden="true"
  class:list={['block font-display font-semibold tabular-nums', SIZES[size], 'text-accent', className]}
>
  {String(value).padStart(2, '0')}
</span>
