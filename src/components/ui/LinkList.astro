---
import { Icon } from 'astro-icon/components';

/** Where to go next: whole rows between thin lines as links, a title, an optional line, a small arrow. */
interface Item {
  href: string;
  title: string;
  text?: string;
  prefetch?: boolean;
}

interface Props {
  items: Item[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ul
  class:list={['grid border-t border-line-strong', className]}
  role="list"
>
  {items.map((item) => (
    <li class="reveal border-b border-line-strong">
      <a
        href={item.href}
        data-astro-prefetch={item.prefetch ? 'hover' : undefined}
        class="group/row grid min-h-14 grid-cols-[minmax(0,1fr)_auto] items-center gap-x-6 gap-y-1 py-4"
      >
        <span class="text-xl font-semibold text-fg transition-colors duration-180 group-hover/row:text-accent">
          {item.title}
        </span>
        <Icon
          name="arrow"
          aria-hidden="true"
          class="col-start-2 row-span-2 row-start-1 size-5 text-accent transition-transform duration-180 group-hover/row:translate-x-0.5"
        />
        {item.text && <span class="text-base text-fg-muted">{item.text}</span>}
      </a>
    </li>
  ))}
</ul>
