---
import { Icon } from 'astro-icon/components'

import { rowDisc } from '@lib/ui'

/** Where to go next: whole rows between thin lines as links, a title, an optional line, a small arrow. */
interface Item {
  href: string
  title: string
  text?: string
}

interface Props {
  items: Item[]
  class?: string
}

const { items, class: className } = Astro.props
---

<ul
  class:list={['grid border-t border-line-strong', className]}
  role="list"
>
  {items.map((item) => (
    <li class="border-b border-line-strong">
      <a
        href={item.href}
        class="group/row grid min-h-14 grid-cols-[minmax(0,1fr)_auto] items-center gap-x-6 gap-y-1 py-4"
      >
        <span class="text-xl font-semibold text-fg transition-colors duration-180">{item.title}</span>
        <span aria-hidden="true" class:list={[rowDisc, 'col-start-2 row-span-2 row-start-1']}>
          <Icon name="arrow" class="size-4 motion-safe:transition-transform motion-safe:group-hover/row:translate-x-0.5" />
        </span>
        {item.text && <span class="text-base text-fg-muted">{item.text}</span>}
      </a>
    </li>
  ))}
</ul>
