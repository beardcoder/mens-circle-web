---
import { Icon } from 'astro-icon/components';

/** Where to go next: whole rows as links, a title, an optional line, an arrow that moves. */
interface Item {
  href: string;
  title: string;
  text?: string;
  prefetch?: boolean;
}

interface Props {
  items: Item[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ul class:list={['grid gap-3', className]} role="list">
  {items.map((item) => (
    <li>
      <a
        href={item.href}
        data-astro-prefetch={item.prefetch ? 'hover' : undefined}
        class="group/row grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-6 gap-y-1 rounded-card border border-line-strong bg-raised px-6 py-5 transition-[border-color,translate] duration-200 hover:-translate-y-0.5 hover:border-accent/50 motion-reduce:hover:translate-y-0"
      >
        <span class="font-serif text-xl font-semibold text-fg transition-colors duration-150 group-hover/row:text-accent">
          {item.title}
        </span>
        <Icon
          name="arrow"
          aria-hidden="true"
          class="col-start-2 row-span-2 row-start-1 size-5 text-accent transition-transform duration-200 group-hover/row:translate-x-1"
        />
        {item.text && <span class="text-sm text-fg-soft">{item.text}</span>}
      </a>
    </li>
  ))}
</ul>
