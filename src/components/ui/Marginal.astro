---
/**
 * A note in the margin column: small, after a short rule, in the secondary text
 * colour. What explains the content beside it without interrupting it (a boundary,
 * a caption, a hint).
 */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'p'>;

const { class: className, ...rest } = Astro.props;
---

<p
  {...rest}
  class:list={[
    'text-marginal font-medium text-fg-muted before:mb-3 before:block before:h-px before:w-8 before:bg-line-strong',
    className,
  ]}
>
  <slot />
</p>
