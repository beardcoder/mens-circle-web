---
/**
 * Rich text from the content files and the admin: paragraphs, links, lists,
 * subheadings, quotes and tables, on the reading measure. Element styles are
 * descendant variants, since the HTML arrives as a string.
 */
interface Props {
  html: string;
  /** `measure` a line of running text (~62 characters); `column` the wider reading column of the legal pages. */
  width?: 'measure' | 'column';
  class?: string;
}

const { html, width = 'measure', class: className }: Props = Astro.props;

const WIDTHS = { measure: 'max-w-measure', column: 'max-w-column' } as const;

const PROSE = [
  WIDTHS[width],
  'text-md text-fg-soft',
  '[&_p]:mb-[1.15em] [&_p:last-child]:mb-0',
  '[&_a]:text-accent [&_a]:underline [&_a]:underline-offset-[3px] [&_a:hover]:text-accent-strong',
  '[&_strong]:font-semibold [&_strong]:text-fg',
  '[&_h2]:mt-12 [&_h2]:mb-4 [&_h2]:text-sub [&_h2]:text-fg [&_h2:first-child]:mt-0',
  '[&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:font-sans [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-fg [&_h3:first-child]:mt-0',
  '[&_ul]:mb-[1.15em] [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:mb-[1.15em] [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:mb-2 [&_li]:pl-1 [&_li::marker]:text-fg-muted',
  '[&_blockquote]:my-8 [&_blockquote]:border-l-2 [&_blockquote]:border-line-strong [&_blockquote]:pl-6 [&_blockquote]:font-serif [&_blockquote]:text-quote [&_blockquote]:text-fg',
  '[&_table]:my-6 [&_table]:w-full [&_td]:border-b [&_td]:border-line [&_td]:px-3 [&_td]:py-2 [&_td]:text-sm [&_th]:border-b [&_th]:border-line [&_th]:px-3 [&_th]:py-2 [&_th]:text-left [&_th]:text-sm [&_th]:font-semibold [&_th]:text-fg',
];
---

<div class:list={[PROSE, className]} set:html={html} />
