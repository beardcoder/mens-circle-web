---
/**
 * A participant's words, quoted as submitted: nothing added, nothing reworded.
 * `short` is the one highlighted voice: the serif at the quote size. `text` reads
 * like running text, so a long voice stays easy to read; past `COLLAPSE_AT`
 * characters it opens folded to a few lines, with "Vollständige Erfahrung lesen"
 * (the whole text is always in the page; without JS it simply stands in full).
 * Name and role follow at one fixed distance in one fixed style.
 */
interface Props {
  quote: string;
  author?: string | null;
  role?: string | null;
  variant?: 'short' | 'text';
  class?: string;
}

const COLLAPSE_AT = 360;

const { quote, author, role, variant = 'text', class: className } = Astro.props;
const short = variant === 'short';
const collapsible = !short && quote.length > COLLAPSE_AT;
---

<figure
  data-quote
  data-collapsible={collapsible || undefined}
  class:list={['group/quote grid content-start', className]}
>
  <blockquote
    class:list={[
      short ? 'font-serif text-quote text-fg' : 'max-w-measure text-md text-fg-soft',
      'group-data-[collapsed]/quote:line-clamp-6',
    ]}
  >
    „{quote}“
  </blockquote>
  {(author || role) && (
    <figcaption class="mt-4 text-sm text-fg-muted">
      {author && <cite class="font-semibold text-fg not-italic">{author}</cite>}
      {author && role && <span aria-hidden="true"> · </span>}
      {role && <span>{role}</span>}
    </figcaption>
  )}
  {collapsible && (
    <button
      type="button"
      data-quote-toggle
      aria-expanded="true"
      hidden
      class="mt-1 inline-flex min-h-11 w-fit items-center text-base font-semibold text-accent underline decoration-1 underline-offset-4 transition-colors duration-180 hover:text-accent-strong"
    >
      Weniger anzeigen
    </button>
  )}
</figure>

<script>
  /** Long participant voices open folded to a few lines; the button unfolds the full, unchanged text. */

  const FOLDED = 'Vollständige Erfahrung lesen';
  const OPEN = 'Weniger anzeigen';

  const bind = (): void => {
    for (const figure of document.querySelectorAll<HTMLElement>('[data-quote][data-collapsible]')) {
      const toggle = figure.querySelector<HTMLButtonElement>('[data-quote-toggle]');

      if (!toggle || toggle.dataset.bound !== undefined) continue;

      toggle.dataset.bound = '';

      const render = (collapsed: boolean): void => {
        figure.toggleAttribute('data-collapsed', collapsed);
        toggle.setAttribute('aria-expanded', String(!collapsed));
        toggle.textContent = collapsed ? FOLDED : OPEN;
      };

      toggle.hidden = false;
      render(true);
      toggle.addEventListener('click', () => render(!figure.hasAttribute('data-collapsed')));
    }
  };

  bind();
</script>
