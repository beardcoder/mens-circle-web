---
/**
 * A participant's words, quoted as submitted: nothing added, nothing reworded.
 * `md` is a voice among voices: a small opening mark in the accent, the words in
 * the sans italic, a hairline, then the name and role. `lg` is a pull quote: the
 * serif's italic, set large beside an accent rule.
 */
interface Props {
  quote: string;
  author?: string | null;
  role?: string | null;
  size?: 'md' | 'lg';
  class?: string;
}

const { quote, author, role, size = 'md', class: className } = Astro.props;
const lg = size === 'lg';
---

{lg ? (
  <figure class:list={['grid gap-5 border-l-2 border-fill pl-6 sm:pl-8', className]}>
    <blockquote class="font-serif text-[clamp(1.5rem,1rem+2vw,2.5rem)] leading-[1.25] text-fg italic">
      „{quote}“
    </blockquote>
    {(author || role) && (
      <figcaption class="flex flex-wrap items-baseline gap-x-2 text-sm">
        {author && <cite class="font-semibold text-fg not-italic">{author}</cite>}
        {role && <span class="text-fg-muted">{role}</span>}
      </figcaption>
    )}
  </figure>
) : (
  <figure class:list={['grid h-full grid-cols-[auto_minmax(0,1fr)] content-start gap-x-4', className]}>
    <span aria-hidden="true" class="font-serif text-2xl leading-none text-accent select-none">
      ”
    </span>
    <blockquote class="text-md leading-relaxed text-fg italic">{quote}</blockquote>
    {(author || role) && (
      <figcaption class="col-span-2 mt-8 grid gap-1 border-t border-line pt-5 text-sm">
        {author && <cite class="font-semibold text-fg not-italic">{author}</cite>}
        {role && <span class="text-fg-muted">{role}</span>}
      </figcaption>
    )}
  </figure>
)}
