---
/**
 * A participant's words, quoted as submitted: nothing added, nothing reworded.
 * `md` is a voice among voices: a large opening mark in the accent, the words in
 * the serif's italic, then the name in small capitals and the role. `lg` is a
 * pull quote: the serif's italic, set large beside an accent rule.
 */
interface Props {
  quote: string;
  author?: string | null;
  role?: string | null;
  size?: 'md' | 'lg';
  class?: string;
}

const { quote, author, role, size = 'md', class: className } = Astro.props;
const lg = size === 'lg';
---

{lg ? (
  <figure class:list={['grid gap-5 border-l-2 border-fill pl-6 sm:pl-8', className]}>
    <blockquote class="font-serif text-[clamp(1.5rem,1rem+2vw,2.5rem)] leading-[1.25] text-fg italic">
      „{quote}“
    </blockquote>
    {(author || role) && (
      <figcaption class="flex flex-wrap items-baseline gap-x-2 text-sm">
        {author && <cite class="font-semibold text-fg not-italic">{author}</cite>}
        {role && <span class="text-fg-muted">{role}</span>}
      </figcaption>
    )}
  </figure>
) : (
  <figure class:list={['flex h-full flex-col gap-5', className]}>
    {/* A decorative mark: the high “ reads as one at this size; the words keep none. */}
    <span aria-hidden="true" class="block h-9 font-serif text-[4.5rem] leading-none text-accent select-none">
      “
    </span>
    <blockquote class="font-serif text-xl leading-[1.4] text-fg italic">{quote}</blockquote>
    {(author || role) && (
      <figcaption class="mt-auto grid gap-1 pt-2">
        {author && <cite class="text-xs font-bold tracking-label text-fg not-italic uppercase">{author}</cite>}
        {role && <span class="text-sm text-fg-muted">{role}</span>}
      </figcaption>
    )}
  </figure>
)}
