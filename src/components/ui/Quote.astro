---
import { card } from '@lib/ui';

/** A participant's words, quoted as submitted: nothing added, nothing reworded. Every voice is set alike, on a card. */
interface Props {
  quote: string;
  author?: string | null;
  role?: string | null;
  class?: string;
}

const { quote, author, role, class: className } = Astro.props;
---

<figure class:list={[card, 'flex h-full flex-col gap-5 p-6 sm:p-7', className]}>
  <span class="font-serif text-[3rem] leading-[0.6] text-accent" aria-hidden="true">
    “
  </span>
  <blockquote class="flex-1 font-serif text-lg leading-relaxed text-fg">{quote}</blockquote>
  {(author || role) && (
    <figcaption class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5 border-t border-line pt-4 text-sm">
      {author && <cite class="font-semibold text-fg not-italic">{author}</cite>}
      {role && <span class="text-fg-muted">{role}</span>}
    </figcaption>
  )}
</figure>
