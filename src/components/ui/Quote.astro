---
import { caps } from '@lib/ui';

/**
 * A participant's words, quoted as submitted: nothing added, nothing reworded.
 * `lg` is the voice a block leads with: a large opening mark in the accent and
 * the words set big in the serif's italic. `md` stands under a heavy accent rule,
 * level with its neighbours. The name and role follow in capitals.
 */
interface Props {
  quote: string;
  author?: string | null;
  role?: string | null;
  size?: 'md' | 'lg';
  class?: string;
}

const { quote, author, role, size = 'md', class: className } = Astro.props;
const lg = size === 'lg';
const by = [author, role].filter(Boolean).join(' · ');
---

<figure class:list={['grid content-start', lg ? 'gap-6' : 'h-full gap-5 border-t-3 border-accent pt-6', className]}>
  {lg && (
    <span
      aria-hidden="true"
      class="-mb-6 block h-[0.55em] font-serif text-[clamp(6rem,4.5rem+6vw,10rem)] leading-[0.8] text-accent select-none"
    >
      “
    </span>
  )}
  <blockquote
    class:list={[
      'font-serif text-fg italic',
      lg ? 'max-w-[30ch] text-[clamp(1.625rem,1.2rem+1.9vw,2.75rem)] leading-[1.2]' : 'text-xl leading-snug',
    ]}
  >
    {quote}
  </blockquote>
  {by && (
    <figcaption class={`${caps} flex items-center gap-3 text-fg-muted`}>
      <span class="h-0.5 w-6 shrink-0 bg-accent" aria-hidden="true"></span>
      <cite class="not-italic">{by}</cite>
    </figcaption>
  )}
</figure>
