---
import Container from './Container.astro';

/**
 * A block of the page. Blocks are parted by space, and by their ground only
 * where it means something: the paper, or a band from edge to edge in warm sand
 * (`alt`: information that belongs together), moss (`moss`: what is spoken in the
 * circle, the agreements and the voices) or forest (`dark`: what draws you in).
 * Each ground re-declares the colour roles (`surface-*` in theme.css), so
 * everything inside follows it. A section clips what bleeds out of it.
 */

type Ground = 'default' | 'alt' | 'moss' | 'dark';
type Space = 'default' | 'band' | 'none';

interface Props {
  id?: string;
  ground?: Ground;
  /** `default` is a section's space (88 → 144px); `band` the compact space of a band (56 → 80px). */
  space?: Space;
  labelledby?: string;
  class?: string;
  /** Classes for the inner container (grid, etc.). */
  innerClass?: string;
}

const GROUNDS: Record<Ground, string> = {
  default: '',
  alt: 'surface-alt',
  moss: 'surface-moss',
  dark: 'surface-dark',
};

const SPACES: Record<Space, string> = {
  default: 'py-section',
  band: 'py-band',
  none: '',
};

const { id, ground = 'default', space = 'default', labelledby, class: className, innerClass } = Astro.props;
---

<section
  id={id}
  aria-labelledby={labelledby}
  class:list={['relative overflow-x-clip', GROUNDS[ground], SPACES[space], className]}
>
  <Container class={innerClass}>
    <slot />
  </Container>
</section>
