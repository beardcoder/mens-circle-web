---
import Container from './Container.astro';

/**
 * A block of the page. Blocks are parted by space, and by their ground only
 * where it means something: the page's paper, the quiet secondary ground
 * (`alt`: information that belongs together), the dark focus ground (`dark`:
 * the home opening and the footer). Each ground re-declares the colour roles
 * (`surface-*` in theme.css), so everything inside follows it.
 */

type Ground = 'default' | 'alt' | 'dark';
type Space = 'default' | 'band' | 'none';

interface Props {
  id?: string;
  ground?: Ground;
  /** `default` is a section's space (64 / 96px); `band` the compact space of a band (40 / 56px). */
  space?: Space;
  labelledby?: string;
  class?: string;
  /** Classes for the inner container (grid, etc.). */
  innerClass?: string;
}

const GROUNDS: Record<Ground, string> = {
  default: '',
  alt: 'surface-alt',
  dark: 'surface-dark',
};

const SPACES: Record<Space, string> = {
  default: 'py-section',
  band: 'py-band',
  none: '',
};

const { id, ground = 'default', space = 'default', labelledby, class: className, innerClass } = Astro.props;
---

<section
  id={id}
  aria-labelledby={labelledby}
  class:list={['relative', GROUNDS[ground], SPACES[space], className]}
>
  <Container class={innerClass}>
    <slot />
  </Container>
</section>
