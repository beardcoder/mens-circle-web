---
import Container from './Container.astro';

/**
 * A block of the page. Blocks are parted by space, and by their ground only
 * where it means something: the linen page; a rounded sheet inset from the edges
 * in warm sand (`alt`: information that belongs together), pale sage (`tint`: a
 * quiet note) or forest (`dark`: what draws you in). Each ground re-declares the
 * colour roles (`surface-*` in theme.css), so everything inside follows it.
 */

type Ground = 'default' | 'alt' | 'tint' | 'dark';
type Space = 'default' | 'band' | 'none';

interface Props {
  id?: string;
  ground?: Ground;
  /** `default` is a section's space (72 → 112px); `band` the compact space of a band (48 → 64px). */
  space?: Space;
  labelledby?: string;
  class?: string;
  /** Classes for the inner container (grid, etc.). */
  innerClass?: string;
}

const GROUNDS: Record<Ground, string> = {
  default: '',
  alt: 'surface-alt sheet',
  tint: 'surface-tint sheet',
  dark: 'surface-dark sheet',
};

const SPACES: Record<Space, string> = {
  default: 'py-section',
  band: 'py-band',
  none: '',
};

const { id, ground = 'default', space = 'default', labelledby, class: className, innerClass } = Astro.props;
---

<section id={id} aria-labelledby={labelledby} class:list={['relative', GROUNDS[ground], SPACES[space], className]}>
  <Container class={innerClass}>
    <slot />
  </Container>
</section>
