---
import Eyebrow from './Eyebrow.astro';

/**
 * Label, title and optional lead of a block, stacked above its content: 12px from
 * label to title, 24px from title to lead. Titles are one colour; `size` names
 * the role (`section` a section's title, `page` a sub-page's title, `sub` a
 * subheading). `center` only for a short invitation.
 */

type Size = 'section' | 'page' | 'sub';

interface Props {
  eyebrow?: string;
  title?: string;
  /** The title holds trusted HTML from the content files. */
  titleHtml?: boolean;
  titleId?: string;
  lead?: string;
  /** The lead holds trusted HTML from the content files (e.g. a link). */
  leadHtml?: boolean;
  as?: 'h1' | 'h2' | 'h3';
  size?: Size;
  align?: 'start' | 'center';
  class?: string;
}

const SIZES: Record<Size, string> = {
  section: 'text-section',
  page: 'text-page',
  sub: 'text-sub',
};

const {
  eyebrow,
  title,
  titleHtml = false,
  titleId,
  lead,
  leadHtml = false,
  as: Heading = 'h2',
  size = 'section',
  align = 'start',
  class: className,
}: Props = Astro.props;

const center = align === 'center';
const leadClass = [
  'mt-6 max-w-measure text-lg text-fg-muted [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-[3px] [&_a:hover]:text-accent-strong',
  center && 'mx-auto',
];
const titleClass = ['max-w-[24ch] text-fg wrap-anywhere hyphens-auto', SIZES[size], center && 'mx-auto'];
---

<div class:list={['grid justify-items-start', center && 'justify-items-center text-center', className]}>
  {eyebrow && <Eyebrow class="mb-3">{eyebrow}</Eyebrow>}
  {title &&
    (titleHtml ? (
      <Heading id={titleId} class:list={titleClass} set:html={title} />
    ) : (
      <Heading id={titleId} class:list={titleClass}>
        {title}
      </Heading>
    ))}
  {lead && (leadHtml ? <p class:list={leadClass} set:html={lead} /> : <p class:list={leadClass}>{lead}</p>)}
  <slot />
</div>
