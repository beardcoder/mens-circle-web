---
import Eyebrow from './Eyebrow.astro';

/** A section heading, with an optional label and lead. Page titles use PageIntro. */
interface Props {
  eyebrow?: string;
  title?: string;
  titleId?: string;
  lead?: string;
  /** The lead holds trusted HTML from the content files (e.g. a link). */
  leadHtml?: boolean;
  size?: 'section' | 'sub';
  class?: string;
}

const { eyebrow, title, titleId, lead, leadHtml = false, size = 'section', class: className }: Props = Astro.props;

const leadClass =
  'mt-6 max-w-measure text-lg text-fg-muted [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-[3px] [&_a:hover]:text-accent-strong';

const titleClass = [
  'max-w-[14.4em] text-fg wrap-anywhere hyphens-auto [view-timeline:--words]',
  size === 'sub' ? 'text-sub' : 'text-section',
];

// Each word its own span, so the home page can light them up one after another (`word-light`).
const words = title?.split(' ') ?? [];
---

<div class:list={['reveal grid justify-items-start', className]}>
  {eyebrow && <Eyebrow class="mb-3">{eyebrow}</Eyebrow>}
  {title && (
    <h2 id={titleId} class:list={titleClass}>
      {words.map((word, index) => (
        <>
          <span class="word-light" style={`--word: ${index}`}>
            {word}
          </span>
          {index < words.length - 1 && ' '}
        </>
      ))}
    </h2>
  )}
  {lead && (leadHtml ? <p class:list={leadClass} set:html={lead} /> : <p class:list={leadClass}>{lead}</p>)}
</div>
