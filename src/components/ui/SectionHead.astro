---
import Eyebrow from './Eyebrow.astro';

/**
 * Eyebrow, title and lead of a block, stacked above its content. `center` sets
 * them on the middle axis (statements, closes). A phrase in `<em>` turns to the
 * accent.
 */

type Size = 'display-1' | 'display-2' | 'display-3';

interface Props {
  eyebrow?: string;
  title?: string;
  /** The title holds trusted HTML from the content files (e.g. `<em>`). */
  titleHtml?: boolean;
  titleId?: string;
  lead?: string;
  /** The lead holds trusted HTML from the content files (e.g. a link). */
  leadHtml?: boolean;
  as?: 'h1' | 'h2';
  size?: Size;
  align?: 'start' | 'center';
  /** The page opening animates in. */
  entrance?: boolean;
  class?: string;
}

const SIZES: Record<Size, string> = {
  'display-1': 'text-display-1',
  'display-2': 'text-display-2',
  'display-3': 'text-display-3',
};

const {
  eyebrow,
  title,
  titleHtml = false,
  titleId,
  lead,
  leadHtml = false,
  as: Heading = 'h2',
  size = 'display-3',
  align = 'start',
  entrance = false,
  class: className,
} = Astro.props;

const center = align === 'center';
const leadClass = [
  'max-w-measure text-lg text-fg-soft [&_a]:text-fg [&_a]:underline [&_a]:decoration-accent/60 [&_a]:decoration-[1.5px] [&_a]:underline-offset-[0.2em] [&_a:hover]:decoration-accent',
  center && 'mx-auto',
  entrance && 'entrance:animate-rise entrance:animate-delay-120',
];
const titleClass = [
  'max-w-[24ch] text-fg wrap-break-word max-sm:hyphens-auto [&_em]:text-accent [&_em]:not-italic',
  SIZES[size],
  center && 'mx-auto',
  entrance && 'entrance:animate-rise entrance:animate-delay-60',
];
---

<div class:list={['grid gap-4', center && 'justify-items-center text-center', className]}>
  {eyebrow && <Eyebrow class:list={[entrance && 'entrance:animate-rise']}>{eyebrow}</Eyebrow>}
  {title &&
    (titleHtml ? (
      <Heading id={titleId} class:list={titleClass} set:html={title} />
    ) : (
      <Heading id={titleId} class:list={titleClass}>
        {title}
      </Heading>
    ))}
  {lead && (leadHtml ? <p class:list={leadClass} set:html={lead} /> : <p class:list={leadClass}>{lead}</p>)}
  <slot />
</div>
