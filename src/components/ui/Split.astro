---
/**
 * The split line every page keeps. Wide screens sit on a 12-column field: the
 * head takes columns 1–5, the content runs from column 7 to the edge, its first
 * line level with the head's. Without a head the content starts at the left
 * edge. Below `lg` everything stacks, left-aligned.
 */
interface Props {
  /** The head holds its place while a long content column passes. */
  sticky?: boolean;
  /** Starts the content level with a title that sits under an eyebrow, not with the eyebrow. */
  alignToTitle?: boolean;
  class?: string;
}

const { sticky = false, alignToTitle = false, class: className } = Astro.props;
const hasHead = Astro.slots.has('head');
---

<div class:list={['grid grid-cols-1 gap-y-8 lg:grid-cols-12 lg:gap-x-grid', className]}>
  {hasHead && (
    <div
      class:list={[
        'min-w-0 lg:col-span-5',
        sticky && 'lg:sticky lg:top-[calc(var(--spacing-clearance)+1.5rem)] lg:self-start',
      ]}
    >
      <slot name="head" />
    </div>
  )}
  <div
    class:list={[
      'min-w-0',
      hasHead ? 'lg:col-span-6 lg:col-start-7' : 'lg:col-span-8',
      alignToTitle && 'lg:pt-[calc(var(--text-xs)*1.3+1.25rem+0.3em)]',
    ]}
  >
    <slot />
  </div>
</div>
