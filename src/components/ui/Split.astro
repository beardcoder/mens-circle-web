---
/**
 * Two columns that belong together: a narrower head (slot `head`: a title, a
 * note, a contact line) and the content beside it. From `lg` they stand side by
 * side (head on columns 1–4, content on 6–12); below they stack, head first.
 */
interface Props {
  /** The head holds its place while a long content column passes. */
  sticky?: boolean;
  class?: string;
}

const { sticky = false, class: className } = Astro.props;
---

<div class:list={['grid grid-cols-1 gap-y-10 lg:grid-cols-12 lg:gap-x-grid', className]}>
  <div
    class:list={[
      'min-w-0 lg:col-span-4',
      sticky && 'lg:sticky lg:top-[calc(var(--spacing-clearance)+1rem)] lg:self-start',
    ]}
  >
    <slot name="head" />
  </div>
  <div class="min-w-0 lg:col-span-7 lg:col-start-6">
    <slot />
  </div>
</div>
