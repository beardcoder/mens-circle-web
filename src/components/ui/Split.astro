---
/**
 * Two columns that belong together: a narrower head (slot `head`: a title, a
 * note, a contact line) and the content beside it. From `lg` they stand side by
 * side (head on columns 1–4, content on 5–12); below they stack, head first.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['grid grid-cols-1 gap-x-grid gap-y-8 lg:grid-cols-12', className]}>
  <div class="min-w-0 lg:col-span-4">
    <slot name="head" />
  </div>
  <div class="min-w-0 lg:col-span-8">
    <slot />
  </div>
</div>
