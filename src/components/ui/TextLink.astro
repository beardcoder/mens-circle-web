---
import { Icon } from 'astro-icon/components';

/** A quiet, self-contained link beside a primary action: the accent, with an arrow that moves. */
interface Props {
  href: string;
  class?: string;
  [attribute: string]: unknown;
}

const { href, class: className, ...attributes } = Astro.props;
---

<a
  href={href}
  class:list={[
    'group/link inline-flex min-h-11 items-center gap-2 font-sans text-xs font-bold tracking-label text-accent uppercase transition-colors duration-150 hover:text-fg',
    className,
  ]}
  {...attributes}
>
  <slot />
  <Icon
    name="arrow"
    aria-hidden="true"
    class="size-[1.05em] shrink-0 transition-transform duration-200 group-hover/link:translate-x-1"
  />
</a>
