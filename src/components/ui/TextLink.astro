---
import { Icon } from 'astro-icon/components';

/** A quiet link beside a primary action or under a block: the accent, underlined, with a small arrow. */
interface Props {
  href: string;
  class?: string;
  [attribute: string]: unknown;
}

const { href, class: className, ...attributes } = Astro.props;
---

<a
  href={href}
  class:list={[
    'group/link inline-flex min-h-11 items-center gap-1.5 font-sans text-base font-semibold text-accent underline decoration-1 underline-offset-4 transition-colors duration-180 hover:text-accent-strong',
    className,
  ]}
  {...attributes}
>
  <slot />
  <Icon
    name="arrow"
    aria-hidden="true"
    class="size-[1em] shrink-0 transition-transform duration-180 group-hover/link:translate-x-1"
  />
</a>
