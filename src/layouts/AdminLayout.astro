---
/** Admin shell — the public design system, in its dark mode. */
import '../styles/admin.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import { Icon } from 'astro-icon/components';
import { button } from '@lib/ui';

interface Props {
  title: string;
  /** Hide the bar (used by the login page). */
  bare?: boolean;
}
const { title, bare = false } = Astro.props;
const admin = Astro.locals.admin;

const path = Astro.url.pathname;
const links = [
  { href: '/admin', label: 'Veranstaltungen', active: path === '/admin' || path.startsWith('/admin/events') },
  { href: '/admin/testimonials', label: 'Stimmen', active: path.startsWith('/admin/testimonials') },
];
---

<!doctype html>
<html lang="de" dir="ltr" data-mode="dark" data-mode-resolved="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#151210" />
    <title>{title} · Admin · Männerkreis</title>
    <Font cssVariable="--font-instrument" preload={[{ weight: '400', style: 'normal' }]} />
    <Font cssVariable="--font-fraunces" />
    <ClientRouter />
  </head>
  <body class="text-base">
    {!bare && (
      <header class="sticky top-0 z-30 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-line bg-ground px-[clamp(1rem,4vw,2rem)] py-2">
        <nav class="flex flex-wrap items-center gap-x-8 gap-y-1" aria-label="Admin">
          <a href="/admin" class="flex items-center gap-2.5 rounded-control">
            <Icon name="logo" aria-hidden="true" class="size-7 text-flame" />
            <span class="font-serif text-lg font-semibold">Männerkreis</span>
            <span class="text-xs font-semibold tracking-label text-fg-muted uppercase">Admin</span>
          </a>
          <div class="flex items-center gap-6">
            {links.map((link) => (
              <a
                href={link.href}
                aria-current={link.active ? 'page' : undefined}
                class="relative flex min-h-11 items-center text-sm font-semibold text-fg-muted transition-colors duration-150 after:absolute after:inset-x-0 after:bottom-1 after:h-0.5 after:bg-transparent hover:text-fg aria-[current=page]:text-fg aria-[current=page]:after:bg-accent"
              >
                {link.label}
              </a>
            ))}
          </div>
        </nav>
        <div class="flex min-w-0 items-center gap-3">
          {admin && <span class="max-w-52 truncate text-sm text-fg-muted">{admin}</span>}
          <button type="button" id="admin-logout" class={button({ variant: 'secondary', size: 'xs' })}>
            Abmelden
          </button>
        </div>
      </header>
    )}
    <main
      class:list={[
        'mx-auto w-full max-w-[60rem] px-[clamp(1rem,4vw,2rem)]',
        bare ? 'grid min-h-dvh place-items-center py-10' : 'pt-[clamp(1.5rem,4vw,2.75rem)] pb-20',
      ]}
    >
      <slot />
    </main>

    <div
      id="toasts"
      aria-live="polite"
      aria-atomic="false"
      transition:persist
      class="pointer-events-none fixed bottom-5 left-1/2 z-50 flex w-[min(92vw,26rem)] -translate-x-1/2 flex-col gap-2"
    ></div>

    <script>
      import { actions } from 'astro:actions';
      import type { AdminToastKind } from '@lib/admin';

      const TOAST =
        'translate-y-2 rounded-control border-2 bg-raised px-4 py-3 text-sm font-semibold opacity-0 shadow-overlay transition-[opacity,translate] duration-150 data-[in]:translate-y-0 data-[in]:opacity-100';
      const TONES: Record<AdminToastKind, string> = {
        ok: 'border-success text-success',
        err: 'border-danger text-danger',
      };

      // Persists on `window` across view-transition swaps; components reach it
      // through `adminToast()` in lib/admin.ts.
      if (!window.adminToast) {
        window.adminToast = (kind: AdminToastKind, text: string) => {
          const host = document.getElementById('toasts');
          if (!host) return;
          const el = document.createElement('div');
          el.className = `${TOAST} ${TONES[kind]}`;
          el.setAttribute('role', kind === 'err' ? 'alert' : 'status');
          el.textContent = text;
          host.appendChild(el);
          requestAnimationFrame(() => (el.dataset.in = ''));
          setTimeout(() => {
            delete el.dataset.in;
            el.addEventListener('transitionend', () => el.remove(), { once: true });
          }, 3600);
        };
      }

      // The button is a fresh node after each swap, so re-bind every time.
      document.addEventListener('astro:page-load', () => {
        const btn = document.getElementById('admin-logout');
        btn?.addEventListener('click', async () => {
          await actions.logout();
          window.location.href = '/admin/login';
        });
      });
    </script>
  </body>
</html>
