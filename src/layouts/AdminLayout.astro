---
/** Admin shell — the public design system, in its dark mode. */
import '../styles/admin.css';

import { Font } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import { label } from '@lib/ui';

import LogoutButton from '../components/admin/LogoutButton';

interface Props {
  title: string;
  /** Hide the bar (used by the login page). */
  bare?: boolean;
}
const { title, bare = false } = Astro.props;
const admin = Astro.locals.admin;

const path = Astro.url.pathname;

const links = [
  { href: '/admin', label: 'Veranstaltungen', active: path === '/admin' || path.startsWith('/admin/events') },
  { href: '/admin/testimonials', label: 'Stimmen', active: path.startsWith('/admin/testimonials') },
];
---

<!doctype html>
<html lang="de" dir="ltr" data-mode="dark" data-mode-resolved="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#151210" />
    <title>{title} · Admin · Männerkreis</title>
    <Font cssVariable="--font-dm-sans" preload={[{ weight: '100 1000', style: 'normal' }]} />
    <Font cssVariable="--font-playfair" />
  </head>
  <body class="text-base">
    {!bare && (
      <header class="sticky top-0 z-30 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-line bg-ground px-[clamp(1rem,4vw,2rem)] py-2">
        <nav class="flex flex-wrap items-center gap-x-8 gap-y-1" aria-label="Admin">
          <a href="/admin" class="flex items-center gap-2.5">
            <Icon name="logo" aria-hidden="true" class="size-7 text-flame" />
            <span class="font-serif text-lg">Männerkreis</span>
            <span class={label}>Admin</span>
          </a>
          <div class="flex items-center gap-6">
            {links.map((link) => (
              <a
                href={link.href}
                aria-current={link.active ? 'page' : undefined}
                class="relative flex min-h-11 items-center text-sm font-semibold text-fg-muted transition-colors duration-150 after:absolute after:inset-x-0 after:bottom-1 after:h-0.5 after:bg-transparent hover:text-fg aria-[current=page]:text-fg aria-[current=page]:after:bg-accent"
              >
                {link.label}
              </a>
            ))}
          </div>
        </nav>
        <div class="flex min-w-0 items-center gap-3">
          {admin && <span class="hidden max-w-52 truncate text-sm text-fg-muted md:inline">{admin}</span>}
          <LogoutButton client:load />
        </div>
      </header>
    )}
    <main
      class:list={[
        'mx-auto w-full max-w-[72rem] px-[clamp(1rem,4vw,2rem)]',
        bare ? 'grid min-h-dvh place-items-center py-10' : 'pt-[clamp(1.5rem,4vw,2.75rem)] pb-20',
      ]}
    >
      <slot />
    </main>
  </body>
</html>
