---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BreathBackdrop from '../components/BreathBackdrop.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SeoHead from '../components/SeoHead.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  socialDetails?: { label: string; value: string }[];
  robots?: string;
  schemas?: Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
  /** The footer's invitation; off where the page ends on its own. */
  footerClose?: boolean;
}

const props = Astro.props;
---

<!doctype html>
<html lang="de" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Before first paint: skip the entrance so only the cross-fade moves.
      addEventListener('pagereveal', (event) => {
        if (event.viewTransition) document.documentElement.classList.add('vt-arrival');
      });
      // Resolve the palette and the mode before first paint so nothing flashes.
      (() => {
        try {
          const root = document.documentElement;
          if (localStorage.getItem('mc-theme') === 'cool') root.setAttribute('data-theme', 'cool');
          const stored = localStorage.getItem('mc-mode');
          const mode = stored === 'light' || stored === 'dark' ? stored : null;
          const resolved = mode || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          root.setAttribute('data-mode-resolved', resolved);
          if (mode) root.setAttribute('data-mode', mode);
        } catch {
          /* localStorage or matchMedia unavailable — fall back to CSS defaults. */
        }
      })();
    </script>
    {/* Both faces are variable (astro.config.mjs): one file per style. The serif
        upright and italic set the hero title (the LCP), the sans upright the first screen. */}
    <Font
      cssVariable="--font-playfair"
      preload={[
        { weight: '400 900', style: 'normal' },
        { weight: '400 900', style: 'italic' },
      ]}
    />
    <Font cssVariable="--font-dm-sans" preload={[{ weight: '100 1000', style: 'normal' }]} />
    <SeoHead {...props} />
  </head>
  <body class="data-[nav-open]:fixed data-[nav-open]:min-h-full data-[nav-open]:w-full data-[nav-open]:overflow-hidden">
    {/* lib/site-header.ts sets `data-nav-open` while the menu is open: the page holds still. */}
    {/* Top sentinel: a static, in-flow target at position 0 for scroll-to-top; it
        takes the focus there, so the next Tab starts at the top (lib/site-header.ts). */}
    <span id="top" tabindex="-1"></span>

    {/* The page breathes: a fixed layer of warm light behind everything. */}
    <BreathBackdrop />

    <a
      href="#main"
      class="fixed -top-full left-4 z-50 rounded-full bg-fill px-6 py-3 text-sm font-semibold text-on-fill transition-[top] duration-150 focus:top-2 print:hidden"
    >
      Zum Inhalt springen
    </a>

    <Header />

    <main id="main">
      <slot />

      {/* Fixed to the corner, but inside a landmark, on the page's own colours. */}
      <a
        href="#top"
        data-scroll-top
        data-llms-skip
        aria-label="Nach oben scrollen"
        title="Nach oben"
        class="fixed right-4 bottom-4 z-30 grid size-12 place-items-center rounded-full bg-fill text-on-fill shadow-card transition-[background-color,translate,box-shadow] duration-300 hover:-translate-y-0.5 hover:bg-fill-strong hover:shadow-[var(--shadow-lift),var(--shadow-glow)] motion-reduce:hover:translate-y-0 scroll-motion:animate-[appear-late_linear_both] scroll-motion:[animation-timeline:scroll(root_block)] print:hidden sm:right-6 sm:bottom-6"
      >
        <Icon name="chevron-up" aria-hidden="true" class="size-4.5" />
      </a>
    </main>

    <Footer close={props.footerClose ?? true} />
    <script>
      import '../lib/client';
    </script>
  </body>
</html>
