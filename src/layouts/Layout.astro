---
import '../styles/app.css';
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import SeoHead from '../components/SeoHead.astro';
import { UMAMI_ENDPOINT, UMAMI_WEBSITE_ID } from '../lib/umami-config';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  robots?: string;
  schemas?: Record<string, unknown>[];
  manifest?: string;
  webAppTitle?: string;
  viewport?: string;
  /** Chrome-less shell — no header, footer, rails or scroll-to-top, so a page
   *  can present as a full-screen app (the installable breathing exercise). */
  bare?: boolean;
}

const { bare = false, ...props } = Astro.props;

// Umami heatmap recorder, alongside the tracker the astro-umami integration
// injects (both read lib/umami-config). Production only. Sample rate and the
// heatmaps toggle live in the Umami admin.
const umamiRecorderSrc = import.meta.env.PROD ? `${UMAMI_ENDPOINT}/recorder.js` : null;
---

<!doctype html>
<html lang="de" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // `.motion-ready` lets CSS hide every [data-reveal] until lib/motion.ts
      // animates it in. Set here rather than from the module so nothing flashes
      // — but a module that never arrives would then leave the page blank, so
      // the class carries a dead-man's switch: initMotion() clears the timer
      // once the reveals are observed, otherwise the hidden state lifts itself.
      document.documentElement.classList.add('motion-ready');
      window.__mcMotionFallback = setTimeout(() => {
        document.documentElement.classList.remove('motion-ready');
      }, 4000);
      // `pagereveal` fires in the incoming document before its first rendering
      // opportunity and carries the ViewTransition when the navigation animates.
      // Marking the document here — the only point early enough — lets CSS stand
      // the page's own entrance down so the cross-fade is the only thing moving.
      // Inline because our module is deferred and would miss the event.
      addEventListener('pagereveal', (event) => {
        if (event.viewTransition) document.documentElement.classList.add('vt-arrival');
      });
      (() => {
        try {
          const root = document.documentElement;
          const theme = localStorage.getItem('mc-theme') === 'cool' ? 'cool' : 'warm';
          const stored = localStorage.getItem('mc-mode');
          const mode = stored === 'light' || stored === 'dark' ? stored : null;
          const resolved = mode || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          root.setAttribute('data-theme', theme);
          root.setAttribute('data-mode-resolved', resolved);
          if (mode) root.setAttribute('data-mode', mode);
        } catch {
          /* localStorage / matchMedia unavailable — fall back to CSS defaults. */
        }
      })();
    </script>
    {/* Preload Playfair — the hero heading is the LCP. Config in astro.config.mjs. */}
    <Font cssVariable="--font-playfair" preload />
    <Font cssVariable="--font-dm-sans" />
    <SeoHead {...props} />
    {
      /* `async`, NOT `defer`: deferred scripts run in document order, so a stalled
        analytics CDN would hold back our own module behind it — 3069ms to
        interactive vs 194ms in a 3s-stall test. Nothing orders against this. */
    }
    {umamiRecorderSrc && <script is:inline async src={umamiRecorderSrc} data-website-id={UMAMI_WEBSITE_ID} />}
  </head>
  <body class:list={[{ 'is-bare': bare }]}>
    {/* Top sentinel: a static, in-flow target at position 0 for scroll-to-top. */}
    {!bare && <span id="top" aria-hidden="true" />}

    {/* Editorial side rails — decorative magazine framing, hidden on small screens */}
    {
      !bare && (
        <>
          <aside class="side-rail side-rail--left" aria-hidden="true">
            <span class="side-rail__text">Männerkreis · Niederbayern</span>
          </aside>
          <aside class="side-rail side-rail--right" aria-hidden="true">
            <span class="side-rail__text">Straubing · Bayern</span>
          </aside>
        </>
      )
    }

    <a href="#main" class="skip-link">Zum Inhalt springen</a>

    {!bare && <Header />}

    <main id="main">
      <slot />
    </main>

    {!bare && <Footer />}

    {!bare && <ScrollToTop />}

    <script>
      import '../lib/client';
    </script>
  </body>
</html>

<style is:global>
  @layer components {
    .skip-link {
      position: absolute;
      inset-block-start: -100%;
      inset-inline-start: 50%;
      z-index: var(--z-toast);
      padding: 1rem 2rem;
      font-size: 0.875rem;
      color: var(--text-on-dark);
      background: var(--bg-section-alt);
      border-radius: var(--radius-full);
      transform: translateX(-50%);
      transition: inset-block-start var(--motion-quick);
    }

    .skip-link:focus {
      inset-block-start: var(--space-sm);
    }
  }
</style>
