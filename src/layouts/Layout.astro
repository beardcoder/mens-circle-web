---
import '../styles/app.css';
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import SeoHead from '../components/SeoHead.astro';
import SpriteDefs from '../components/SpriteDefs.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  robots?: string;
  schemas?: Record<string, unknown>[];
  manifest?: string;
  webAppTitle?: string;
  viewport?: string;
  /** Chrome-less shell: drop the header, footer, side rails and
   *  scroll-to-top so a page can present as a focused, full-screen app
   *  (used by the installable breathing exercise). */
  bare?: boolean;
}

const { bare = false, ...props } = Astro.props;

// Umami heatmap recorder — a second, optional tracker script alongside the
// analytics script the @yeskunall/astro-umami integration injects. Only
// loaded in production when Umami is configured; the sample rate and the
// heatmaps toggle live in the Umami admin, not here.
const umamiId = import.meta.env.PUBLIC_UMAMI_ID;
const umamiEndpoint = import.meta.env.PUBLIC_UMAMI_ENDPOINT;
const umamiRecorderSrc = import.meta.env.PROD && umamiId && umamiEndpoint ? `${umamiEndpoint}/recorder.js` : null;

// The "next event" CTAs ([data-event-cta]) are HIDDEN by default (CSS) and
// revealed at runtime by the client only when an upcoming event is actually
// scheduled (see lib/event-cta.ts). They can't be gated at build time because
// these pages are prerendered and PocketBase isn't reachable during the build.
---

<!doctype html>
<html
  lang="de"
  dir="ltr"
>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      document.documentElement.classList.add('motion-ready');
      (() => {
        try {
          const root = document.documentElement;
          const theme = localStorage.getItem('mc-theme') === 'cool' ? 'cool' : 'warm';
          const stored = localStorage.getItem('mc-mode');
          const mode = stored === 'light' || stored === 'dark' ? stored : null;
          const resolved = mode || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          root.setAttribute('data-theme', theme);
          root.setAttribute('data-mode-resolved', resolved);
          if (mode) root.setAttribute('data-mode', mode);
        } catch {
          /* localStorage / matchMedia unavailable — fall back to CSS defaults. */
        }
      })();
    </script>
    {
      /* Native Astro fonts (config in astro.config.mjs). Preload Playfair —
        the hero heading is the LCP; DM Sans loads without a preload race. */
    }
    <Font
      cssVariable="--font-playfair"
      preload
    />
    <Font cssVariable="--font-dm-sans" />
    <SeoHead {...props} />
    {
      umamiRecorderSrc && (
        <script
          is:inline
          defer
          src={umamiRecorderSrc}
          data-website-id={umamiId}
        />
      )
    }
  </head>
  <body class:list={[{ 'is-bare': bare }]}>
    {/* Top sentinel: a static, in-flow target at position 0 for scroll-to-top. */}
    {
      !bare && (
        <span
          id="top"
          aria-hidden="true"
        />
      )
    }

    <SpriteDefs />

    {/* Editorial side rails — decorative magazine framing, hidden on small screens */}
    {
      !bare && (
        <>
          <aside
            class="side-rail side-rail--left"
            aria-hidden="true"
          >
            <span class="side-rail__text">Männerkreis · Niederbayern</span>
          </aside>
          <aside
            class="side-rail side-rail--right"
            aria-hidden="true"
          >
            <span class="side-rail__text">Straubing · Bayern</span>
          </aside>
        </>
      )
    }

    <a
      href="#main"
      class="skip-link"
      >Zum Inhalt springen</a
    >

    {!bare && <Header />}

    <main id="main">
      <slot />
    </main>

    {!bare && <Footer />}

    {!bare && <ScrollToTop />}

    <script>
      import '../lib/client';
    </script>
    <script
      defer
      src="https://va.letsbenow.de/recorder.js"
      data-website-id="f2964cb9-28e6-4658-810f-2acfb9cb9c46"
    ></script>
  </body>
</html>

<style is:global>
  @layer components {
    .skip-link {
      position: absolute;
      inset-block-start: -100%;
      inset-inline-start: 50%;
      z-index: var(--z-toast);
      padding: 1rem 2rem;
      font-size: 0.875rem;
      color: var(--text-on-dark);
      background: var(--bg-section-alt);
      border-radius: var(--radius-full);
      transform: translateX(-50%);
      transition: inset-block-start var(--motion-quick);
    }

    .skip-link:focus {
      inset-block-start: var(--space-sm);
    }
  }
</style>
