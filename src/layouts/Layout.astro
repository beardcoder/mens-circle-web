---
import '../styles/global.css';

import { Font } from 'astro:assets';
import type { ComponentProps } from 'astro/types';

import BackToTop from '../components/BackToTop.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Motion from '../components/Motion.astro';
import SeoHead from '../components/SeoHead.astro';
import { bootScript, fontScript, speculationRules } from '../scripts/inline';

type Props = ComponentProps<typeof SeoHead> & {
  headerAction?: ComponentProps<typeof Header>['action'];
  /** The page opens on the forest (the home opening): the bar starts clear over it. */
  overHero?: boolean;
};

const { headerAction, overHero = false, ...props } = Astro.props;
---

<!doctype html>
<html lang="de" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <script is:inline set:html={bootScript} />
    {/* Both upright faces are in the first viewport; the italic loads when used. */}
    <Font cssVariable="--font-fraunces" preload />
    <Font cssVariable="--font-figtree" preload={[{ weight: '300 900', style: 'normal' }]} />
    <script is:inline set:html={fontScript} />
    <script is:inline type="speculationrules" set:html={speculationRules} />
    <SeoHead {...props} />
  </head>
  <body>
    {/* Top sentinel: a static, in-flow target at position 0 for scroll-to-top; it
        takes the focus there, so the next Tab starts at the top (BackToTop.astro). */}
    <span id="top" tabindex="-1"></span>

    <a
      href="#main"
      class="fixed -top-full left-4 z-50 rounded-full bg-fill px-5 py-3 text-base font-semibold text-on-fill transition-[top] duration-180 focus:top-2 print:hidden"
    >
      Zum Inhalt springen
    </a>

    <Header action={headerAction} overHero={overHero} />
    <span
      aria-hidden="true"
      class="pointer-events-none fixed inset-x-0 top-0 z-50 h-0.5 origin-left scale-x-0 bg-fill scroll-motion:animate-[reading-progress_linear_both] scroll-motion:[animation-timeline:scroll(root_block)] print:hidden"
    ></span>

    <main id="main" tabindex="-1">
      <slot />

      {/* Fixed to the corner, but inside a landmark, on the page's own colours. */}
      <BackToTop />
    </main>

    <Footer />
    <Motion />
  </body>
</html>
