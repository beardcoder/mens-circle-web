---
import '../styles/app.css';
import { Font } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SeoHead from '../components/SeoHead.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  socialDetails?: { label: string; value: string }[];
  robots?: string;
  schemas?: Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
}

const props = Astro.props;
---

<!doctype html>
<html lang="de" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Before first paint: skip the entrance so only the cross-fade moves.
      addEventListener('pagereveal', (event) => {
        if (event.viewTransition) document.documentElement.classList.add('vt-arrival');
      });
      // Resolve the mode before first paint so nothing flashes.
      (() => {
        try {
          const root = document.documentElement;
          const stored = localStorage.getItem('mc-mode');
          const mode = stored === 'light' || stored === 'dark' ? stored : null;
          const resolved = mode || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          root.setAttribute('data-mode-resolved', resolved);
          if (mode) root.setAttribute('data-mode', mode);
        } catch {
          /* localStorage or matchMedia unavailable — fall back to CSS defaults. */
        }
      })();
    </script>
    {/* Preload the serif headline weight — the hero sentence is the LCP. Config in astro.config.mjs. */}
    <Font cssVariable="--font-serif" preload={[{ weight: '400', style: 'normal' }]} />
    <Font cssVariable="--font-sans" preload={[{ weight: '400', style: 'normal' }]} />
    <SeoHead {...props} />
  </head>
  <body>
    {/* Top sentinel: a static, in-flow target at position 0 for scroll-to-top. */}
    <span id="top" aria-hidden="true"></span>

    <a href="#main" class="skip-link">
      Zum Inhalt springen
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <a href="#top" class="scroll-to-top" aria-label="Nach oben scrollen" title="Nach oben">
      <Icon name="chevron-up" aria-hidden="true" />
    </a>

    <script>
      import '../lib/client';
    </script>
  </body>
</html>

<style is:global>
  @layer components {
    .skip-link {
      position: absolute;
      inset-block-start: -100%;
      inset-inline-start: var(--space-sm);
      z-index: var(--z-toast);
      padding: 0.75rem 1.25rem;
      font-size: var(--text-caption);
      font-weight: 600;
      color: var(--on-accent);
      background: var(--accent);
      border-radius: var(--radius);
      transition: inset-block-start var(--motion-quick);
    }

    .skip-link:focus {
      inset-block-start: var(--space-xs);
    }
  }
</style>
