---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SeoHead from '../components/SeoHead.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  socialDetails?: { label: string; value: string }[];
  robots?: string;
  schemas?: Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
  /** The footer's invitation; off where the page ends on its own. */
  footerClose?: boolean;
}

const props = Astro.props;
---

<!doctype html>
<html lang="de" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Before first paint: skip the entrance so only the cross-fade moves.
      addEventListener('pagereveal', (event) => {
        if (event.viewTransition) document.documentElement.classList.add('vt-arrival');
      });
      // Resolve the mode before first paint so nothing flashes.
      (() => {
        try {
          const root = document.documentElement;
          const stored = localStorage.getItem('mc-mode');
          const mode = stored === 'light' || stored === 'dark' ? stored : null;
          const resolved = mode || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          root.setAttribute('data-mode-resolved', resolved);
          if (mode) root.setAttribute('data-mode', mode);
        } catch {
          /* localStorage or matchMedia unavailable — fall back to CSS defaults. */
        }
      })();
    </script>
    {/* Preload the serif headline weight (600) — the hero sentence is the LCP. Config in astro.config.mjs. */}
    <Font cssVariable="--font-fraunces" preload={[{ weight: '600', style: 'normal' }]} />
    {/* And the sans at the two weights of the first screen: text (400) and the
        navigation, buttons and card lines (600). A late swap rewraps them. */}
    <Font
      cssVariable="--font-instrument"
      preload={[
        { weight: '400', style: 'normal' },
        { weight: '600', style: 'normal' },
      ]}
    />
    <SeoHead {...props} />
  </head>
  <body class="max-lg:data-[nav-open]:fixed max-lg:data-[nav-open]:min-h-full max-lg:data-[nav-open]:w-full max-lg:data-[nav-open]:overflow-hidden">
    {/* lib/site-header.ts sets `data-nav-open` while the phone panel is open: the page holds still. */}
    {/* Top sentinel: a static, in-flow target at position 0 for scroll-to-top; it
        takes the focus there, so the next Tab starts at the top (lib/site-header.ts). */}
    <span id="top" tabindex="-1"></span>

    <a
      href="#main"
      class="fixed -top-full left-4 z-50 rounded-control bg-accent px-5 py-3 text-sm font-semibold text-on-accent transition-[top] duration-150 focus:top-2 print:hidden"
    >
      Zum Inhalt springen
    </a>

    <Header />

    <main id="main">
      <slot />

      {/* Fixed to the corner, but inside a landmark, on the page's own colours. */}
      <a
        href="#top"
        data-scroll-top
        data-llms-skip
        aria-label="Nach oben scrollen"
        title="Nach oben"
        class="fixed right-4 bottom-4 z-30 grid size-12 place-items-center rounded-full border border-line-strong bg-raised text-fg transition-colors duration-150 hover:border-accent hover:bg-accent hover:text-on-accent scroll-motion:animate-[appear-late_linear_both] scroll-motion:[animation-timeline:scroll(root_block)] print:hidden"
      >
        <Icon name="chevron-up" aria-hidden="true" class="size-4.5" />
      </a>
    </main>

    <Footer close={props.footerClose ?? true} />
    <script>
      import '../lib/client';
    </script>
  </body>
</html>
