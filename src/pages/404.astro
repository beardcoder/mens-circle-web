---
import { link } from '@lib/ui';

import PageIntro from '../components/PageIntro.astro';
import Button from '../components/ui/Button.astro';
import site from '../data/site.json';
import Layout from '../layouts/Layout.astro';

// Prerendered: no live data. The adapter reads 404.html from disk for unmatched routes.
export const prerender = true;

Astro.cache.set({
  maxAge: 120,
  swr: 60,
  tags: ['404'],
});
---

<Layout
  title={`Seite nicht gefunden – ${site.siteName}`}
  robots="noindex, nofollow"
>
  <PageIntro
    eyebrow="Fehler 404"
    title="Diese Seite gibt es nicht"
    titleId="error-title"
  >
    <Fragment slot="lead">
      Die Seite, die du suchst, wurde verschoben, umbenannt oder hat es nie gegeben.
      {site.contactEmail && (
        <>
          {' '}
          Du vermisst hier etwas?{' '}
          <a
            class={link}
            href={`mailto:${site.contactEmail}`}
          >
            Schreib mir kurz.
          </a>
        </>
      )}
    </Fragment>
    <Button
      href="/"
      size="lg"
      class="max-sm:w-full"
    >
      Zur Startseite
    </Button>
    <Button
      href="/event"
      variant="secondary"
      size="lg"
      class="max-sm:w-full"
    >
      Termine &amp; Anmeldung
    </Button>
  </PageIntro>
  <div class="pb-section"></div>
</Layout>
