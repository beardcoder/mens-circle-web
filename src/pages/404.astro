---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';

// Server-rendered: the Bun adapter hands every unmatched route to
// `app.render()`, which resolves to this 404 route. It must NOT be
// prerendered — the adapter has no static-file fallback for 404.html, so a
// prerendered version would leave unmatched routes with an empty body.
---

<Layout title={`Seite nicht gefunden – ${site.siteName}`} robots="noindex, nofollow">
  <section class="error-page">
    <div class="error-page__content">
      <p class="error-page__code" aria-hidden="true">404</p>
      <h1 class="error-page__title">Diese Seite gibt es nicht</h1>
      <p class="error-page__text">
        Die Seite, die du suchst, wurde verschoben, umbenannt oder hat nie existiert. Kein Grund zur Sorge – der Kreis
        bleibt offen.
      </p>
      <div class="error-page__actions">
        <a href="/" class="btn btn--primary">Zur Startseite</a>
        <a href="/event" class="btn btn--secondary" data-event-cta>Zum nächsten Termin</a>
      </div>
      {
        site.contactEmail && (
          <p class="error-page__contact">
            Du vermisst hier etwas? <a href={`mailto:${site.contactEmail}`}>Schreib mir kurz.</a>
          </p>
        )
      }
    </div>
  </section>
</Layout>

<style is:global>
  @layer sections {
    .error-page {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      /* Clear the fixed header, and fill the viewport so the footer never
         floats into view on short error content. */
      min-block-size: 100svh;
      padding-block: var(--header-clearance) var(--space-xl);
      text-align: center;
    }

    .error-page__content {
      max-inline-size: var(--content-max-description);
      margin-inline: auto;
    }

    .error-page__code {
      margin-block-end: var(--space-sm);
      font-family: var(--font-display);
      font-size: clamp(5rem, 18vw, 9rem);
      line-height: 1;
      color: var(--text-accent);
    }

    .error-page__title {
      margin-block-end: var(--space-md);
      font-size: clamp(1.75rem, 4vw, 2.5rem);
      color: var(--text-primary);
    }

    .error-page__text {
      margin-block-end: var(--space-md);
      font-size: var(--text-section-body-lg);
      line-height: var(--leading-relaxed);
      color: var(--text-muted);
    }

    .error-page__actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-sm);
      justify-content: center;
    }

    .error-page__contact {
      margin-block-start: var(--space-md);
      font-size: 1rem;
      color: var(--text-muted);
    }

    .error-page__contact a,
    .error-page__text a {
      color: var(--accent-primary);
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: color var(--motion-quick);
    }

    .error-page__contact a:hover,
    .error-page__contact a:focus-visible,
    .error-page__text a:hover,
    .error-page__text a:focus-visible {
      color: var(--text-accent);
    }
  }
</style>
