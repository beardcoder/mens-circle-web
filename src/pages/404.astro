---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import SeatRing from '../components/SeatRing.astro';

// Prerendered: no live data. The adapter reads 404.html from disk for unmatched routes.
export const prerender = true;
---

<Layout title={`Seite nicht gefunden – ${site.siteName}`} robots="noindex, nofollow">
  <section class="page-hero error-page">
    <div class="container page-hero__layout">
      <div class="page-hero__content">
        <p class="kicker">Fehler 404</p>
        <h1 class="page-hero__title display">Diese Seite gibt es nicht.</h1>
        <p class="page-hero__lead">Sie wurde verschoben, umbenannt oder hat es nie gegeben. Hier geht es weiter:</p>
        <p class="page-hero__cta actions">
          <a href="/" class="btn btn--primary">
            Zur Startseite
          </a>
          <a href="/event" class="btn btn--secondary">
            Termine &amp; Anmeldung
          </a>
        </p>
        {site.contactEmail && (
          <p class="error-page__contact">
            Du vermisst hier etwas?{' '}
            <a class="link" href={`mailto:${site.contactEmail}`}>
              Schreib mir kurz.
            </a>
          </p>
        )}
      </div>
      <div class="page-hero__media error-page__seats">
        <SeatRing seats={12} open={[7]} enter />
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  @layer sections {
    .error-page {
      min-block-size: 70svh;
    }

    .error-page__contact {
      margin-block-start: var(--space-md);
      font-family: var(--font-ui);
      color: var(--text-muted);
    }

    .error-page__seats {
      align-self: center;
    }

    @media (width <= 56em) {
      .error-page__seats {
        inline-size: 8rem;
      }
    }
  }
</style>
