---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';

// Server-rendered: the Bun adapter hands every unmatched route to
// `app.render()`, which resolves to this 404 route. It must NOT be
// prerendered — the adapter has no static-file fallback for 404.html, so a
// prerendered version would leave unmatched routes with an empty body.
---

<Layout title={`Seite nicht gefunden – ${site.siteName}`} robots="noindex, nofollow">
  <section class="error-page">
    <div class="error-page__content">
      <p class="error-page__code" aria-hidden="true">404</p>
      <h1 class="error-page__title">Diese Seite gibt es nicht</h1>
      <p class="error-page__text">Die Seite, die du suchst, wurde verschoben, umbenannt oder hat es nie gegeben.</p>
      <div class="error-page__actions">
        <a href="/" class="btn btn--primary">Zur Startseite</a>
        <a href="/event" class="btn btn--secondary">Termine &amp; Anmeldung</a>
      </div>
      {
        site.contactEmail && (
          <p class="error-page__contact">
            Du vermisst hier etwas? <a href={`mailto:${site.contactEmail}`}>Schreib mir kurz.</a>
          </p>
        )
      }
    </div>
  </section>
</Layout>

<style is:global>
  @layer sections {
    .error-page {
      /* Clear the fixed header, and leave enough height that the footer never
         floats into view on short error content. */
      min-block-size: 70svh;
      padding-block: calc(var(--header-clearance) + var(--space-lg)) var(--space-xl);
      padding-inline: var(--container-gutter);
    }

    .error-page__content {
      max-inline-size: var(--container-width);
      margin-inline: auto;
    }

    .error-page__code {
      margin-block-end: var(--space-xs);
      font-family: var(--font-body);
      font-size: var(--text-caption);
      font-weight: 600;
      line-height: 1;
      color: var(--text-muted);
      letter-spacing: 0.04em;
    }

    .error-page__title {
      margin-block-end: var(--space-sm);
      font-size: var(--text-4xl);
      line-height: 1.1;
      color: var(--text-primary);
    }

    .error-page__text {
      max-inline-size: var(--measure);
      margin-block-end: var(--space-md);
      font-size: var(--text-section-body-lg);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
    }

    .error-page__actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-xs) var(--space-sm);
    }

    .error-page__contact {
      max-inline-size: var(--measure);
      margin-block-start: var(--space-md);
      font-size: var(--text-caption);
      color: var(--text-muted);
    }

    .error-page__contact a,
    .error-page__text a {
      color: var(--accent-text);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.2em;
      transition: color var(--motion-quick);
    }

    .error-page__contact a:hover,
    .error-page__contact a:focus-visible,
    .error-page__text a:hover,
    .error-page__text a:focus-visible {
      color: var(--accent-rare);
    }
  }
</style>
