---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import BrushRing from '../components/BrushRing.astro';

// Prerendered: no live data. The adapter reads 404.html from disk for unmatched routes.
export const prerender = true;
---

<Layout title={`Seite nicht gefunden – ${site.siteName}`} robots="noindex, nofollow">
  <section class="error-page">
    <div class="error-page__content">
      <BrushRing class="error-page__mark" seed={404} />
      <p class="marker error-page__code">Fehler 404</p>
      <h1 class="display error-page__title">Diese Seite gibt es nicht.</h1>
      <p class="error-page__text">Die Seite, die du suchst, wurde verschoben, umbenannt oder hat es nie gegeben.</p>
      <div class="error-page__actions">
        <a href="/" class="btn btn--primary">
          Zur Startseite
        </a>
        <a href="/event" class="btn btn--secondary">
          Termine &amp; Anmeldung
        </a>
      </div>
      {site.contactEmail && (
        <p class="error-page__contact">
          Du vermisst hier etwas? <a href={`mailto:${site.contactEmail}`}>Schreib mir kurz.</a>
        </p>
      )}
    </div>
  </section>
</Layout>

<style is:global>
  @layer sections {
    .error-page {
      min-block-size: 70svh;
      padding-block: calc(var(--header-height) + var(--space-xl)) var(--space-2xl);
      padding-inline: var(--container-gutter);
    }

    .error-page__content {
      max-inline-size: calc(var(--container-width) - 2 * var(--container-gutter));
      margin-inline: auto;
    }

    .error-page__mark {
      inline-size: clamp(6rem, 4rem + 8vw, 10rem);
      margin-block-end: var(--space-lg);
    }

    .error-page__title {
      max-inline-size: 14ch;
      margin-block-end: var(--space-md);
    }

    .error-page__text {
      max-inline-size: var(--measure);
      margin-block-end: var(--space-lg);
      font-size: var(--text-section-body-lg);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
    }

    .error-page__actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-xs) var(--space-sm);
    }

    .error-page__contact {
      max-inline-size: var(--measure);
      margin-block-start: var(--space-lg);
      font-size: var(--text-caption);
      color: var(--text-muted);
    }

    .error-page__contact a {
      color: var(--text-primary);
      text-decoration: underline;
      text-decoration-color: var(--accent);
      text-decoration-thickness: 1.5px;
      text-underline-offset: 0.2em;
    }
  }
</style>
