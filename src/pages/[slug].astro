---
import { getCollection } from 'astro:content';

import { PRERENDERED_CACHE_CONTROL } from '@lib/cache';

import PageIntro from '../components/PageIntro.astro';
import Container from '../components/ui/Container.astro';
import Prose from '../components/ui/Prose.astro';
import Layout from '../layouts/Layout.astro';

// Static legal pages — no live data, prerendered to plain HTML at build time.
export const prerender = true;

Astro.response.headers.set('Cache-Control', PRERENDERED_CACHE_CONTROL);

// One page per file in src/content/legal/; the file name is the URL.
export async function getStaticPaths() {
  const pages = await getCollection('legal');

  return pages.map((page) => ({ params: { slug: page.id }, props: { page: page.data } }));
}

const { page } = Astro.props;
---

<Layout title={page.meta.title} description={page.meta.description} robots={page.robots}>
  {/* A compact title and one reading column; the legal text itself stays as written. */}
  <PageIntro title={page.title} />
  <Container class="pb-section">
    <Prose html={page.content} width="column" />
  </Container>
</Layout>
