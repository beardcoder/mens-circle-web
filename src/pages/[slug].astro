---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Container from '../components/ui/Container.astro';
import Prose from '../components/ui/Prose.astro';
import datenschutz from '../content/legal/datenschutz.json';
import impressum from '../content/legal/impressum.json';
import { PRERENDERED_CACHE_CONTROL } from '@lib/cache';

// Static legal pages — no live data, prerendered to plain HTML at build time.
export const prerender = true;
Astro.response.headers.set('Cache-Control', PRERENDERED_CACHE_CONTROL);

export function getStaticPaths() {
  const pages = { impressum, datenschutz };
  return Object.entries(pages).map(([slug, page]) => ({
    params: { slug },
    props: { page },
  }));
}

const { page } = Astro.props;
---

<Layout
  title={page.meta?.title ?? page.title}
  description={page.meta?.description}
  robots={page.robots ?? 'noindex, nofollow'}
>
  {/* A compact title and one reading column; the legal text itself stays as written. */}
  <PageIntro title={page.title} titleHtml />
  <Container class="pb-section">
    <Prose html={page.content} width="column" />
  </Container>
</Layout>
