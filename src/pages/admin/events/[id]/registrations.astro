---
import { readAdminRegistrations } from '@lib/server/admin-data';

import RegistrationManager from '../../../../components/admin/RegistrationManager';
import AdminLayout from '../../../../layouts/AdminLayout.astro';

export const prerender = false;

const data = await readAdminRegistrations(Astro.params.id ?? '');

if (!data) return Astro.redirect('/admin', 302);
---

<AdminLayout title="Anmeldungen">
  <RegistrationManager client:load initial={data} />
</AdminLayout>
