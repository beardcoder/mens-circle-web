---
import { DEFAULT_EVENT_NEWSLETTER_INTRO } from '@lib/server/events';
import { getEventById } from '@lib/server/events';

import EventForm from '../../../components/admin/EventForm';
import AdminLayout from '../../../layouts/AdminLayout.astro';

export const prerender = false;

// `?from=<id>` pre-fills the form from an existing event for quick duplication.
const from = Astro.url.searchParams.get('from');
const source = from ? await getEventById(from) : null;

const event = source
  ? {
      ...source,
      id: undefined,
      eventDate: '',
      slug: '',
      isPublished: false,
    }
  : null;
---

<AdminLayout title="Neuer Termin">
  <EventForm client:load event={event} newsletterIntro={DEFAULT_EVENT_NEWSLETTER_INTRO} />
</AdminLayout>
