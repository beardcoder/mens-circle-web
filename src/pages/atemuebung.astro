---
import { BREATHING_STEPS, BREATHING_WARNING } from '@lib/breathing';
import Layout from '../layouts/Layout.astro';
import BreathingExperience from '../components/BreathingExperience.astro';

// Embedded breathing tool — the public-site page. Opened from the nav/footer it
// presents inside the normal site chrome (header/footer). The whole page is one
// continuous dark surface (intro → tool → guide → CTA) so it shares the calm,
// earthy language of the rest of the site instead of bouncing light↔dark. The
// chrome-less, installable full-screen variant lives at /atemuebung/app.
export const prerender = true;

const siteUrl = Astro.site ?? new URL('https://mens-circle.de');
const canonical = new URL(Astro.url.pathname, siteUrl).href;

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: siteUrl.origin },
      { '@type': 'ListItem', position: 2, name: 'Atemübung', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': canonical,
    url: canonical,
    name: 'Atemübung',
    description: 'Eine geführte, interaktive Atemübung im Stil der Wim-Hof-Methode.',
    inLanguage: 'de-DE',
    isPartOf: { '@id': `${siteUrl.origin}/#website` },
  },
];
---

<Layout
  title="Atemübung – Männerkreis Niederbayern/ Straubing"
  description="Eine geführte, interaktive Atemübung im Stil der Wim-Hof-Methode. Drei Runden bewusster Atem für Klarheit, Energie und innere Ruhe."
  schemas={schemas}
>
  <div class="atem-page">
    <section class="atem-intro">
      <div class="atem-intro__inner">
        <p class="atem-intro__eyebrow">Atemübung</p>
        <h1 class="atem-intro__title">Komm bei <span class="atem-intro__accent">dir</span> an.</h1>
        <p class="atem-intro__lede">
          Eine geführte, interaktive Atemübung im Stil der Wim-Hof-Methode — drei Runden bewusster Atem für Klarheit,
          Energie und innere Ruhe. Setze oder lege dich entspannt hin und folge dem Kreis.
        </p>
      </div>
    </section>

    <BreathingExperience />

    <section class="atem-guide">
      <div class="atem-guide__inner">
        <h2 class="atem-guide__title">So funktioniert es</h2>
        <ol class="breathing__steps atem-guide__steps">
          {
            BREATHING_STEPS.map((step) => (
              <li>
                <strong>{step.title}:</strong> {step.text}
              </li>
            ))
          }
        </ol>
        <p class="breathing__warning atem-guide__warning">
          <strong>Wichtig:</strong>
          {BREATHING_WARNING}
        </p>
      </div>
    </section>

    <section class="atem-cta">
      <p class="atem-cta__text">Lieber ablenkungsfrei? Öffne die Übung im Vollbild oder installiere sie als App.</p>
      <a class="btn btn--primary btn--large" href="/atemuebung/app">Im Vollbild öffnen</a>
    </section>
  </div>
</Layout>

<style>
  /* One continuous dark surface. The exercise itself is a dim room, and the
     bands above and below it stay on that ground so the page reads as a single
     calm column rather than bouncing light↔dark around the tool.

     Only the surface changed here: the exercise, its timing, its controls, the
     full-screen route and the safety note are untouched. */
  .atem-page {
    color: var(--color-chalk);
    background: var(--color-night);
  }

  /* The orange primary already reads on this ground (5.9:1 for the ink label on
     orange, and the fill itself against the near-black). Only the hover has to
     change: it cannot go darker here, so it goes to paper. */
  .atem-page .btn--primary {
    --btn-hover-bg: var(--color-paper);
    --btn-hover-color: var(--color-ink);
    --btn-hover-border: var(--color-paper);
  }

  .atem-intro {
    padding-block: calc(var(--header-clearance) + var(--space-md)) var(--space-lg);
    padding-inline: var(--container-gutter);
  }

  .atem-intro__inner {
    inline-size: 100%;
    max-inline-size: var(--container-width);
    margin-inline: auto;
  }

  .atem-intro__eyebrow {
    display: flex;
    gap: 0.6em;
    align-items: center;
    margin: 0 0 var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--text-marker);
    font-weight: 600;
    color: var(--color-chalk);
    text-transform: uppercase;
    letter-spacing: var(--tracking-marker);
  }

  .atem-intro__eyebrow::before {
    flex: none;
    inline-size: 1.75rem;
    block-size: 3px;
    content: '';
    background: var(--color-orange);
  }

  .atem-intro__title {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--display-3);
    font-weight: 800;
    line-height: 0.95;
    color: var(--color-chalk);
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .atem-intro__accent {
    color: var(--color-orange);
  }

  .atem-intro__lede {
    max-inline-size: var(--measure);
    margin: 0;
    font-size: var(--text-section-body-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-chalk-muted);
    text-wrap: pretty;
  }

  /* Instructions and the safety note, below the tool. The safety note must stay
     visible and legible — it is never collapsed, never faded and never moved
     below the fold of the section it belongs to. */
  .atem-guide {
    padding-block: var(--space-lg);
    padding-inline: var(--container-gutter);
    border-block-start: 1px solid var(--border-on-dark);
  }

  .atem-guide__inner {
    inline-size: 100%;
    max-inline-size: var(--container-width);
    margin-inline: auto;
  }

  .atem-guide__title {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    line-height: 1.1;
    color: var(--color-chalk);
    text-transform: uppercase;
  }

  .atem-guide__steps {
    max-inline-size: var(--measure);
    margin-block-end: var(--space-md);
  }

  .atem-guide__warning {
    max-inline-size: var(--measure);
  }

  .atem-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    align-items: center;
    padding-block: var(--space-lg) var(--space-xl);
    padding-inline: var(--container-gutter);
    border-block-start: 1px solid var(--border-on-dark);
  }

  .atem-cta__text {
    max-inline-size: var(--measure);
    margin: 0;
    font-size: var(--text-section-body);
    line-height: var(--leading-relaxed);
    color: var(--color-chalk-muted);
  }

  @media (width >= 700px) {
    .atem-cta {
      justify-content: space-between;
    }
  }
</style>
