---
import site from '@data/site.json'
import { PUBLIC_CACHE, readPublicEvents } from '@lib/server/public-data'
import { breadcrumbSchema, eventSeriesSchema } from '@lib/shared/event-schema'
import { link } from '@lib/ui'

import Faq from '../components/blocks/Faq.astro'
import LinkBand from '../components/blocks/LinkBand.astro'
import EventList from '../components/event/EventList.astro'
import PageIntro from '../components/PageIntro.astro'
import AccordionItem from '../components/ui/AccordionItem.astro'
import Layout from '../layouts/Layout.astro'

const events = await readPublicEvents()

if (events) {
  Astro.cache.set(PUBLIC_CACHE)
}
else {
  Astro.response.status = 503
  Astro.response.headers.set('Cache-Control', 'no-store')
}

const siteUrl = Astro.site!
const canonical = new URL('/event', siteUrl).href;
---

<Layout
  title={`Termine & Anmeldung – ${site.siteName}`}
  description="Termine des Männerkreises in Straubing, Niederbayern: aktueller Terminstand, Ort, Dauer, Beitrag und Anmeldung. Ohne Vorerfahrung, auf Spendenbasis."
  schemas={[eventSeriesSchema(siteUrl), breadcrumbSchema(siteUrl, [['Termine', canonical]])]}
>
  <PageIntro eyebrow="Männerkreis · Straubing / Niederbayern" title="Termine und Anmeldung">
    <Fragment slot="lead">
      Wir treffen uns alle zwei bis vier Wochen im Raum
      {' '}
      {site.geo.locality}
      {' '}
      in Niederbayern. Ein Abend dauert zwei bis
      drei Stunden, läuft auf Spendenbasis und setzt keine Vorerfahrung voraus. Wenn du noch nicht weißt, was dich
      erwartet, lies zuerst,
      {' '}
      {/* The period follows the link directly: on its own line Astro sets a space before it. */}
      <a class={link} href="/#ueber">
        worum es an so einem Abend geht
      </a>
      .
    </Fragment>
  </PageIntro>

  {/* The dates are what this page is for; the notification stands beside them, smaller. */}
  <EventList events={events} />

  <Faq anchor="fragen-zum-termin" title="Fragen zu Termin und Anmeldung">
    <AccordionItem question="Wann findet der nächste Männerkreis statt?">
      Die aktuellen Termine stehen oben auf dieser Seite. Sobald ein neuer Abend geplant ist, erfährst du es auch per
      E-Mail oder über die WhatsApp-Gruppe.
    </AccordionItem>
    <AccordionItem question="Wie melde ich mich an?">
      Wähle einen Termin aus. Dort siehst du den Treffpunkt und ob noch ein Platz frei ist. Für die Anmeldung
      reichen dein Vorname, dein Nachname und deine E-Mail-Adresse. Die Bestätigung kommt per E-Mail.
    </AccordionItem>
    <AccordionItem question="Was kostet die Teilnahme?">
      Der Kreis läuft auf Spendenbasis. Du gibst, was dir der Abend wert ist und was für dich machbar ist. Es gibt
      keinen festen Preis und keine Mitgliedschaft. Die Angaben zum jeweiligen Abend stehen beim Termin.
    </AccordionItem>
    <AccordionItem question="Wo genau findet der Männerkreis statt?">
      Wir treffen uns im Raum
      {' '}
      {site.geo.locality}
      {' '}
      in Niederbayern. Den Veranstaltungsort mit Adresse und Anfahrt findest
      du auf der Seite des jeweiligen Termins. So kannst du schon vor der Anmeldung schauen, ob der Weg für dich passt.
    </AccordionItem>
    <AccordionItem question="Kann ich alleine kommen?">
      Ja. Melde dich für den Abend an, der dir passt. Du brauchst vorher niemanden zu kennen.
    </AccordionItem>
    <AccordionItem question="Gibt es Atemübungen oder Meditation?">
      Je nach Abend kann eine einfache Übung mit Atem, Körperwahrnehmung oder Stille dazugehören. Ich erkläre die Übung vorher.
      Du entscheidest selbst, ob du mitmachst.
    </AccordionItem>
  </Faq>

  <LinkBand
    title="Weiterlesen"
    titleId="mehr-title"
    items={[
      {
        href: '/#ueber',
        title: 'Worum es an so einem Abend geht',
        text: 'Wie wir anfangen, worüber wir sprechen und was wir miteinander vereinbaren.',
      },
      {
        href: '/warum-ich-den-maennerkreis-leite',
        title: 'Warum ich den Männerkreis leite',
        text: 'Markus erzählt, wie er die Abende leitet.',
      },
      {
        href: '/#stimmen',
        title: 'Stimmen aus dem Kreis',
        text: 'Was Männer nach einem Abend geschrieben haben.',
      },
    ]}
  />
</Layout>
