---
import Layout from '../layouts/Layout.astro';
import { fetchNextEventState } from '@lib/server/events';
import { fetchTestimonials } from '@lib/server/testimonials';
import { dateStatus } from '@lib/event-status';
import Faq from '../components/blocks/Faq.astro';
import Facts from '../components/blocks/Facts.astro';
import NextDate from '../components/event/NextDate.astro';
import { eventSeriesSchema } from '@lib/series-schema';
import { buildEventSchema } from '@lib/event-schema';
import site from '@data/site.json';

/** Evergreen landing page for the dates; never redirects. SSR so the date is in the HTML. */
const { status, event } = await fetchNextEventState();
// One object for the whole page, so the date block, the FAQ and the metadata
// cannot disagree. A failed read is its own state, never "kein Termin geplant".
const state = dateStatus(status, event);
const { next } = state;

// One published voice for the pull quote — the top of the curated order, not a
// second copy of the home page's grid. `null` renders no section.
const [voice = null] = await fetchTestimonials(1);

const siteUrl = Astro.site ?? new URL('https://mens-circle.de');
const canonical = new URL('/event', siteUrl).href;

// Rendered below and emitted as FAQPage JSON-LD from this one list — Google flags FAQ markup that does not match the visible text.
const faqItems = [
  {
    question: 'Wann findet der nächste Männerkreis statt?',
    answer: next
      ? `Der nächste Termin ist ${next.dateLabel}${next.timeRange ? ` um ${next.timeRange}` : ''} in ${next.place}. Alle Details und die Anmeldung findest du auf der Seite zu diesem Termin.`
      : 'Der nächste Termin steht noch nicht fest. Sobald er geplant ist, erfährst du es über die Benachrichtigung auf dieser Seite oder über die WhatsApp-Gruppe.',
  },
  {
    question: 'Wie melde ich mich an?',
    answer:
      'Über das Anmeldeformular auf der Seite des jeweiligen Termins. Du brauchst nur Vor- und Nachnamen und eine E-Mail-Adresse. Danach bekommst du eine Bestätigung per E-Mail mit dem genauen Treffpunkt. Ist ein Abend ausgebucht, kommst du auf die Warteliste und rückst nach, sobald ein Platz frei wird.',
  },
  {
    question: 'Was kostet die Teilnahme?',
    answer: next?.costBasis
      ? `Für den nächsten Termin gilt: ${next.costBasis}. Du gibst, was dir der Abend wert ist und was für dich machbar ist – einen festen Preis oder eine Mitgliedschaft gibt es nicht.`
      : 'Der Kreis läuft auf Spendenbasis. Du gibst, was dir der Abend wert ist und was für dich machbar ist. Es gibt keinen festen Preis und keine Mitgliedschaft.',
  },
  {
    question: 'Wo genau findet der Männerkreis statt?',
    answer: `Der Männerkreis findet in ${next?.place || site.geo.locality} in Niederbayern statt. Die genaue Adresse bekommst du mit der Anmeldebestätigung – so bleibt der Ort der Gruppe vorbehalten, die tatsächlich zusammenkommt.`,
  },
  {
    question: 'Kann ich alleine kommen?',
    answer:
      'Ja. Du musst vorher niemanden kennen. Es reicht, wenn du dich für einen Termin anmeldest und an dem Abend da bist.',
  },
  {
    question: 'Gibt es Atemübungen oder Meditation?',
    answer:
      'Je nach Abend kann eine einfache Übung mit Atem, Körperwahrnehmung oder Stille dazugehören. Sie wird vorher erklärt, bleibt bodenständig, und du entscheidest selbst, woran du teilnimmst.',
  },
];

// The page's exit, ordered by what someone who has just read the date wants
// next: what an evening is, who holds it, what others said.
const moreLinks = [
  {
    href: '/#ueber',
    title: 'Worum es an einem Abend geht',
    text: 'Was im Kreis passiert, wie ein Abend abläuft und was dort gilt.',
  },
  {
    href: '/warum-ich-den-maennerkreis-leite',
    title: 'Warum ich den Kreis leite',
    text: 'Ein persönlicher Text von Markus: was ihm wichtig ist und was du von ihm erwarten kannst.',
  },
  {
    href: '/#faq',
    title: 'Häufige Fragen',
    text: 'Was Männer vor ihrem ersten Abend wissen wollen – auch zu Therapie und Coaching.',
  },
];

/** The series is built once in lib/series-schema.ts and shared with the home page, so both describe one entity under one `@id`. */
const eventSeries = eventSeriesSchema(siteUrl);
if (event) {
  // Google validates every Event node as a rich result, so a stub with only `@id`/`url`
  // is flagged invalid: embed the full Event, minus what the series already states.
  const { '@context': _context, superEvent: _superEvent, ...subEvent } = buildEventSchema(event, siteUrl);
  eventSeries.subEvent = subEvent;
}

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonical}#faq`,
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: siteUrl.origin },
    { '@type': 'ListItem', position: 2, name: 'Termine', item: canonical },
  ],
};

// Changes with the state so the SERP snippet is never stale, but both variants
// lead with the same evergreen keywords.
const description = next
  ? `Nächster Männerkreis in ${next.place}: ${next.dateLabel}${next.timeRange ? `, ${next.timeRange}` : ''}. Anmeldung, Ort, Dauer und Beitrag auf einen Blick – ohne Vorerfahrung, auf Spendenbasis.`
  : 'Termine des Männerkreises in Straubing, Niederbayern: aktueller Terminstand, Ort, Dauer, Beitrag und Anmeldung. Ohne Vorerfahrung, auf Spendenbasis.';

// The <title> stays evergreen because that is what ranks; the social title leads with the date when there is one.
const socialTitle = next ? `Nächster Männerkreis: ${next.dateLabel} in ${next.place}` : `Termine – ${site.siteName}`;

const socialDetails = next
  ? [
      { label: 'Nächster Termin', value: [next.dateLabel, next.timeRange].filter(Boolean).join(', ') },
      { label: 'Ort', value: next.place },
    ]
  : [];
---

<Layout
  title={`Termine & Anmeldung – ${site.siteName} / Niederbayern`}
  description={description}
  ogTitle={socialTitle}
  socialDetails={socialDetails}
  schemas={[eventSeries, faqPage, breadcrumbs]}
>
  <section class="page-hero">
    <div class="container page-hero__layout">
      <div class="page-hero__content">
        <p class="kicker">Männerkreis Straubing, Niederbayern</p>
        <h1 class="page-hero__title display">Termine und Anmeldung</h1>
        <p class="page-hero__lead">
          Wir treffen uns alle zwei bis vier Wochen in {next?.place || site.geo.locality}. Ein Abend dauert zwei bis
          drei Stunden, läuft auf Spendenbasis und setzt keine Vorerfahrung voraus. Noch unsicher? Lies zuerst,{' '}
          <a class="link" href="/#ueber">
            worum es an so einem Abend geht
          </a>
          .
        </p>
      </div>
    </div>
  </section>

  <NextDate state={state} />
  <Facts variant="list" next={next} />

  {/* The top curated entry as a pull quote, quoted as submitted. Not a second
      testimonials grid — that would put the same quotes on two indexed URLs. */}
  {voice && (
    <section class="section section--ruled event-landing-voice" aria-label="Stimme aus dem Kreis">
      <div class="container">
        <figure class="event-landing-voice__figure" data-reveal>
          <blockquote class="event-landing-voice__quote">{voice.quote}</blockquote>
          {(voice.author || voice.role) && (
            <figcaption class="event-landing-voice__author">
              {voice.author && <cite class="event-landing-voice__name">{voice.author}</cite>}
              {voice.role && <span class="event-landing-voice__role">{voice.role}</span>}
            </figcaption>
          )}
        </figure>
      </div>
    </section>
  )}

  <Faq
    data={{
      anchor: 'fragen-zum-termin',
      title: 'Fragen zu Termin und Anmeldung',
      items: faqItems,
    }}
  />

  <section class="section section--sand event-landing-more" aria-labelledby="mehr-title">
    <div class="container">
      <h2 class="event-landing-more__heading" id="mehr-title">
        Bevor du dich anmeldest
      </h2>

      <ul class="doors" role="list">
        {moreLinks.map((link) => (
          <li data-reveal>
            <a class="doors__link" href={link.href}>
              <span class="doors__title">{link.title}</span>
              <span class="doors__text">{link.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style is:global>
  @layer sections {
    .event-landing-voice__figure {
      max-inline-size: 40ch;
      margin: 0 0 0 auto;
    }

    .event-landing-voice__quote {
      margin: 0;
      font-family: var(--font-body);
      font-size: var(--step-2);
      font-style: italic;
      font-weight: 380;
      line-height: 1.32;
      color: var(--text-primary);
      text-wrap: pretty;
    }

    .event-landing-voice__author {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3xs) var(--space-xs);
      align-items: baseline;
      margin-block-start: var(--space-sm);
      font-family: var(--font-ui);
    }

    .event-landing-voice__name {
      font-size: 0.9375rem;
      font-style: normal;
      font-weight: 600;
      color: var(--text-primary);
    }

    .event-landing-voice__role {
      font-size: 0.9375rem;
      color: var(--text-muted);
    }

    .event-landing-more__heading {
      margin-block-end: var(--space-lg);
      font-size: var(--step-3);
    }
  }
</style>
