---
import Layout from '../layouts/Layout.astro';
import { fetchNextEventState } from '@lib/server/events';
import { fetchTestimonials } from '@lib/server/testimonials';
import { buildEventFaq, summarizeNextEvent } from '@lib/event-landing';
import { dateStatus } from '@lib/event-status';
import EventLanding from '../components/event/EventLanding.astro';
import { eventSeriesSchema } from '@lib/series-schema';
import site from '@data/site.json';

/**
 * The permanent landing page for the dates. It never redirects to
 * /event/<slug>, so this URL holds evergreen content and can rank. SSR, not
 * prerendered: the upcoming date belongs in the initial HTML.
 */
const { status, event } = await fetchNextEventState();
const next = summarizeNextEvent(event);
// One object for the whole page, so the date block, the FAQ and the metadata
// cannot disagree. A failed read is its own state, never "kein Termin geplant".
const state = dateStatus(status, next);

// One published voice for the pull quote — the top of the curated order, not a
// second copy of the home page's grid. `null` renders no section.
const [voice = null] = await fetchTestimonials(1);

const siteUrl = Astro.site ?? new URL('https://mens-circle.de');
const canonical = new URL('/event', siteUrl).href;

// The same builder the component renders from, so the FAQPage markup cannot
// drift from the visible questions.
const faqItems = buildEventFaq(state.next);

/**
 * The series is built once in lib/series-schema.ts and shared with the home
 * page, so both describe one entity under one `@id`. A scheduled meeting is
 * referenced as a `subEvent` pointing at its canonical URL, never restated.
 */
const eventSeries: Record<string, unknown> = {
  ...eventSeriesSchema(siteUrl),
  ...(state.next
    ? {
        subEvent: {
          '@type': 'Event',
          '@id': new URL(`/event/${state.next.slug}`, siteUrl).href,
          url: new URL(`/event/${state.next.slug}`, siteUrl).href,
        },
      }
    : {}),
};

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonical}#faq`,
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: siteUrl.origin },
    { '@type': 'ListItem', position: 2, name: 'Termine', item: canonical },
  ],
};

// Changes with the state so the SERP snippet is never stale, but both variants
// lead with the same evergreen keywords.
const description = state.next
  ? `Nächster Männerkreis in ${state.next.place}: ${state.next.dateLabel}${state.next.timeRange ? `, ${state.next.timeRange}` : ''}. Anmeldung, Ort, Dauer und Beitrag auf einen Blick – ohne Vorerfahrung, auf Spendenbasis.`
  : 'Termine des Männerkreises in Straubing, Niederbayern: aktueller Terminstand, Ort, Dauer, Beitrag und Anmeldung. Ohne Vorerfahrung, auf Spendenbasis.';

// The <title> stays evergreen because that is what ranks; the social title
// leads with the date when there is one. `unavailable` gets the evergreen
// wording rather than a claim about an empty calendar.
const socialTitle = state.next
  ? `Nächster Männerkreis: ${state.next.dateLabel} in ${state.next.place}`
  : `Termine – ${site.siteName}`;

const socialDetails = state.next
  ? [
      { label: 'Nächster Termin', value: [state.next.dateLabel, state.next.timeRange].filter(Boolean).join(', ') },
      { label: 'Ort', value: state.next.place },
    ]
  : [];
---

<Layout
  title={`Termine & Anmeldung – ${site.siteName} / Niederbayern`}
  description={description}
  ogTitle={socialTitle}
  socialDetails={socialDetails}
  schemas={[eventSeries, faqPage, breadcrumbs]}
>
  <EventLanding state={state} voice={voice} />
</Layout>
