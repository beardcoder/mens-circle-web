---
import site from '@data/site.json';
import { PRERENDERED_CACHE_CONTROL } from '@lib/cache-policy';
import { breadcrumbSchema, eventSeriesSchema } from '@lib/event-schema';
import { link } from '@lib/ui';

import Faq from '../components/blocks/Faq.astro';
import LinkBand from '../components/blocks/LinkBand.astro';
import EventList from '../components/event/EventList.astro';
import PageIntro from '../components/PageIntro.astro';
import AccordionItem from '../components/ui/AccordionItem.astro';
import Layout from '../layouts/Layout.astro';

export const prerender = true;

Astro.response.headers.set('Cache-Control', PRERENDERED_CACHE_CONTROL);

const siteUrl = Astro.site!;
const canonical = new URL('/event', siteUrl).href;
---

<Layout
  title={`Termine & Anmeldung – ${site.siteName}`}
  description="Termine des Männerkreises in Straubing, Niederbayern: aktueller Terminstand, Ort, Dauer, Beitrag und Anmeldung. Ohne Vorerfahrung, auf Spendenbasis."
  schemas={[eventSeriesSchema(siteUrl), breadcrumbSchema(siteUrl, [['Termine', canonical]])]}
  preloadData={['/api/public/events']}
>
  <PageIntro eyebrow="Männerkreis · Straubing / Niederbayern" title="Termine und Anmeldung">
    <Fragment slot="lead">
      Wir treffen uns alle zwei bis vier Wochen in {site.geo.locality} in Niederbayern. Ein Abend dauert zwei bis drei
      Stunden, läuft auf Spendenbasis und setzt keine Vorerfahrung voraus. Wenn du noch nicht weißt, was dich erwartet,
      lies zuerst, {/* The period follows the link directly: on its own line Astro sets a space before it. */}
      <a class={link} href="/#ueber">
        worum es an so einem Abend geht
      </a>
      {'.'}
    </Fragment>
  </PageIntro>

  {/* The dates are what this page is for; the notification stands beside them, smaller. */}
  <EventList />

  <Faq anchor="fragen-zum-termin" eyebrow="Vor dem Termin" title="Fragen zu Termin und Anmeldung">
    <AccordionItem question="Wann findet der nächste Männerkreis statt?">
      Die aktuellen Termine stehen oben auf dieser Seite. Sobald ein neuer Abend geplant ist, erfährst du es auch per
      E-Mail oder über die WhatsApp-Gruppe.
    </AccordionItem>
    <AccordionItem question="Wie melde ich mich an?">
      Über das Anmeldeformular auf der Seite des jeweiligen Termins. Du brauchst nur Vor- und Nachnamen und eine
      E-Mail-Adresse. Danach bekommst du eine Bestätigung per E-Mail mit dem genauen Treffpunkt. Ist ein Abend
      ausgebucht, kommst du auf die Warteliste und rückst nach, sobald ein Platz frei wird.
    </AccordionItem>
    <AccordionItem question="Was kostet die Teilnahme?">
      Der Kreis läuft auf Spendenbasis. Du gibst, was dir der Abend wert ist und was für dich machbar ist. Es gibt
      keinen festen Preis und keine Mitgliedschaft. Die Angaben zum jeweiligen Abend stehen beim Termin.
    </AccordionItem>
    <AccordionItem question="Wo genau findet der Männerkreis statt?">
      Der Männerkreis findet in {site.geo.locality} in Niederbayern statt. Die genaue Adresse bekommst du mit der
      Anmeldebestätigung – so bleibt der Ort der Gruppe vorbehalten, die tatsächlich zusammenkommt.
    </AccordionItem>
    <AccordionItem question="Kann ich alleine kommen?">
      Ja. Du musst vorher niemanden kennen. Es reicht, wenn du dich für einen Termin anmeldest und an dem Abend da bist.
    </AccordionItem>
    <AccordionItem question="Gibt es Atemübungen oder Meditation?">
      Je nach Abend kann eine einfache Übung mit Atem, Körperwahrnehmung oder Stille dazugehören. Sie wird vorher
      erklärt, bleibt bodenständig, und du entscheidest selbst, woran du teilnimmst.
    </AccordionItem>
  </Faq>

  <LinkBand
    eyebrow="Mehr über den Kreis"
    title="Weiterlesen"
    titleId="mehr-title"
    items={[
      {
        href: '/#ueber',
        title: 'Worum es an so einem Abend geht',
        text: 'Der Ablauf, der Rahmen und was der Kreis ausdrücklich nicht ist.',
      },
      {
        href: '/warum-ich-den-maennerkreis-leite',
        title: 'Warum ich den Männerkreis leite',
        prefetch: true,
        text: 'Ein persönlicher Text von Markus: was ihm wichtig ist und was du von ihm erwarten kannst.',
      },
      {
        href: '/#stimmen',
        title: 'Stimmen aus dem Kreis',
        text: 'Was Männer nach einem Abend geschrieben haben.',
      },
    ]}
  />
</Layout>
