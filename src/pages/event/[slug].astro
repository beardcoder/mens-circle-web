---
import { buildEventMeta } from '@lib/event-meta';
import { breadcrumbSchema, buildEventSchema } from '@lib/event-schema';
import { getEventBySlug } from '@lib/server/events';

import LinkBand from '../../components/blocks/LinkBand.astro';
import EventIntro from '../../components/event/EventIntro.astro';
import EventMapSection from '../../components/event/EventMapSection.astro';
import EventRegister from '../../components/event/EventRegister.astro';
import Layout from '../../layouts/Layout.astro';

// One SSR page per event, read per request, so a new or edited event is live with no rebuild.
const { slug } = Astro.params;
const event = slug ? await getEventBySlug(slug) : null;

if (!event) return Astro.redirect('/event', 302);

const siteUrl = Astro.site!;
const hasMap = event.latitude !== null && event.longitude !== null;

// This is the page people forward, so the preview answers "when, where, still a
// seat?" without anyone opening the link.
const meta = buildEventMeta(event, siteUrl);

// No `ogType="event"`: Open Graph never registered that type, so every scraper
// falls back to "website". The Event JSON-LD below carries the event-ness.

const eventSchema = buildEventSchema(event, siteUrl, meta);

// /event carries the first two levels; without this the individual date sits
// outside the site's hierarchy.
const breadcrumbs = breadcrumbSchema(siteUrl, [
  ['Termine', new URL('/event', siteUrl).href],
  [meta.ogTitle, new URL(`/event/${event.slug}`, siteUrl).href],
]);

// The page's exit: where someone who has read the date goes next.
const nextLinks = [
  ...(event.is_past ? [{ href: '/event#benachrichtigung', title: 'Termine per E-Mail erhalten' }] : []),
  { href: '/event', title: 'Alle Termine' },
  { href: '/#ueber', title: 'Worum es an so einem Abend geht' },
  { href: '/warum-ich-den-maennerkreis-leite', title: 'Warum ich den Männerkreis leite', prefetch: true },
];
---

<Layout
  title={meta.title}
  description={meta.description}
  ogTitle={meta.ogTitle}
  ogImageAlt={meta.imageAlt}
  socialDetails={meta.details}
  schemas={[eventSchema, breadcrumbs]}
>
  {/* The date and its facts, then what the page is for: the description beside the registration. */}
  <EventIntro event={event} />
  <EventRegister event={event} />

  {hasMap && <EventMapSection event={event} />}
  <LinkBand eyebrow="Weiter" title="Wohin als Nächstes" titleId="weiter-title" items={nextLinks} />
</Layout>
