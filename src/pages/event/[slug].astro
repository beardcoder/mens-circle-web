---
import { actions, isInputError } from 'astro:actions';

import { fetchEventState } from '@lib/server/events';
import { PUBLIC_CACHE, publicEvent } from '@lib/server/public-data';
import { buildEventMeta } from '@lib/shared/event-meta';
import { breadcrumbSchema, buildEventSchema } from '@lib/shared/event-schema';
import { splitFee } from '@lib/shared/event-status';

import LinkBand from '../../components/blocks/LinkBand.astro';
import EventIntro from '../../components/event/EventIntro.astro';
import EventMapSection from '../../components/event/EventMapSection.astro';
import EventRegister from '../../components/event/EventRegister.astro';
import EventStory from '../../components/event/EventStory.astro';
import Layout from '../../layouts/Layout.astro';

// One SSR page per event, read on a route-cache miss, so a new or edited event is live with no rebuild.
const { status, event } = await fetchEventState(Astro.params.slug ?? '');

if (status === 'not-found') return Astro.redirect('/event', 302);

if (!event) {
  return new Response('Der Termin ist gerade nicht abrufbar. Bitte versuche es später erneut.', {
    status: 503,
    headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Cache-Control': 'no-store', 'Retry-After': '30' },
  });
}

// The registration posted without JavaScript: answer on this page, never from or into the cache.
const posted = Astro.getActionResult(actions.register);
let values: Record<string, string> = {};

if (posted) {
  Astro.response.headers.set('Cache-Control', 'private, no-store');

  if (posted.error) {
    const form = await Astro.request
      .clone()
      .formData()
      .catch(() => null);

    values = Object.fromEntries(
      ['first_name', 'last_name', 'email', 'phone_number', 'privacy'].map((name) => [
        name,
        String(form?.get(name) ?? ''),
      ]),
    );
  }
} else {
  Astro.cache.set(PUBLIC_CACHE);
}

const registration = posted?.data
  ? { message: posted.data.message }
  : posted?.error
    ? {
        error: posted.error.message,
        fields: isInputError(posted.error)
          ? Object.fromEntries(Object.entries(posted.error.fields).map(([key, list]) => [key, list?.[0] ?? '']))
          : {},
      }
    : null;

const siteUrl = Astro.site!;

const hasPlace = !!(
  event.location ||
  event.street ||
  event.city ||
  (event.latitude !== null && event.longitude !== null)
);

// This is the page people forward, so the preview answers "when, where, still a
// seat?" without anyone opening the link.
const meta = buildEventMeta(event, siteUrl);

// No `ogType="event"`: Open Graph never registered that type, so every scraper
// falls back to "website". The Event JSON-LD below carries the event-ness.

const eventSchema = buildEventSchema(event, siteUrl, meta);

// /event carries the first two levels; without this the individual date sits
// outside the site's hierarchy.
const breadcrumbs = breadcrumbSchema(siteUrl, [
  ['Termine', new URL('/event', siteUrl).href],
  [meta.ogTitle, new URL(`/event/${event.slug}`, siteUrl).href],
]);
---

<Layout
  title={meta.title}
  description={meta.description}
  ogTitle={meta.ogTitle}
  ogImageAlt={meta.imageAlt}
  socialDetails={meta.details}
  schemas={[eventSchema, breadcrumbs]}
  headerAction={event.is_past ? undefined : { href: '#anmeldung', label: event.is_full ? 'Warteliste' : 'Anmelden' }}
>
  {/* Invitation and date, the conversation beside the signup, then the meeting place. */}
  <EventIntro event={event}>
    <EventRegister
      event={publicEvent(event)}
      contribution={splitFee(event.cost_basis)}
      result={registration}
      values={values}
    />
  </EventIntro>
  <EventStory event={event} />

  {hasPlace && <EventMapSection event={event} />}
  <LinkBand
    eyebrow=""
    title="Den Kreis kennenlernen"
    titleId="weiter-title"
    items={[
      ...(event.is_past ? [{ href: '/event#benachrichtigung', title: 'Termine per E-Mail erhalten' }] : []),
      { href: '/#reise', title: 'So läuft ein Abend ab' },
      { href: '/warum-ich-den-maennerkreis-leite', title: 'Warum ich den Männerkreis leite' },
    ]}
  />
</Layout>
