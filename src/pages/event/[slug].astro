---
import Layout from '../../layouts/Layout.astro';
import { getEventBySlug } from '@lib/server/events';
import { buildEventMeta } from '@lib/event-meta';
import { CARD_HEIGHT, CARD_WIDTH } from '@lib/og-card-size';
import { buildEventSchema } from '@lib/event-schema';
import EventPageContent from '../../components/event/EventPageContent.astro';

// One SSR page per event, read per request, so a new or edited event is live
// with no rebuild. An unknown slug falls back to /event.
const { slug } = Astro.params;
const event = slug ? await getEventBySlug(slug) : null;
if (!event) return Astro.redirect('/event', 302);

const siteUrl = Astro.site ?? new URL('https://mens-circle.de');

// This is the page people forward, so the preview answers "when, where, still a
// seat?" without anyone opening the link.
const meta = buildEventMeta(event, siteUrl);

// No `ogType="event"`: Open Graph never registered that type, so every scraper
// falls back to "website". The Event JSON-LD below carries the event-ness.

const eventSchema = buildEventSchema(event, siteUrl);

// /event carries the first two levels; without this the individual date sits
// outside the site's hierarchy.
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: siteUrl.origin },
    { '@type': 'ListItem', position: 2, name: 'Termine', item: new URL('/event', siteUrl).href },
    {
      '@type': 'ListItem',
      position: 3,
      name: meta.ogTitle,
      item: new URL(`/event/${event.slug}`, siteUrl).href,
    },
  ],
};
---

<Layout
  title={meta.title}
  description={meta.description}
  ogTitle={meta.ogTitle}
  ogImage={meta.image}
  ogImageWidth={CARD_WIDTH}
  ogImageHeight={CARD_HEIGHT}
  ogImageAlt={meta.imageAlt}
  socialDetails={meta.details}
  schemas={[eventSchema, breadcrumbs]}
>
  <EventPageContent event={event} />
</Layout>
