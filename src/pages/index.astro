---
import site from '@data/site.json';
import { eventSeriesSchema } from '@lib/event-schema';
import { PUBLIC_CACHE, readPublicEvents, readPublicTestimonials } from '@lib/server/public-data';

import avatar from '../assets/images/markus-avatar-192.webp';
import circle480 from '../assets/images/markus-kreis-480.avif';
import circle720 from '../assets/images/markus-kreis-720.avif';
import circle960 from '../assets/images/markus-kreis-960.avif';
import Dates from '../components/blocks/Dates.astro';
import Fact from '../components/blocks/Fact.astro';
import Facts from '../components/blocks/Facts.astro';
import Faq from '../components/blocks/Faq.astro';
import Frame from '../components/blocks/Frame.astro';
import Hero from '../components/blocks/Hero.astro';
import Intro from '../components/blocks/Intro.astro';
import JourneyStep from '../components/blocks/JourneyStep.astro';
import JourneySteps from '../components/blocks/JourneySteps.astro';
import Moderator from '../components/blocks/Moderator.astro';
import Newsletter from '../components/blocks/Newsletter.astro';
import Statement from '../components/blocks/Statement.astro';
import Testimonials from '../components/blocks/Testimonials.astro';
import AccordionItem from '../components/ui/AccordionItem.astro';
import Layout from '../layouts/Layout.astro';

// Rendered on a route-cache miss; actions purge the cache when the data changes.
const [events, testimonials] = await Promise.all([readPublicEvents(), readPublicTestimonials()]);

if (!events) Astro.response.status = 503;

// A partial page is shown, but never stored.
if (events && testimonials) {
  Astro.cache.set(PUBLIC_CACHE);
} else {
  Astro.response.headers.set('Cache-Control', 'no-store');
}
---

<Layout
  title="Männerkreis Niederbayern · Straubing und Umgebung"
  description="Männerkreis in Straubing, Niederbayern: Männer sitzen im Kreis, hören zu und sprechen offen, dazu einfache Atemübungen. Auf Spendenbasis, ohne Vorerfahrung."
  schemas={[eventSeriesSchema(Astro.site!)]}
>
  <Hero
    events={events}
    kicker="Männerkreis in Straubing · Niederbayern"
    secondaryLabel="Wie ein Abend abläuft"
    secondaryLink="#reise"
    images={[circle480, circle720, circle960]}
    imageAlt="Markus Sommer sitzt auf einem Felsen und blickt in der Abendsonne über den Bayerischen Wald."
  >
    <Fragment slot="title">
      Ein Abend, an dem du <em>nichts darstellen</em> musst.
    </Fragment>
    Wir sitzen im Kreis und sprechen über das, was uns gerade beschäftigt. Die anderen hören zu, ohne zu bewerten oder
    Ratschläge zu geben. Je nach Abend kommen einfache Atem- und Körperübungen dazu. Du entscheidest, ob du mitmachst.
  </Hero>

  <Facts anchor="praktisches" eyebrow="Auf einen Blick">
    <Fact label="Wo" icon="place">
      <Fragment slot="value">{events?.next?.place || site.geo.locality}</Fragment>
      Adresse und Anfahrt stehen beim jeweiligen Termin
    </Fact>
    <Fact label="Wie oft" icon="calendar">
      <Fragment slot="value">Alle 2–4 Wochen</Fragment>
      Ohne Mitgliedschaft. Du kommst, wann es dir passt.
    </Fact>
    <Fact label="Dauer" icon="clock">
      <Fragment slot="value">2–3 Stunden</Fragment>
      {events?.next?.timeRange ? `Nächster Termin: ${events.next.timeRange}` : 'Ein Abend, kein Seminar'}
    </Fact>
    <Fact label="Beitrag" icon="heart">
      <Fragment slot="value">{events?.fee.main || 'Spendenbasis'}</Fragment>
      {events?.fee.note ?? 'Du gibst, was für dich machbar ist'}
    </Fact>
  </Facts>

  <Intro
    anchor="ueber"
    eyebrow="Der Kreis"
    title="Worum es an so einem Abend geht"
    questionsLabel="Fragen aus der ersten Runde"
    questions={[
      'Wie geht es dir gerade wirklich?',
      'Was spürst du, und wo im Körper?',
      'Was läuft gut, was kostet dich Kraft?',
      'Was schiebst du schon länger vor dir her?',
    ]}
    close="Einen besonderen Grund zu kommen brauchst du nicht. Manchmal reicht Neugier."
  >
    <p>
      Arbeit, Familie, Beziehung und Verantwortung beschäftigen uns im Alltag. Vieles machen wir mit uns selbst aus.
      Gespräche unter Männern landen oft schnell bei Job, Sport oder dem nächsten Ratschlag.
    </p>
    <p>
      Im Kreis geht es auch um das, was sonst keinen Platz hat. Fertige Antworten brauchst du dafür nicht. Es reicht,
      den anderen zuzuhören und ehrlich zu erzählen, wenn du dran bist.
    </p>
  </Intro>

  <JourneySteps
    anchor="reise"
    eyebrow=""
    title="Wie ein Abend abläuft"
    subtitle="Die Abende laufen ähnlich ab, aber nicht nach Minutenplan. Wir sitzen im Kreis, und jeder hat das gleiche Recht, zu sprechen und gehört zu werden."
  >
    <Fragment slot="steps">
      <JourneyStep number={1} title="Ankommen">
        Wir kommen an, oft mit ein paar ruhigen Atemzügen. Dann erkläre ich die Absprachen und frage, ob alle damit
        einverstanden sind.
      </JourneyStep>
      <JourneyStep number={2} title="Die erste Runde">
        Reihum sagt jeder kurz, wie es ihm gerade geht und was er mitbringt. So kommt jeder einmal zu Wort, bevor wir
        ins Gespräch gehen.
      </JourneyStep>
      <JourneyStep number={3} title="Teilen und zuhören">
        Wer spricht, hat die ganze Aufmerksamkeit der anderen. Wir lassen ausreden, bewerten nicht und geben keine
        ungefragten Ratschläge. Du erzählst so viel, wie du möchtest. Nur zuzuhören ist auch in Ordnung.
      </JourneyStep>
      <JourneyStep number={4} title="Abschlussrunde">
        Zum Schluss sagt jeder in ein, zwei Worten, was er mitnimmt. Oft ist es ein Gedanke oder eine andere Sicht auf
        etwas, manchmal einfach das Gefühl, mit etwas nicht allein zu sein.
      </JourneyStep>
    </Fragment>
    <p slot="close">
      Vorerfahrung mit Männerkreisen, Meditation oder Atemarbeit brauchst du nicht, und vorbereiten musst du nichts.
    </p>
  </JourneySteps>

  <Statement
    anchor="haltung"
    eyebrow="Atem und Körper"
    lines={['Aus dem Kopf.', 'In den Körper.']}
    text="Nach einem vollen Tag hilft es, kurz auf den Körper zu achten. Dafür nehmen wir uns zu Beginn Zeit: ruhig atmen, die Füße auf dem Boden spüren. Die Übungen sind einfach, und du entscheidest bei jeder, ob du mitmachst."
    linkLabel="Was wir miteinander vereinbaren"
    linkUrl="#rahmen"
    breathGuide="Atme ein paar Züge mit: langsam ein und langsam aus, je gut fünf Sekunden."
  />

  <Moderator
    anchor="moderator"
    eyebrow="Wer den Kreis leitet"
    name="Ich bin Markus."
    quote="Ich sorge dafür, dass jeder in Ruhe sprechen kann und die anderen zuhören. Mit Ratschlägen halte ich mich zurück."
    avatar={avatar}
    imageAlt="Markus Sommer"
    signature="Markus Sommer"
    signatureNote="hat den Kreis gegründet und leitet ihn"
    linkLabel="Warum ich den Männerkreis leite"
    linkUrl="/warum-ich-den-maennerkreis-leite"
  >
    <p>
      Ich bin gebürtiger Niederbayer und habe den Männerkreis in Straubing gegründet, weil mir selbst ein Ort gefehlt
      hat, an dem Männer über das sprechen können, was sie sonst mit sich allein ausmachen.
    </p>
    <p>
      Natur, Atem und Körperwahrnehmung helfen mir, aus dem Kopf zu kommen. Davon bringe ich etwas in den Kreis mit.
    </p>
    <p>
      Ich sitze mit im Kreis. Zu Beginn erkläre ich die Absprachen, frage, ob alle sie mittragen, und achte darauf, dass
      sie gelten. Jeder kann zu Wort kommen, keiner muss.
    </p>
    <p>
      Übungen mit Atem oder Körperwahrnehmung leite ich als Angebot an. Bevor wir etwas gemeinsam machen, frage ich, ob
      es für dich passt. Nein ist dabei immer eine gute Antwort.
    </p>
  </Moderator>

  <Frame
    anchor="rahmen"
    eyebrow="Der Rahmen"
    title="Was wir vereinbaren"
    intro={
      'Zu Beginn jedes Abends gehen wir fünf Absprachen durch und fragen, ob alle sie mittragen. Sie machen es leichter, offen zu sprechen.'
    }
    agreements={[
      {
        title: 'Vertraulichkeit',
        text: 'Was im Kreis erzählt wird, bleibt im Kreis. Das sagen wir uns zu Beginn gegenseitig zu.',
      },
      {
        title: 'Ehrlichkeit',
        text: 'Du erzählst, wie es dir wirklich geht. Auch „Ich möchte heute nichts sagen“ ist eine ehrliche Antwort.',
      },
      {
        title: 'Annehmen statt bewerten',
        text: 'Wir hören zu, auch wenn Erfahrungen weit auseinandergehen, und versuchen nicht, einander zu reparieren. Ratschläge gibt es nur, wenn jemand darum bittet.',
      },
      {
        title: 'Von sich sprechen',
        text: 'Jeder spricht von sich: „ich“ statt „man“. Was du erzählst und wobei du mitmachst, entscheidest du selbst.',
      },
      {
        title: 'Respekt',
        text: 'Wir nehmen ernst, was jemand erzählt. Niemand wird belächelt, unterbrochen oder kommentiert.',
      },
    ]}
    boundaryTitle="Gut zu wissen"
    boundaryText={
      'Der Männerkreis ist weder Therapie noch Coaching und ersetzt beides nicht. Wenn du gerade therapeutische Unterstützung brauchst, ist professionelle Hilfe der richtige Weg. Es gibt im Kreis keine Lehre und kein festes Bild davon, wie ein Mann zu sein hat.'
    }
  />

  <Testimonials
    items={testimonials}
    anchor="stimmen"
    eyebrow="Aus dem Kreis"
    title="Was Teilnehmer geschrieben haben"
    linkUrl="/teile-deine-erfahrung"
    linkLabel="Du warst dabei? Teile deine Erfahrung"
    emptyText="Erfahrungen von Teilnehmern erscheinen hier, sobald sie freigegeben sind."
    errorText="Die Erfahrungen lassen sich gerade nicht laden. Bitte schau später noch einmal vorbei."
  />

  <Faq anchor="faq" eyebrow="" title="Was Männer vorher wissen wollen">
    <AccordionItem question="Was ist ein Männerkreis?">
      Ein Männerkreis ist eine feste Runde von Männern, die sich regelmäßig trifft, im Kreis sitzt und offen über das
      spricht, was gerade da ist. Einer spricht, die anderen hören zu, ohne zu bewerten oder Ratschläge zu geben. In
      Straubing treffen wir uns alle zwei bis vier Wochen für zwei bis drei Stunden, auf Spendenbasis und ohne
      Vorerfahrung.
    </AccordionItem>
    <AccordionItem question="Für wen ist der Männerkreis?">
      Für Männer, die sich ehrlichere Gespräche mit anderen Männern wünschen. Alter, Herkunft, Glaube, Beruf und mit wem
      du dein Leben teilst, spielen keine Rolle. Mitbringen musst du nur die Bereitschaft, zuzuhören und die anderen
      respektvoll zu behandeln.
    </AccordionItem>
    <AccordionItem question="Muss ich etwas erzählen?">
      Nein. Du entscheidest, was und wie viel du teilst. Niemand wird gedrängt, und zuhören ist genauso Teil des Kreises
      wie sprechen.
    </AccordionItem>
    <AccordionItem question="Muss ich bei den Atem- und Körperübungen mitmachen?">
      Nein. Die Übungen sind einfach und ein Angebot. Du machst mit, soweit es für dich passt, oder bleibst einfach
      sitzen.
    </AccordionItem>
    <AccordionItem question="Ich war noch nie in einem Männerkreis. Ist das ein Problem?">
      Nein. Du brauchst keine Vorerfahrung und musst nichts vorbereiten. Der Rahmen wird zu Beginn erklärt, damit du
      weißt, worauf du dich einlässt. Ungewohnt ist der erste Abend für fast jeden.
    </AccordionItem>
    <AccordionItem question="Ist das spirituell?">
      Nein, eher bodenständig. Wir sitzen zusammen, atmen, sprechen und hören zu, manchmal halten wir auch einen Moment
      Stille. Es gibt keine Lehre und keinen Glauben, dem du folgen musst.
    </AccordionItem>
    <AccordionItem question="Gibt es Körperkontakt?">
      Nur, wenn du zustimmst. Wenn wir etwas mit Berührung machen, etwa den Kreis zum Schluss Schulter an Schulter im
      Stehen schließen, frage ich vorher, ob das für alle passt. Du kannst jederzeit Nein sagen oder einfach
      dabeistehen.
    </AccordionItem>
    <AccordionItem question="Wie vertraulich ist das, was ich erzähle?">
      Vertraulichkeit ist die erste Absprache jedes Abends: Was hier erzählt wird, bleibt hier. Sie ist eine Zusage
      unter den Anwesenden, keine Garantie. Wie viel du erzählst, entscheidest deshalb immer du.
    </AccordionItem>
  </Faq>

  <Dates
    events={events}
    anchor="termine"
    eyebrow=""
    lede={'Wähle einen Abend, der für dich passt. Treffpunkt, Beitrag und Anmeldung findest du beim jeweiligen Termin.'}
    title="Dabei sein."
  />

  <Newsletter
    title="Termine per E‑Mail erhalten"
    text="Du bekommst eine kurze Nachricht, sobald der nächste Männerkreis feststeht. Mehr wird über diesen Verteiler nicht verschickt."
    whatsappTitle="Zwischen den Abenden"
    whatsappText="Für den Austausch zwischen den Abenden gibt es außerdem eine WhatsApp-Gruppe."
    whatsappLabel="Zur WhatsApp-Gruppe"
    whatsappLink={site.whatsappCommunityLink}
  />
</Layout>
