---
import { PRERENDERED_CACHE_CONTROL } from '@lib/cache';
import { PENDING } from '@lib/event-status';
import { eventSeriesSchema } from '@lib/series-schema';

import photo from '../assets/images/markus-sommer.jpg';
import Dates from '../components/blocks/Dates.astro';
import Facts from '../components/blocks/Facts.astro';
import Faq from '../components/blocks/Faq.astro';
import Frame from '../components/blocks/Frame.astro';
import Hero from '../components/blocks/Hero.astro';
import Intro from '../components/blocks/Intro.astro';
import JourneySteps from '../components/blocks/JourneySteps.astro';
import Moderator from '../components/blocks/Moderator.astro';
import Statement from '../components/blocks/Statement.astro';
import Testimonials from '../components/blocks/Testimonials.astro';
import home from '../content/home.json';
import Layout from '../layouts/Layout.astro';

// Prerendered, so its photo is built with the page. What is live (the next date, the
// facts that follow from it, the voices) comes as server islands, read on every visit.
export const prerender = true;

Astro.response.headers.set('Cache-Control', PRERENDERED_CACHE_CONTROL);

const { meta, faq, journey_steps: evening } = home;

const siteUrl = Astro.site ?? new URL('https://mens-circle.de');

// Structured data uses the same copy as the visible sections.
const schemas: Record<string, unknown>[] = [];

if (faq.items.length) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${siteUrl.origin}/#faq`,
    mainEntity: faq.items
      .filter((i) => i.question && i.answer)
      .map((i) => ({
        '@type': 'Question',
        name: i.question,
        acceptedAnswer: { '@type': 'Answer', text: i.answer },
      })),
  });
}

// ItemList, not HowTo: the steps describe how an evening runs rather than an
// actionable procedure, and Google retired HowTo rich results in 2023.
if (evening.steps.length) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: evening.title ?? 'Wie ein Abend abläuft',
    description: evening.subtitle ?? '',
    itemListElement: evening.steps.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.title ?? '',
      description: s.description ?? '',
    })),
  });
}

// One shared entity, also emitted by /event.
schemas.push(eventSeriesSchema(siteUrl));
---

<Layout title={meta.title} description={meta.description} schemas={schemas}>
  <Hero {...home.hero} />
  <Facts server:defer {...home.facts}>
    <Facts slot="fallback" {...home.facts} state={PENDING} />
  </Facts>
  <Intro {...home.intro} />
  <JourneySteps {...home.journey_steps} />
  <Statement {...home.statement} />
  <Moderator {...home.moderator} image={photo} />
  <Frame {...home.frame} />
  <Testimonials server:defer {...home.testimonials}>
    <Testimonials slot="fallback" {...home.testimonials} pending />
  </Testimonials>
  <Faq {...home.faq} />
  <Dates {...home.dates} />
</Layout>
