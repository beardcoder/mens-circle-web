---
import { getEntry } from 'astro:content';

import { eventSeriesSchema } from '@lib/series-schema';

import PageContent from '../components/PageContent.astro';
import Layout from '../layouts/Layout.astro';

// Rendered on demand: the next date, the facts and the voices are in the first HTML,
// so nothing on the page is swapped after load. The middleware's revalidate policy
// keeps the seat count current.

const home = await getEntry('pages', 'home');

if (!home) throw new Error('src/content/home.json is missing');

const { meta, blocks } = home.data;

const siteUrl = Astro.site ?? new URL('https://mens-circle.de');

// Build per-page structured data from the content blocks.
const schemas: Record<string, unknown>[] = [];

const faq = blocks.find((b) => b.type === 'faq');

if (faq?.data?.items?.length) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${siteUrl.origin}/#faq`,
    mainEntity: faq.data.items
      .filter((i) => i.question && i.answer)
      .map((i) => ({
        '@type': 'Question',
        name: i.question,
        acceptedAnswer: { '@type': 'Answer', text: i.answer },
      })),
  });
}

// ItemList, not HowTo: the steps describe how an evening runs rather than an
// actionable procedure, and Google retired HowTo rich results in 2023.
const evening = blocks.find((b) => b.type === 'journey-steps');

if (evening?.data?.steps?.length) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: evening.data.title ?? 'Wie ein Abend abläuft',
    description: evening.data.subtitle ?? '',
    itemListElement: evening.data.steps.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.title ?? '',
      description: s.description ?? '',
    })),
  });
}

// One shared entity, also emitted by /event.
schemas.push(eventSeriesSchema(siteUrl));
---

<Layout title={meta.title} description={meta.description} schemas={schemas}>
  <PageContent blocks={blocks} />
</Layout>
