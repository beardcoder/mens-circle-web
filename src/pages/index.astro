---
import Layout from '../layouts/Layout.astro';
import type { Block } from '../components/PageContent.astro';
import PageContent from '../components/PageContent.astro';
import home from '../content/home.json';
import { PRERENDERED_CACHE_CONTROL } from '@lib/cache';
import { eventSeriesSchema } from '@lib/series-schema';

// Static shell and native <Picture> assets; live content uses server:defer.
export const prerender = true;
// Everything live on this page arrives through a server island, so the document itself may be cached.
Astro.response.headers.set('Cache-Control', PRERENDERED_CACHE_CONTROL);

const blocks = home.blocks as Block[];

const siteUrl = Astro.site ?? new URL('https://mens-circle.de');

// Build per-page structured data from the content blocks.
const schemas: Record<string, unknown>[] = [];

const faq = blocks.find((b) => b.type === 'faq');
if (faq?.data?.items?.length) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${siteUrl.origin}/#faq`,
    mainEntity: faq.data.items
      .filter((i: { question?: string; answer?: string }) => i.question && i.answer)
      .map((i: { question?: string; answer?: string }) => ({
        '@type': 'Question',
        name: i.question,
        acceptedAnswer: { '@type': 'Answer', text: i.answer },
      })),
  });
}

// ItemList, not HowTo: the steps describe how an evening runs rather than an
// actionable procedure, and Google retired HowTo rich results in 2023.
const evening = blocks.find((b) => b.type === 'journey-steps');
if (evening?.data?.steps?.length) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: evening.data.title ?? 'Wie ein Abend abläuft',
    description: evening.data.subtitle ?? '',
    itemListElement: evening.data.steps.map((s: { title?: string; description?: string }, i: number) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.title ?? '',
      description: s.description ?? '',
    })),
  });
}

// One shared entity, also emitted by /event.
schemas.push(eventSeriesSchema(siteUrl));
---

<Layout title={home.meta.title} description={home.meta.description} schemas={schemas}>
  <PageContent blocks={blocks} />
</Layout>
