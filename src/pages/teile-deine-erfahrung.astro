---
import Layout from '../layouts/Layout.astro';
import TestimonialForm from '../components/forms/TestimonialForm.astro';
import { PRERENDERED_CACHE_CONTROL } from '@lib/cache';

// Prerendered: the form posts to the submitTestimonial action client-side
// (see src/lib/form.ts), so nothing here needs server rendering.
export const prerender = true;
Astro.response.headers.set('Cache-Control', PRERENDERED_CACHE_CONTROL);

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: '/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Teile deine Erfahrung',
        item: '/teile-deine-erfahrung',
      },
    ],
  },
];
---

<Layout
  title="Teile deine Erfahrung – Männerkreis Straubing"
  description="Du warst schon einmal da? Erzähl in ein paar Sätzen, wie der Abend für dich war. Deine Worte helfen Männern, die noch überlegen, ob sie kommen."
  schemas={schemas}
>
  <section class="hero">
    <div class="container">
      <div class="hero__content">
        <p class="marker hero__label">Aus dem Kreis</p>
        <h1 class="hero__title">Teile deine Erfahrung</h1>
        <p class="hero__subtitle">
          Wenn du beim Männerkreis warst und etwas dazu sagen möchtest: Dein Text hilft anderen Männern einzuschätzen,
          worauf sie sich einlassen.
        </p>
      </div>
    </div>
  </section>

  <section class="section surface-sand testimonial-form-section">
    <div class="container">
      <div class="testimonial-form__wrapper">
        <div class="testimonial-form__intro">
          <h2 class="display display--sm">Was du schreibst, lese ich zuerst</h2>
          <p>
            Dein Text wird nicht automatisch veröffentlicht. Ich sehe ihn mir vorher an und stelle ihn dann –
            unverändert – auf die Website. Du entscheidest, welchen Namen du angibst.
          </p>
        </div>

        <TestimonialForm />
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  @layer sections {
    .testimonial-form__wrapper {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-xl);
      align-items: start;
    }

    .testimonial-form__intro h2 {
      margin-block-end: var(--space-md);
    }

    .testimonial-form__intro p {
      max-inline-size: 42ch;
      font-size: var(--text-section-body-lg);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
    }

    .testimonial-form {
      padding: var(--space-lg);
      background: var(--bg-primary);
      border: 1px solid var(--border-medium);
      border-radius: var(--radius);
    }

    /* Under the field, not floating inside it. */
    .testimonial-form__counter {
      display: block;
      margin-block-start: var(--space-3xs);
      font-size: var(--text-caption);
      color: var(--text-muted);
      text-align: end;
      pointer-events: none;
    }

    .testimonial-form__note {
      max-inline-size: var(--measure);
      margin-block-start: var(--space-sm);
      font-size: var(--text-caption);
      line-height: var(--leading-relaxed);
      color: var(--text-muted);
    }

    @media (width <= 56em) {
      .testimonial-form__wrapper {
        grid-template-columns: minmax(0, 1fr);
      }

      .testimonial-form {
        padding: var(--space-md);
        margin-inline: calc(-0.5 * var(--container-gutter));
      }
    }
  }
</style>
