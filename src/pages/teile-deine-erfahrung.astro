---
import Layout from '../layouts/Layout.astro';
import TestimonialForm from '../components/islands/TestimonialForm.svelte';

// Static form page — prerendered at build. The island POSTs to
// /api/testimonial/submit, so no server rendering is needed here.
export const prerender = true;

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: '/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Teile deine Erfahrung',
        item: '/teile-deine-erfahrung',
      },
    ],
  },
];
---

<Layout
  title="Teile deine Erfahrung – Männerkreis Niederbayern/ Straubing"
  description="Teile deine Erfahrung mit dem Männerkreis Niederbayern/ Straubing. Hilf anderen Männern zu verstehen, was der Kreis bedeuten kann."
  schemas={schemas}
>
  <section class="hero">
    <div class="container">
      <div class="hero__content">
        <p class="hero__label">Aus dem Kreis</p>
        <h1 class="hero__title">Teile deine Erfahrung</h1>
        <p class="hero__subtitle">
          Wenn du beim Männerkreis warst und etwas dazu sagen möchtest: Dein Text hilft anderen Männern einzuschätzen,
          worauf sie sich einlassen.
        </p>
      </div>
    </div>
  </section>

  <section class="section testimonial-form-section">
    <div class="container">
      <div class="testimonial-form__wrapper">
        <div class="testimonial-form__intro">
          <h2>Was du geschrieben hast, lese ich zuerst</h2>
          <p>
            Dein Text wird nicht automatisch veröffentlicht. Ich sehe ihn mir vorher an und stelle ihn dann –
            unverändert – auf die Website. Du entscheidest, welchen Namen du angibst.
          </p>
        </div>

        <TestimonialForm client:visible />
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  @layer sections {
    .testimonial-form-section {
      border-block-start: 1px solid var(--border-light);
    }

    .testimonial-form__wrapper {
      max-inline-size: var(--container-narrow);
    }

    .testimonial-form__intro {
      margin-block-end: var(--space-lg);
    }

    .testimonial-form__intro h2 {
      margin-block-end: var(--space-xs);
      font-family: var(--font-display);
      font-size: var(--text-3xl);
      line-height: 1.15;
      color: var(--text-primary);
    }

    .testimonial-form__intro p {
      max-inline-size: var(--measure);
      margin-block-end: var(--space-sm);
      font-size: var(--text-section-body-lg);
      line-height: var(--leading-relaxed);
      color: var(--text-secondary);
    }

    .testimonial-form__intro p:last-child {
      margin-block-end: 0;
    }

    .testimonial-form {
      max-inline-size: var(--content-max-form);
    }

    /* Under the field, not floating inside it: the square corners and the
       native resize grip leave no clear space in the bottom-right any more. */
    .testimonial-form__counter {
      display: block;
      margin-block-start: var(--space-3xs);
      font-size: var(--text-caption);
      color: var(--text-muted);
      text-align: end;
      pointer-events: none;
    }

    .testimonial-form__note {
      max-inline-size: var(--measure);
      margin-block-start: var(--space-sm);
      font-size: var(--text-caption);
      line-height: var(--leading-relaxed);
      color: var(--text-muted);
    }
  }
</style>
