---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import TestimonialForm from '../components/forms/TestimonialForm.astro';
import Container from '../components/ui/Container.astro';
import { PRERENDERED_CACHE_CONTROL } from '@lib/cache';
import site from '@data/site.json';

// Prerendered: the form posts to the submitTestimonial action client-side
// (see src/lib/form.ts), so nothing here needs server rendering.
export const prerender = true;
Astro.response.headers.set('Cache-Control', PRERENDERED_CACHE_CONTROL);

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: '/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Teile deine Erfahrung',
        item: '/teile-deine-erfahrung',
      },
    ],
  },
];
---

<Layout
  title={`Teile deine Erfahrung – ${site.siteName}`}
  description="Du warst schon einmal da? Erzähl in ein paar Sätzen, wie der Abend für dich war. Deine Worte helfen Männern, die noch überlegen, ob sie kommen."
  robots="noindex, follow"
  schemas={schemas}
>
  <PageIntro eyebrow="Aus dem Kreis" title="Teile deine Erfahrung">
    <Fragment slot="lead">
      Wenn du beim Männerkreis warst und etwas dazu sagen möchtest: Dein Text hilft anderen Männern einzuschätzen,
      worauf sie sich einlassen.
    </Fragment>
  </PageIntro>

  {/* One column of a readable width: the notes stand at the form, not beside it. */}
  <section aria-labelledby="teilen-title" class="pb-section">
    <Container>
      <div class="max-w-form">
        <h2 id="teilen-title" class="text-sub text-fg">
          Was du schreibst, lese ich zuerst
        </h2>
        <p class="mt-3 text-md text-fg-soft">
          Dein Text wird nicht automatisch veröffentlicht. Ich sehe ihn mir vorher an und stelle ihn dann&nbsp;–
          unverändert&nbsp;– auf die Website. Du entscheidest, welchen Namen du angibst.
        </p>
        <TestimonialForm class="mt-8" />
      </div>
    </Container>
  </section>
</Layout>
