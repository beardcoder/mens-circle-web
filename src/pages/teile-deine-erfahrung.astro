---
import Layout from '../layouts/Layout.astro';
import TestimonialForm from '../components/forms/TestimonialForm.astro';
import { PRERENDERED_CACHE_CONTROL } from '@lib/cache';

// Prerendered: the form posts to the submitTestimonial action client-side
// (see src/lib/form.ts), so nothing here needs server rendering.
export const prerender = true;
Astro.response.headers.set('Cache-Control', PRERENDERED_CACHE_CONTROL);

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: '/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Teile deine Erfahrung',
        item: '/teile-deine-erfahrung',
      },
    ],
  },
];
---

<Layout
  title="Teile deine Erfahrung – Männerkreis Straubing"
  description="Du warst schon einmal da? Erzähl in ein paar Sätzen, wie der Abend für dich war. Deine Worte helfen Männern, die noch überlegen, ob sie kommen."
  schemas={schemas}
>
  <section class="page-hero">
    <div class="container page-hero__layout">
      <div class="page-hero__content">
        <p class="kicker">Aus dem Kreis</p>
        <h1 class="page-hero__title display">Teile deine Erfahrung</h1>
        <p class="page-hero__lead">
          Du warst beim Männerkreis und möchtest etwas dazu sagen? Deine Worte helfen anderen Männern einzuschätzen,
          worauf sie sich einlassen.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--sand testimonial-form-section">
    <div class="container bay">
      <div class="testimonial-form__intro">
        <h2>Was du schreibst, lese ich zuerst</h2>
        <p>
          Dein Text wird nicht automatisch veröffentlicht. Ich sehe ihn mir vorher an und stelle ihn dann unverändert
          auf die Website. Welchen Namen du angibst, entscheidest du.
        </p>
      </div>

      <div class="testimonial-form__panel">
        <TestimonialForm />
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  @layer sections {
    .testimonial-form__intro {
      grid-column: 1 / span 5;
    }

    .testimonial-form__intro h2 {
      margin-block-end: var(--space-md);
      font-size: var(--step-3);
    }

    .testimonial-form__intro p {
      max-inline-size: 40ch;
      font-family: var(--font-body);
      font-size: var(--step-1);
      line-height: 1.5;
      color: var(--text-secondary);
    }

    .testimonial-form__panel {
      grid-column: 7 / span 6;
      padding: var(--space-lg);
      background: var(--bg-elevated);
      border: 1px solid var(--rule);
      border-radius: var(--radius);
    }

    /* Under the field, not floating inside it. */
    .testimonial-form__counter {
      display: block;
      margin-block-start: var(--space-3xs);
      font-family: var(--font-ui);
      font-size: var(--text-caption);
      color: var(--text-muted);
      text-align: end;
      pointer-events: none;
    }

    .testimonial-form__note {
      margin-block-start: var(--space-sm);
      font-family: var(--font-ui);
      font-size: var(--text-caption);
      line-height: var(--leading-normal);
      color: var(--text-muted);
    }

    @media (width <= 56em) {
      .testimonial-form__panel {
        margin-block-start: var(--space-lg);
        padding: var(--space-md);
      }
    }
  }
</style>
