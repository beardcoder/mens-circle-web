---
import site from '@data/site.json';
import { breadcrumbSchema } from '@lib/event-schema';

import TestimonialForm from '../components/forms/TestimonialForm.astro';
import PageIntro from '../components/PageIntro.astro';
import Container from '../components/ui/Container.astro';
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout
  title={`Teile deine Erfahrung – ${site.siteName}`}
  description="Du warst schon einmal da? Erzähl in ein paar Sätzen, wie der Abend für dich war. Deine Worte helfen Männern, die noch überlegen, ob sie kommen."
  robots="noindex, follow"
  schemas={[
    breadcrumbSchema(Astro.site!, [['Teile deine Erfahrung', new URL('/teile-deine-erfahrung', Astro.site!).href]]),
  ]}
>
  <PageIntro eyebrow="Aus dem Kreis" title="Teile deine Erfahrung">
    <Fragment slot="lead">
      Wenn du beim Männerkreis warst und etwas dazu sagen möchtest: Dein Text hilft anderen Männern einzuschätzen,
      worauf sie sich einlassen.
    </Fragment>
  </PageIntro>

  {/* One column of a readable width: the notes stand at the form, not beside it. */}
  <section aria-labelledby="teilen-title" class="pb-section">
    <Container>
      <div class="max-w-form">
        <h2 id="teilen-title" class="text-sub text-fg">
          Was du schreibst, lese ich zuerst
        </h2>
        <p class="mt-3 text-md text-fg-soft">
          Dein Text wird nicht automatisch veröffentlicht. Ich sehe ihn mir vorher an und stelle ihn dann unverändert
          auf die Website. Du entscheidest, welchen Namen du angibst.
        </p>
        <TestimonialForm class="mt-8" />
      </div>
    </Container>
  </section>
</Layout>
