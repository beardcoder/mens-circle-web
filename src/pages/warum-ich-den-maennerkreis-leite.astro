---
import Layout from '../layouts/Layout.astro';
import type { Block } from '../components/PageContent.astro';
import PageContent from '../components/PageContent.astro';
import page from '../content/warum-ich-den-maennerkreis-leite.json';
import { canonicalUrl } from '@lib/canonical';

// Prerendered: content only, no live data.
export const prerender = true;

const blocks = page.blocks as Block[];

// Strip inline HTML from titles/answers for schema text.
const strip = (s = '') => s.replace(/<[^>]*>/g, '').trim();

const siteUrl = Astro.site ?? new URL('https://mens-circle.de');
const canonical = canonicalUrl(siteUrl, Astro.url.pathname);

// Build per-page structured data from the content blocks.
const schemas: Record<string, unknown>[] = [];

const faq = blocks.find((b) => b.type === 'faq');
if (faq?.data?.items?.length) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.data.items
      .filter((i: { question?: string; answer?: string }) => i.question && i.answer)
      .map((i: { question?: string; answer?: string }) => ({
        '@type': 'Question',
        name: i.question,
        acceptedAnswer: { '@type': 'Answer', text: strip(i.answer) },
      })),
  });
}

// Breadcrumb: home → this page.
schemas.push({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: siteUrl.origin },
    { '@type': 'ListItem', position: 2, name: 'Warum ich den Männerkreis leite', item: canonical },
  ],
});

// `Article`, not a bare `WebPage`: a signed piece of writing, attributed to the
// `Person` entity in SeoHead. The dates are set by hand in the content file —
// a file mtime would claim every page was modified at build time.
const articleImage = new URL('/images/og-markus.jpg', siteUrl).href;

schemas.push({
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonical}#article`,
  url: canonical,
  mainEntityOfPage: canonical,
  headline: page.meta.ogTitle ?? strip(page.meta.title),
  description: page.meta.description,
  image: articleImage,
  inLanguage: 'de-DE',
  datePublished: page.meta.datePublished,
  dateModified: page.meta.dateModified,
  author: { '@id': `${siteUrl.origin}/#markus` },
  publisher: { '@id': `${siteUrl.origin}/#organization` },
  isPartOf: { '@id': `${siteUrl.origin}/#website` },
  about: { '@id': `${siteUrl.origin}/#organization` },
});

// This page ships its own card image, so it declares its size too: a declared
// size that does not match the file downgrades a large card to a small one.
const OG_IMAGE = { width: 1200, height: 630 };
---

<Layout
  title={page.meta.title}
  description={page.meta.description}
  ogTitle={page.meta.ogTitle}
  ogDescription={page.meta.ogDescription}
  ogType="article"
  ogImage="/images/og-markus.jpg"
  ogImageWidth={OG_IMAGE.width}
  ogImageHeight={OG_IMAGE.height}
  ogImageAlt="Markus Sommer, der den Männerkreis in Straubing leitet"
  publishedTime={page.meta.datePublished}
  modifiedTime={page.meta.dateModified}
  schemas={schemas}
>
  <PageContent blocks={blocks} />
</Layout>
