---
import { PRERENDERED_CACHE_CONTROL } from '@lib/cache';
import { canonicalUrl } from '@lib/canonical';

import photo from '../assets/images/markus-sommer.jpg';
import Cta from '../components/blocks/Cta.astro';
import Faq from '../components/blocks/Faq.astro';
import PageHero from '../components/blocks/PageHero.astro';
import TextSection from '../components/blocks/TextSection.astro';
import ValueItems from '../components/blocks/ValueItems.astro';
import page from '../content/warum-ich-den-maennerkreis-leite.json';
import Layout from '../layouts/Layout.astro';

// Prerendered: content only, no live data.
export const prerender = true;

Astro.response.headers.set('Cache-Control', PRERENDERED_CACHE_CONTROL);

const { meta, faq } = page;

// Strip inline HTML from titles/answers for schema text.
const strip = (s = '') => s.replace(/<[^>]*>/g, '').trim();

const siteUrl = Astro.site ?? new URL('https://mens-circle.de');
const canonical = canonicalUrl(siteUrl, Astro.url.pathname);

// Structured data uses the same copy as the visible sections.
const schemas: Record<string, unknown>[] = [];

if (faq.items.length) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.items
      .filter((i) => i.question && i.answer)
      .map((i) => ({
        '@type': 'Question',
        name: i.question,
        acceptedAnswer: { '@type': 'Answer', text: strip(i.answer) },
      })),
  });
}

// Breadcrumb: home → this page.
schemas.push({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: siteUrl.origin },
    { '@type': 'ListItem', position: 2, name: 'Warum ich den Männerkreis leite', item: canonical },
  ],
});

// `Article`, not a bare `WebPage`: a signed piece of writing, attributed to the `Person` entity in SeoHead.
const articleImage = new URL('/images/og-markus.jpg?v=2', siteUrl).href;

schemas.push({
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonical}#article`,
  url: canonical,
  mainEntityOfPage: canonical,
  headline: meta.ogTitle ?? strip(meta.title),
  description: meta.description,
  image: articleImage,
  inLanguage: 'de-DE',
  datePublished: meta.datePublished,
  dateModified: meta.dateModified,
  author: { '@id': `${siteUrl.origin}/#markus` },
  publisher: { '@id': `${siteUrl.origin}/#organization` },
  isPartOf: { '@id': `${siteUrl.origin}/#website` },
  about: { '@id': `${siteUrl.origin}/#organization` },
});

// This page ships its own card image, so it declares its size too: a declared
// size that does not match the file downgrades a large card to a small one.
const OG_IMAGE = { width: 1200, height: 630 };
---

<Layout
  title={meta.title}
  description={meta.description}
  ogTitle={meta.ogTitle}
  ogDescription={meta.ogDescription}
  ogType="article"
  ogImage="/images/og-markus.jpg?v=2"
  ogImageWidth={OG_IMAGE.width}
  ogImageHeight={OG_IMAGE.height}
  ogImageAlt="Markus Sommer, der den Männerkreis in Straubing leitet"
  publishedTime={meta.datePublished}
  modifiedTime={meta.dateModified}
  schemas={schemas}
>
  <PageHero data={{ ...page.page_hero, image: photo }} />
  <TextSection data={page.why} />
  <TextSection data={page.hesitation} />
  <ValueItems data={page.value_items} />
  <TextSection data={page.expectations} />
  <TextSection data={page.invitation} />
  <Faq data={page.faq} />
  <Cta data={page.cta} />
</Layout>
