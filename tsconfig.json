{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src",
    "scripts",
    "tests",
    "server.ts",
    "astro.config.mjs",
    "eslint.config.ts",
    "drizzle.config.ts"
  ],
  "exclude": ["dist", "drizzle"],
  "compilerOptions": {
    "strictNullChecks": true,
    "allowJs": true,
    "types": ["bun"],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["src/lib/*"],
      "@components/*": ["src/components/*"],
      "@data/*": ["src/data/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  }
}
